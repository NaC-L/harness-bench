+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createLimiter } = require('./limit');
+
+test('invokes tasks once with no arguments and adopts their results', async () => {
+  const run = createLimiter(1);
+  let calls = 0;
+  function task() {
+    calls += 1;
+    assert.equal(arguments.length, 0);
+    return 42;
+  }
+  assert.equal(await run(task), 42);
+  assert.equal(calls, 1);
+  assert.equal(await run(() => Promise.resolve('resolved')), 'resolved');
+});
+
+test('synchronous throws release capacity and preserve queued submission order', { timeout: 2000 }, async () => {
+  const run = createLimiter(1);
+  const error = new Error('synchronous failure');
+  const started = [];
+  const failed = run(() => {
+    started.push(0);
+    throw error;
+  });
+  const rejection = assert.rejects(failed, actual => actual === error);
+  const queued = [1, 2, 3].map(value => run(() => {
+    started.push(value);
+    return value;
+  }));
+  await rejection;
+  assert.deepEqual(await Promise.all(queued), [1, 2, 3]);
+  assert.deepEqual(started, [0, 1, 2, 3]);
+  assert.equal(await run(() => 'still usable'), 'still usable');
+});
