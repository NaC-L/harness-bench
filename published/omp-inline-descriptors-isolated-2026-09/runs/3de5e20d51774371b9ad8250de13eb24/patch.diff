 class LRUCache {
+  #entries = new Map();
+
   constructor(capacity) {
+    if (!Number.isInteger(capacity) || capacity <= 0) {
+      throw new RangeError('Capacity must be a positive integer Number');
+    }
     this.capacity = capacity;
   }
 
