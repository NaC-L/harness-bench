+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createParser, parse } = require('./src/csv');
+const { toObjects } = require('./src/rows');
+
+function checkChunkings(text, expected, options) {
+  assert.deepEqual(parse(text, options), expected);
+  // Every pair of boundaries includes empty chunks and splits within CRLF,
+  // escaped quotes, and surrogate pairs, without relying on parse as an oracle.
+  for (let first = 0; first <= text.length; first++) {
+    for (let second = first; second <= text.length; second++) {
+      const parser = createParser(options);
+      const actual = [
+        ...parser.push(''),
+        ...parser.push(text.slice(0, first)),
+        ...parser.push(''),
+        ...parser.push(text.slice(first, second)),
+        ...parser.push(''),
+        ...parser.push(text.slice(second)),
+        ...parser.end(),
+      ];
+      assert.deepEqual(actual, expected, `boundaries ${first}, ${second} in ${JSON.stringify(text)}`);
+      assert.deepEqual(parser.end(), []);
+    }
+  }
+}
+
+test('streaming grammar is independent of chunk boundaries', () => {
+  const cases = [
+    ['', []],
+    ['\uFEFF', []],
+    ['\n', [['']]],
+    ['\r\n\r\n\n\r', [[''], [''], [''], ['']]],
+    ['a\r\nb\rc\n', [['a'], ['b'], ['c']]],
+    [',,', [['', '', '']]],
+    ['""', [['']]],
+    ['""""', [['"']]],
+    ['a"b,"c,d","say ""hi""",\r\n', [['a"b', 'c,d', 'say "hi"', '']]],
+    ['\uFEFF"a\r\nb\rc\nd",😀\r\n\uFEFF', [['a\r\nb\rc\nd', '😀'], ['\uFEFF']]],
+    ['\uFEFF\uFEFF', [['\uFEFF']]],
+  ];
+  for (const [text, expected] of cases) checkChunkings(text, expected);
+  checkChunkings('a;"b;c";\r\n;z', [['a', 'b;c', ''], ['', 'z']], { delimiter: ';' });
+});
+
+test('push emits records immediately and never repeats earlier output', () => {
+  const parser = createParser({ header: true });
+  const first = parser.push('a,b\r');
+  assert.deepEqual(first, [['a', 'b']]);
+  assert.deepEqual(parser.push(''), []);
+  assert.deepEqual(parser.push('\n"x\r'), []);
+  assert.deepEqual(parser.push('\ny",z\nlast,'), [['x\r\ny', 'z']]);
+  assert.deepEqual(parser.end(), [['last', '']]);
+  assert.deepEqual(first, [['a', 'b']]);
+  assert.deepEqual(parser.end(), []);
+  assert.throws(() => parser.push(''), Error);
+  assert.throws(() => parser.push('more'), Error);
+});
+
+test('delimiter and chunk validation use the documented exception types', () => {
+  for (const delimiter of ['', 'ab', '😀', '"', '\r', '\n', null, 1, true, {}, []]) {
+    assert.throws(() => createParser({ delimiter }), RangeError);
+    assert.throws(() => parse('', { delimiter }), RangeError);
+  }
+  assert.deepEqual(parse('a,b', { delimiter: undefined }), [['a', 'b']]);
+  for (const delimiter of [';', '\t', ' ', '\0', '\uD800']) {
+    assert.deepEqual(parse(`a${delimiter}b`, { delimiter }), [['a', 'b']]);
+  }
+  const parser = createParser();
+  for (const chunk of [undefined, null, 0, {}, [], Buffer.from('a')]) {
+    assert.throws(() => parser.push(chunk), TypeError);
+  }
+  assert.deepEqual(parser.push('\uFEFFa\n'), [['a']]);
+  assert.deepEqual(parser.end(), []);
+});
+
+test('syntax errors report physical lines across every single split', () => {
+  const cases = [
+    ['"a"x', 1, false],
+    ['"a" ', 1, false],
+    ['a\r\n"b\r\nc\rd\ne"x', 5, false],
+    ['"', 1, true],
+    ['"a\r\nb\rc\n', 4, true],
+    ['x\r\n"a""', 2, true],
+    ['"a\r', 2, true],
+  ];
+  for (const [text, line, atEnd] of cases) {
+    const checkError = error => error instanceof SyntaxError &&
+      new RegExp(`\\bline ${line}\\b`).test(error.message);
+    assert.throws(() => parse(text), checkError);
+    for (let split = 0; split <= text.length; split++) {
+      const parser = createParser();
+      const push = () => {
+        parser.push(text.slice(0, split));
+        parser.push('');
+        parser.push(text.slice(split));
+      };
+      if (atEnd) {
+        push();
+        assert.throws(() => parser.end(), checkError);
+      } else {
+        assert.throws(push, checkError);
+      }
+    }
+  }
+});
+
+test('parser instances and returned rows have independent state', () => {
+  const left = createParser();
+  const right = createParser({ delimiter: ';' });
+  assert.deepEqual(left.push('"left'), []);
+  assert.deepEqual(right.push('right;value\r'), [['right', 'value']]);
+  const rows = left.push('"\n');
+  rows[0][0] = 'changed';
+  assert.deepEqual(left.push('next\n'), [['next']]);
+  assert.deepEqual(right.push('\nlast'), []);
+  assert.deepEqual(left.end(), []);
+  assert.deepEqual(right.end(), [['last']]);
+});
+
+test('parse header mode preserves the rows helper contract', () => {
+  const text = 'x,x,x_2,x,__proto__,constructor,toString,\na,b,c,d,e,f,g,h,extra\nshort';
+  const objects = parse(text, { header: true });
+  assert.deepEqual(Object.keys(objects[0]), [
+    'x', 'x_2', 'x_2_2', 'x_3', '__proto__', 'constructor', 'toString', '',
+  ]);
+  assert.deepEqual(Object.values(objects[0]), ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h']);
+  assert.deepEqual(Object.values(objects[1]), ['short', '', '', '', '', '', '', '']);
+  for (const object of objects) {
+    assert.equal(Object.getPrototypeOf(object), Object.prototype);
+    for (const key of Object.keys(object)) {
+      const descriptor = Object.getOwnPropertyDescriptor(object, key);
+      assert.equal(descriptor.enumerable, true);
+      assert.equal(descriptor.writable, true);
+      assert.equal(descriptor.configurable, true);
+    }
+  }
+  assert.deepEqual(parse('', { header: true }), []);
+  assert.deepEqual(parse('header', { header: true }), []);
+  assert.deepEqual(parse('a\nb', { header: false }), [['a'], ['b']]);
+  const records = Object.freeze([Object.freeze(['value']), Object.freeze([])]);
+  const header = Object.freeze(['__proto__', 'x', 'x']);
+  const options = Object.freeze({ header });
+  const result = toObjects(records, options);
+  assert.deepEqual(Object.keys(result[0]), ['__proto__', 'x', 'x_2']);
+  assert.deepEqual(Object.values(result[0]), ['value', '', '']);
+  assert.deepEqual(records, [['value'], []]);
+  assert.deepEqual(header, ['__proto__', 'x', 'x']);
+  assert.deepEqual(toObjects(records, { header: [] }), [{}, {}]);
+});
