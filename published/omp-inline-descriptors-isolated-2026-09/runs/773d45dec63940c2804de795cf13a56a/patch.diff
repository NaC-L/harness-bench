+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { LRUCache } = require('./lru');
+
+test('capacity must be a positive integer Number', () => {
+  for (const capacity of [0, -0, -1, 1.5, Infinity, -Infinity, NaN,
+    '2', '', undefined, null, true, false, 2n, Symbol('2'), {}, [], new Number(2)]) {
+    assert.throws(() => new LRUCache(capacity), RangeError);
+  }
+  assert.throws(() => new LRUCache(), RangeError);
+  for (const capacity of [1, 2, Number.MAX_SAFE_INTEGER, Number.MAX_VALUE]) {
+    assert.equal(new LRUCache(capacity).size, 0);
+  }
+});
+
+test('getting an undefined value refreshes recency', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', undefined).set('b', 2);
+  assert.equal(cache.get('a'), undefined);
+  cache.set('c', 3);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('b'), false);
+  assert.equal(cache.size, 2);
+});
+
+test('updating an entry preserves size and makes it most recent', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.set('a', 3), cache);
+  assert.equal(cache.size, 2);
+  assert.equal(cache.has('b'), true);
+  cache.set('c', 4);
+  assert.equal(cache.has('b'), false);
+  assert.equal(cache.get('a'), 3);
+  assert.equal(cache.size, 2);
+});
+
+test('has and missing operations do not refresh recency', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('missing'), false);
+  assert.equal(cache.get('missing'), undefined);
+  assert.equal(cache.delete('missing'), false);
+  cache.set('c', 3);
+  assert.equal(cache.has('a'), false);
+  assert.equal(cache.has('b'), true);
+});
+
+test('deletion preserves relative recency of surviving entries', () => {
+  const cache = new LRUCache(3);
+  cache.set('a', 1).set('b', 2).set('c', 3);
+  assert.equal(cache.delete('b'), true);
+  assert.equal(cache.delete('b'), false);
+  assert.equal(cache.size, 2);
+  cache.set('d', 4).set('e', 5);
+  assert.equal(cache.has('a'), false);
+  assert.equal(cache.has('c'), true);
+  assert.equal(cache.size, 3);
+});
+
+test('keys and values retain Map semantics', () => {
+  const cache = new LRUCache(12);
+  const objectKey = {};
+  const functionKey = () => {};
+  const symbolKey = Symbol('key');
+  const value = {};
+  const keys = [objectKey, functionKey, symbolKey, null, undefined, NaN, 0, '0', 1n, false];
+  for (const key of keys) cache.set(key, value);
+  assert.equal(cache.size, keys.length);
+  for (const key of keys) assert.equal(cache.get(key), value);
+  assert.equal(cache.has({}), false);
+  assert.equal(cache.has(Symbol('key')), false);
+  cache.set(-0, undefined);
+  assert.equal(cache.size, keys.length);
+  assert.equal(cache.has(0), true);
+  assert.equal(cache.get(0), undefined);
+  cache.set(NaN, null);
+  assert.equal(cache.size, keys.length);
+  assert.equal(cache.get(NaN), null);
+});
+
+test('undefined keys can be evicted and capacity one supports updates', () => {
+  const cache = new LRUCache(1);
+  cache.set(undefined, 1).set(undefined, 2);
+  assert.equal(cache.size, 1);
+  assert.equal(cache.get(undefined), 2);
+  cache.set('replacement', 3);
+  assert.equal(cache.has(undefined), false);
+  assert.equal(cache.size, 1);
+});
+
+test('cache instances are independent', () => {
+  const first = new LRUCache(1);
+  const second = new LRUCache(2);
+  first.set('a', 1);
+  second.set('a', 2).set('b', 3);
+  first.set('c', 4);
+  assert.equal(second.get('a'), 2);
+  assert.equal(first.has('a'), false);
+  second.delete('a');
+  assert.equal(first.get('c'), 4);
+  assert.equal(first.size, 1);
+  assert.equal(second.size, 1);
+});
