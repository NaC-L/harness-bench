+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createParser, parse } = require('./src/csv');
+const { toObjects } = require('./src/rows');
+
+function parseChunks(chunks, options) {
+  const parser = createParser(options);
+  const records = [];
+  for (const chunk of chunks) records.push(...parser.push(chunk));
+  records.push(...parser.end());
+  return records;
+}
+
+const cases = [
+  ['', []],
+  ['\uFEFF', []],
+  ['\n', [['']]],
+  ['\r\n\r\n', [[''], ['']]],
+  ['a\rb\nc\r\nd', [['a'], ['b'], ['c'], ['d']]],
+  ['a,,b,', [['a', '', 'b', '']]],
+  ['""', [['']]],
+  ['"a,b","say ""hi"""\r\n', [['a,b', 'say "hi"']]],
+  ['"a\r\nb\rc\nd",tail\r\n', [['a\r\nb\rc\nd', 'tail']]],
+  ['a"b,"c"', [['a"b', 'c']]],
+  ['\uFEFFa,\uFEFFb\n\uFEFFc', [['a', '\uFEFFb'], ['\uFEFFc']]],
+  ['\uFEFF\uFEFF', [['\uFEFF']]],
+  ['😀,"😀"', [['😀', '😀']]],
+  ['left;"right;side";', [['left', 'right;side', '']], { delimiter: ';' }],
+  ['a\tb\t', [['a', 'b', '']], { delimiter: '\t' }],
+  ['a\0b', [['a', 'b']], { delimiter: '\0' }],
+];
+
+for (const [text, expected, options] of cases) {
+  test(`chunk boundaries preserve ${JSON.stringify(text)}`, () => {
+    assert.deepEqual(parse(text, options), expected);
+    assert.deepEqual(parseChunks(['', ...text.split('').flatMap(c => [c, '']), ''], options), expected);
+    for (let boundary = 0; boundary <= text.length; boundary++) {
+      assert.deepEqual(parseChunks([text.slice(0, boundary), '', text.slice(boundary)], options), expected);
+    }
+  });
+}
+
+test('completed records are emitted immediately, including at CR before LF arrives', () => {
+  const parser = createParser({ header: true });
+  assert.deepEqual(parser.push('a\r'), [['a']]);
+  assert.deepEqual(parser.push(''), []);
+  assert.deepEqual(parser.push('\n"b'), []);
+  assert.deepEqual(parser.push('"'), []);
+  assert.deepEqual(parser.push(',c\n\nlast,'), [['b', 'c'], ['']]);
+  assert.deepEqual(parser.end(), [['last', '']]);
+  assert.deepEqual(parser.end(), []);
+  assert.throws(() => parser.push(''), Error);
+  assert.throws(() => parser.push('more'), Error);
+});
+
+test('empty chunks leave the initial BOM eligible for stripping', () => {
+  assert.deepEqual(parseChunks(['', '', '\uFEFF', '', 'x\n']), [['x']]);
+});
+
+test('delimiter validation occurs at creation without coercion', () => {
+  for (const delimiter of ['', 'ab', '😀', '"', '\r', '\n', null, 1, {}, [], false]) {
+    assert.throws(() => createParser({ delimiter }), RangeError);
+  }
+  assert.deepEqual(parse('a,b', { delimiter: undefined }), [['a', 'b']]);
+  assert.deepEqual(parse('a b', { delimiter: ' ' }), [['a', 'b']]);
+});
+
+test('push rejects nonstrings without consuming input', () => {
+  const parser = createParser();
+  for (const chunk of [undefined, null, 0, {}, [], Buffer.from('a')]) {
+    assert.throws(() => parser.push(chunk), TypeError);
+  }
+  assert.deepEqual(parser.push('\uFEFFa\n'), [['a']]);
+  assert.deepEqual(parser.end(), []);
+});
+
+const invalidCases = [
+  ['"a"x', 1, 'push'],
+  ['"a" ', 1, 'push'],
+  ['a\r\n"b"x', 2, 'push'],
+  ['"a\r\nb"x', 2, 'push'],
+  ['"a\rb\nc"x', 3, 'push'],
+  ['"a\r\n\r\nb"x', 3, 'push'],
+  ['"', 1, 'end'],
+  ['"a\r\n', 2, 'end'],
+  ['"a\r\n\r', 3, 'end'],
+  ['"a""', 1, 'end'],
+];
+for (const [text, line, phase] of invalidCases) {
+  test(`syntax errors report physical line ${line}: ${JSON.stringify(text)}`, () => {
+    const validate = error => error instanceof SyntaxError && error.message.includes(`line ${line}`);
+    for (let boundary = 0; boundary <= text.length; boundary++) {
+      const parser = createParser();
+      const push = () => {
+        parser.push(text.slice(0, boundary));
+        parser.push('');
+        parser.push(text.slice(boundary));
+      };
+      if (phase === 'push') assert.throws(push, validate);
+      else {
+        push();
+        assert.throws(() => parser.end(), validate);
+      }
+    }
+  });
+}
+
+test('parsers maintain independent state', () => {
+  const first = createParser();
+  const second = createParser({ delimiter: ';' });
+  assert.deepEqual(first.push('"a'), []);
+  assert.deepEqual(second.push('b;c\r'), [['b', 'c']]);
+  assert.deepEqual(first.push('\r\nb"\n'), [['a\r\nb']]);
+  assert.deepEqual(second.push('\nd'), []);
+  assert.deepEqual(first.end(), []);
+  assert.deepEqual(second.end(), [['d']]);
+});
+
+test('parse header mode preserves unique names, padding, and special own keys', () => {
+  const [object] = parse('x,x,x_2,x,__proto__,constructor,toString,\n1,2,3,4,5,6,7', { header: true });
+  assert.deepEqual(Object.keys(object), ['x', 'x_2', 'x_2_2', 'x_3', '__proto__', 'constructor', 'toString', '']);
+  assert.equal(Object.getPrototypeOf(object), Object.prototype);
+  assert.equal(object.__proto__, '5');
+  assert.equal(object.constructor, '6');
+  assert.equal(object.toString, '7');
+  assert.equal(object[''], '');
+  assert.deepEqual(parse('', { header: true }), []);
+  assert.deepEqual(parse('name\n', { header: true }), []);
+  assert.deepEqual(parse('a\nb,extra', { header: true }), [{ a: 'b' }]);
+  assert.deepEqual(parse('a\nb', { header: false }), [['a'], ['b']]);
+});
+
+test('row helper still accepts frozen explicit headers and records without mutation', () => {
+  const records = Object.freeze([Object.freeze(['1']), Object.freeze(['2', 'extra'])]);
+  const header = Object.freeze(['__proto__', '__proto__']);
+  const options = Object.freeze({ header });
+  const objects = toObjects(records, options);
+  assert.deepEqual(Object.keys(objects[0]), ['__proto__', '__proto___2']);
+  assert.equal(objects[0].__proto__, '1');
+  assert.equal(objects[0].__proto___2, '');
+  assert.equal(objects[1].__proto___2, 'extra');
+  assert.deepEqual(records, [['1'], ['2', 'extra']]);
+  assert.deepEqual(header, ['__proto__', '__proto__']);
+  assert.deepEqual(toObjects(records, { header: [] }), [{}, {}]);
+});
