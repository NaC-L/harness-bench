+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createParser, parse } = require('./src/csv');
+const { toObjects } = require('./src/rows');
+
+test('CSV grammar is independent of every pair of chunk boundaries', () => {
+  const cases = [
+    ['', []],
+    ['\uFEFF', []],
+    ['\uFEFF\uFEFF', [['\uFEFF']]],
+    ['\n', [['']]],
+    ['\r\n\r\n\n\r', [[''], [''], [''], ['']]],
+    ['a,b\r\nc,d\re,f\n', [['a', 'b'], ['c', 'd'], ['e', 'f']]],
+    [',,', [['', '', '']]],
+    ['""', [['']]],
+    ['""""', [['"']]],
+    ['"a""b",c', [['a"b', 'c']]],
+    ['"a\r\nb\rc\nd",', [['a\r\nb\rc\nd', '']]],
+    ['a"b,c"d', [['a"b', 'c"d']]],
+    ['a\uFEFF,😀', [['a\uFEFF', '😀']]],
+  ];
+  for (const [text, expected] of cases) {
+    assert.deepEqual(parse(text), expected);
+    for (let first = 0; first <= text.length; first++) {
+      for (let second = first; second <= text.length; second++) {
+        const parser = createParser();
+        const records = [
+          ...parser.push(''),
+          ...parser.push(text.slice(0, first)),
+          ...parser.push(''),
+          ...parser.push(text.slice(first, second)),
+          ...parser.push(text.slice(second)),
+          ...parser.end(),
+        ];
+        assert.deepEqual(records, expected, `${JSON.stringify(text)} at ${first}, ${second}`);
+      }
+    }
+    const parser = createParser();
+    const records = [];
+    for (let index = 0; index < text.length; index++) records.push(...parser.push(text[index]));
+    records.push(...parser.end());
+    assert.deepEqual(records, expected);
+  }
+});
+
+test('records emit immediately, including CR before a split CRLF', () => {
+  const parser = createParser({ header: true });
+  assert.deepEqual(parser.push(''), []);
+  assert.deepEqual(parser.push('\uFEFF"a\r'), []);
+  assert.deepEqual(parser.push('\nb"\r'), [['a\r\nb']]);
+  assert.deepEqual(parser.push(''), []);
+  assert.deepEqual(parser.push('\n\nx,'), [['']]);
+  assert.deepEqual(parser.end(), [['x', '']]);
+  assert.deepEqual(parser.end(), []);
+  assert.throws(() => parser.push(''), Error);
+  assert.throws(() => parser.push('another row'), Error);
+});
+
+test('delimiter validation and single UTF-16 code unit delimiters', () => {
+  for (const delimiter of ['', 'ab', '😀', '"', '\r', '\n', null, 0, false, {}, []]) {
+    assert.throws(() => createParser({ delimiter }), RangeError);
+    assert.throws(() => parse('', { delimiter }), RangeError);
+  }
+  for (const delimiter of [';', '\t', '\0', '\uD800']) {
+    assert.deepEqual(parse(`left${delimiter}"a${delimiter}b"${delimiter}`, { delimiter }), [
+      ['left', `a${delimiter}b`, ''],
+    ]);
+  }
+  assert.deepEqual(parse('a,b', { delimiter: undefined }), [['a', 'b']]);
+  assert.deepEqual(parse('\uFEFFa\uFEFFb', { delimiter: '\uFEFF' }), [['a', 'b']]);
+});
+
+test('push validates strings without consuming input, and parsers are independent', () => {
+  const first = createParser();
+  const second = createParser();
+  for (const value of [undefined, null, 1, {}, [], Buffer.from('x'), new String('x')]) {
+    assert.throws(() => first.push(value), TypeError);
+    assert.throws(() => parse(value), TypeError);
+  }
+  assert.deepEqual(first.push('\uFEFF"a'), []);
+  assert.deepEqual(second.push('b\n'), [['b']]);
+  assert.deepEqual(first.push('"\n'), [['a']]);
+  assert.deepEqual(first.end(), []);
+  assert.deepEqual(second.end(), []);
+  assert.throws(() => first.push(null), Error);
+});
+
+test('invalid text after a closing quote reports physical lines across all splits', () => {
+  const cases = [
+    ['"a"x', 1],
+    ['"a" ', 1],
+    ['\r\n"a"\t', 2],
+    ['"a\r\nb"x', 2],
+    ['one\r\n"two\r\nthree\rfour\nfive" x', 5],
+  ];
+  for (const [text, line] of cases) {
+    for (let split = 0; split <= text.length; split++) {
+      const parser = createParser();
+      assert.throws(() => {
+        parser.push(text.slice(0, split));
+        parser.push('');
+        parser.push(text.slice(split));
+      }, error => error instanceof SyntaxError && error.message.includes(`line ${line}`));
+    }
+  }
+});
+
+test('unterminated quotes report the physical EOF line, including split CRLF', () => {
+  const cases = [
+    ['"', 1],
+    ['"a""', 1],
+    ['"a\r\n', 2],
+    ['"a\r', 2],
+    ['"a\n', 2],
+    ['one\r\n"two\r\nthree\rfour\nfive', 5],
+  ];
+  for (const [text, line] of cases) {
+    for (let split = 0; split <= text.length; split++) {
+      const parser = createParser();
+      parser.push(text.slice(0, split));
+      parser.push(text.slice(split));
+      assert.throws(() => parser.end(), error =>
+        error instanceof SyntaxError && error.message.includes(`line ${line}`));
+    }
+  }
+});
+
+test('header conversion preserves duplicate names, padding, and special own properties', () => {
+  const options = Object.freeze({ header: true });
+  const [object] = parse('x,x,x_2,x,__proto__,constructor,toString,\n1,2,3,4,5,6,7', options);
+  assert.equal(Object.getPrototypeOf(object), Object.prototype);
+  assert.deepEqual(Object.keys(object), ['x', 'x_2', 'x_2_2', 'x_3', '__proto__', 'constructor', 'toString', '']);
+  assert.deepEqual(Object.values(object), ['1', '2', '3', '4', '5', '6', '7', '']);
+  for (const key of Object.keys(object)) {
+    const descriptor = Object.getOwnPropertyDescriptor(object, key);
+    assert.equal(descriptor.enumerable, true);
+    assert.equal(descriptor.writable, true);
+    assert.equal(descriptor.configurable, true);
+  }
+  assert.deepEqual(parse('', options), []);
+  assert.deepEqual(parse('header', options), []);
+  assert.deepEqual(parse('x\na,extra', options), [{ x: 'a' }]);
+});
+
+test('rows helper preserves frozen records, explicit headers, and options', () => {
+  const records = Object.freeze([Object.freeze(['a']), Object.freeze(['b', 'c', 'extra'])]);
+  const header = Object.freeze(['x', 'x']);
+  const options = Object.freeze({ header });
+  assert.deepEqual(toObjects(records, options), [{ x: 'a', x_2: '' }, { x: 'b', x_2: 'c' }]);
+  assert.deepEqual(toObjects(records, { header: [] }), [{}, {}]);
+  assert.deepEqual(records, [['a'], ['b', 'c', 'extra']]);
+  assert.deepEqual(header, ['x', 'x']);
+});
