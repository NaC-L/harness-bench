+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createParser, parse } = require('./csv');
+const { toObjects } = require('./rows');
+
+function stream(chunks, options) {
+  const parser = createParser(options);
+  const records = [];
+  for (const chunk of chunks) records.push(...parser.push(chunk));
+  records.push(...parser.end());
+  return records;
+}
+
+test('grammar is independent of all two-boundary chunk splits', () => {
+  const cases = [
+    ['', []],
+    ['\uFEFF', []],
+    ['\n\n', [[''], ['']]],
+    ['a\r\nb\rc\n', [['a'], ['b'], ['c']]],
+    [',,', [['', '', '']]],
+    ['""', [['']]],
+    ['"a,b","say ""hi"""\r\n', [['a,b', 'say "hi"']]],
+    ['"a\r\nb\rc\nd",tail', [['a\r\nb\rc\nd', 'tail']]],
+    ['a"b,c"d', [['a"b', 'c"d']]],
+    ['\uFEFFx,\uFEFFy\n\uFEFF', [['x', '\uFEFFy'], ['\uFEFF']]],
+    ['\uFEFF\uFEFF', [['\uFEFF']]],
+    ['😀,"😀"', [['😀', '😀']]],
+  ];
+  for (const [text, expected] of cases) {
+    assert.deepEqual(parse(text), expected);
+    for (let first = 0; first <= text.length; first++) {
+      for (let second = first; second <= text.length; second++) {
+        assert.deepEqual(stream([
+          '', text.slice(0, first), '', text.slice(first, second),
+          '', text.slice(second), '',
+        ]), expected, `splits ${first}, ${second} for ${JSON.stringify(text)}`);
+      }
+    }
+    assert.deepEqual(stream(text.split('')), expected);
+  }
+});
+
+test('records emit immediately, including CR before the LF arrives', () => {
+  const parser = createParser();
+  assert.deepEqual(parser.push('a\r'), [['a']]);
+  assert.deepEqual(parser.push(''), []);
+  assert.deepEqual(parser.push('\n'), []);
+  assert.deepEqual(parser.push('\rb\nc\r\nunfinished,'), [[''], ['b'], ['c']]);
+  assert.deepEqual(parser.end(), [['unfinished', '']]);
+  assert.deepEqual(parser.end(), []);
+  assert.throws(() => parser.push(''), Error);
+});
+
+test('escaped quotes and closing quotes can straddle chunks', () => {
+  const parser = createParser();
+  assert.deepEqual(parser.push('"a"'), []);
+  assert.deepEqual(parser.push(''), []);
+  assert.deepEqual(parser.push('"b"'), []);
+  assert.deepEqual(parser.push(',c\n'), [['a"b', 'c']]);
+  assert.deepEqual(parser.end(), []);
+  assert.deepEqual(stream(['"', '"']), [['']]);
+});
+
+test('delimiter validation rejects coercion and accepts single code units', () => {
+  for (const delimiter of ['', 'ab', '😀', '"', '\r', '\n', null, 1, {}, []]) {
+    assert.throws(() => createParser({ delimiter }), RangeError);
+  }
+  assert.deepEqual(parse('a,b', { delimiter: undefined }), [['a', 'b']]);
+  for (const delimiter of [';', '\t', ' ', '\uD83D', '\uFEFF']) {
+    assert.deepEqual(stream(['a', delimiter, '"b', delimiter, 'c"'], { delimiter }),
+      [['a', `b${delimiter}c`]]);
+  }
+});
+
+test('invalid chunks do not consume input or the initial BOM', () => {
+  const parser = createParser();
+  for (const chunk of [undefined, null, 1, {}, [], Buffer.from('a')]) {
+    assert.throws(() => parser.push(chunk), TypeError);
+  }
+  assert.deepEqual(parser.push(''), []);
+  assert.deepEqual(parser.push('\uFEFFa\n'), [['a']]);
+  assert.deepEqual(parser.end(), []);
+});
+
+test('syntax errors report physical lines for every chunk split', () => {
+  const cases = [
+    ['"x" ', 1],
+    ['a\r\n"x"z', 2],
+    ['"a\r\nb\nc\rd"x', 4],
+    ['"a\r\nb\nc\rd', 4],
+    ['"a\r\n', 2],
+    ['"a\r', 2],
+    ['"a\n', 2],
+    ['"', 1],
+  ];
+  for (const [text, line] of cases) {
+    for (let split = 0; split <= text.length; split++) {
+      assert.throws(() => stream([text.slice(0, split), '', text.slice(split)]),
+        error => error instanceof SyntaxError &&
+          new RegExp(`\\bline ${line}\\b`).test(error.message));
+    }
+  }
+  const parser = createParser();
+  parser.push('"closed"');
+  assert.throws(() => parser.push(' '), SyntaxError);
+});
+
+test('parsers have independent state and streaming ignores header mode', () => {
+  const first = createParser({ header: true });
+  const second = createParser({ delimiter: ';' });
+  assert.deepEqual(first.push('"a'), []);
+  assert.deepEqual(second.push('x;y\r'), [['x', 'y']]);
+  assert.deepEqual(first.push('"\n'), [['a']]);
+  assert.deepEqual(second.push('\nz'), []);
+  assert.deepEqual(first.end(), []);
+  assert.deepEqual(second.end(), [['z']]);
+});
+
+test('header conversion retains duplicate, padding, and special-key behavior', () => {
+  const objects = parse('x,x,x_2,x,__proto__,constructor,toString\n1,2,3,4,5,6,7,extra\nshort',
+    { header: true });
+  assert.deepEqual(Object.keys(objects[0]),
+    ['x', 'x_2', 'x_2_2', 'x_3', '__proto__', 'constructor', 'toString']);
+  assert.deepEqual(Object.values(objects[0]), ['1', '2', '3', '4', '5', '6', '7']);
+  assert.deepEqual(Object.values(objects[1]), ['short', '', '', '', '', '', '']);
+  for (const object of objects) {
+    assert.equal(Object.getPrototypeOf(object), Object.prototype);
+    for (const key of Object.keys(object)) {
+      const descriptor = Object.getOwnPropertyDescriptor(object, key);
+      assert.equal(descriptor.enumerable, true);
+      assert.equal(descriptor.writable, true);
+      assert.equal(descriptor.configurable, true);
+    }
+  }
+  assert.deepEqual(parse('', { header: true }), []);
+  assert.deepEqual(parse('header', { header: true }), []);
+});
+
+test('rows helper remains non-mutating with explicit and empty headers', () => {
+  const records = Object.freeze([Object.freeze(['one']), Object.freeze(['two', 'extra'])]);
+  const header = Object.freeze(['__proto__', '__proto__']);
+  const options = Object.freeze({ header });
+  const objects = toObjects(records, options);
+  assert.deepEqual(Object.keys(objects[0]), ['__proto__', '__proto___2']);
+  assert.deepEqual(Object.values(objects[0]), ['one', '']);
+  assert.deepEqual(Object.values(objects[1]), ['two', 'extra']);
+  assert.deepEqual(toObjects(records, { header: Object.freeze([]) }), [{}, {}]);
+  assert.deepEqual(records, [['one'], ['two', 'extra']]);
+  assert.deepEqual(header, ['__proto__', '__proto__']);
+});
