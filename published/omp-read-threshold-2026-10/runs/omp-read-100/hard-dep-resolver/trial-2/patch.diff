+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+
+test('orders all version components numerically', () => {
+  const registry = {
+    major: { '9.0.0': {}, '10.0.0': {} },
+    minor: { '1.9.0': {}, '1.10.0': {} },
+    patch: { '1.0.9': {}, '1.0.10': {} },
+  };
+  assert.deepEqual(resolve(registry, { major: '*', minor: '*', patch: '*' }), {
+    major: '10.0.0', minor: '1.10.0', patch: '1.0.10',
+  });
+});
+
+test('collects dependency constraints immediately and processes names in FIFO order', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*', b: '<3.0.0' } },
+    b: { '3.0.0': {}, '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '2.0.0', c: '1.0.0',
+  });
+});
+
+test('backtracks the latest choice rather than maximizing later packages', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+});
+
+test('undoes constraints across multiple exhausted choice frames', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0' });
+});
+
+test('removes dependencies reachable only through rejected versions', () => {
+  const registry = {
+    a: { '2.0.0': { old: '*', missing: '*' }, '1.0.0': { replacement: '*' } },
+    old: { '1.0.0': {} },
+    replacement: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', replacement: '1.0.0' });
+});
+
+test('undoes partially discovered dependencies after an immediate conflict', () => {
+  const registry = {
+    guard: { '1.0.0': {} },
+    a: { '2.0.0': { leak: '*', guard: '2.0.0', tail: '*' }, '1.0.0': {} },
+    leak: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { guard: '1.0.0', a: '*' }), {
+    guard: '1.0.0', a: '1.0.0',
+  });
+});
+
+test('terminates on self cycles and mutual cycles without re-expansion', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = { a: { '1.0.0': { b: '*' } }, b: { '1.0.0': { a: '*' } } };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '>1.0.0' } } }, { a: '*' }), null);
+});
+
+test('handles long chains and their cycle without a call-stack or iteration limit', () => {
+  const registry = {};
+  const expected = {};
+  const count = 20000;
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % count}`]: '*' } };
+    expected[`p${i}`] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, { p0: '*' }), expected);
+});
+
+test('rejects discovered conflicts before expanding a Cartesian product', () => {
+  const registry = { gate: { '1.0.0': {}, '2.0.0': {} } };
+  const root = {};
+  const expected = {};
+  for (let i = 0; i < 32; i += 1) {
+    registry[`p${i}`] = { '2.0.0': { gate: '2.0.0' }, '1.0.0': {} };
+    root[`p${i}`] = '*';
+    expected[`p${i}`] = '1.0.0';
+  }
+  root.gate = '1.0.0';
+  expected.gate = '1.0.0';
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('returns null for missing packages, empty catalogs and incompatible constraints', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '>1.0.0 <2.0.0' }), null);
+  assert.deepEqual(resolve({ a: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('validates every map, version and range even when unreachable', () => {
+  for (const invalid of [null, [], new Date(), Object.create({})]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { missing: '^1.2' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+});
+
+test('accepts null-prototype maps and treats special names as own result properties', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  const expected = {};
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    const versions = Object.create(null);
+    versions['1.0.0'] = Object.create(null);
+    registry[name] = versions;
+    root[name] = '*';
+    Object.defineProperty(expected, name, { value: '1.0.0', enumerable: true });
+  }
+  const result = resolve(registry, root);
+  assert.deepEqual(result, expected);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test('ignores non-enumerable and symbol keys and does not mutate inputs', () => {
+  const deps = Object.freeze({});
+  const versions = Object.freeze({ '1.0.0': deps });
+  const registry = { a: versions };
+  const root = { a: '*' };
+  for (const record of [registry, root]) {
+    Object.defineProperty(record, 'ignored', { value: null });
+    record[Symbol('ignored')] = null;
+    Object.freeze(record);
+  }
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0' });
+  assert.equal(registry.a, versions);
+  assert.equal(versions['1.0.0'], deps);
+  assert.equal(root.a, '*');
+});
