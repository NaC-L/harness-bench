+++ "{temp}\\hb-a54f77c3-wh_1tvng/src/semver.test.js"
@@ -0,0 +1,69 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parse, compare, satisfies, compileRange } = require('./semver');
+
+test('parses canonical safe integers and compares numerically', () => {
+  assert.deepEqual(parse('0.10.9007199254740991'), [0, 10, Number.MAX_SAFE_INTEGER]);
+  assert.equal(compare('1.10.0', '1.9.0'), 1);
+  assert.equal(compare('9.0.0', '10.0.0'), -1);
+  assert.equal(compare('1.0.9', '1.0.10'), -1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+});
+
+test('rejects noncanonical versions including trailing line terminators', () => {
+  const invalid = [null, 1, '', '1.2', '1.2.3.4', '01.2.3', '1.02.3', '1.2.03',
+    '-1.2.3', '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3 ', '1.2.3\n',
+    '1.2.3\r', '1.2.3\u2028', '1.2.3\u2029', '9007199254740992.0.0'];
+  for (const version of invalid) {
+    assert.throws(() => parse(version), TypeError, String(version));
+    assert.throws(() => compare(version, '1.0.0'), TypeError, String(version));
+    assert.throws(() => satisfies(version, '*'), TypeError, String(version));
+  }
+});
+
+test('range predicates implement exact, wildcard, comparisons and AND terms', () => {
+  const cases = [
+    ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false],
+    ['0.0.0', '*', true], ['1.2.3', '>=1.2.3', true], ['1.2.2', '>=1.2.3', false],
+    ['1.2.3', '>1.2.3', false], ['1.2.4', '>1.2.3', true],
+    ['1.2.3', '<=1.2.3', true], ['1.2.4', '<=1.2.3', false],
+    ['1.2.3', '<1.2.3', false], ['1.2.2', '<1.2.3', true],
+    ['1.5.0', ' \t* >=1.0.0\n<2.0.0 ', true],
+    ['2.0.0', '>=1.0.0 <2.0.0', false], ['1.0.0', '>2.0.0 <1.0.0', false],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected, `${version} ${range}`);
+  }
+});
+
+test('caret and tilde ranges use the specified zero-major and exclusive upper bounds', () => {
+  const cases = [
+    ['^1.2.3', '1.2.2', false], ['^1.2.3', '1.2.3', true],
+    ['^1.2.3', '1.99.99', true], ['^1.2.3', '2.0.0', false],
+    ['^0.2.3', '0.2.2', false], ['^0.2.3', '0.2.3', true],
+    ['^0.2.3', '0.2.99', true], ['^0.2.3', '0.3.0', false],
+    ['^0.0.3', '0.0.2', false], ['^0.0.3', '0.0.3', true],
+    ['^0.0.3', '0.0.4', false], ['^0.0.0', '0.0.0', true], ['^0.0.0', '0.0.1', false],
+    ['~0.0.3', '0.0.2', false], ['~0.0.3', '0.0.99', true], ['~0.0.3', '0.1.0', false],
+    ['~1.2.3', '1.2.3', true], ['~1.2.3', '1.2.99', true], ['~1.2.3', '1.3.0', false],
+    ['^9007199254740991.0.0', '9007199254740991.1.0', true],
+    ['^0.9007199254740991.0', '0.9007199254740991.1', true],
+    ['^0.0.9007199254740991', '0.0.9007199254740991', true],
+    ['^0.0.9007199254740991', '0.1.0', false],
+    ['~1.9007199254740991.0', '2.0.0', false],
+  ];
+  for (const [range, version, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+  }
+});
+
+test('validates every range term eagerly', () => {
+  for (const range of [null, 1, '', ' \n ', '^1.2', '1.x', '||', '>= 1.2.3',
+    '=1.2.3', '=>1.2.3', '^^1.2.3', '1.2.3-beta', '* ^01.2.3', '<0.0.0 invalid']) {
+    assert.throws(() => compileRange(range), TypeError, String(range));
+    assert.throws(() => satisfies('1.0.0', range), TypeError, String(range));
+  }
+});
