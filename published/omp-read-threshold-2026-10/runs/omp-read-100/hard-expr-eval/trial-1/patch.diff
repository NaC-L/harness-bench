+++ "{temp}\\hb-4de8ca26-y8kouwlm/evaluator-contract.test.js"
@@ -0,0 +1,113 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error =>
+    error instanceof ExprError && error.column === column);
+}
+
+test('power binds above a left unary sign and associates right', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625], ['2 * -3 ** 2', -18],
+    ['--2 ** 2', 4], ['+2 ** +3', 8],
+    ['8 / 2 * 3', 12], ['10 - 3 - 2', 5],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo retain the signed integer identity', () => {
+  for (const left of [-7, -6, -1, -0, 0, 1, 6, 7]) {
+    for (const right of [-3, -2, 2, 3]) {
+      const quotient = evaluate('a // b', { a: left, b: right });
+      const remainder = evaluate('a % b', { a: left, b: right });
+      assert.equal(quotient, Math.floor(left / right) || 0);
+      assert.equal(quotient * right + remainder, left || 0);
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(right));
+      else assert.equal(Object.is(remainder, -0), false);
+      if (quotient === 0) assert.equal(Object.is(quotient, -0), false);
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+});
+
+test('comparisons chain, preserve shared values, and short-circuit', () => {
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return 1; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 2; },
+  };
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('a > b < c', variables), false);
+  assert.deepEqual(reads, ['a', 'b']);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+  assert.equal(evaluate('3 > 2 > 1'), true);
+  assert.equal(evaluate('1 < 2 == 2 != 3 >= 3 > 0'), true);
+  assert.equal(evaluate('(3 > 2) > 1'), false);
+  assert.equal(evaluate('(1 < 2) + (2 < 1)'), 1);
+  assert.equal(evaluate('(1 < 2) == 1'), true);
+  assert.equal(evaluate('(1 > 2) == 0'), true);
+  assert.equal(evaluate('1 + 2 < 2 * 2'), true);
+});
+
+test('calls and variable occurrences evaluate left to right without mutation', () => {
+  const reads = [];
+  const variables = Object.freeze({
+    get a() { reads.push('a'); return -3; },
+    get b() { reads.push('b'); return 4; },
+    get c() { reads.push('c'); return 2; },
+  });
+  assert.equal(evaluate('max(abs(a), min(b, c), a)', variables), 3);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'a']);
+  reads.length = 0;
+  assert.equal(evaluate('a - b * c', variables), -11);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  assert.equal(evaluate('min(4)'), 4);
+  assert.equal(evaluate('abs(1 > 2)'), 0);
+  assert.equal(evaluate('min + max + abs', { min: 1, max: 2, abs: 3 }), 6);
+  errorAt('  inherited', 3, Object.create({ inherited: 4 }));
+  errorAt('toString', 1, {});
+});
+
+test('the entire source and call arities are validated before evaluation', () => {
+  const variables = { get a() { assert.fail('Syntax errors must precede evaluation'); } };
+  for (const [source, column] of [
+    ['a + mystery(1)', 5], ['a + min()', 5], ['a + max()', 5],
+    ['a + abs()', 5], ['a + abs(1, 2)', 5],
+    ['0 > 1 < abs(1, 2)', 9], ['a + min(1, )', 12],
+    ['a + 2 3', 7], ['a + 2(3)', 6], ['a + 1 = 2', 7],
+    ['a + "text"', 5], ['a + 1 $', 7], ['a + (1', 7],
+  ]) errorAt(source, column, variables);
+});
+
+test('error columns point to tokens after whitespace and UTF-16 end offsets', () => {
+  for (const [source, column] of [
+    ['   missing', 4], ['1 +   missing', 7], ['  min()', 3],
+    ['1  +  * 2', 7], ['\t1 +\r\n  $', 9], [' 1 +  💰', 7],
+    ['1 + \t ', 7], ['   ', 4], ['', 1], ['(1 + 2)   )', 11],
+    ['min(1, )', 8], ['. ', 1], ['1e+', 2],
+    ['4   / 0', 5], ['4   // -0', 5], ['4   % (1 > 2)', 5],
+  ]) errorAt(source, column);
+});
+
+test('numeric literals, identifiers, and whitespace follow the grammar', () => {
+  assert.equal(evaluate(' 1.5e-3 + .5 + 5. + 2E+2 '), 205.5015);
+  assert.equal(evaluate('_a1 + Z9', { _a1: 2, Z9: 3 }), 5);
+  assert.equal(evaluate('\n\t(1 + 2)\r\n * 3 '), 9);
+});
+
+test('flat arithmetic and comparison chains do not exhaust the stack', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array(count).fill('2').join('>=')), true);
+});
