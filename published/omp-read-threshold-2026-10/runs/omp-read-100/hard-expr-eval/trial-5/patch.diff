@@ -0,0 +1,136 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column);
+    return true;
+  });
+}
+
+test('arithmetic follows the documented precedence and associativity', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['2 ** -2 ** 2', 1 / 16],
+    ['--2 ** 2', 4], ['-2 ** 2 * 3 + 5', -7],
+    ['10 - 3 - 2', 5], ['24 / 4 / 2', 3],
+    ['20 // 3 * 2 % 5', 2], ['1.5e-3 + .5 + 5.', 5.5015],
+    ['1E+2 + 2e-1', 100.2],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo obey divisor signs and normalize zero', () => {
+  for (const a of [-17, -7, -1, 0, 1, 7, 17]) {
+    for (const b of [-5, -3, -1, 1, 3, 5]) {
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      assert.equal(Object.is(remainder, -0), false);
+      assert.equal(Object.is(quotient, -0), false);
+    }
+  }
+  for (const [source, expected] of [
+    ['-7.5 // 2', -4], ['-7.5 % 2', 0.5],
+    ['7.5 // -2', -4], ['7.5 % -2', -0.5],
+    ['1 // 0.1', 9], ['1 % 0.1', 0.09999999999999995],
+  ]) assert.equal(evaluate(source), expected, source);
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`1   ${operator} -0`, 5);
+  }
+});
+
+test('comparisons chain, share operands, and short-circuit', () => {
+  const reads = [];
+  const variables = Object.create(null);
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < a / 0', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+  assert.equal(evaluate('1 < 2 == 2 != 3 >= 3 > 2'), true);
+  assert.equal(evaluate('(1 < 2) + (3 < 2) * 10', variables), 1);
+  assert.equal(evaluate('(1 < 2) == 1'), true);
+  assert.equal(evaluate('(1 < 2) == (3 < 4)'), true);
+  assert.equal(evaluate('(3 < 2) < 2'), true);
+  errorAt('3 < 2 < (1 + )', 14, variables);
+});
+
+test('variables read own properties once per occurrence in evaluation order', () => {
+  let next = 0;
+  const variables = { get x() { return ++next; } };
+  assert.equal(evaluate('x + x * x', variables), 7);
+  assert.equal(next, 3);
+  assert.equal(evaluate('_value2', { _value2: 4 }), 4);
+  assert.equal(evaluate('constructor', { constructor: 9 }), 9);
+  errorAt('  inherited', 3, Object.create({ inherited: 1 }));
+  errorAt('toString', 1, {});
+  const frozen = Object.freeze({ x: 3 });
+  assert.equal(evaluate('x * x', frozen), 9);
+});
+
+test('built-ins evaluate all arguments left to right and preserve numeric ties', () => {
+  let next = 0;
+  const variables = { get x() { return ++next; } };
+  assert.equal(evaluate('max(x, min(x, x), abs(-x))', variables), 4);
+  assert.equal(next, 4);
+  assert.equal(evaluate('min(3, -1, 2)'), -1);
+  assert.equal(evaluate('max(3)'), 3);
+  assert.equal(evaluate('abs(-0)'), 0);
+  assert.equal(evaluate('min(zero, negativeZero)', { zero: 0, negativeZero: -0 }), 0);
+  assert.equal(evaluate('max(negativeZero, zero)', { zero: 0, negativeZero: -0 }), -0);
+  assert.equal(evaluate('min(1, nan)', { nan: NaN }), 1);
+  assert.equal(evaluate('max(1, nan)', { nan: NaN }), 1);
+  assert.ok(Number.isNaN(evaluate('min(nan, 1)', { nan: NaN })));
+});
+
+test('syntax and call validation finish before evaluating any variable', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['x + mystery(1)', 5], ['x + min()', 5], ['x + max()', 5],
+    ['x + abs()', 5], ['x + abs(1, 2)', 5], ['x + abs(1,)', 11],
+    ['x + mystery(+)', 5], ['x + (2', 7], ['x 2', 3],
+    ['x + 2 @', 7], ['3 < 2 < mystery(1)', 9],
+    ['3 < 2 < abs(1, 2)', 9],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('error columns use token offsets after whitespace and UTF-16 EOF offsets', () => {
+  for (const [source, column] of [
+    ['   missing', 4], ['1 +   missing', 7], ['1   / 0', 5],
+    ['1   // 0', 5], ['1   % 0', 5], ['  @', 3],
+    ['1 +\t\n  @', 8], ['1 +   )', 7], ['1   2', 5],
+    ['', 1], ['   ', 4], ['1 +   ', 7], ['(1  ', 5],
+    ['  mystery(1)', 3], ['  abs(1, 2)', 3], ['1 +  💰', 6],
+    ['1 +\u2003 ', 6], ['2(3)', 2], ['1 = 2', 3], ['.e2', 1],
+    ['1e+', 2], ['min(1 2)', 7],
+  ]) errorAt(source, column);
+});
+
+test('long flat arithmetic, comparisons, and calls avoid operand recursion', () => {
+  const count = 120001;
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  assert.equal(evaluate('x+'.repeat(count - 1) + 'x', variables), count);
+  assert.equal(reads, count);
+  assert.equal(evaluate('1*'.repeat(count - 1) + '1'), 1);
+  reads = 0;
+  assert.equal(evaluate('x<='.repeat(count - 1) + 'x', variables), true);
+  assert.equal(reads, count);
+  assert.equal(evaluate('min(' + '2,'.repeat(count - 1) + '1)'), 1);
+});
