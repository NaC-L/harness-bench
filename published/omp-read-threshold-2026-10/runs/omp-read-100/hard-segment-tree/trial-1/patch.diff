@@ -0,0 +1,147 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both the parent and its children', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 9);
+  tree.add(3, 7, -4);
+  tree.add(0, 7, 6);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  assert.equal(tree.sum(1, 6), -10);
+  assert.equal(tree.sum(0, 7), -14);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-2));
+  tree.assign(2, 5, 8);
+  tree.add(3, 7, 1);
+  assert.deepEqual(tree.toArray(), [-2, -2, 8, 9, 9, -1, -1]);
+});
+
+test('partial maxima remain negative and empty ranges have their identities', () => {
+  const tree = new RangeTree([-8, -3, -6, -4, -9]);
+  assert.equal(tree.max(1, 4), -3);
+  assert.equal(tree.max(4, 5), -9);
+  tree.assign(0, 5, -10);
+  tree.add(2, 4, 3);
+  assert.equal(tree.max(1, 5), -7);
+  assert.equal(tree.max(0, 2), -10);
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+    assert.equal(tree.assign(i, i, 20), undefined);
+    assert.equal(tree.add(i, i, 20), undefined);
+  }
+  assert.deepEqual(tree.toArray(), [-10, -10, -7, -7, -10]);
+});
+
+test('threshold search sees lazy assignments and additions before materialization', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0, 0, 0]);
+  tree.assign(0, 7, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(4, 10), 4);
+  tree.add(0, 7, 5);
+  assert.equal(tree.firstAtLeast(2, 15), 2);
+  tree.assign(0, 3, -10);
+  tree.add(3, 7, -20);
+  assert.equal(tree.firstAtLeast(0, -5), 3);
+  assert.equal(tree.firstAtLeast(4, -5), 4);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), 5);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+});
+
+test('mixed updates and queries agree with an array model', () => {
+  let seed = 0x12345678;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const size of [1, 2, 3, 7, 16, 31]) {
+    const values = Array.from({ length: size }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    const checkRange = (l, r) => {
+      let sum = 0;
+      let max = -Infinity;
+      for (let i = l; i < r; i++) {
+        sum += values[i];
+        max = Math.max(max, values[i]);
+      }
+      assert.equal(tree.sum(l, r), sum);
+      assert.equal(tree.max(l, r), max);
+    };
+    for (let step = 0; step < 300; step++) {
+      let l = random(size + 1);
+      let r = random(size + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 5 === 0) [l, r] = [0, size];
+      const value = random(41) - 20;
+      const assigning = random(2) === 0;
+      assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+
+      // Search first so other queries cannot mask missing lazy propagation.
+      const lo = random(size + 1);
+      const threshold = random(81) - 40;
+      let expected = -1;
+      for (let i = lo; i < size; i++) {
+        if (values[i] >= threshold) {
+          expected = i;
+          break;
+        }
+      }
+      assert.equal(tree.firstAtLeast(lo, threshold), expected);
+      checkRange(0, size);
+      l = random(size + 1);
+      r = random(size + 1);
+      if (l > r) [l, r] = [r, l];
+      checkRange(l, r);
+      const index = random(size);
+      assert.equal(tree.get(index), values[index]);
+      if (step % 11 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    for (let l = 0; l <= size; l++) {
+      for (let r = l; r <= size; r++) checkRange(l, r);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation is atomic and arrays and length preserve their contracts', () => {
+  for (const values of [null, {}, [], [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -4, 6];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.add(0, 3, 1);
+  for (const [l, r] of [[-1, 2], [2, 1], [0, 4], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 7), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '2', undefined, null]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 1.5, NaN, '1', Infinity]) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 1.5, NaN, '1', Infinity]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '1', undefined, null]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+    assert.throws(() => tree.firstAtLeast(3, threshold), RangeError);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  const output = tree.toArray();
+  assert.deepEqual(output, [3, -3, 7]);
+  output[0] = 100;
+  assert.deepEqual(tree.toArray(), [3, -3, 7]);
+});
