@@ -0,0 +1,119 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards pending additions at every overwritten node', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 7, 9);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  assert.equal(tree.sum(1, 6), -10);
+  tree.add(0, 3, 8);
+  tree.assign(0, 7, -5);
+  tree.add(2, 5, 1);
+  assert.deepEqual(tree.toArray(), [-5, -5, -4, -4, -4, -5, -5]);
+  assert.equal(tree.sum(0, 7), -32);
+});
+
+test('partial maxima preserve negative values and empty-range identity', () => {
+  const tree = new RangeTree([-8, -7, -6, -5, -4]);
+  assert.equal(tree.max(1, 4), -5);
+  tree.assign(0, 5, -10);
+  tree.add(2, 4, 3);
+  assert.equal(tree.max(1, 4), -7);
+  assert.equal(tree.max(0, 1), -10);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search observes pending assignment and addition before descending', () => {
+  const tree = new RangeTree([9, 8, 7, 6, 5, 4, 3]);
+  tree.assign(0, 7, 0);
+  assert.equal(tree.firstAtLeast(0, 5), -1);
+  tree.add(0, 7, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(3, 10), 3);
+  tree.assign(0, 3, -4);
+  tree.add(3, 7, 2);
+  assert.equal(tree.firstAtLeast(0, 11), 3);
+  assert.equal(tree.firstAtLeast(4, 12), 4);
+  assert.equal(tree.firstAtLeast(0, 13), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+});
+
+test('mixed updates and queries agree with an array oracle', () => {
+  let state = 0x12345678;
+  const random = bound => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % bound;
+  };
+  for (const length of [1, 2, 3, 7, 16, 31]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 300; step++) {
+      const a = random(length + 1);
+      const b = random(length + 1);
+      const l = Math.min(a, b);
+      const r = Math.max(a, b);
+      const value = random(41) - 20;
+      const operation = random(6);
+      if (operation < 2) {
+        const method = operation === 0 ? 'assign' : 'add';
+        assert.equal(tree[method](l, r, value), undefined);
+        for (let i = l; i < r; i++) {
+          values[i] = operation === 0 ? value : values[i] + value;
+        }
+      } else if (operation === 2) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((sum, v) => sum + v, 0));
+      } else if (operation === 3) {
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+      } else if (operation === 4) {
+        assert.equal(tree.firstAtLeast(l, value), values.findIndex((v, i) => i >= l && v >= value));
+      } else {
+        const index = random(length);
+        assert.equal(tree.get(index), values[index]);
+      }
+    }
+    assert.deepEqual(tree.toArray(), values);
+    assert.equal(tree.sum(0, length), values.reduce((sum, v) => sum + v, 0));
+    assert.equal(tree.max(0, length), Math.max(...values));
+  }
+});
+
+test('validation and empty operations preserve pending updates and array ownership', () => {
+  for (const values of [[], [NaN], [Infinity], [1, undefined], 'values', null]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  tree.assign(0, 3, -2);
+  tree.add(0, 3, 5);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN]]) {
+      assert.throws(() => tree[method](l, r, 1), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined]) {
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    assert.equal(tree[method](1, 1, 9), undefined);
+  }
+  for (const i of [-1, 3, 0.5, NaN]) assert.throws(() => tree.get(i), RangeError);
+  for (const [lo, x] of [[-1, 0], [4, 0], [0.5, 0], [NaN, 0], [0, NaN], [0, '1']]) {
+    assert.throws(() => tree.firstAtLeast(lo, x), RangeError);
+  }
+  assert.throws(() => { tree.length = 100; }, TypeError);
+  assert.equal(tree.length, 3);
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(3, 3), -Infinity);
+  assert.equal(tree.firstAtLeast(0, 3), 0);
+  const output = tree.toArray();
+  assert.deepEqual(output, [3, 3, 3]);
+  output[0] = 100;
+  assert.equal(tree.get(0), 3);
+});
