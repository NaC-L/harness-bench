@@ -0,0 +1,252 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./src/cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+for (const oldFirst of [true, false]) {
+  test(`invalidation isolates flights when ${oldFirst ? 'old' : 'new'} settles first`, async () => {
+    const old = deferred();
+    const fresh = deferred();
+    let calls = 0;
+    const cache = createCache({ now: () => 0, load: () => ++calls === 1 ? old.promise : fresh.promise });
+    const oldReader = cache.get('key');
+    const oldWaiter = cache.get('key');
+    cache.invalidate('key');
+    const freshReader = cache.get('key');
+    if (oldFirst) {
+      old.resolve('old');
+      assert.deepEqual(await Promise.all([oldReader, oldWaiter]), ['old', 'old']);
+      assert.equal(cache.size, 0);
+      const freshWaiter = cache.get('key');
+      fresh.resolve('fresh');
+      assert.deepEqual(await Promise.all([freshReader, freshWaiter]), ['fresh', 'fresh']);
+    } else {
+      fresh.resolve('fresh');
+      assert.equal(await freshReader, 'fresh');
+      old.resolve('old');
+      assert.deepEqual(await Promise.all([oldReader, oldWaiter]), ['old', 'old']);
+    }
+    assert.equal(await cache.get('key'), 'fresh');
+    assert.equal(calls, 2);
+    assert.equal(cache.size, 1);
+  });
+}
+
+test('repeated invalidations are independent barriers without stored values', async () => {
+  const gates = [deferred(), deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+  const first = cache.get('key');
+  cache.invalidate('key');
+  const second = cache.get('key');
+  cache.invalidate('key');
+  const third = cache.get('key');
+  gates[1].resolve('second');
+  assert.equal(await second, 'second');
+  gates[0].resolve('first');
+  assert.equal(await first, 'first');
+  assert.equal(cache.size, 0);
+  const waiter = cache.get('key');
+  gates[2].resolve('third');
+  assert.deepEqual(await Promise.all([third, waiter]), ['third', 'third']);
+  assert.equal(await cache.get('key'), 'third');
+  assert.equal(calls, 3);
+});
+
+test('clear removes stored values and detaches every active key', async () => {
+  const oldA = deferred();
+  const oldB = deferred();
+  const newA = deferred();
+  const newB = deferred();
+  const queues = new Map([['a', [oldA, newA]], ['b', [oldB, newB]]]);
+  const cache = createCache({ now: () => 0, load: key => queues.get(key).shift().promise });
+  cache.set('stored', 'value');
+  const firstA = cache.get('a');
+  const firstB = cache.get('b');
+  await Promise.resolve();
+  assert.equal(cache.clear(), undefined);
+  assert.equal(cache.size, 0);
+  const secondA = cache.get('a');
+  const secondB = cache.get('b');
+  oldA.resolve('old-a');
+  oldB.resolve('old-b');
+  assert.deepEqual(await Promise.all([firstA, firstB]), ['old-a', 'old-b']);
+  assert.equal(cache.size, 0);
+  const waiterA = cache.get('a');
+  const waiterB = cache.get('b');
+  newA.resolve('new-a');
+  newB.resolve('new-b');
+  assert.deepEqual(await Promise.all([secondA, secondB, waiterA, waiterB]),
+    ['new-a', 'new-b', 'new-a', 'new-b']);
+  assert.equal(cache.size, 2);
+});
+
+for (const synchronous of [true, false]) {
+  test(`${synchronous ? 'synchronous throws' : 'asynchronous rejections'} release a flight for retry`, async () => {
+    const reason = synchronous ? undefined : { failure: 'load' };
+    const gate = deferred();
+    let calls = 0;
+    const cache = createCache({ now: () => 0, load() {
+      if (++calls !== 1) return null;
+      if (synchronous) throw reason;
+      return gate.promise;
+    } });
+    const first = cache.get('key');
+    const waiter = cache.get('key');
+    const failures = Promise.all([
+      assert.rejects(first, error => error === reason),
+      assert.rejects(waiter, error => error === reason)
+    ]);
+    if (!synchronous) gate.reject(reason);
+    await failures;
+    assert.equal(cache.size, 0);
+    assert.equal(await cache.get('key'), null);
+    assert.equal(await cache.get('key'), null);
+    assert.equal(calls, 2);
+  });
+}
+
+test('obsolete rejection cannot detach a newer flight', async () => {
+  const old = deferred();
+  const fresh = deferred();
+  const reason = new Error('old failure');
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => ++calls === 1 ? old.promise : fresh.promise });
+  const oldReader = cache.get('key');
+  const oldWaiter = cache.get('key');
+  cache.invalidate('key');
+  const freshReader = cache.get('key');
+  const failures = Promise.all([
+    assert.rejects(oldReader, error => error === reason),
+    assert.rejects(oldWaiter, error => error === reason)
+  ]);
+  old.reject(reason);
+  await failures;
+  const freshWaiter = cache.get('key');
+  fresh.resolve('fresh');
+  assert.deepEqual(await Promise.all([freshReader, freshWaiter]), ['fresh', 'fresh']);
+  assert.equal(await cache.get('key'), 'fresh');
+  assert.equal(calls, 2);
+});
+
+test('set wins over detached success without restarting its TTL', async () => {
+  let time = 0;
+  const old = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 10, now: () => time, load: () => ++calls === 1 ? old.promise : 'fresh' });
+  const oldReader = cache.get('key');
+  time = 2;
+  assert.equal(cache.set('key', undefined), undefined);
+  time = 8;
+  old.resolve('old');
+  assert.equal(await oldReader, 'old');
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(cache.size, 1);
+  time = 12;
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'fresh');
+  assert.equal(calls, 2);
+});
+
+test('expired set starts a new flight while a detached load remains pending', async () => {
+  let time = 0;
+  const old = deferred();
+  const fresh = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 5, now: () => time, load: () => ++calls === 1 ? old.promise : fresh.promise });
+  const oldReader = cache.get('key');
+  cache.set('key', 'set');
+  time = 5;
+  const freshReader = cache.get('key');
+  assert.equal(cache.size, 0);
+  old.resolve('old');
+  assert.equal(await oldReader, 'old');
+  const freshWaiter = cache.get('key');
+  fresh.resolve('fresh');
+  assert.deepEqual(await Promise.all([freshReader, freshWaiter]), ['fresh', 'fresh']);
+  assert.equal(calls, 2);
+});
+
+for (const mutation of ['invalidate', 'clear', 'set']) {
+  test(`synchronous load-time ${mutation} is a barrier`, async () => {
+    let calls = 0;
+    let cache;
+    cache = createCache({ now: () => 0, load() {
+      if (++calls === 1) {
+        if (mutation === 'set') cache.set('key', 'set');
+        else cache[mutation]('key');
+        return 'old';
+      }
+      return 'fresh';
+    } });
+    assert.equal(await cache.get('key'), 'old');
+    assert.equal(await cache.get('key'), mutation === 'set' ? 'set' : 'fresh');
+    assert.equal(calls, mutation === 'set' ? 1 : 2);
+  });
+}
+
+test('reentrant reads join their own flight and load other keys independently', async () => {
+  let cache;
+  let sameKey;
+  let otherKey;
+  const keys = [];
+  cache = createCache({ now: () => 0, load(key) {
+    assert.equal(arguments.length, 1);
+    keys.push(key);
+    if (key === 'a') {
+      sameKey = cache.get('a');
+      otherKey = cache.get('b');
+    }
+    return key.toUpperCase();
+  } });
+  assert.equal(await cache.get('a'), 'A');
+  assert.equal(await sameKey, 'A');
+  assert.equal(await otherKey, 'B');
+  assert.deepEqual(keys, ['a', 'b']);
+});
+
+test('TTL begins at commit and expiration is inclusive', async () => {
+  let time = 0;
+  const gate = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 10, now: () => time, load: () => ++calls === 1 ? gate.promise : 'new' });
+  const reader = cache.get('key');
+  time = 50;
+  assert.equal(cache.size, 0);
+  const waiter = cache.get('key');
+  gate.resolve('value');
+  assert.deepEqual(await Promise.all([reader, waiter]), ['value', 'value']);
+  time = 59;
+  assert.equal(await cache.get('key'), 'value');
+  time = 60;
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'new');
+  assert.equal(calls, 2);
+});
+
+test('zero TTL deduplicates only unsettled loads, including thenables', async () => {
+  const gate = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 0, now: () => 0, load: () => {
+    calls += 1;
+    return { then(resolve, reject) { gate.promise.then(resolve, reject); } };
+  } });
+  const first = cache.get('key');
+  const waiter = cache.get('key');
+  gate.resolve(undefined);
+  assert.deepEqual(await Promise.all([first, waiter]), [undefined, undefined]);
+  assert.equal(calls, 1);
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(calls, 2);
+});
