--- /dev/null
+++ "{temp}\\hb-0bdbd79e-gohv53qn/src/cache.test.js"
@@ -0,0 +1,264 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+function controlledCache(options = {}) {
+  const loads = [];
+  const cache = createCache({
+    now: () => 0,
+    ...options,
+    load(key) {
+      const flight = deferred();
+      loads.push({ key, ...flight });
+      return flight.promise;
+    }
+  });
+  return { cache, loads };
+}
+
+function rejectsWith(promise, reason) {
+  return assert.rejects(promise, error => {
+    assert.equal(error, reason);
+    return true;
+  });
+}
+
+for (const mutation of ['invalidate', 'clear']) {
+  for (const outcome of ['resolve', 'reject']) {
+    for (const olderFirst of [true, false]) {
+      test(`${mutation}: obsolete ${outcome}, ${olderFirst ? 'older' : 'newer'} flight settles first`, async () => {
+        const { cache, loads } = controlledCache();
+        const oldReader = cache.get('key');
+        const oldWaiter = cache.get('key');
+        await Promise.resolve();
+        assert.equal(loads.length, 1);
+        cache[mutation]('key');
+        const freshReader = cache.get('key');
+        await Promise.resolve();
+        assert.equal(loads.length, 2);
+        const reason = { obsolete: true };
+        const oldResult = outcome === 'reject'
+          ? Promise.all([rejectsWith(oldReader, reason), rejectsWith(oldWaiter, reason)])
+          : Promise.all([oldReader, oldWaiter]);
+        const settleOld = async () => {
+          loads[0][outcome](outcome === 'reject' ? reason : 'old');
+          const result = await oldResult;
+          if (outcome === 'resolve') assert.deepEqual(result, ['old', 'old']);
+        };
+        if (olderFirst) {
+          await settleOld();
+          assert.equal(cache.size, 0);
+          const freshWaiter = cache.get('key');
+          await Promise.resolve();
+          assert.equal(loads.length, 2, 'obsolete settlement must not detach the fresh flight');
+          loads[1].resolve('fresh');
+          assert.equal(await freshWaiter, 'fresh');
+        } else {
+          loads[1].resolve('fresh');
+          assert.equal(await freshReader, 'fresh');
+          await settleOld();
+        }
+        assert.equal(await freshReader, 'fresh');
+        assert.equal(await cache.get('key'), 'fresh');
+        assert.equal(cache.size, 1);
+        assert.equal(loads.length, 2);
+      });
+    }
+  }
+}
+
+test('repeated invalidations are distinct barriers without stored values', async () => {
+  const { cache, loads } = controlledCache();
+  const first = cache.get('key');
+  cache.invalidate('key');
+  const second = cache.get('key');
+  cache.invalidate('key');
+  const third = cache.get('key');
+  await Promise.resolve();
+  assert.equal(loads.length, 3);
+  loads[1].resolve('second');
+  assert.equal(await second, 'second');
+  loads[0].resolve('first');
+  assert.equal(await first, 'first');
+  assert.equal(cache.size, 0);
+  const waiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(loads.length, 3);
+  loads[2].resolve('third');
+  assert.equal(await third, 'third');
+  assert.equal(await waiter, 'third');
+  assert.equal(await cache.get('key'), 'third');
+});
+
+test('clear detaches flights for every key and removes stored values', async () => {
+  const { cache, loads } = controlledCache();
+  cache.set('stored', 'value');
+  const first = cache.get('first');
+  const second = cache.get('second');
+  await Promise.resolve();
+  cache.clear();
+  assert.equal(cache.size, 0);
+  const freshFirst = cache.get('first');
+  const freshSecond = cache.get('second');
+  const freshStored = cache.get('stored');
+  await Promise.resolve();
+  assert.deepEqual(loads.map(flight => flight.key), ['first', 'second', 'first', 'second', 'stored']);
+  loads[0].resolve('obsolete first');
+  loads[1].resolve('obsolete second');
+  assert.equal(await first, 'obsolete first');
+  assert.equal(await second, 'obsolete second');
+  assert.equal(cache.size, 0);
+  const waiter = cache.get('second');
+  await Promise.resolve();
+  assert.equal(loads.length, 5);
+  loads[2].resolve('fresh first');
+  loads[3].resolve('fresh second');
+  loads[4].resolve('fresh stored');
+  assert.deepEqual(await Promise.all([freshFirst, freshSecond, freshStored, waiter]),
+    ['fresh first', 'fresh second', 'fresh stored', 'fresh second']);
+  assert.equal(cache.size, 3);
+});
+
+test('set wins over an old load without restarting its TTL', async () => {
+  let time = 0;
+  const { cache, loads } = controlledCache({ ttlMs: 10, now: () => time });
+  const oldReader = cache.get('key');
+  await Promise.resolve();
+  time = 5;
+  assert.equal(cache.set('key', undefined), undefined);
+  time = 14;
+  loads[0].resolve('old');
+  assert.equal(await oldReader, 'old');
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(cache.size, 1);
+  time = 15;
+  assert.equal(cache.size, 0);
+  const freshReader = cache.get('key');
+  await Promise.resolve();
+  assert.equal(loads.length, 2);
+  loads[1].resolve(null);
+  assert.equal(await freshReader, null);
+  assert.equal(await cache.get('key'), null);
+});
+
+test('expiry after set starts a fresh load while the detached load remains pending', async () => {
+  let time = 0;
+  const { cache, loads } = controlledCache({ ttlMs: 10, now: () => time });
+  const oldReader = cache.get('key');
+  await Promise.resolve();
+  cache.set('key', 'set');
+  time = 10;
+  const freshReader = cache.get('key');
+  await Promise.resolve();
+  assert.equal(loads.length, 2);
+  loads[0].resolve('old');
+  assert.equal(await oldReader, 'old');
+  assert.equal(cache.size, 0);
+  const waiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(loads.length, 2);
+  time = 20;
+  loads[1].resolve('fresh');
+  assert.equal(await freshReader, 'fresh');
+  assert.equal(await waiter, 'fresh');
+  time = 29;
+  assert.equal(await cache.get('key'), 'fresh');
+  time = 30;
+  assert.equal(cache.size, 0);
+});
+
+for (const failure of ['throw', 'promise', 'thenable']) {
+  test(`${failure} failures share their reason, are not cached, and permit retry`, async () => {
+    const reason = { failure };
+    let calls = 0;
+    const cache = createCache({
+      now: () => 0,
+      load() {
+        calls += 1;
+        if (calls > 1) return 'recovered';
+        if (failure === 'throw') throw reason;
+        if (failure === 'promise') return Promise.reject(reason);
+        return { then(resolve, reject) { reject(reason); } };
+      }
+    });
+    const first = cache.get('key');
+    const second = cache.get('key');
+    await Promise.all([rejectsWith(first, reason), rejectsWith(second, reason)]);
+    assert.equal(calls, 1);
+    assert.equal(cache.size, 0);
+    assert.deepEqual(await Promise.all([cache.get('key'), cache.get('key')]), ['recovered', 'recovered']);
+    assert.equal(calls, 2);
+    assert.equal(cache.size, 1);
+  });
+}
+
+for (const mutation of ['invalidate', 'clear', 'set']) {
+  test(`synchronous load ${mutation} prevents its own result from committing`, async () => {
+    let calls = 0;
+    let cache;
+    cache = createCache({
+      now: () => 0,
+      load(key) {
+        calls += 1;
+        if (calls === 1) {
+          if (mutation === 'set') cache.set(key, 'set');
+          else cache[mutation](key);
+          return 'obsolete';
+        }
+        return 'fresh';
+      }
+    });
+    assert.equal(await cache.get('key'), 'obsolete');
+    assert.equal(await cache.get('key'), mutation === 'set' ? 'set' : 'fresh');
+    assert.equal(calls, mutation === 'set' ? 1 : 2);
+  });
+}
+
+test('reentrant reads join the current flight while another key loads independently', async () => {
+  let cache;
+  let selfReader;
+  const keys = [];
+  cache = createCache({
+    now: () => 0,
+    load(key) {
+      keys.push(key);
+      if (key === 'outer') {
+        selfReader = cache.get(key);
+        return cache.get('inner').then(value => `${value}:outer`);
+      }
+      return 'inner';
+    }
+  });
+  assert.equal(await cache.get('outer'), 'inner:outer');
+  assert.equal(await selfReader, 'inner:outer');
+  assert.deepEqual(keys, ['outer', 'inner']);
+  assert.equal(cache.size, 2);
+});
+
+test('zero TTL deduplicates only unsettled loads; size does not detach them', async () => {
+  const { cache, loads } = controlledCache({ ttlMs: 0 });
+  const first = cache.get('key');
+  assert.equal(cache.size, 0);
+  const waiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(loads.length, 1);
+  loads[0].resolve('first');
+  assert.deepEqual(await Promise.all([first, waiter]), ['first', 'first']);
+  assert.equal(cache.size, 0);
+  const second = cache.get('key');
+  await Promise.resolve();
+  assert.equal(loads.length, 2);
+  loads[1].resolve('second');
+  assert.equal(await second, 'second');
+});
