@@ -0,0 +1,180 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+
+test('candidate ordering compares each numeric version component', () => {
+  for (const versions of [
+    ['9.0.0', '10.0.0'],
+    ['1.9.0', '1.10.0'],
+    ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    const catalog = Object.fromEntries(versions.map(version => [version, {}]));
+    assert.deepEqual(resolve({ a: catalog }, { a: '*' }), { a: versions[1] });
+  }
+});
+
+test('backtracking removes failed dependencies, constraints, and selections', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0', missing: '*' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': { c: '*' } },
+    c: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0' });
+});
+
+test('a partial discovery conflict is undone before the next candidate', () => {
+  const registry = {
+    anchor: { '1.0.0': {} },
+    a: {
+      '3.0.0': { orphan: '*', anchor: '2.0.0', never: '*' },
+      '2.0.0': { a: '1.0.0' },
+      '1.0.0': {},
+    },
+  };
+  assert.deepEqual(resolve(registry, { anchor: '*', a: '*' }), {
+    anchor: '1.0.0', a: '1.0.0',
+  });
+});
+
+test('first-found selection uses FIFO discovery and retries the most recent choice', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': { c: '2.0.0' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '2.0.0', c: '1.0.0',
+  });
+  registry.a['2.0.0'].c = '2.0.0';
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '2.0.0',
+  });
+});
+
+test('all root constraints apply and only selected versions create reachability', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0', missing: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+    unreachable: { '1.0.0': { missing: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '1.0.0' }), {
+    a: '1.0.0', b: '1.0.0',
+  });
+  assert.deepEqual(resolve(registry, {}), {});
+  assert.equal(resolve(registry, { missing: '*' }), null);
+  assert.equal(resolve(registry, { b: '>2.0.0' }), null);
+});
+
+test('cycles expand each selected package once and reject incompatible cycles', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { a: '*', b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve(registry, { a: '2.0.0' }), null);
+});
+
+test('long cyclic chains do not depend on call-stack depth or iteration caps', () => {
+  const registry = {};
+  const expected = {};
+  const length = 12000;
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % length}`]: '*' } };
+    expected[`p${i}`] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, { p0: '*' }), expected);
+  registry[`p${length - 1}`]['1.0.0'].missing = '*';
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('discovered conflicts prune choices instead of enumerating a Cartesian product', () => {
+  const registry = { anchor: { '1.0.0': {} } };
+  const root = { anchor: '*' };
+  const expected = { anchor: '1.0.0' };
+  for (let i = 0; i < 40; i += 1) {
+    registry[`p${i}`] = { '2.0.0': { anchor: '2.0.0' }, '1.0.0': {} };
+    root[`p${i}`] = '*';
+    expected[`p${i}`] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('map validation is eager, accepts null prototypes, and ignores inherited keys', () => {
+  for (const invalid of [null, [], new Date(), 1]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unreachable: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unreachable: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unreachable: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unreachable: { '1.0.0': { a: '^bad' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { a: '' }), TypeError);
+  const registry = Object.create(null);
+  registry.__proto__ = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+  registry.constructor = { '1.0.0': {} };
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  const root = Object.assign(Object.create(null), { constructor: '*' });
+  root.__proto__ = '*';
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['constructor', '__proto__']);
+  assert.equal(result.__proto__, '1.0.0');
+});
+
+test('resolution does not mutate frozen inputs', () => {
+  const deps = Object.freeze({ a: '*' });
+  const registry = Object.freeze({ a: Object.freeze({ '1.0.0': deps }) });
+  const root = Object.freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0' });
+  assert.deepEqual(deps, { a: '*' });
+});
+
+test('semver parsing is canonical and comparison is numeric', () => {
+  assert.deepEqual(parse('9007199254740991.10.0'), [Number.MAX_SAFE_INTEGER, 10, 0]);
+  assert.equal(compare('1.10.0', '1.9.9'), 1);
+  assert.equal(compare('0.0.0', '0.0.0'), 0);
+  assert.equal(compare('1.0.0', '2.0.0'), -1);
+  for (const invalid of [null, 1, '01.0.0', '1.0', '-1.0.0', '1.0.0-alpha',
+    '1.0.0+build', ' 1.0.0', '1.0.0\n', '9007199254740992.0.0']) {
+    assert.throws(() => parse(invalid), TypeError);
+  }
+});
+
+test('range operators enforce inclusive lower and exclusive upper bounds', () => {
+  const cases = [
+    ['*', '0.0.0', true],
+    ['1.2.3', '1.2.3', true], ['1.2.3', '1.2.4', false],
+    ['^1.2.3', '1.2.2', false], ['^1.2.3', '1.9.9', true], ['^1.2.3', '2.0.0', false],
+    ['^0.2.3', '0.2.2', false], ['^0.2.3', '0.2.9', true], ['^0.2.3', '0.3.0', false],
+    ['^0.0.3', '0.0.2', false], ['^0.0.3', '0.0.3', true], ['^0.0.3', '0.0.4', false],
+    ['^0.0.0', '0.0.0', true], ['^0.0.0', '0.0.1', false],
+    ['~0.0.3', '0.0.2', false], ['~0.0.3', '0.0.9', true], ['~0.0.3', '0.1.0', false],
+    ['~1.2.3', '1.2.9', true], ['~1.2.3', '1.3.0', false],
+    ['>=1.0.0', '1.0.0', true], ['>1.0.0', '1.0.0', false],
+    ['<=1.0.0', '1.0.0', true], ['<1.0.0', '1.0.0', false],
+    [' \t>=1.0.0\n<2.0.0 * ', '1.9.0', true], ['>=1.0.0 <2.0.0', '2.0.0', false],
+    ['^9007199254740991.0.0', '9007199254740991.1.0', true],
+    ['^0.9007199254740991.0', '0.9007199254740991.1', true],
+    ['^0.0.9007199254740991', '0.1.0', false],
+    ['~1.9007199254740991.0', '2.0.0', false],
+  ];
+  for (const [range, version, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected, `${version} compiled ${range}`);
+  }
+  for (const invalid of [null, 1, '', ' ', '||', '1.2', '>= 1.0.0', '**', '^01.0.0',
+    '1.0.0 || 2.0.0', '>=1.0.0 nope']) {
+    assert.throws(() => compileRange(invalid), TypeError);
+  }
+});
+
+test('resolver uses zero-major caret bounds for candidate filtering', () => {
+  const registry = { a: { '0.3.0': {}, '0.2.4': {}, '0.2.3': {}, '0.0.4': {}, '0.0.3': {} } };
+  assert.deepEqual(resolve(registry, { a: '^0.2.3' }), { a: '0.2.4' });
+  assert.deepEqual(resolve(registry, { a: '^0.0.3' }), { a: '0.0.3' });
+});
