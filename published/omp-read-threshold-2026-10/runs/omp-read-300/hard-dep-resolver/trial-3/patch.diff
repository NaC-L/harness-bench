+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+
+const version = '1.0.0';
+
+test('candidate ordering compares every component numerically', () => {
+  const registry = {
+    major: { '9.0.0': {}, '10.0.0': {} },
+    minor: { '1.9.0': {}, '1.10.0': {} },
+    patch: { '1.0.9': {}, '1.0.10': {} },
+    large: { '9007199254740990.0.0': {}, '9007199254740991.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { major: '*', minor: '*', patch: '*', large: '*' }), {
+    major: '10.0.0', minor: '1.10.0', patch: '1.0.10', large: '9007199254740991.0.0',
+  });
+});
+
+test('FIFO processes roots before dependencies and collects constraints on discovery', () => {
+  const registry = {
+    a: { '2.0.0': { shared: '*' } },
+    b: { '2.0.0': { shared: '1.0.0' }, '1.0.0': { shared: '2.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '2.0.0', shared: '1.0.0',
+  });
+});
+
+test('first-found selection follows root order rather than globally maximizing versions', () => {
+  const registry = {
+    a: { '2.0.0': { shared: '1.0.0' }, '1.0.0': { shared: '2.0.0' } },
+    b: { '2.0.0': { shared: '2.0.0' }, '1.0.0': { shared: '1.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', shared: '1.0.0',
+  });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), {
+    b: '2.0.0', a: '1.0.0', shared: '2.0.0',
+  });
+});
+
+test('dependency key order determines the first complete assignment', () => {
+  const registry = {
+    start: { [version]: { a: '*', b: '*' } },
+    a: { '2.0.0': { shared: '1.0.0' }, '1.0.0': { shared: '2.0.0' } },
+    b: { '2.0.0': { shared: '2.0.0' }, '1.0.0': { shared: '1.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { start: '*' }), {
+    start: version, a: '2.0.0', b: '1.0.0', shared: '1.0.0',
+  });
+});
+
+test('backtracking removes abandoned constraints, dependencies, and descendant choices', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*', missing: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('an immediate conflict rolls back even partially discovered dependencies', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { missing: '*', a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('cycles expand selected versions only once and still enforce conflicting edges', () => {
+  assert.deepEqual(resolve({ a: { [version]: { a: '*' } } }, { a: '*' }), { a: version });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { [version]: { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: version });
+  assert.equal(resolve(registry, { a: '2.0.0' }), null);
+});
+
+test('long chains and rollback use explicit frames without an iteration cutoff', () => {
+  const count = 12000;
+  const registry = {};
+  for (let i = 0; i < count; i += 1) {
+    const deps = { [`p${i + 1}`]: '*' };
+    registry[`p${i}`] = { '2.0.0': deps, '1.0.0': {} };
+  }
+  // The absent final package forces rollback at the deepest choice.
+  const expected = {};
+  for (let i = 0; i < count; i += 1) expected[`p${i}`] = i === count - 1 ? '1.0.0' : '2.0.0';
+  assert.deepEqual(resolve(registry, { p0: '*' }), expected);
+  // With no descendant alternatives, rollback must unwind the entire chain.
+  for (let i = 1; i < count; i += 1) delete registry[`p${i}`]['1.0.0'];
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '1.0.0' });
+});
+
+test('conflicts are checked before exploring unrelated combinations', { timeout: 5000 }, () => {
+  const registry = { anchor: { [version]: {} } };
+  const root = { anchor: '*' };
+  const expected = { anchor: version };
+  for (let i = 0; i < 40; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { anchor: '2.0.0' }, '1.0.0': {} };
+    root[name] = '*';
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('missing packages are unsatisfiable, empty roots select nothing, and inputs stay unchanged', () => {
+  const deps = Object.freeze({ leaf: '*' });
+  const registry = Object.freeze({
+    start: Object.freeze({ [version]: deps }),
+    leaf: Object.freeze({ [version]: Object.freeze({}) }),
+  });
+  const root = Object.freeze({ start: '*' });
+  assert.deepEqual(resolve(registry, root), { start: version, leaf: version });
+  assert.deepEqual(resolve(registry, {}), {});
+  assert.equal(resolve(registry, { missing: '*' }), null);
+});
+
+test('all registry entries are validated eagerly even with an empty root', () => {
+  for (const registry of [
+    { unused: [] },
+    { unused: { '01.0.0': {} } },
+    { unused: { [version]: null } },
+    { unused: { [version]: { missing: '^0.1' } } },
+    { unused: { [version]: { missing: 1 } } },
+  ]) {
+    assert.throws(() => resolve(registry, {}), TypeError);
+  }
+  for (const map of [null, [], new Map(), new Date()]) {
+    assert.throws(() => resolve(map, {}), TypeError);
+    assert.throws(() => resolve({}, map), TypeError);
+  }
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+});
+
+test('null-prototype maps and special names use only own enumerable string keys', () => {
+  const deps = Object.create(null);
+  deps.constructor = '*';
+  const versions = Object.create(null);
+  versions[version] = deps;
+  Object.defineProperty(versions, 'invalid', { value: null });
+  const registry = Object.create(null);
+  registry.__proto__ = versions;
+  registry.constructor = { [version]: {} };
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(registry, 'ignored', { value: [] });
+  const root = Object.create(null);
+  root.__proto__ = '*';
+  const expected = JSON.parse('{"__proto__":"1.0.0","constructor":"1.0.0"}');
+  const result = resolve(registry, root);
+  assert.deepEqual(result, expected);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(resolve({}, { toString: '*' }), null);
+});
