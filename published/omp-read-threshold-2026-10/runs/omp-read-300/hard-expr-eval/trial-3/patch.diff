@@ -0,0 +1,122 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error =>
+    error instanceof ExprError && error.column === column);
+}
+
+test('power associates right and binds above a left unary sign', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625],
+    ['--2 ** 2', 4],
+    ['3 * -2 ** 2 + 5', -7],
+    ['8 / 2 * 3', 12],
+    ['10 - 3 + 2', 9],
+    ['2 ** +3', 8],
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo handle signs, fractions and positive zero', () => {
+  for (const [a, b] of [[7, 3], [-7, 3], [7, -3], [-7, -3]]) {
+    const quotient = evaluate('a // b', { a, b });
+    const remainder = evaluate('a % b', { a, b });
+    assert.equal(quotient, Math.floor(a / b));
+    assert.equal(remainder, a - quotient * b);
+    assert.equal(a, quotient * b + remainder);
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const source of ['0 // -3', '-0 // 3', '0 % -3', '-6 % 3', '6 % -3']) {
+    assert.equal(evaluate(source), 0, source);
+  }
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`1   ${operator} -0`, 5);
+    errorAt(`1   ${operator} (2 < 1)`, 5);
+  }
+});
+
+test('comparisons chain, with boolean-to-number arithmetic and equality', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 == 2 != 3 > 1 >= 1', true],
+    ['3 > 2 > 1', true],
+    ['1 == 1 == 2', false],
+    ['(3 < 2) < 1', true],
+    ['(1 < 2) + (3 < 2)', 1],
+    ['(1 < 2) == 1', true],
+    ['(3 < 2) == 0', true],
+    ['1 + 2 < 2 * 2', true],
+    ['abs(-(1 < 2))', 1],
+    ['min(3, max(1, 2), -4)', -4],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('operands and call arguments read own getters once, left to right', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 100 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c + d', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a, min(b, c), d)', variables), 4);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+  reads.length = 0;
+  assert.equal(evaluate('a + a * b', variables), 3);
+  assert.deepEqual(reads, ['a', 'a', 'b']);
+  errorAt('  inherited', 3, variables);
+});
+
+test('false comparisons skip later operands but never skip syntax validation', () => {
+  const variables = { get skipped() { assert.fail('short-circuited getter'); } };
+  assert.equal(evaluate('3 < 2 < skipped', variables), false);
+  assert.equal(evaluate('3 < 2 < unknown'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+  const unread = { get a() { assert.fail('evaluated before parsing completed'); } };
+  for (const call of ['unknown(1)', 'unknown(,)', 'abs()', 'abs(1, 2)', 'min()', 'max()']) {
+    const source = `a < 0 <   ${call}`;
+    errorAt(source, 11, unread);
+  }
+  errorAt('a + 1   2', 9, unread);
+  errorAt('3 < 2 < (1 + )', 14);
+});
+
+test('error columns point to tokens after whitespace and include trailing whitespace at EOF', () => {
+  for (const [source, column] of [
+    ['1 +   missing', 7],
+    ['  \tmissing', 4],
+    ['1 +   @', 7],
+    ['1 +   😀', 7],
+    ['1 +   )', 7],
+    ['1   2', 5],
+    ['1 +   ', 7],
+    ['(1  ', 5],
+    ['   ', 4],
+    ['', 1],
+    ['abs(1,)', 7],
+    ['2(3)', 2],
+    ['1 = 2', 3],
+  ]) errorAt(source, column);
+});
+
+test('long flat arithmetic and comparison chains avoid recursive evaluation', () => {
+  const count = 100001;
+  assert.equal(evaluate('1+'.repeat(count - 1) + '1'), count);
+  assert.equal(evaluate('1*'.repeat(count - 1) + '2'), 2);
+  assert.equal(evaluate('1<='.repeat(count - 1) + '1'), true);
+});
