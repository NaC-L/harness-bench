@@ -0,0 +1,95 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column);
+    return true;
+  });
+}
+
+test('power associates right and binds asymmetrically with unary signs', () => {
+  assert.equal(evaluate('-2 ** 2'), -4);
+  assert.equal(evaluate('(-2) ** 2'), 4);
+  assert.equal(evaluate('2 ** 3 ** 2'), 512);
+  assert.equal(evaluate('2 ** -2 ** 2'), 1 / 16);
+  assert.equal(evaluate('-2 ** -2'), -1 / 4);
+  assert.equal(evaluate('2 * -3 ** 2 + +4'), -14);
+  assert.equal(evaluate('16 / 2 / 2 - 1 - 2'), 1);
+});
+
+test('floor and modulo preserve integer identities and normalize zero', () => {
+  for (const a of [-7, 0, 7]) {
+    for (const b of [-3, 3]) {
+      const q = evaluate('a // b', { a, b });
+      const r = evaluate('a % b', { a, b });
+      assert.equal(q, Math.floor(a / b) || 0);
+      assert.equal(a, q * b + r);
+      assert.ok(r === 0 || Math.sign(r) === Math.sign(b));
+    }
+  }
+  assert.equal(evaluate('-5.5 // 2'), -3);
+  assert.equal(evaluate('-5.5 % 2'), 0.5);
+  assert.equal(evaluate('5.5 % -2'), -0.5);
+  for (const source of ['0 // -2', '-0 // 2', '-6 % 3', '6 % -3', '-0 % 2']) {
+    assert.equal(evaluate(source), 0);
+  }
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`1   ${operator} -0`, 5);
+  }
+});
+
+test('comparison chains reuse operands and short-circuit in evaluation order', () => {
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return 3; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 1; },
+  };
+  assert.equal(evaluate('a > b > c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('a < b < missing', variables), false);
+  assert.deepEqual(reads, ['a', 'b']);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+  assert.equal(evaluate('1 < 2 > 3'), false);
+  assert.equal(evaluate('1 < 2 <= 2 != 3 == 3 >= 0'), true);
+  assert.equal(evaluate('(1 < 2) + (3 < 2)'), 1);
+  assert.equal(evaluate('(1 < 2) == 1'), true);
+  assert.equal(evaluate('(1 > 2) == 0'), true);
+});
+
+test('the whole formula is parsed before any variables are evaluated', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  errorAt('x +   nope(1)', 7, variables);
+  errorAt('x +   abs(1, 2)', 7, variables);
+  errorAt('x +   min()', 7, variables);
+  errorAt('x +   max()', 7, variables);
+  errorAt('x +   abs()', 7, variables);
+  errorAt('3 < 2 <   )', 11, variables);
+  errorAt('x + min(1,)', 11, variables);
+  assert.equal(reads, 0);
+});
+
+test('columns identify tokens after whitespace and include trailing whitespace at EOF', () => {
+  errorAt(' \t missing', 4);
+  errorAt('1 +   @', 7);
+  errorAt('1 +   \u{1f600}', 7);
+  errorAt('1 +   )', 7);
+  errorAt('1   2', 5);
+  errorAt('1 + \t ', 7);
+  errorAt('  (1  ', 7);
+  errorAt(' \t ', 4);
+});
+
+test('long flat arithmetic and comparison chains do not consume the call stack', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate('2' + '*1'.repeat(count - 1)), 2);
+  assert.equal(evaluate(Array(count).fill('1').join('<=')), true);
+});
