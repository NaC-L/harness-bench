@@ -0,0 +1,124 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards earlier additions on both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -2);
+  tree.assign(2, 6, 5);
+  assert.equal(tree.sum(1, 7), 16);
+  assert.deepEqual(tree.toArray(), [-2, -2, 5, 5, 5, 5, -2, -2]);
+});
+
+test('partial maximum queries preserve negative maxima', () => {
+  const tree = new RangeTree([-9, -3, -7, -5, -8]);
+  assert.equal(tree.max(1, 4), -3);
+  tree.add(0, 5, -4);
+  assert.equal(tree.max(2, 5), -9);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search propagates lazy updates before inspecting children', () => {
+  const tree = new RangeTree([0, 1, 2, 3, 4]);
+  tree.assign(0, 5, 10);
+  assert.equal(tree.firstAtLeast(2, 10), 2);
+  tree.add(0, 5, -20);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.add(0, 5, 30);
+  assert.equal(tree.firstAtLeast(1, 20), 1);
+  tree.assign(0, 5, -5);
+  tree.assign(3, 5, 7);
+  assert.equal(tree.firstAtLeast(0, 7), 3);
+  assert.equal(tree.firstAtLeast(4, 7), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('mixed updates and queries agree with a deterministic array oracle', () => {
+  let seed = 0x12345678;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 7, 8, 17, 32]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 200; step++) {
+      const a = random(length + 1);
+      const b = random(length + 1);
+      const l = Math.min(a, b);
+      const r = Math.max(a, b);
+      const value = random(41) - 20;
+      if (random(2) === 0) {
+        assert.equal(tree.assign(l, r, value), undefined);
+        values.fill(value, l, r);
+      } else {
+        assert.equal(tree.add(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] += value;
+      }
+      // Query before materializing: toArray must not hide stale lazy tags.
+      const lo = random(length + 1);
+      const threshold = random(81) - 40;
+      assert.equal(tree.firstAtLeast(lo, threshold),
+        values.findIndex((entry, i) => i >= lo && entry >= threshold));
+      const c = random(length + 1);
+      const d = random(length + 1);
+      const start = Math.min(c, d);
+      const end = Math.max(c, d);
+      let sum = 0;
+      let maximum = -Infinity;
+      for (let i = start; i < end; i++) {
+        sum += values[i];
+        maximum = Math.max(maximum, values[i]);
+      }
+      assert.equal(tree.sum(start, end), sum);
+      assert.equal(tree.max(start, end), maximum);
+      const index = random(length);
+      assert.equal(tree.get(index), values[index]);
+      if (step % 23 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, and array ownership retain their API behavior', () => {
+  for (const input of [[], null, [NaN], [Infinity], [1, '2'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  const output = tree.toArray();
+  output[1] = 99;
+  assert.deepEqual(tree.toArray(), [2, -3, 4]);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 4; }, TypeError);
+  tree.add(0, 3, 2);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [2, 1], [0, 4], [0.5, 2], [0, NaN]]) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    assert.equal(tree[method](3, 3, 8), undefined);
+  }
+  for (const index of [-1, 3, 0.5, NaN]) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const [lo, x] of [[-1, 0], [4, 0], [0.5, 0], [0, NaN], [0, '1']]) {
+    assert.throws(() => tree.firstAtLeast(lo, x), RangeError);
+  }
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(3, 3), -Infinity);
+  assert.deepEqual(tree.toArray(), [4, -1, 6]);
+});
