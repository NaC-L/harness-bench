+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both the overwritten node and its children', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(4, 8, -3);
+  tree.add(0, 8, 5);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -2);
+  tree.assign(2, 6, 4);
+  assert.equal(tree.sum(1, 7), 12);
+  assert.equal(tree.get(0), -2);
+  assert.deepEqual(tree.toArray(), [-2, -2, 4, 4, 4, 4, -2, -2]);
+});
+
+test('partial maxima preserve negative values and the empty-range identity', () => {
+  const tree = new RangeTree([-9, -7, -5, -3, -1]);
+  assert.equal(tree.max(0, 3), -5);
+  assert.equal(tree.max(1, 2), -7);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 2);
+  assert.equal(tree.max(2, 5), -8);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search sees pending assignments and additions before descending', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.assign(0, 5, -10);
+  tree.add(0, 5, 20);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(2, 10), 2);
+  assert.equal(tree.firstAtLeast(0, 11), -1);
+  tree.assign(0, 5, -20);
+  tree.add(3, 5, 15);
+  assert.equal(tree.firstAtLeast(0, -5), 3);
+  assert.equal(tree.firstAtLeast(4, -5), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('mixed updates and reads agree with an array model on uneven tree sizes', () => {
+  let seed = 0x12345678;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 3, 8, 17]) {
+    const values = Array.from({ length }, () => random(21) - 10);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 300; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 7 === 0) { l = 0; r = length; }
+      const value = random(21) - 10;
+      const assigning = random(2) === 0;
+      assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+
+      // Search first: other reads must not flush tags and conceal search defects.
+      const lo = random(length + 1);
+      const threshold = random(41) - 20;
+      const expectedIndex = values.findIndex((v, i) => i >= lo && v >= threshold);
+      assert.equal(tree.firstAtLeast(lo, threshold), expectedIndex);
+      const a = random(length + 1);
+      const b = a + random(length - a + 1);
+      const range = values.slice(a, b);
+      assert.equal(tree.sum(a, b), range.reduce((sum, v) => sum + v, 0));
+      assert.equal(tree.max(a, b), Math.max(...range));
+      const index = random(length);
+      assert.equal(tree.get(index), values[index]);
+      assert.equal(tree.sum(0, length), values.reduce((sum, v) => sum + v, 0));
+      assert.equal(tree.max(0, length), Math.max(...values));
+      if (step % 31 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
