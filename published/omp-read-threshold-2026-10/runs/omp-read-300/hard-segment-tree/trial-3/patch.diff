@@ -0,0 +1,139 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+function checkQueries(tree, values) {
+  assert.equal(tree.length, values.length);
+  for (let l = 0; l <= values.length; l++) {
+    let sum = 0;
+    let maximum = -Infinity;
+    for (let r = l; r <= values.length; r++) {
+      assert.equal(tree.sum(l, r), sum, `sum(${l}, ${r})`);
+      assert.equal(tree.max(l, r), maximum, `max(${l}, ${r})`);
+      if (r < values.length) {
+        sum += values[r];
+        maximum = Math.max(maximum, values[r]);
+      }
+    }
+  }
+  for (let i = 0; i < values.length; i++) assert.equal(tree.get(i), values[i]);
+  assert.deepEqual(tree.toArray(), values);
+}
+
+function checkSearch(tree, values) {
+  const thresholds = [-Infinity, Infinity, -1, 0, 1];
+  for (const value of values) thresholds.push(value - 1, value, value + 1);
+  for (let lo = 0; lo <= values.length; lo++) {
+    for (const threshold of thresholds) {
+      const expected = values.findIndex((value, i) => i >= lo && value >= threshold);
+      assert.equal(tree.firstAtLeast(lo, threshold), expected,
+        `firstAtLeast(${lo}, ${threshold})`);
+    }
+  }
+}
+
+test('assignments discard older additions at parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 8);
+  tree.add(3, 7, -5);
+  tree.add(0, 7, 4);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  tree.assign(1, 6, -9);
+  tree.add(2, 7, 3);
+  checkQueries(tree, [-2, -9, -6, -6, -6, -6, 1]);
+});
+
+test('partial maxima retain negative values', () => {
+  const tree = new RangeTree([-8, -4, -6, -10, -3]);
+  checkQueries(tree, [-8, -4, -6, -10, -3]);
+  tree.assign(0, 5, -7);
+  tree.add(1, 4, -3);
+  checkQueries(tree, [-7, -10, -10, -10, -7]);
+});
+
+test('threshold searches see pending assignments and additions before other queries', () => {
+  const tree = new RangeTree([9, 0, 9, 0, 9]);
+  tree.add(0, 5, -8);
+  assert.equal(tree.firstAtLeast(1, 0), 2);
+  tree.assign(0, 5, 7);
+  assert.equal(tree.firstAtLeast(0, 7), 0);
+  tree.add(0, 5, 3);
+  assert.equal(tree.firstAtLeast(2, 10), 2);
+  tree.assign(1, 4, -2);
+  tree.add(0, 5, -4);
+  checkSearch(tree, [6, -6, -6, -6, 6]);
+  checkQueries(tree, [6, -6, -6, -6, 6]);
+});
+
+test('deterministic mixed updates match an array oracle across tree shapes', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 8) % limit;
+  };
+  for (const length of [1, 2, 3, 7, 8, 17]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let batch = 0; batch < 30; batch++) {
+      // Leave several overlapping updates pending before any reads.
+      for (let step = 0; step < 8; step++) {
+        let l = random(length + 1);
+        let r = random(length + 1);
+        if (l > r) [l, r] = [r, l];
+        if (step === 0 || step === 3) { l = 0; r = length; }
+        const value = random(31) - 15;
+        const assigning = random(2) === 0;
+        assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      }
+      // Searching first is essential: other reads would push the lazy tags.
+      checkSearch(tree, values);
+      checkQueries(tree, values);
+    }
+  }
+});
+
+test('validation, empty ranges, read-only length and independent arrays are preserved', () => {
+  for (const input of [[], null, {}, '123', [NaN], [Infinity], [-Infinity], ['1'], Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.add(0, 3, 5);
+  for (const [l, r] of [[-1, 1], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 1]]) {
+    for (const operation of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[operation](l, r, 0), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const operation of ['assign', 'add']) {
+      assert.throws(() => tree[operation](0, 3, value), RangeError);
+      assert.throws(() => tree[operation](1, 1, value), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) assert.throws(() => tree.get(i), RangeError);
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  for (let i = 0; i <= 3; i++) {
+    assert.equal(tree.assign(i, i, 99), undefined);
+    assert.equal(tree.add(i, i, -99), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  checkSearch(tree, [7, 2, 9]);
+  checkQueries(tree, [7, 2, 9]);
+  const output = tree.toArray();
+  output[1] = 99;
+  tree.assign(2, 3, -4);
+  assert.deepEqual(output, [7, 99, 9]);
+  checkQueries(tree, [7, 2, -4]);
+});
