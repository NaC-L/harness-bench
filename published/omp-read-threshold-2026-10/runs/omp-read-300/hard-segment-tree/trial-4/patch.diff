@@ -0,0 +1,121 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards older additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 9);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -2);
+  assert.equal(tree.sum(1, 7), -12);
+  assert.equal(tree.get(0), -2);
+  assert.deepEqual(tree.toArray(), Array(8).fill(-2));
+  tree.add(2, 6, 5);
+  tree.assign(3, 5, -7);
+  assert.equal(tree.sum(0, 8), -16);
+  assert.deepEqual(tree.toArray(), [-2, -2, 3, -7, -7, 3, -2, -2]);
+});
+
+test('partial maxima remain negative rather than being clamped to zero', () => {
+  const tree = new RangeTree([-9, -8, -7, -6, -5]);
+  assert.equal(tree.max(1, 4), -6);
+  tree.add(0, 5, -10);
+  assert.equal(tree.max(2, 5), -15);
+  tree.assign(1, 4, -20);
+  assert.equal(tree.max(1, 3), -20);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold search observes pending assignment and addition before descending', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 13), 2);
+  tree.assign(0, 5, -4);
+  assert.equal(tree.firstAtLeast(1, -3), -1);
+  assert.equal(tree.firstAtLeast(1, -4), 1);
+  tree.add(0, 5, 9);
+  assert.equal(tree.firstAtLeast(3, 5), 3);
+  tree.assign(0, 3, -8);
+  assert.equal(tree.firstAtLeast(0, 5), 3);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('mixed updates and queries agree with a deterministic array model', () => {
+  let state = 0x12345678;
+  const random = n => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % n;
+  };
+  for (const size of [1, 2, 5, 8, 17, 32]) {
+    const values = Array.from({ length: size }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 400; step++) {
+      const a = random(size + 1);
+      const b = random(size + 1);
+      const l = Math.min(a, b);
+      const r = Math.max(a, b);
+      const value = random(41) - 20;
+      if (random(2)) {
+        assert.equal(tree.assign(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] = value;
+      } else {
+        assert.equal(tree.add(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] += value;
+      }
+      // Search first: materialization must not hide stale-child defects.
+      const lo = random(size + 1);
+      const threshold = random(81) - 40;
+      assert.equal(tree.firstAtLeast(lo, threshold),
+        values.findIndex((v, i) => i >= lo && v >= threshold));
+      const start = random(size + 1);
+      const end = start + random(size - start + 1);
+      const slice = values.slice(start, end);
+      assert.equal(tree.sum(start, end), slice.reduce((sum, v) => sum + v, 0));
+      assert.equal(tree.max(start, end), Math.max(...slice));
+      const i = random(size);
+      assert.equal(tree.get(i), values[i]);
+      if (step % 23 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, read-only length, and array ownership are preserved', () => {
+  for (const input of [[], null, '12', [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  const output = tree.toArray();
+  output[1] = 99;
+  assert.deepEqual(tree.toArray(), [2, -3, 4]);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  tree.add(0, 3, 2);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined]) {
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    assert.equal(tree[method](1, 1, 20), undefined);
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const [lo, x] of [[-1, 0], [4, 0], [0.5, 0], ['0', 0], [0, NaN], [0, '1']]) {
+    assert.throws(() => tree.firstAtLeast(lo, x), RangeError);
+  }
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(3, 3), -Infinity);
+  assert.deepEqual(tree.toArray(), [4, -1, 6]);
+});
