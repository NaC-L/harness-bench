@@ -0,0 +1,133 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions pending on both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4]);
+  tree.add(0, 2, 7);
+  tree.add(0, 4, 3);
+  tree.assign(0, 4, -5);
+  tree.add(0, 4, 2);
+  assert.equal(tree.sum(0, 2), -6);
+  assert.equal(tree.get(0), -3);
+  assert.deepEqual(tree.toArray(), [-3, -3, -3, -3]);
+});
+
+test('partial maxima preserve negative values and empty-range identity', () => {
+  const tree = new RangeTree([-8, -2, -7, -4, -9]);
+  assert.equal(tree.max(1, 4), -2);
+  assert.equal(tree.max(4, 5), -9);
+  tree.assign(0, 5, -6);
+  tree.add(2, 5, -3);
+  assert.equal(tree.max(1, 4), -6);
+  assert.equal(tree.max(2, 5), -9);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search pushes assignments and additions before descending', () => {
+  const tree = new RangeTree([9, -4, 8, -6, 7]);
+  tree.assign(0, 5, -10);
+  assert.equal(tree.firstAtLeast(0, -5), -1);
+  tree.add(0, 5, 20);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(3, 10), 3);
+  assert.equal(tree.firstAtLeast(0, 11), -1);
+  tree.assign(0, 2, -20);
+  tree.add(2, 5, 4);
+  assert.equal(tree.firstAtLeast(1, 14), 2);
+  assert.equal(tree.firstAtLeast(4, 14), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(1, -Infinity), 1);
+});
+
+test('mixed updates and queries agree with an array across tree shapes', () => {
+  let state = 0x12345678;
+  const random = limit => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  };
+  for (const size of [1, 2, 3, 5, 8, 17]) {
+    const values = Array.from({ length: size }, () => random(31) - 15);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 80; step++) {
+      const a = random(size + 1);
+      const b = random(size + 1);
+      const l = step % 7 === 0 ? 0 : Math.min(a, b);
+      const r = step % 7 === 0 ? size : Math.max(a, b);
+      const value = random(31) - 15;
+      const assigning = random(3) === 0;
+      assert.equal(tree[assigning ? 'assign' : 'add'](l, r, value), undefined);
+      for (let i = l; i < r; i++) {
+        values[i] = assigning ? value : values[i] + value;
+      }
+      // Search first: materializing leaves must not hide stale lazy tags.
+      for (let lo = 0; lo <= size; lo++) {
+        for (const threshold of [-Infinity, -20, 0, value, 20, Infinity]) {
+          const expected = values.findIndex((v, i) => i >= lo && v >= threshold);
+          assert.equal(tree.firstAtLeast(lo, threshold), expected,
+            `search: size=${size}, step=${step}, lo=${lo}, x=${threshold}`);
+        }
+      }
+      for (let left = 0; left <= size; left++) {
+        let sum = 0;
+        let max = -Infinity;
+        for (let right = left; right <= size; right++) {
+          assert.equal(tree.sum(left, right), sum,
+            `sum: size=${size}, step=${step}, range=[${left},${right})`);
+          assert.equal(tree.max(left, right), max,
+            `max: size=${size}, step=${step}, range=[${left},${right})`);
+          if (right < size) {
+            sum += values[right];
+            max = Math.max(max, values[right]);
+          }
+        }
+      }
+      for (let i = 0; i < size; i++) assert.equal(tree.get(i), values[i]);
+      assert.deepEqual(tree.toArray(), values);
+    }
+  }
+});
+
+test('validation is atomic, empty updates are no-ops, and arrays do not alias', () => {
+  for (const input of [[], null, '123', [1, NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.add(0, 3, 4);
+  const expected = [5, 6, 7];
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    assert.equal(tree[method](0, 0, 100), undefined);
+    assert.equal(tree[method](3, 3, 100), undefined);
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '1', undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 1; }, TypeError);
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(0, 0), -Infinity);
+  assert.deepEqual(tree.toArray(), expected);
+  const result = tree.toArray();
+  result[1] = 100;
+  assert.deepEqual(tree.toArray(), expected);
+});
