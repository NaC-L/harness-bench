+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+
+test('numeric candidate order compares all three components', () => {
+  for (const [older, newer] of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    assert.deepEqual(resolve({ a: { [older]: {}, [newer]: {} } }, { a: '*' }), { a: newer });
+    assert.equal(compare(older, newer), -1);
+    assert.equal(compare(newer, older), 1);
+    assert.equal(compare(newer, newer), 0);
+  }
+});
+
+test('semver operators, conjunctions, and zero-major caret boundaries', () => {
+  const cases = [
+    ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false],
+    ['1.2.3', '*', true], ['1.2.3', ' >=1.0.0\t<2.0.0 ', true],
+    ['1.2.3', '>1.2.3', false], ['1.2.3', '>=1.2.3', true],
+    ['1.2.3', '<1.2.3', false], ['1.2.3', '<=1.2.3', true],
+    ['1.9.9', '^1.2.3', true], ['2.0.0', '^1.2.3', false],
+    ['0.2.9', '^0.2.3', true], ['0.3.0', '^0.2.3', false],
+    ['0.2.2', '^0.2.3', false], ['0.0.3', '^0.0.3', true],
+    ['0.0.4', '^0.0.3', false], ['0.1.0', '^0.0.0', false],
+    ['0.0.0', '^0.0.0', true], ['0.0.1', '^0.0.0', false],
+    ['0.0.9', '~0.0.3', true], ['0.1.0', '~0.0.3', false],
+    ['1.2.9', '~1.2.3', true], ['1.3.0', '~1.2.3', false],
+    ['9007199254740991.0.0', '^9007199254740991.0.0', true],
+    ['0.9007199254740991.1', '^0.9007199254740991.0', true],
+    ['0.0.9007199254740991', '^0.0.9007199254740991', true],
+    ['1.9007199254740991.0', '~1.9007199254740991.0', true],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected, `${version} ${range}`);
+  }
+  assert.deepEqual(resolve({ a: { '0.2.9': {}, '0.3.0': {} } }, { a: '^0.2.3' }), { a: '0.2.9' });
+});
+
+test('malformed versions and ranges throw eagerly, including unreachable entries', () => {
+  for (const version of ['', '01.2.3', '1.2', '1.2.3.4', '-1.2.3', '1.2.3-beta',
+    '1.2.3+build', ' 1.2.3', '1.2.3\n', '9007199254740992.0.0', 123, null]) {
+    assert.throws(() => parse(version), TypeError);
+    assert.throws(() => compare('1.0.0', version), TypeError);
+    if (typeof version === 'string') {
+      assert.throws(() => resolve({ unused: { [version]: {} } }, {}), TypeError);
+    }
+  }
+  for (const range of ['', ' ', '1.2', 'v1.2.3', '!=1.2.3', '1.x', '>= 1.0.0',
+    '^01.0.0', '1.0.0 || 2.0.0', '~', '>=1.0.0 invalid', 123, null, undefined]) {
+    assert.throws(() => compileRange(range), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': { a: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { a: range }), TypeError);
+  }
+});
+
+test('all map levels are validated even for empty roots', () => {
+  for (const bad of [null, [], 'map', 1, () => {}, new Date(), Object.create({ a: '*' })]) {
+    assert.throws(() => resolve(bad, {}), TypeError);
+    assert.throws(() => resolve({}, bad), TypeError);
+    assert.throws(() => resolve({ unused: bad }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': bad } }, {}), TypeError);
+  }
+  assert.deepEqual(resolve({}, {}), {});
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+});
+
+test('only own enumerable string keys participate and special names are safe', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'ignored', { value: null });
+  Object.defineProperty(root, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  root[Symbol('ignored')] = null;
+  Object.defineProperty(registry.__proto__, 'bad-version', { value: null });
+  Object.defineProperty(registry.__proto__['1.0.0'], 'ignored', { value: null });
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+});
+
+test('FIFO discovery collects all constraints before selecting queued names', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*', c: '*', d: '1.0.0' } },
+    b: { '2.0.0': { d: '2.0.0' }, '1.0.0': {} },
+    c: { '2.0.0': {}, '1.0.0': {} },
+    d: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '2.0.0', d: '1.0.0',
+  });
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('backtracking removes rejected dependencies, queue entries, and constraints', () => {
+  const registry = {
+    a: { '3.0.0': { b: '1.0.0', missing: '*' }, '2.0.0': { b: '2.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '*' }, '1.0.0': {} },
+    c: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0', b: '2.0.0', c: '1.0.0' });
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': { absent: '*' } },
+  }, { a: '*' }), { a: '1.0.0', b: '2.0.0' });
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '*' } },
+  }, { a: '*' }), { a: '1.0.0' });
+});
+
+test('cycles terminate and conflicting cycles backtrack or return null', () => {
+  assert.deepEqual(resolve({
+    a: { '1.0.0': { b: '*' } }, b: { '1.0.0': { a: '*' } },
+  }, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve({
+    a: { '1.0.0': { b: '*' } }, b: { '1.0.0': { a: '2.0.0' } },
+  }, { a: '*' }), null);
+});
+
+test('long cyclic dependency chains do not use the recursive call stack or a search cutoff', () => {
+  const count = 15000;
+  const registry = Object.create(null);
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % count}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, count);
+  for (let i = 0; i < count; i += 1) assert.equal(result[`p${i}`], '1.0.0');
+  registry.p0 = { '2.0.0': { p1: '*' }, '1.0.0': {} };
+  registry[`p${count - 1}`] = { '1.0.0': { missing: '*' } };
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '1.0.0' });
+});
+
+test('discovered conflicts prune choices before enumerating a Cartesian product', () => {
+  const registry = { gate: { '1.0.0': {} } };
+  const root = { gate: '*' };
+  const expected = { gate: '1.0.0' };
+  for (let i = 0; i < 40; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { gate: '2.0.0' }, '1.0.0': {} };
+    root[name] = '*';
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('resolution never mutates frozen input maps', () => {
+  const registry = Object.freeze({ a: Object.freeze({
+    '2.0.0': Object.freeze({ missing: '*' }), '1.0.0': Object.freeze({}),
+  }) });
+  const root = Object.freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0' });
+  assert.deepEqual(registry, { a: { '2.0.0': { missing: '*' }, '1.0.0': {} } });
+  assert.deepEqual(root, { a: '*' });
+});
+
+// Small snapshot-based reference search, independent of the production trail.
+function referenceResolve(registry, root) {
+  function discover(constraints, selected, requirements) {
+    for (const [name, range] of Object.entries(requirements)) {
+      if (!constraints.has(name)) constraints.set(name, []);
+      constraints.get(name).push(range);
+      if (selected.has(name) && !satisfies(selected.get(name), range)) return false;
+    }
+    return true;
+  }
+  function visit(queue, cursor, constraints, selected) {
+    while (cursor < queue.length && selected.has(queue[cursor])) cursor += 1;
+    if (cursor === queue.length) return Object.fromEntries(selected);
+    const name = queue[cursor];
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints.get(name).every(range => satisfies(version, range))) continue;
+      const nextSelected = new Map(selected).set(name, version);
+      const nextConstraints = new Map([...constraints].map(([key, ranges]) => [key, ranges.slice()]));
+      const deps = registry[name][version];
+      if (!discover(nextConstraints, nextSelected, deps)) continue;
+      const result = visit(queue.concat(Object.keys(deps)), cursor + 1, nextConstraints, nextSelected);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  const constraints = new Map();
+  discover(constraints, new Map(), root);
+  return visit(Object.keys(root), 0, constraints, new Map());
+}
+
+test('first-found assignments match an independent reference across cyclic graphs', () => {
+  let seed = 123456789;
+  function random(max) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return Math.floor((seed / 0x100000000) * max);
+  }
+  const names = ['a', 'b', 'c', 'd', 'e'];
+  const ranges = ['*', '1.0.0', '2.0.0', '3.0.0', '>=2.0.0', '<3.0.0'];
+  for (let trial = 0; trial < 400; trial += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        const deps = {};
+        for (let i = 0, count = random(4); i < count; i += 1) {
+          deps[names[random(6)] || 'missing'] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (let i = 0, count = random(4); i < count; i += 1) {
+      root[names[random(names.length)]] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `trial ${trial}`);
+  }
+});
