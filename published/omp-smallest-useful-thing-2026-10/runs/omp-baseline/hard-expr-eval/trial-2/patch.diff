@@ -0,0 +1,148 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('../src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('numbers, precedence, associativity and built-in calls', () => {
+  const cases = [
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['10 - 3 + 2', 9],
+    ['24 / 3 * 2 // 3 % 4', 1],
+    ['2 + 3 * 4', 14],
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625],
+    ['2 * -3 ** 2', -18],
+    ['--2 ** 2', 4],
+    ['min(4, max(1, 3), abs(-2))', 2],
+    ['min(7)', 7],
+    ['max(7)', 7],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo obey divisor signs and normalize zero', () => {
+  for (let a = -20; a <= 20; a++) {
+    for (let b = -7; b <= 7; b++) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const operator of ['/', '//', '%']) {
+    const source = `  7   ${operator} -0`;
+    errorAt(source, source.indexOf(operator) + 1);
+  }
+});
+
+test('comparisons chain and coerce booleans numerically in arithmetic and equality', () => {
+  const cases = [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 == 2 != 3 > 2 >= 2', true],
+    ['2 == 2 == 2', true],
+    ['1 < 2 > 1', true],
+    ['1 + 2 < 2 * 2', true],
+    ['(1 < 2) + (3 < 2)', 1],
+    ['(1 < 2) == 1', true],
+    ['(1 > 2) != 0', false],
+    ['-(1 < 2)', -1],
+    ['2 ** (1 < 2)', 2],
+    ['abs(2 < 1)', 0],
+    ['(3 < 2) < 1', true],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < 1 / 0'), false);
+});
+
+test('own variables and getter occurrences are read once in left-to-right order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 42 });
+  for (const [name, value] of Object.entries({ a: 1, b: 2, c: 3 })) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('max(a + b, abs(-c), a ** b)', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'a', 'b']);
+  errorAt('  inherited', 3, variables);
+  assert.equal(evaluate('_name1 + min', { _name1: 4, min: 2 }), 6);
+  assert.equal(evaluate('toString', { toString: 7 }), 7);
+  errorAt('toString', 1);
+});
+
+test('the whole source is validated before any getter is evaluated', () => {
+  let reads = 0;
+  const variables = { get x() { reads++; return 1; } };
+  for (const [source, column] of [
+    ['x + mystery(1)', 5],
+    ['x + abs()', 5],
+    ['x + abs(1, 2)', 5],
+    ['x + min()', 5],
+    ['x + max()', 5],
+    ['x + 2 @', 7],
+    ['x + 2 3', 7],
+    ['2 < 1 < abs()', 9],
+    ['2 < 1 < (3 + )', 14],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('errors use offending UTF-16 token offsets, including whitespace and EOF', () => {
+  for (const [source, column] of [
+    ['', 1],
+    [' \t\n', 4],
+    ['  missing', 3],
+    ['1 +   missing', 7],
+    ['1 +   @', 7],
+    ['1 +   😀', 7],
+    ['1 +   )', 7],
+    ['1 + \t  ', 8],
+    ['(1 + 2   ', 10],
+    ['1  2', 4],
+    ['2 (3)', 3],
+    ['min(1,)', 7],
+    ['abs(1 2)', 7],
+    ['  mystery(1)', 3],
+    ['1e+', 2],
+    ['.', 1],
+    ['1 = 2', 3],
+    ['1 ! 2', 3],
+    ['1 /   0', 3],
+  ]) errorAt(source, column);
+});
+
+test('100,001-operand flat chains do not overflow the stack', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array(count).fill('1').join('==')), true);
+  assert.equal(evaluate(Array.from({ length: count }, (_, i) => String(i)).join('<')), true);
+});
