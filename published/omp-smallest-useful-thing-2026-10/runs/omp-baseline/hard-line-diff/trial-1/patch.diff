+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const above = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = above;
+    }
+  }
+  return row[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('exhaustive short repetitive inputs have minimal scripts and patch roundtrips', () => {
+  const sequences = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(prefix => ['', 'x', '+x'].map(line => Object.freeze([...prefix, line])));
+    sequences.push(...level);
+  }
+  for (const a of sequences) {
+    for (const b of sequences) {
+      checkScript(a, b);
+      for (const context of [0, 1, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+        if (a.length === b.length && a.every((line, i) => line === b[i])) {
+          assert.deepEqual(hunks, []);
+        }
+      }
+    }
+  }
+});
+
+test('zero-length ranges use the preceding complete-file coordinate', () => {
+  assert.deepEqual(unifiedHunks(['a', 'b'], ['top', 'a', 'middle', 'b', 'end'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 1, oldLines: 0, newStart: 3, newLines: 1, lines: ['+middle'] },
+    { oldStart: 2, oldLines: 0, newStart: 5, newLines: 1, lines: ['+end'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['top', 'a', 'middle', 'b', 'end'], ['a', 'b'], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-top'] },
+    { oldStart: 3, oldLines: 1, newStart: 1, newLines: 0, lines: ['-middle'] },
+    { oldStart: 5, oldLines: 1, newStart: 2, newLines: 0, lines: ['-end'] },
+  ]);
+});
+
+test('context windows merge when they touch, not when one unchanged line separates them', () => {
+  const a = ['head', 'old1', 'gap1', 'gap2', 'old2', 'tail'];
+  const b = ['head', 'new1', 'gap1', 'gap2', 'new2', 'tail'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' head', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' tail'],
+  }]);
+  a.splice(4, 0, 'gap3');
+  b.splice(4, 0, 'gap3');
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: [' head', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3, lines: [' gap3', '-old2', '+new2', ' tail'] },
+  ]);
+});
+
+test('application preserves prefixes, empty strings, omitted lines, and original inputs', () => {
+  const a = Object.freeze(['keep', '-old', '', '+keep', 'tail']);
+  const b = ['keep', ' new', '', '+keep', 'tail', '-end'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(unifiedHunks(a, a), []);
+});
+
+test('application rejects malformed counts, coordinates, lines, and mismatches', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {}, { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: NaN },
+    { ...valid, oldStart: 5 }, { ...valid, newStart: 3 },
+    { ...valid, oldLines: -1 }, { ...valid, newLines: -1 },
+    { ...valid, oldLines: 0 }, { ...valid, newLines: 2 },
+    { ...valid, oldLines: 3 }, { ...valid, lines: null },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b', '+B'] },
+    { ...valid, lines: ['', '+B'] },
+    { ...valid, lines: [1, '+B'] },
+    { ...valid, lines: ['-b', '-c', '+B'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [{
+    oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+past end'],
+  }]), /hunk 0 does not apply/);
+});
+
+test('later hunk coordinates include earlier insertion and deletion offsets', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f'];
+  const b = ['top', 'a', 'c', 'd', 'e', 'F', 'end'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const malformed = hunks.map(hunk => ({ ...hunk }));
+  malformed[1].newStart--;
+  assert.throws(() => applyHunks(a, malformed), /hunk 1 does not apply/);
+});
+
+test('localized changes in 20,000-line unique and repetitive files stay fast', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? `line ${i % 5}` : `line ${i}`);
+    const b = a.slice();
+    b.splice(100, 1, 'replacement');
+    b.splice(10000, 0, 'inserted');
+    b.splice(19000, 1);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.ok(performance.now() - start < 1000, 'small edits should run well under a second');
+  }
+});
