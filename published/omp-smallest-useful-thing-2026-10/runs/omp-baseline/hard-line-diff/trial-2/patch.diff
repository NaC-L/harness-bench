+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+function lcsLength(a, b) {
+  let previous = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const row = [0];
+    for (let j = 0; j < b.length; j++) {
+      row.push(line === b[j] ? previous[j] + 1 : Math.max(previous[j + 1], row[j]));
+    }
+    previous = row;
+  }
+  return previous[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+}
+
+function checkRoundtrip(a, b, context) {
+  const hunks = unifiedHunks(a, b, { context });
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+}
+
+test('exhaustive short repetitive inputs have minimal scripts and patch roundtrips', () => {
+  const inputs = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'repeat'].map(line => [...lines, line]));
+    inputs.push(...level.map(lines => Object.freeze(lines)));
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      checkScript(a, b);
+      for (const context of [0, 1, 2, 3]) checkRoundtrip(a, b, context);
+    }
+  }
+});
+
+test('seeded edits preserve empty and prefix-like lines', () => {
+  let seed = 123456789;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  const alphabet = ['', 'a', 'b', ' ', '-old', '+new', ' repeated'];
+  for (let trial = 0; trial < 500; trial++) {
+    const a = Object.freeze(Array.from({ length: random(25) }, () => alphabet[random(alphabet.length)]));
+    const b = Object.freeze(Array.from({ length: random(25) }, () => alphabet[random(alphabet.length)]));
+    checkScript(a, b);
+    checkRoundtrip(a, b, random(6));
+  }
+});
+
+test('zero-length coordinates name the preceding line', () => {
+  const cases = [
+    [[], ['x'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['x'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'b'], ['x', 'a', 'b'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a', 'b'], ['a', 'x', 'b'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['a', 'b'], ['a', 'b', 'x'], { oldStart: 2, oldLines: 0, newStart: 3, newLines: 1, lines: ['+x'] }],
+    [['x', 'a', 'b'], ['a', 'b'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x', 'b'], ['a', 'b'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+    [['a', 'b', 'x'], ['a', 'b'], { oldStart: 3, oldLines: 1, newStart: 2, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, hunk] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [hunk]);
+    assert.deepEqual(applyHunks(a, [hunk]), b);
+  }
+});
+
+test('context windows merge when touching, without duplicating context', () => {
+  const a = ['A', 'one', 'two', 'B'];
+  const b = ['X', 'one', 'two', 'Y'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 4, newStart: 1, newLines: 4,
+    lines: ['-A', '+X', ' one', ' two', '-B', '+Y'],
+  }]);
+  assert.deepEqual(unifiedHunks(['A', 'one', 'two', 'three', 'B'],
+    ['X', 'one', 'two', 'three', 'Y'], { context: 1 }), [
+    { oldStart: 1, oldLines: 2, newStart: 1, newLines: 2, lines: ['-A', '+X', ' one'] },
+    { oldStart: 4, oldLines: 2, newStart: 4, newLines: 2, lines: [' three', '-B', '+Y'] },
+  ]);
+  assert.equal(unifiedHunks(a, b, { context: 0 }).length, 2);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  for (const context of [-1, 0.5, NaN, Infinity, '3', null]) {
+    assert.throws(() => unifiedHunks(a, b, { context }), RangeError);
+  }
+});
+
+test('application tracks original coordinates and earlier length changes', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd']);
+  const hunks = [
+    { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-b'] },
+    { oldStart: 4, oldLines: 1, newStart: 3, newLines: 1, lines: ['-d', '+D'] },
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['a', 'c', 'D']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(applyHunks(['-old', '+new', ''], [{
+    oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+    lines: [' -old', '-+new', '++replacement', ' '],
+  }]), ['-old', '+replacement', '']);
+});
+
+test('malformed and nonapplicable hunks fail with the correct index', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const malformed = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [''] },
+    { ...valid, lines: [42] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+B'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, oldStart: -1 },
+    { ...valid, oldStart: 5 }, { ...valid, oldStart: 1.5 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 3 },
+    { ...valid, oldLines: 2 }, { ...valid, oldLines: -1 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: Infinity },
+    { ...valid, oldStart: 4, oldLines: 2 },
+    { oldStart: 5, oldLines: 0, newStart: 6, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of malformed) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, { ...valid, oldStart: 1, newStart: 1 }]),
+    /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, { ...valid, oldStart: 4, lines: ['-d', '+D'] }]),
+    /hunk 1 does not apply/);
+  assert.deepEqual(a, ['a', 'b', 'c', 'd']);
+});
+
+test('small changes to 20,000-line files stay fast, including repetitive lines', t => {
+  for (const repetitive of [false, true]) {
+    const a = Object.freeze(Array.from({ length: 20000 }, (_, i) => repetitive ? 'repeat' : `line ${i}`));
+    const b = a.slice();
+    b.splice(100, 1, 'replacement');
+    b.splice(10000, 0, 'inserted');
+    b.splice(19000, 1);
+    Object.freeze(b);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const patched = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(patched, b);
+    assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `20,000-line roundtrip took ${elapsed.toFixed(1)}ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} lines: ${elapsed.toFixed(1)}ms`);
+    assert.deepEqual(unifiedHunks(a, a), []);
+  }
+});
+
+test('large single-sided patches need neither recursion nor argument spreading', () => {
+  const lines = Object.freeze(Array.from({ length: 20000 }, (_, i) => `line ${i}`));
+  checkRoundtrip([], lines, 0);
+  checkRoundtrip(lines, [], 0);
+});
