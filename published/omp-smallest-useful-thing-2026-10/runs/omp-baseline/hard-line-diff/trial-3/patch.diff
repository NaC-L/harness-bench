+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small reference oracle used only in tests, never on large inputs.
+function lcsLength(a, b) {
+  let previous = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const current = [0];
+    for (let j = 0; j < b.length; j++) {
+      current.push(line === b[j]
+        ? previous[j] + 1
+        : Math.max(previous[j + 1], current[j]));
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function checkPair(a, b) {
+  const beforeA = a.slice();
+  const beforeB = b.slice();
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  for (const context of [0, 1, 2, 3]) {
+    const hunks = unifiedHunks(a, b, { context });
+    const snapshot = JSON.stringify(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    assert.equal(JSON.stringify(hunks), snapshot);
+  }
+  assert.deepEqual(a, beforeA);
+  assert.deepEqual(b, beforeB);
+}
+
+test('exhaustive short repetitive inputs produce minimal, ordered roundtrips', () => {
+  const sequences = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(a => ['', 'x'].map(line => [...a, line]));
+    sequences.push(...level);
+  }
+  for (const a of sequences) {
+    for (const b of sequences) checkPair(a, b);
+  }
+});
+
+test('seeded repetitive and prefix-containing lines roundtrip', () => {
+  let state = 42;
+  const random = n => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % n;
+  };
+  const alphabet = ['', 'a', 'b', '+plus', '-minus', ' space'];
+  for (let trial = 0; trial < 300; trial++) {
+    const a = Array.from({ length: random(24) }, () => alphabet[random(alphabet.length)]);
+    const b = Array.from({ length: random(24) }, () => alphabet[random(alphabet.length)]);
+    checkPair(a, b);
+  }
+});
+
+test('zero-line coordinates at the top, middle, and end are preceding lines', () => {
+  const a = ['a', 'b'];
+  assert.deepEqual(unifiedHunks(a, ['top', 'a', 'middle', 'b', 'end'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 1, oldLines: 0, newStart: 3, newLines: 1, lines: ['+middle'] },
+    { oldStart: 2, oldLines: 0, newStart: 5, newLines: 1, lines: ['+end'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['top', 'a', 'middle', 'b', 'end'], a, { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-top'] },
+    { oldStart: 3, oldLines: 1, newStart: 1, newLines: 0, lines: ['-middle'] },
+    { oldStart: 5, oldLines: 1, newStart: 2, newLines: 0, lines: ['-end'] },
+  ]);
+});
+
+test('context touching merges exactly once; larger gaps remain separate', () => {
+  const a = ['first', 'one', 'two', 'last'];
+  const b = ['FIRST', 'one', 'two', 'LAST'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 4, newStart: 1, newLines: 4,
+    lines: ['-first', '+FIRST', ' one', ' two', '-last', '+LAST'],
+  }]);
+  const spacedA = ['first', 'one', 'two', 'three', 'last'];
+  const spacedB = ['FIRST', 'one', 'two', 'three', 'LAST'];
+  assert.deepEqual(unifiedHunks(spacedA, spacedB, { context: 1 }), [
+    { oldStart: 1, oldLines: 2, newStart: 1, newLines: 2,
+      lines: ['-first', '+FIRST', ' one'] },
+    { oldStart: 4, oldLines: 2, newStart: 4, newLines: 2,
+      lines: [' three', '-last', '+LAST'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('application rejects malformed hunks, mismatches, and inconsistent coordinates', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const malformed = [
+    null, {}, { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: 5 }, { ...valid, newStart: 3 },
+    { ...valid, oldLines: 2 }, { ...valid, newLines: 2 },
+    { ...valid, oldLines: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, newLines: NaN }, { ...valid, newStart: Infinity },
+    { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['-b', '-c', '+B'] },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of malformed) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const earlier = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] };
+  assert.throws(() => applyHunks(a, [valid, earlier]), /hunk 1 does not apply/);
+  assert.deepEqual(applyHunks(a, [valid]), ['a', 'B', 'c']);
+});
+
+test('application tracks prior offsets without mutating frozen inputs', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd']);
+  const b = Object.freeze(['start', 'a', 'B', 'extra', 'c']);
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  hunks.forEach(hunk => { Object.freeze(hunk.lines); Object.freeze(hunk); });
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(applyHunks(['-a', '+b', ' c', ''], [{
+    oldStart: 1, oldLines: 4, newStart: 1, newLines: 4,
+    lines: [' -a', ' +b', '  c', ' '],
+  }]), ['-a', '+b', ' c', '']);
+});
+
+test('small edits to 20,000-line unique and repetitive files are fast', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(10, 0, 'inserted');
+    b[10000] = 'replacement';
+    b.splice(19000, 1);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const applied = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(applied, b);
+    assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `20,000-line roundtrip took ${elapsed.toFixed(1)}ms`);
+  }
+});
