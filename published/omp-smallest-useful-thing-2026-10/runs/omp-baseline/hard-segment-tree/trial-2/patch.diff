+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./range-tree');
+
+test('assignment discards additions on both the overwritten node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 11);
+  tree.add(3, 7, -4);
+  tree.assign(0, 7, -8);
+  tree.add(0, 7, 2);
+  assert.equal(tree.sum(1, 6), -30);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-6));
+
+  tree.add(0, 7, 9);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  assert.equal(tree.get(4), -2);
+  assert.equal(tree.sum(0, 7), -14);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-2));
+});
+
+test('partial maxima remain negative, including singleton and uneven ranges', () => {
+  const tree = new RangeTree([-9, -8, -7, -6, -5]);
+  assert.equal(tree.max(1, 4), -6);
+  assert.equal(tree.max(0, 1), -9);
+  tree.assign(0, 5, -20);
+  tree.add(2, 5, 3);
+  assert.equal(tree.max(1, 4), -17);
+  assert.equal(tree.max(0, 2), -20);
+});
+
+test('threshold searches propagate lazy updates before inspecting children', () => {
+  const tree = new RangeTree([10, 9, 8, 7, 6, 5, 4]);
+  tree.assign(0, 7, -10);
+  tree.add(0, 7, 2);
+  // Search before any other query can push the pending tags.
+  assert.equal(tree.firstAtLeast(2, -5), -1);
+  assert.equal(tree.firstAtLeast(2, -8), 2);
+  tree.add(0, 7, 20);
+  assert.equal(tree.firstAtLeast(4, 12), 4);
+  tree.assign(0, 3, -30);
+  tree.assign(3, 7, 15);
+  assert.equal(tree.firstAtLeast(0, 15), 3);
+  assert.equal(tree.firstAtLeast(6, 15), 6);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+});
+
+test('validation, empty ranges, return values, and independent arrays preserve the API', () => {
+  for (const values of [[], null, {}, [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 1; }, TypeError);
+  assert.equal(tree.assign(0, 3, 7), undefined);
+  assert.equal(tree.add(0, 3, -2), undefined);
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 1], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+      assert.throws(() => tree[method](l, r, 6), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '2', null, undefined]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), [5, 5, 5]);
+  const output = tree.toArray();
+  output[0] = 100;
+  assert.deepEqual(tree.toArray(), [5, 5, 5]);
+});
+
+test('seeded mixed updates and queries agree with an independent array model', () => {
+  let seed = 0x12345678;
+  const random = (bound) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % bound;
+  };
+  for (const length of [1, 2, 3, 7, 8, 17, 32, 65]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 600; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      // Leave multiple updates pending, including full-range overwrites.
+      if (step % 7 === 0) [l, r] = [0, length];
+      const value = random(41) - 20;
+      const assigning = random(2) === 0;
+      tree[assigning ? 'assign' : 'add'](l, r, value);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      if (step % 3 !== 0) continue;
+
+      const lo = random(length + 1);
+      const threshold = random(81) - 40;
+      const expected = values.findIndex((v, i) => i >= lo && v >= threshold);
+      assert.equal(tree.firstAtLeast(lo, threshold), expected, `search n=${length} step=${step}`);
+      for (let query = 0; query < 5; query++) {
+        let a = random(length + 1);
+        let b = random(length + 1);
+        if (a > b) [a, b] = [b, a];
+        const slice = values.slice(a, b);
+        assert.equal(tree.sum(a, b), slice.reduce((sum, v) => sum + v, 0));
+        assert.equal(tree.max(a, b), Math.max(-Infinity, ...slice));
+      }
+      const i = random(length);
+      assert.equal(tree.get(i), values[i]);
+      if (step % 30 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
