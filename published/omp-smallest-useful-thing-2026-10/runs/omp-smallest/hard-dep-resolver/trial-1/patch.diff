+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('../src');
+const { compare, satisfies } = require('../src/semver');
+
+test('numeric candidate ordering covers every version component', () => {
+  const registry = { a: Object.fromEntries(['1.2.9', '1.2.10', '1.9.99', '1.10.0', '2.0.0'].map(v => [v, {}])) };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0' });
+  assert.deepEqual(resolve(registry, { a: '^1.0.0' }), { a: '1.10.0' });
+  assert.deepEqual(resolve(registry, { a: '~1.2.0' }), { a: '1.2.10' });
+});
+
+test('backtracking removes abandoned dependencies and restores earlier constraints', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0', abandoned: '*' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '2.0.0' });
+  const shared = {
+    a: { '1.0.0': { shared: '<2.0.0' } },
+    b: { '2.0.0': { shared: '2.0.0' }, '1.0.0': { shared: '*' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(shared, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0', shared: '1.0.0' });
+});
+
+test('partial appends are undone after immediate selected-version conflicts', () => {
+  const registry = {
+    a: { '1.0.0': {} },
+    b: { '3.0.0': { ghost: '*', a: '2.0.0' }, '2.0.0': { a: '2.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('first-found assignment uses FIFO discovery rather than recursive dependency order', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '2.0.0', c: '1.0.0' });
+  registry.a['2.0.0'] = { c: '*', b: '1.0.0' };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0', c: '2.0.0' });
+});
+
+test('cycles terminate, self-conflicts backtrack, and shared packages expand only once', () => {
+  assert.deepEqual(resolve({ a: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
