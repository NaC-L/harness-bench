+    a: { '2.0.0': { b: '2.0.0' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0' });
+  registry.a['1.0.0'] = { b: '1.0.0' };
+  registry.b['1.0.0'] = { a: '2.0.0' };
+  assert.equal(resolve(registry, { a: '*' }), null);
+  const diamond = {
+    a: { '1.0.0': { b: '*', c: '*' } },
+    b: { '1.0.0': { d: '*' } }, c: { '1.0.0': { d: '*' } },
+    d: { '1.0.0': { a: '*' } },
+  };
+  assert.deepEqual(resolve(diamond, { a: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0', d: '1.0.0' });
+});
+
+test('missing packages and incompatible roots are unsatisfiable, not malformed', () => {
+  assert.equal(resolve({}, { absent: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '>1.0.0' }), null);
+  assert.deepEqual(resolve({ unreachable: { '1.0.0': { absent: '*' } } }, {}), {});
+  assert.deepEqual(resolve({ a: { '1.0.0': {}, '2.0.0': { absent: '*' } } }, { a: '*' }), { a: '1.0.0' });
+});
+
+test('all registry maps, versions and ranges are validated even when unreachable', () => {
+  for (const malformed of [null, [], new Date(), Object.create({}), 1, 'map']) {
+    assert.throws(() => resolve(malformed, {}), TypeError);
+    assert.throws(() => resolve({}, malformed), TypeError);
+    assert.throws(() => resolve({ unused: malformed }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': malformed } }, {}), TypeError);
+  }
+  for (const version of ['1.2', '01.2.3', '1.2.3\n', '9007199254740992.0.0']) {
+    assert.throws(() => resolve({ unused: { [version]: {} } }, {}), TypeError);
+  }
+  for (const range of ['', 'bad', '^0.01.0', null]) {
+    assert.throws(() => resolve({ unused: { '1.0.0': { other: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { absent: range }), TypeError);
+  }
+});
+
+test('null-prototype and special-key maps work without mutating inputs', () => {
+  const names = ['__proto__', 'constructor', 'toString'];
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of names) {
+    const deps = Object.freeze(Object.create(null));
+    registry[name] = Object.freeze(Object.assign(Object.create(null), { '1.0.0': deps }));
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(root, 'ignored', { value: null });
+  root[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), names);
+  assert.deepEqual(result, Object.fromEntries(names.map(name => [name, '1.0.0'])));
+  assert.deepEqual(Object.keys(registry), names);
+  assert.deepEqual(Object.keys(root), names);
+});
+
+test('long cyclic chains use iterative search and prune candidates before deeper choices', () => {
+  const count = 15000;
+  const registry = {};
+  for (let i = 0; i < count; i += 1) {
+    const next = i + 1 === count ? 'p0' : `p${i + 1}`;
+    const deps = { [next]: i + 1 === count ? '*' : '1.0.0' };
+    registry[`p${i}`] = { '2.0.0': deps, '1.0.0': deps };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, count);
+  assert.equal(result.p0, '2.0.0');
+  for (let i = 1; i < count; i += 1) assert.equal(result[`p${i}`], '1.0.0');
+});
+
+// A deliberately small, copy-on-branch oracle independently checks first-found
+// ordering and rollback. Recursion here is bounded to four package choices.
+function referenceResolve(registry, root) {
+  function search(selected, pending) {
+    for (const [name, range] of pending) {
+      if (selected.has(name) && !satisfies(selected.get(name), range)) return null;
+    }
+    const next = pending.find(([name]) => !selected.has(name));
+    if (!next) return Object.fromEntries(selected);
+    const name = next[0];
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!pending.every(([other, range]) => other !== name || satisfies(version, range))) continue;
+      const result = search(new Map([...selected, [name, version]]), [...pending, ...Object.entries(registry[name][version])]);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(new Map(), Object.entries(root));
+}
+
+test('generated small cyclic registries match an independent first-found oracle', () => {
+  let seed = 123456789;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=2.0.0', '<2.0.0', '>3.0.0'];
+  for (let run = 0; run < 600; run += 1) {
+    const registry = {};
+    for (const name of names) {
+      const versions = registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        const deps = versions[version] = {};
+        for (let i = random(4); i > 0; i -= 1) {
+          deps[[...names, 'missing'][random(5)]] = ranges[random(ranges.length)];
+        }
+      }
+    }
+    const root = {};
+    for (let i = 1 + random(4); i > 0; i -= 1) root[names[random(4)]] = ranges[random(ranges.length)];
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `registry ${run}`);
+  }
+});
