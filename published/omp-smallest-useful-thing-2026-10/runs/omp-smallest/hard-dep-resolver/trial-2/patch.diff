@@ -0,0 +1,227 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { parse, compare, satisfies, compileRange } = require('./semver');
+
+test('versions are ordered numerically at every component', () => {
+  for (const versions of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10'],
+  ]) {
+    const registry = { a: Object.fromEntries(versions.map(version => [version, {}])) };
+    assert.deepEqual(resolve(registry, { a: '*' }), { a: versions[1] });
+    assert.equal(compare(...versions), -1);
+    assert.equal(compare(...versions.slice().reverse()), 1);
+  }
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+});
+
+test('ranges honor exact, AND, comparison, tilde, and zero-major caret boundaries', () => {
+  const cases = [
+    ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false],
+    ['1.2.3', '  >=1.2.0\t<2.0.0 *  ', true], ['2.0.0', '>=1.2.0 <2.0.0', false],
+    ['1.2.3', '>1.2.3', false], ['1.2.4', '>1.2.3', true],
+    ['1.2.3', '<=1.2.3', true], ['1.2.4', '<=1.2.3', false],
+    ['1.9.9', '^1.2.3', true], ['2.0.0', '^1.2.3', false],
+    ['1.2.9', '~1.2.3', true], ['1.3.0', '~1.2.3', false],
+    ['0.2.9', '^0.2.3', true], ['0.3.0', '^0.2.3', false],
+    ['0.2.2', '^0.2.3', false], ['0.0.3', '^0.0.3', true],
+    ['0.0.4', '^0.0.3', false], ['0.0.0', '^0.0.0', true],
+    ['0.0.1', '^0.0.0', false], ['0.0.9', '~0.0.3', true],
+    ['0.1.0', '~0.0.3', false],
+    ['9007199254740991.0.0', '^9007199254740991.0.0', true],
+    ['0.9007199254740991.0', '^0.9007199254740991.0', true],
+    ['0.0.9007199254740991', '^0.0.9007199254740991', true],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected, `${version} ${range} compiled`);
+  }
+});
+
+test('malformed versions and ranges throw TypeError eagerly', () => {
+  for (const version of [null, 1, '', '1.2', '01.2.3', '1.02.3', '1.2.03',
+    '-1.2.3', '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3\n', '9007199254740992.0.0']) {
+    assert.throws(() => parse(version), TypeError);
+    assert.throws(() => compare('1.0.0', version), TypeError);
+  }
+  for (const range of [null, 1, '', '  ', '^', '1.2', '>= 1.2.3', '==1.2.3',
+    '1.2.3 || 2.0.0', '* invalid', '^01.2.3']) {
+    assert.throws(() => compileRange(range), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': { missing: range } } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '1.0.0\n': {} } }, {}), TypeError);
+});
+
+test('map validation includes unreachable entries and empty roots', () => {
+  for (const invalid of [null, [], 1, 'map', new Date(), Object.create({})]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+  assert.equal(resolve({}, { missing: '*' }), null);
+});
+
+test('FIFO discovery, not dependency-first or global maximization, determines the first solution', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': {} },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '2.0.0', c: '1.0.0' });
+  const competing = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(competing, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(competing, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+});
+
+test('root and newly discovered constraints apply before choosing a queued package', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.equal(resolve(registry, { a: '*', b: '2.0.0' }), null);
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('backtracking removes abandoned constraints, selections, and pending discoveries', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0', missing: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': { abandoned: '*' }, '1.0.0': {} },
+    abandoned: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  const partial = {
+    a: { '2.0.0': {} },
+    b: { '2.0.0': { ghost: '*', a: '1.0.0', later: '*' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(partial, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('cycles expand each selected package only once and can backtrack', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('plain and null-prototype maps handle special names without mutating inputs', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.freeze({ '1.0.0': Object.freeze({}) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(root, 'ignored', { value: null });
+  root[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+  assert.equal(root.__proto__, '*');
+});
+
+test('long cyclic chains and deep backtracking do not depend on call-stack depth', () => {
+  const count = 15000;
+  const registry = {};
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % count}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, count);
+  assert.equal(result[`p${count - 1}`], '1.0.0');
+  registry[`p${count - 1}`]['1.0.0'] = { missing: '*' };
+  registry.p0['2.0.0'] = {};
+  assert.deepEqual(resolve(registry, { p0: '1.0.0' }), null);
+  registry.p0 = { '2.0.0': { p1: '*' }, '1.0.0': {} };
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '1.0.0' });
+});
+
+test('early selected conflicts prune branches instead of enumerating a Cartesian product', () => {
+  const registry = { anchor: { '1.0.0': {} } };
+  const root = { anchor: '*' };
+  for (let i = 0; i < 80; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { anchor: '2.0.0' }, '1.0.0': {} };
+    root[name] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.keys(result).length, 81);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+});
+
+// A copy-on-branch oracle is intentionally limited to tiny graphs. Unlike the
+// production trail, it cannot leak state from one candidate into the next.
+function referenceResolve(registry, root) {
+  function discover(state, deps) {
+    for (const [name, range] of Object.entries(deps)) {
+      state.queue.push(name);
+      state.constraints.set(name, [...(state.constraints.get(name) || []), range]);
+      if (state.selected.has(name) && !satisfies(state.selected.get(name), range)) return false;
+    }
+    return true;
+  }
+  function search(state) {
+    while (state.cursor < state.queue.length) {
+      const name = state.queue[state.cursor++];
+      if (state.selected.has(name)) continue;
+      const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+      for (const version of versions) {
+        if (!state.constraints.get(name).every(range => satisfies(version, range))) continue;
+        const branch = {
+          queue: state.queue.slice(), cursor: state.cursor,
+          selected: new Map(state.selected), constraints: new Map(state.constraints),
+        };
+        branch.selected.set(name, version);
+        if (!discover(branch, registry[name][version])) continue;
+        const result = search(branch);
+        if (result !== null) return result;
+      }
+      return null;
+    }
+    return Object.fromEntries(state.selected);
+  }
+  const state = { queue: [], cursor: 0, selected: new Map(), constraints: new Map() };
+  discover(state, root);
+  return search(state);
+}
+
+test('first-found assignments match an independent oracle across generated cyclic graphs', () => {
+  let seed = 1729;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=1.0.0 <2.0.0'];
+  for (let trial = 0; trial < 400; trial += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0']) {
+        const deps = {};
+        for (const target of [...names, 'missing']) {
+          if (random(5) === 0) deps[target] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names) {
+      if (random(3) !== 0) root[name] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `trial ${trial}`);
+  }
+});
