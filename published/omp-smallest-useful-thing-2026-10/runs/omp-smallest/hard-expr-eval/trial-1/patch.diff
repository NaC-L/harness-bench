@@ -0,0 +1,145 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('numbers, arithmetic precedence and associativity', () => {
+  const cases = [
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['10 - 3 - 2', 5],
+    ['20 / 2 * 3', 30],
+    ['20 // 3 % 4 * 2', 4],
+    ['2 + 3 * 4', 14],
+    ['(2 + 3) * 4', 20],
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['3 * -2 ** 2', -12],
+    ['--2 ** 2', 4],
+    ['2 ** +3', 8],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo agree across signs and normalize zero', () => {
+  for (let a = -15; a <= 15; a++) {
+    for (let b = -7; b <= 7; b++) {
+      if (!b) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      assert.ok(remainder === 0 || (remainder < 0) === (b < 0));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+    }
+  }
+  const cases = [
+    ['-5.5 // 2', -3], ['-5.5 % 2', 0.5],
+    ['5.5 % -2', -0.5], ['1 // 0.1', 9],
+    ['-1e-100 // 1e100', -1], ['-0 // 3', 0], ['-0 % 3', 0],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('comparisons chain, preserve booleans and coerce them in arithmetic', () => {
+  const cases = [
+    ['3 < 2 < 1', false], ['1 < 2 <= 2 != 3', true],
+    ['4 > 3 >= 3 == 3', true], ['1 == 2 == 0', false],
+    ['1 < 2 + 3 * 4', true], ['(1 < 2) + 4', 5],
+    ['(1 > 2) * 10', 0], ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true], ['(1 < 2) < 2', true],
+    ['1 < (2 < 3)', false], ['(1 < 2) ** 3', 1],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+  assert.equal(evaluate('3 < 2 < unknown'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+});
+
+test('variables and call arguments are read once in left-to-right order', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, { get() { reads.push(name); return value; } });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('a > b < c', variables), false);
+  assert.deepEqual(reads.splice(0), ['a', 'b']);
+  assert.equal(evaluate('a + b * c - a', variables), 6);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'a']);
+  assert.equal(evaluate('max(a, min(b, c), abs(-d))', variables), 4);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  let occurrence = 0;
+  assert.equal(evaluate('x < x < x', { get x() { return ++occurrence; } }), true);
+  assert.equal(occurrence, 3);
+  assert.equal(evaluate('min + _amount2', { min: 3, _amount2: 5 }), 8);
+  errorAt(' inherited', 2, Object.create({ inherited: 7 }));
+});
+
+test('built-ins handle nested expressions, booleans and first-argument ties', () => {
+  assert.equal(evaluate('min(7, 2, 4)'), 2);
+  assert.equal(evaluate('max(-7, -2, -4)'), -2);
+  assert.equal(evaluate('abs(-3 ** 2)'), 9);
+  assert.equal(evaluate('abs(1 < 2)'), 1);
+  assert.equal(evaluate('min(1 < 2, 2)'), true);
+  assert.equal(evaluate('max(1 > 2, -1)'), false);
+  assert.ok(Object.is(evaluate('min(0, -0)'), 0));
+  assert.ok(Object.is(evaluate('max(-0, 0)'), -0));
+  assert.equal(evaluate('min(1, nan)', { nan: NaN }), 1);
+});
+
+test('errors point at token starts after whitespace and at the complete source end', () => {
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`  7   ${operator} -0`, 7);
+  }
+  for (const [source, column] of [
+    ['   missing', 4], ['  @', 3], ['1 +   @', 7], ['1 +  😀', 6],
+    ['1   2', 5], ['1 +   * 2', 7], ['  )', 3],
+    ['', 1], [' \t ', 4], ['1 +   ', 7], ['(1 + 2  ', 9],
+    ['2(3)', 2], ['1 = 2', 3], ['1 ! 2', 3],
+    ['1e+', 2], ['.', 1], ['abs(1,)', 7], ['min(,1)', 5],
+    ['  unknown(1)', 3], ['  abs()', 3], ['  abs(1, 2)', 3],
+    ['  min()', 3], ['  max()', 3],
+  ]) errorAt(source, column);
+});
+
+test('the entire source is parsed before getters or short circuiting', () => {
+  let reads = 0;
+  const variables = { get x() { reads++; return 1; } };
+  for (const source of ['x +', 'x + mystery(1)', 'x + abs(1, 2)', 'x > 2 < abs()', 'x > 2 < (3 + )']) {
+    assert.throws(() => evaluate(source, variables), ExprError);
+  }
+  assert.equal(reads, 0);
+});
+
+test('100,001-operand arithmetic and comparison chains do not grow the call stack', t => {
+  const count = 100001;
+  const arithmetic = Array(count).fill('1').join(' + ');
+  let start = performance.now();
+  assert.equal(evaluate(arithmetic), count);
+  t.diagnostic(`arithmetic: ${(performance.now() - start).toFixed(1)} ms`);
+  const comparisons = Array(count).fill('x').join(' <= ');
+  let reads = 0;
+  start = performance.now();
+  assert.equal(evaluate(comparisons, { get x() { reads++; return 1; } }), true);
+  assert.equal(reads, count);
+  t.diagnostic(`comparisons: ${(performance.now() - start).toFixed(1)} ms`);
+  const argumentsList = Array(count).fill('1').join(',');
+  assert.equal(evaluate(`max(${argumentsList})`), 1);
+});
