@@ -0,0 +1,154 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError, source);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('arithmetic precedence and associativity follow the documented grammar', () => {
+  const cases = [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625],
+    ['--2 ** 2', 4],
+    ['3 * -2 ** 2', -12],
+    ['2 * 3 ** 2 + 4', 22],
+    ['20 / 2 * 3', 30],
+    ['20 - 5 - 3', 12],
+    ['20 // 3 % 4 * 2', 4],
+    ['1.5e-3 + .5 + 5. + 2E+1', 25.5015],
+    ['abs(-3) + min(4, 2, 8) * max(1, 5)', 13],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo handle signs, fractions and positive zero', () => {
+  for (let a = -15; a <= 15; a += 1) {
+    for (let b = -5; b <= 5; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      assert.ok(remainder === 0 || (remainder < 0) === (b < 0));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`  1  ${operator} -0`, 6);
+    errorAt(`  1  ${operator} (2 - 2)`, 6);
+  }
+});
+
+test('comparisons chain and coerce booleans numerically in arithmetic and equality', () => {
+  const cases = [
+    ['1 < 2 < 3', true],
+    ['3 < 2 < 1', false],
+    ['1 < 3 > 2 == 2 != 4 >= 3', true],
+    ['1 + 2 * 3 == 7', true],
+    ['(1 < 2) + (3 < 2)', 1],
+    ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true],
+    ['(1 < 2) < 2', true],
+    ['(3 < 2) < 1', true],
+    ['min(1 < 2, 2 < 1)', 0],
+    ['abs(-(1 < 2))', 1],
+    ['3 < 2 < missing', false],
+    ['3 < 2 < (1 / 0)', false],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('variables and call arguments are read once in left-to-right order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 123 });
+  for (const [name, value] of Object.entries({ a: 1, b: 2, c: 3, d: 4 })) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+      enumerable: true,
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('c < b < d', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('max(a + b, abs(-c), min(d, a))', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd', 'a']);
+  assert.equal(evaluate('a + a * b', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'a', 'b']);
+  errorAt('  inherited', 3, variables);
+  assert.equal(evaluate('_x2', { _x2: 7 }), 7);
+});
+
+test('the entire formula is parsed before evaluation, even after a false comparison', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 0; } };
+  const cases = [
+    ['a < -1 < nope(2)', 10],
+    ['a + abs()', 5],
+    ['a + max()', 5],
+    ['a + min()', 5],
+    ['a + abs(1, 2)', 5],
+    ['a < -1 < min(1,)', 16],
+  ];
+  for (const [source, column] of cases) errorAt(source, column, variables);
+  errorAt('a + 2 3', 7, variables);
+  assert.equal(reads, 0);
+});
+
+test('error columns identify tokens after whitespace and use UTF-16 offsets', () => {
+  const cases = [
+    ['  missing', 3],
+    ['1 +\t unknown', 6],
+    ['1 +   @', 7],
+    ['1 +   😀', 7],
+    ['1 + \n\t', 7],
+    ['(1 + 2   ', 10],
+    ['   ', 4],
+    ['', 1],
+    ['1  2', 4],
+    ['2 (3)', 3],
+    ['min(1, )', 8],
+    ['min(,1)', 5],
+    ['abs(1 2)', 7],
+    ['  mystery(1)', 3],
+    ['  abs(1, 2)', 3],
+    ['  min()', 3],
+    ['1 +   )', 7],
+    ['1 = 1', 3],
+    ['1 ! 2', 3],
+  ];
+  for (const [source, column] of cases) errorAt(source, column);
+});
+
+test('100,001-operand arithmetic and comparison chains remain iterative and fast', () => {
+  const count = 100001;
+  const cases = [
+    [Array(count).fill('1').join(' + '), count],
+    [Array(count).fill('1').join(' * '), 1],
+    [Array(count).fill('1').join(' <= '), true],
+    [`2 < 1 < ${Array(count).fill('missing').join(' < ')}`, false],
+  ];
+  for (const [source, expected] of cases) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected);
+    assert.ok(performance.now() - start < 1000, 'long chain should evaluate in under a second');
+  }
+});
