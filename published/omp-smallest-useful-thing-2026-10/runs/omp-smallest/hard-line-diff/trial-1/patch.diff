+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small quadratic oracle is deliberately confined to test inputs.
+function editDistance(a, b) {
+  let previous = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 1; i <= a.length; i++) {
+    const current = [i];
+    for (let j = 1; j <= b.length; j++) {
+      current[j] = a[i - 1] === b[j - 1]
+        ? previous[j - 1]
+        : Math.min(previous[j] + 1, current[j - 1] + 1);
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function checkPair(a, b) {
+  Object.freeze(a);
+  Object.freeze(b);
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length, editDistance(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+    if (entry.op === 'insert') inserted = true;
+  }
+  for (const context of [0, 1, 2, 10]) {
+    const hunks = unifiedHunks(a, b, { context });
+    for (const hunk of hunks) {
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+    }
+    Object.freeze(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+}
+
+test('minimal, deterministic scripts and patch roundtrips for exhaustive repeated lines', () => {
+  const inputs = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'x'].map(line => [...lines, line]));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) checkPair(a, b);
+  }
+});
+
+test('seeded varied scripts preserve empty lines and literal patch prefixes', () => {
+  let seed = 12345;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  const alphabet = ['', '-', '+', ' ', 'repeat', '-content', '+content'];
+  for (let i = 0; i < 400; i++) {
+    const a = Array.from({ length: random(25) }, () => alphabet[random(alphabet.length)]);
+    const b = Array.from({ length: random(25) }, () => alphabet[random(alphabet.length)]);
+    checkPair(a, b);
+  }
+});
+
+test('zero-line ranges use the preceding line at both file boundaries', () => {
+  assert.deepEqual(unifiedHunks([], ['+a'], { context: 0 }), [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['++a'],
+  }]);
+  assert.deepEqual(unifiedHunks(['-a'], [], { context: 0 }), [{
+    oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['--a'],
+  }]);
+  assert.deepEqual(unifiedHunks(['a'], ['a', 'b'], { context: 0 }), [{
+    oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+b'],
+  }]);
+  assert.deepEqual(unifiedHunks(['a', 'b'], ['a'], { context: 0 }), [{
+    oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-b'],
+  }]);
+  assert.deepEqual(unifiedHunks(['a'], ['b', 'a'], { context: 0 }), [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+b'],
+  }]);
+  assert.deepEqual(unifiedHunks(['b', 'a'], ['a'], { context: 0 }), [{
+    oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-b'],
+  }]);
+});
+
+test('context touches merge, but a larger unchanged gap separates hunks', () => {
+  const a = ['top', 'old1', 'gap1', 'gap2', 'old2', 'bottom'];
+  const b = ['top', 'new1', 'gap1', 'gap2', 'new2', 'bottom'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' top', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' bottom'],
+  }]);
+  a.splice(4, 0, 'gap3');
+  b.splice(4, 0, 'gap3');
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+      lines: [' top', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+      lines: [' gap3', '-old2', '+new2', ' bottom'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  assert.deepEqual(unifiedHunks(a, b), [{
+    oldStart: 1, oldLines: 7, newStart: 1, newLines: 7,
+    lines: [' top', '-old1', '+new1', ' gap1', ' gap2', ' gap3', '-old2', '+new2', ' bottom'],
+  }]);
+});
+
+test('hunk coordinates account for previous insertions and deletions', () => {
+  const a = ['a', 'b', 'c', 'd', 'e'];
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 2, oldLines: 1, newStart: 3, newLines: 0, lines: ['-b'] },
+    { oldStart: 5, oldLines: 1, newStart: 6, newLines: 2, lines: ['-e', '+z', '+w'] },
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['x', 'y', 'a', 'c', 'd', 'z', 'w']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('application rejects mismatches, invalid counts, coordinates and lines', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {},
+    { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 5 },
+    { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: NaN },
+    { ...valid, oldLines: -1 },
+    { ...valid, oldLines: 2 },
+    { ...valid, newStart: 0 },
+    { ...valid, newStart: 3 },
+    { ...valid, newLines: 0 },
+    { ...valid, newLines: 2 },
+    { ...valid, lines: null },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] },
+    { ...valid, lines: [null] },
+    { ...valid, lines: [] },
+    { ...valid, lines: ['-b', '-c', '+B'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' wrong'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+});
+
+test('small distant changes in 20,000 lines remain minimal and roundtrip', () => {
+  const a = Array.from({ length: 20000 }, (_, i) => `line ${i}`);
+  const b = a.slice();
+  b.splice(19000, 1);
+  b.splice(10000, 1, 'replacement');
+  b.splice(10, 0, 'insertion');
+  assert.equal(diffLines(a, b).filter(entry => entry.op !== 'equal').length, 4);
+  const hunks = unifiedHunks(a, b);
+  assert.equal(hunks.length, 3);
+  assert.deepEqual(applyHunks(a, hunks), b);
+});
