+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small, independent oracle used only for exhaustive short-input checks.
+function lcsLength(a, b) {
+  let previous = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const row = [0];
+    for (let j = 0; j < b.length; j++) {
+      row.push(line === b[j] ? previous[j] + 1 : Math.max(previous[j + 1], row[j]));
+    }
+    previous = row;
+  }
+  return previous[b.length];
+}
+
+function verifyScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserting = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserting = false;
+    if (entry.op === 'insert') inserting = true;
+    if (entry.op === 'delete') assert.equal(inserting, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('exhaustive repetitive and empty lines: minimal scripts and patch roundtrips', () => {
+  const alphabet = ['', '+same', '-same'];
+  const inputs = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(prefix => alphabet.map(line => Object.freeze([...prefix, line])));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      verifyScript(a, b);
+      for (const context of [0, 1, 2, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        assert.deepEqual(applyHunks(a, Object.freeze(hunks)), b);
+      }
+    }
+  }
+});
+
+test('zero-line coordinates refer to the preceding line in the complete file', () => {
+  const a = ['a', 'b', 'c', 'd', 'e'];
+  const b = ['top', 'a', 'c', 'd', 'e', 'end'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 2, oldLines: 1, newStart: 2, newLines: 0, lines: ['-b'] },
+    { oldStart: 5, oldLines: 0, newStart: 6, newLines: 1, lines: ['+end'] },
+  ]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(unifiedHunks(['a'], [], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-a'] },
+  ]);
+  assert.deepEqual(unifiedHunks([], ['a'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+a'] },
+  ]);
+});
+
+test('touching context merges, while wider gaps keep full-file coordinates', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i'];
+  const merged = unifiedHunks(a, ['a', 'B', 'c', 'd', 'E', 'f', 'g', 'H', 'i'], { context: 1 });
+  assert.deepEqual(merged, [{
+    oldStart: 1, oldLines: 9, newStart: 1, newLines: 9,
+    lines: [' a', '-b', '+B', ' c', ' d', '-e', '+E', ' f', ' g', '-h', '+H', ' i'],
+  }]);
+  assert.deepEqual(unifiedHunks(a, ['a', 'B', 'c', 'd', 'e', 'F', 'g', 'h', 'i'], { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: [' a', '-b', '+B', ' c'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3, lines: [' e', '-f', '+F', ' g'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('application verifies content, counts, coordinates, ordering, and prefixes', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  for (const malformed of [
+    null, undefined, [], {},
+    { ...valid, oldStart: -1 },
+    { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: Infinity },
+    { ...valid, oldLines: -1 },
+    { ...valid, oldLines: 2 },
+    { ...valid, newStart: 0 },
+    { ...valid, newStart: 3 },
+    { ...valid, newLines: 0 },
+    { ...valid, newLines: 2 },
+    { ...valid, lines: null },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] },
+    { ...valid, lines: [null] },
+    { ...valid, oldStart: 4, newStart: 4 },
+    { ...valid, oldLines: 0, newLines: 0, oldStart: 4, newStart: 4, lines: [] },
+  ]) {
+    assert.throws(() => applyHunks(a, [malformed]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const top = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] };
+  assert.throws(() => applyHunks(a, [top, valid]), /hunk 1 does not apply/);
+  assert.deepEqual(applyHunks(a, [top, { ...valid, newStart: 3 }]), ['top', 'a', 'B', 'c']);
+  assert.deepEqual(applyHunks([], [top, { ...top, newStart: 2 }]), ['top', 'top']);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+});
+
+test('prefix characters are removed exactly once and input text is preserved', () => {
+  const a = Object.freeze([' leading', '-old', '+kept', '', 'trailing\r']);
+  const b = Object.freeze([' leading', '+new', '+kept', '', 'trailing\r', '-end']);
+  assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+  for (const context of [-1, 0.5, NaN, Infinity, '3']) {
+    assert.throws(() => unifiedHunks(a, b, { context }), RangeError);
+  }
+});
+
+test('small changes to 20,000-line files remain fast, including repetitive inputs', t => {
+  for (const repetitive of [false, true]) {
+    const a = Object.freeze(Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`));
+    const b = a.slice();
+    b.splice(10, 1, 'changed near top');
+    b.splice(10000, 0, 'inserted in middle');
+    b.splice(19990, 1);
+    Object.freeze(b);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const patched = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(patched, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `small diff took ${elapsed.toFixed(1)} ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} lines: ${elapsed.toFixed(1)} ms`);
+  }
+});
