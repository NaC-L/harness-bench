@@ -0,0 +1,179 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('../src/range-tree');
+
+test('assignment discards additions at both the assigned node and stale descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(0, 7, 4);
+  tree.assign(0, 7, -8);
+  tree.add(0, 7, 3);
+  tree.assign(0, 7, 0);
+  tree.add(2, 6, -2);
+  assert.equal(tree.sum(0, 7), -8);
+  assert.equal(tree.sum(1, 5), -6);
+  assert.equal(tree.get(2), -2);
+  assert.deepEqual(tree.toArray(), [0, 0, -2, -2, -2, -2, 0]);
+});
+
+test('partial maxima use the negative-infinity identity', () => {
+  const tree = new RangeTree([-9, -7, -4, -11, -5]);
+  assert.equal(tree.max(0, 3), -4);
+  assert.equal(tree.max(3, 5), -5);
+  assert.equal(tree.max(3, 4), -11);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 6);
+  assert.equal(tree.max(0, 2), -14);
+  assert.equal(tree.max(4, 5), -20);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold search pushes assignments and positive or negative additions', () => {
+  const tree = new RangeTree([-10, -9, -8, -7, -6, -5, -4]);
+  tree.add(0, 7, 20);
+  assert.equal(tree.firstAtLeast(0, 12), 2);
+  tree.assign(0, 7, 30);
+  assert.equal(tree.firstAtLeast(3, 30), 3);
+  tree.add(0, 7, -40);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  assert.equal(tree.firstAtLeast(4, -10), 4);
+  tree.assign(1, 6, 8);
+  tree.add(0, 7, 2);
+  assert.equal(tree.firstAtLeast(2, 10), 2);
+  assert.equal(tree.firstAtLeast(6, 10), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), 5);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+});
+
+test('mixed updates and queries agree with a seeded plain-array model', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  // Integer values avoid differences caused solely by floating-point grouping.
+  for (const n of [1, 2, 3, 5, 8, 17, 31, 64, 97]) {
+    const values = Array.from({ length: n }, () => random(101) - 50);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 1000; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      // Accumulate lazy tags between queries, including repeated full updates.
+      if (step % 5 === 0) [l, r] = [0, n];
+      const value = random(101) - 50;
+      const assigning = random(3) === 0;
+      assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+
+      if (step % 3 !== 0) continue;
+      const lo = random(n + 1);
+      const threshold = random(201) - 100;
+      // Search first so other queries cannot repair stale descendants for it.
+      assert.equal(tree.firstAtLeast(lo, threshold),
+        values.findIndex((v, i) => i >= lo && v >= threshold), `search n=${n} step=${step}`);
+      let a = random(n + 1);
+      let b = random(n + 1);
+      if (a > b) [a, b] = [b, a];
+      const slice = values.slice(a, b);
+      assert.equal(tree.sum(a, b), slice.reduce((sum, v) => sum + v, 0), `sum n=${n} step=${step}`);
+      assert.equal(tree.max(a, b), Math.max(...slice), `max n=${n} step=${step}`);
+      const i = random(n);
+      assert.equal(tree.get(i), values[i]);
+      if (step % 51 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, read-only length and independent arrays retain their contract', () => {
+  for (const input of [null, undefined, [], {}, '123', new Float64Array([1]),
+    [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1.5, -2.25, 3.75];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 8; }, TypeError);
+  tree.add(0, 3, 0.5);
+  const expected = [2, -1.75, 4.25];
+  for (const [l, r] of [[-1, 1], [0, 4], [2, 1], [0.5, 2], [0, 2.5],
+    [NaN, 2], [0, Infinity], ['0', 2], [0, undefined]]) {
+    for (const method of ['sum', 'max', 'assign', 'add']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined, {}, 1n]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', null, undefined, {}, 1n]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 7), undefined);
+    assert.equal(tree.add(i, i, 7), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), expected);
+  const copy = tree.toArray();
+  copy[1] = 100;
+  assert.deepEqual(tree.toArray(), expected);
+  assert.equal(tree.sum(0, 3), 4.5);
+  assert.equal(tree.max(0, 3), 4.25);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+  assert.equal(tree.firstAtLeast(3, -Infinity), -1);
+});
+
+test('tree traversal stays logarithmic for operations and linear for construction and export', () => {
+  const n = 4093;
+  let builds = 0;
+  class CountingTree extends RangeTree {
+    _build(...args) {
+      builds++;
+      return super._build(...args);
+    }
+  }
+  const tree = new CountingTree(Array.from({ length: n }, (_, i) => -i));
+  assert.equal(builds, 2 * n - 1);
+  let visits = 0;
+  for (const method of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[method];
+    tree[method] = function (...args) {
+      visits++;
+      return original.apply(this, args);
+    };
+  }
+  const logarithmic = operation => {
+    visits = 0;
+    operation();
+    assert.ok(visits <= 8 * Math.ceil(Math.log2(n)) + 1, `visited ${visits} nodes`);
+  };
+  logarithmic(() => tree.assign(0, n, -10));
+  logarithmic(() => tree.add(0, n, 2));
+  logarithmic(() => tree.assign(17, n - 29, -4));
+  logarithmic(() => tree.add(33, n - 15, 3));
+  logarithmic(() => assert.equal(tree.sum(33, n - 29), -(n - 62)));
+  logarithmic(() => assert.equal(tree.max(31, n - 17), -1));
+  logarithmic(() => assert.equal(tree.get(n - 30), -1));
+  logarithmic(() => assert.equal(tree.firstAtLeast(0, -1), 33));
+  logarithmic(() => assert.equal(tree.firstAtLeast(n - 29, -1), -1));
+  logarithmic(() => assert.equal(tree.firstAtLeast(n, -Infinity), -1));
+  visits = 0;
+  assert.equal(tree.toArray().length, n);
+  assert.equal(visits, 2 * n - 1);
+});
