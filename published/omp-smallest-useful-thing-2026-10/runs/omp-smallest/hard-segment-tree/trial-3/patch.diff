@@ -0,0 +1,127 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both the assigned node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(3, 7, -10);
+  tree.add(0, 7, 5);
+  tree.assign(0, 7, -4);
+  tree.add(0, 7, 2);
+  assert.equal(tree.sum(1, 6), -10);
+  tree.assign(2, 5, 0);
+  tree.add(3, 6, 7);
+  assert.deepEqual(tree.toArray(), [-2, -2, 0, 7, 7, 5, -2]);
+});
+
+test('partial maxima use the identity for negative values', () => {
+  const tree = new RangeTree([-9, -7, -5, -3, -1]);
+  assert.equal(tree.max(0, 2), -7);
+  assert.equal(tree.max(2, 4), -3);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, -3);
+  assert.equal(tree.max(1, 4), -23);
+  assert.equal(tree.max(0, 0), -Infinity);
+});
+
+test('threshold search propagates assignments and additions before descending', () => {
+  const tree = new RangeTree([1, 9, 2, 8, 3, 7, 4]);
+  tree.assign(0, 7, 5);
+  assert.equal(tree.firstAtLeast(0, 5), 0);
+  assert.equal(tree.firstAtLeast(2, 6), -1);
+  tree.add(0, 7, 10);
+  assert.equal(tree.firstAtLeast(3, 15), 3);
+  tree.assign(0, 3, -10);
+  tree.add(3, 7, -20);
+  assert.equal(tree.firstAtLeast(0, -5), 3);
+  assert.equal(tree.firstAtLeast(4, -5), 4);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(6, -Infinity), 6);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+});
+
+test('mixed updates and queries match an array across varied tree shapes', () => {
+  let state = 0x12345678;
+  const random = (limit) => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return (state >>> 8) % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 31, 64]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 300; step++) {
+      const a = random(n + 1);
+      const b = random(n + 1);
+      const l = step % 7 === 0 ? 0 : Math.min(a, b);
+      const r = step % 7 === 0 ? n : Math.max(a, b);
+      const value = random(41) - 20;
+      const assigning = random(2) === 0;
+      assert.equal(tree[assigning ? 'assign' : 'add'](l, r, value), undefined);
+      for (let i = l; i < r; i++) {
+        values[i] = assigning ? value : values[i] + value;
+      }
+      // Search first, so a preceding materialization cannot hide stale tags.
+      for (let query = 0; query < 5; query++) {
+        const lo = random(n + 1);
+        const threshold = random(81) - 40;
+        assert.equal(tree.firstAtLeast(lo, threshold),
+          values.findIndex((v, i) => i >= lo && v >= threshold));
+        const c = random(n + 1);
+        const d = random(n + 1);
+        const slice = values.slice(Math.min(c, d), Math.max(c, d));
+        assert.equal(tree.sum(Math.min(c, d), Math.max(c, d)),
+          slice.reduce((sum, v) => sum + v, 0));
+        assert.equal(tree.max(Math.min(c, d), Math.max(c, d)), Math.max(...slice));
+        const index = random(n);
+        assert.equal(tree.get(index), values[index]);
+      }
+      if (step % 17 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, read-only length, and array independence are preserved', () => {
+  for (const input of [undefined, null, {}, [], [NaN], [Infinity], ['1'], Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  const copy = tree.toArray();
+  copy[1] = 100;
+  assert.deepEqual(tree.toArray(), [1, 2, 3]);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  tree.add(0, 3, 4);
+  for (const [l, r] of [[-1, 1], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 100), undefined);
+    assert.equal(tree.add(i, i, 100), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), [5, 6, 7]);
+});
