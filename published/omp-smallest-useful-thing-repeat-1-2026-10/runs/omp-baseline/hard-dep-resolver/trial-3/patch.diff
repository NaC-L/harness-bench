+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { parse, compare, satisfies, compileRange } = require('./semver');
+
+const MAX = Number.MAX_SAFE_INTEGER;
+
+test('versions are canonical safe integers and compare numerically', () => {
+  assert.deepEqual(parse(`0.${MAX}.12`), [0, MAX, 12]);
+  for (const version of [null, 1, new String('1.2.3'), '', '1.2', '01.2.3',
+    '1.02.3', '1.2.03', '-1.2.3', '1.2.3-alpha', '1.2.3+build',
+    ' 1.2.3', '1.2.3 ', '1.2.3\n', '1.2.3\r\n', `${MAX + 1}.0.0`]) {
+    assert.throws(() => parse(version), TypeError);
+  }
+  assert.equal(compare('1.10.0', '1.9.99'), 1);
+  assert.equal(compare('2.0.0', '10.0.0'), -1);
+  assert.equal(compare('1.0.10', '1.0.9'), 1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+  assert.throws(() => compare('1.2.3', 'bad'), TypeError);
+});
+
+test('range operators, whitespace, and AND terms retain their API', () => {
+  const cases = [
+    ['1.2.3', '*', true], ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false],
+    ['1.2.3', '>=1.2.3', true], ['1.2.3', '>1.2.3', false],
+    ['1.2.3', '<=1.2.3', true], ['1.2.3', '<1.2.3', false],
+    ['1.2.4', '>1.2.3', true], ['1.2.2', '<1.2.3', true],
+    ['1.9.0', ' \t>=1.2.3\n<2.0.0 * ', true],
+    ['2.0.0', '>=1.2.3 <2.0.0', false], ['1.0.0', '>2.0.0 <1.0.0', false],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected);
+  }
+  for (const range of [null, 1, '', ' \t\n', '^', '~', '>=', '=1.2.3',
+    '1.2', '>= 1.2.3', '1.2.3 || 2.0.0', '* nope', '^01.2.3']) {
+    assert.throws(() => compileRange(range), TypeError);
+  }
+});
+
+test('caret and tilde upper bounds respect zero majors and safe integer limits', () => {
+  const cases = [
+    ['1.9.9', '^1.2.3', true], ['2.0.0', '^1.2.3', false],
+    ['1.2.2', '^1.2.3', false], ['0.2.9', '^0.2.3', true],
+    ['0.3.0', '^0.2.3', false], ['0.2.2', '^0.2.3', false],
+    ['0.0.3', '^0.0.3', true], ['0.0.4', '^0.0.3', false],
+    ['0.0.0', '^0.0.0', true], ['0.0.1', '^0.0.0', false],
+    ['1.2.99', '~1.2.3', true], ['1.3.0', '~1.2.3', false],
+    ['0.0.9', '~0.0.3', true], ['0.1.0', '~0.0.3', false],
+    [`${MAX}.${MAX}.${MAX}`, `^${MAX}.0.0`, true],
+    [`0.${MAX}.${MAX}`, `^0.${MAX}.0`, true],
+    [`0.0.${MAX}`, `^0.0.${MAX}`, true],
+    [`1.${MAX}.${MAX}`, `~1.${MAX}.0`, true],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+  }
+});
+
+test('resolver selects numeric maxima in every version component', () => {
+  for (const versions of [['1.9.0', '1.10.0'], ['9.0.0', '10.0.0'], ['1.0.9', '1.0.10']]) {
+    assert.deepEqual(resolve({ a: Object.fromEntries(versions.map(v => [v, {}])) }, { a: '*' }),
+      { a: versions[1] });
+  }
+  assert.deepEqual(resolve({ a: { '0.2.9': {}, '0.3.0': {} } }, { a: '^0.2.3' }), { a: '0.2.9' });
+});
+
+test('FIFO discovery collects constraints before choosing a pending dependency', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '2.0.0', c: '1.0.0' });
+  assert.deepEqual(resolve(registry, { a: '*', c: '1.0.0' }), { a: '2.0.0', c: '1.0.0' });
+});
+
+test('first-found follows root and dependency key order, not global maximization', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+    entry: { '1.0.0': { a: '*', b: '*' } },
+    reversed: { '1.0.0': { b: '*', a: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+  assert.deepEqual(resolve(registry, { entry: '*' }), { entry: '1.0.0', a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { reversed: '*' }), { reversed: '1.0.0', b: '2.0.0', a: '1.0.0' });
+});
+
+test('partial dependency batches are undone on immediate conflicts', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { ghost: '*', a: '1.0.0', never: '*' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('backtracking removes descendant selections, queue entries, and constraints', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*', c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    b: { '2.0.0': { missing: '*' }, '1.0.0': { missing: '*' } },
+    c: { '1.0.0': {}, '2.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', c: '2.0.0' });
+  assert.deepEqual(resolve({ a: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {} } }, { a: '*', c: '*' }), { a: '1.0.0', c: '2.0.0' });
+});
+
+test('cycles expand each selected package only once and can backtrack', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '>1.0.0' } } }, { a: '*' }), null);
+});
+
+test('missing packages and empty version maps are unsatisfiable, unreachable ones are ignored', () => {
+  assert.equal(resolve({}, { absent: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': { absent: '*' } } }, { a: '*' }), null);
+  assert.deepEqual(resolve({ unused: { '1.0.0': { absent: '*' } } }, {}), {});
+});
+
+test('all maps, versions, and ranges are validated eagerly, including unreachable entries', () => {
+  for (const malformed of [null, [], 1, 'x', new Date(), Object.create({})]) {
+    assert.throws(() => resolve(malformed, {}), TypeError);
+    assert.throws(() => resolve({}, malformed), TypeError);
+    assert.throws(() => resolve({ unused: malformed }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': malformed } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { 'bad': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { missing: 'bad' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: 'bad' }), TypeError);
+});
+
+test('own enumerable keys, null prototypes, special names, and input immutability', () => {
+  const deps = Object.assign(Object.create(null), { constructor: '*' });
+  Object.defineProperty(deps, 'ignored', { value: 'bad', enumerable: false });
+  deps[Symbol('ignored')] = 'bad';
+  Object.freeze(deps);
+  const registry = Object.create(null);
+  registry.__proto__ = Object.freeze({ '1.0.0': deps });
+  registry.constructor = Object.freeze({ '1.0.0': Object.freeze({}) });
+  Object.defineProperty(registry, 'ignored', { value: null, enumerable: false });
+  registry[Symbol('ignored')] = null;
+  const root = Object.freeze(Object.assign(Object.create(null), { ['__proto__']: '*' }));
+  Object.freeze(registry);
+  const expected = { ['__proto__']: '1.0.0', constructor: '1.0.0' };
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result, expected);
+  assert.deepEqual(resolve(registry, root), expected);
+  assert.equal(deps.constructor, '*');
+  assert.equal(resolve({}, { toString: '*' }), null);
+});
+
+test('long chains and rollback are iterative and have no arbitrary search limit', () => {
+  const length = 15000;
+  const registry = {};
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${i + 1}`]: '*' } };
+  }
+  registry[`p${length}`] = { '1.0.0': { p0: '*' } };
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length + 1);
+  assert.equal(result[`p${length}`], '1.0.0');
+  registry[`p${length}`] = { '1.0.0': { missing: '*' } };
+  registry.p0['0.0.0'] = {};
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '0.0.0' });
+});
+
+test('constraints prune conflicting choices before exploring an unrelated Cartesian product', () => {
+  const registry = { anchor: { '1.0.0': {} } };
+  const root = { anchor: '*' };
+  for (let i = 0; i < 40; i += 1) {
+    root[`p${i}`] = '*';
+    registry[`p${i}`] = {
+      '2.0.0': { anchor: '2.0.0' },
+      '1.0.0': { anchor: '1.0.0' },
+    };
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.keys(result).length, 41);
+  assert.ok(Object.values(result).every(version => version === '1.0.0'));
+});
+
+// A small copying-state oracle deliberately avoids the production rollback trail.
+function referenceResolve(registry, root) {
+  const entries = record => Object.entries(record).map(([name, range]) => ({ name, range }));
+  function search(selected, queue, cursor) {
+    if (queue.some(({ name, range }) => selected.has(name) && !satisfies(selected.get(name), range))) {
+      return null;
+    }
+    if (cursor === queue.length) return Object.fromEntries(selected);
+    const { name } = queue[cursor];
+    if (selected.has(name)) return search(selected, queue, cursor + 1);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!queue.filter(item => item.name === name).every(item => satisfies(version, item.range))) continue;
+      const next = new Map(selected);
+      next.set(name, version);
+      const result = search(next, queue.concat(entries(registry[name][version])), cursor + 1);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(new Map(), entries(root), 0);
+}
+
+test('first-found matches an independent small-registry oracle across seeded cyclic graphs', () => {
+  let seed = 1729;
+  const random = n => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return Math.floor(seed / 0x100000000 * n);
+  };
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=2.0.0', '<2.0.0', '>3.0.0'];
+  for (let sample = 0; sample < 500; sample += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        if (random(7) === 0) continue;
+        const deps = {};
+        for (const dep of [...names, 'missing']) {
+          if (random(4) === 0) deps[dep] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names) {
+      if (random(3) !== 0) root[name] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root),
+      `sample ${sample}: ${JSON.stringify({ registry, root })}`);
+  }
+});
