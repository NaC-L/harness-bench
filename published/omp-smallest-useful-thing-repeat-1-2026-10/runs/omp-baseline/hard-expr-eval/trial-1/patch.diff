@@ -0,0 +1,123 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('floor division and modulo obey Python signs and floating-point rounding', () => {
+  for (const [source, expected] of [
+    ['-7 // 2', -4], ['7 // -2', -4], ['-7 // -2', 3],
+    ['-7 % 3', 2], ['7 % -3', -2], ['-7 % -3', -1],
+    ['-7.5 // 2', -4], ['-7.5 % 2', 0.5], ['7.5 % -2', -0.5],
+    ['1 // 0.1', 9], ['1 % 0.1', 0.09999999999999995],
+    ['-1 // 0.1', -10], ['-1 % 0.1', 5.551115123125783e-17],
+    ['-6 % 3', 0], ['6 % -3', 0], ['0 // -3', 0],
+    ['-0 % 3', 0], ['-0 // 3', 0], ['1 // -3', -1],
+  ]) assert.equal(evaluate(source), expected, source);
+
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -5; b <= 5; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+    }
+  }
+});
+
+test('unary signs and right-associative powers follow the grammar', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625], ['--2 ** 2', 4],
+    ['2 * -3 ** 2', -18], ['2 ** +3', 8], ['+2 ** 2', 4],
+    ['20 / 2 * 3', 30], ['20 - 5 - 3', 12],
+    ['8 // 3 * 2 % 3', 1], ['1.5e-3 + .5 + 5.', 5.5015],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('comparisons chain and booleans coerce only in numeric operations', () => {
+  for (const [source, expected] of [
+    ['1 < 2 < 3', true], ['3 > 2 > 1', true], ['1 < 2 > 1', true],
+    ['1 < 2 == 2 <= 3 != 4 >= 1', true], ['3 < 2 < 1', false],
+    ['1 == 1 == 1', true], ['2 == 2 == 1', false],
+    ['(1 < 2) + (2 < 1)', 1], ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true], ['(1 < 2) < 2', true],
+    ['(1 < 2) ** 3', 1], ['1 + 2 * 3 < 8', true],
+    ['1 < (2 < 3)', false], ['abs(-(1 < 2))', 1],
+  ]) assert.equal(evaluate(source), expected, source);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < 1 / 0'), false);
+});
+
+test('variables and call arguments are read exactly once in source order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 10 });
+  for (const [name, value] of Object.entries({ a: 1, b: 2, c: 3, d: 4 })) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b <= c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('a > b < c', variables), false);
+  assert.deepEqual(reads.splice(0), ['a', 'b']);
+  assert.equal(evaluate('max(a, min(b, c), abs(-d))', variables), 4);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('a + a * b ** c', variables), 9);
+  assert.deepEqual(reads.splice(0), ['a', 'a', 'b', 'c']);
+  assert.equal(evaluate('d ** c ** a', variables), 64);
+  assert.deepEqual(reads.splice(0), ['d', 'c', 'a']);
+  errorAt('inherited', 1, variables);
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('_x2', Object.assign(Object.create(null), { _x2: 7 })), 7);
+});
+
+test('syntax and call arity are validated before any evaluation', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 2; } };
+  for (const [source, column] of [
+    ['x + unknown(1)', 5], ['x + abs()', 5], ['x + abs(1, 2)', 5],
+    ['x + min()', 5], ['x + max()', 5], ['x + min(1,)', 11],
+    ['x + (1', 7], ['x + 1 2', 7], ['x < 0 < unknown(1)', 9],
+    ['x < 0 < abs()', 9], ['x < 0 < (1 + )', 14],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+  assert.equal(evaluate('min(3)'), 3);
+  assert.equal(evaluate('max(3, -2, 7)'), 7);
+  assert.equal(evaluate('abs(-4)'), 4);
+});
+
+test('error columns identify tokens after whitespace and the full-source EOF', () => {
+  for (const [source, column] of [
+    ['   missing', 4], ['1 + \t missing', 7], ['  @', 3],
+    ['1 +\t🙂', 5], ['  1 + )', 7], ['1  2', 4],
+    ['  foo(1)', 3], ['  abs(1,2)', 3],
+    ['', 1], [' \t\n', 4], ['1 +   ', 7], ['(1  ', 5],
+    ['1 **   ', 8], ['1 <  ', 6], ['1 + 2 = 3', 7],
+    ['2(3)', 2], ['1e+', 2], ['1 + .', 5],
+  ]) errorAt(source, column);
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`1   ${operator}  -0`, 5);
+    errorAt(`1   ${operator}  (2 < 1)`, 5);
+  }
+});
+
+test('long flat arithmetic and comparison chains do not consume the call stack', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array(count).fill('1').join('<=')), true);
+  assert.equal(evaluate(`2 < 1 < ${Array(count).fill('missing').join('<')}`), false);
+  assert.equal(evaluate(`max(${Array(count).fill('1').join(',')})`), 1);
+});
