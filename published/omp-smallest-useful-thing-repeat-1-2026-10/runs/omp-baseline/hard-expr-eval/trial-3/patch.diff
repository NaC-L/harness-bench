@@ -0,0 +1,172 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('literal syntax, arithmetic precedence and associativity', () => {
+  const cases = [
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['10 - 3 - 2', 5],
+    ['24 / 3 * 2', 16],
+    ['20 // 3 % 4', 2],
+    ['1 + 2 * 3', 7],
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['3 * -2 ** 2', -12],
+    ['--2 ** 2', 4],
+    ['2 ** +3 * 4', 32],
+    ['-(2 + 3) * +4', -20],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and remainder have Python signs and positive zeros', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -7; b <= 7; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || (remainder < 0) === (b < 0));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const source of ['-0 // 3', '0 // -3', '-0 % 3', '0 % -3']) {
+    assert.ok(Object.is(evaluate(source), 0), source);
+  }
+});
+
+test('comparison chains share operands, short circuit, and coerce booleans numerically', () => {
+  const cases = [
+    ['3 > 2 > 1', true],
+    ['1 < 2 <= 2 != 3 == 3 >= 2 > 0', true],
+    ['1 < 2 > 3', false],
+    ['3 < 2 < unknown', false],
+    ['3 < 2 < 1 / 0', false],
+    ['1 + 2 < 2 * 2', true],
+    ['(1 < 2) + (3 < 2)', 1],
+    ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true],
+    ['(1 < 2) ** 2', 1],
+    ['2 < (3 < 4)', false],
+    ['(3 > 2) > 0', true],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+
+  const reads = [];
+  const variables = Object.create(null);
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, { get() { reads.push(name); return value; } });
+  }
+  assert.equal(evaluate('a < b < c < d', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+  reads.length = 0;
+  assert.equal(evaluate('a > b < c < d', variables), false);
+  assert.deepEqual(reads, ['a', 'b']);
+});
+
+test('variables are own properties read once per occurrence, left to right', () => {
+  const reads = [];
+  const variables = Object.freeze({
+    get a() { reads.push('a'); return 2; },
+    get b() { reads.push('b'); return 3; },
+    get c() { reads.push('c'); return 4; },
+  });
+  assert.equal(evaluate('a + b * a ** c', variables), 50);
+  assert.deepEqual(reads, ['a', 'b', 'a', 'c']);
+  assert.equal(evaluate('_amount2', { _amount2: 12 }), 12);
+  errorAt('  inherited', 3, Object.create({ inherited: 1 }));
+  errorAt('toString', 1);
+  assert.equal(evaluate('constructor', { constructor: 7 }), 7);
+});
+
+test('built-ins evaluate arguments left to right and validate calls before evaluation', () => {
+  assert.equal(evaluate('min(3, -2, max(4, 5))'), -2);
+  assert.equal(evaluate('max(3, -2, abs(-7))'), 7);
+  assert.equal(evaluate('min(2)'), 2);
+  assert.equal(evaluate('abs(1 > 2)'), 0);
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return 3; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 1; },
+  };
+  assert.equal(evaluate('max(a, min(b, c), a)', variables), 3);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'a']);
+  reads.length = 0;
+  for (const [source, column] of [
+    ['a + nope(1)', 5],
+    ['a + min()', 5],
+    ['a + max()', 5],
+    ['a + abs()', 5],
+    ['a + abs(1, 2)', 5],
+    ['3 < 2 < nope(a)', 9],
+    ['3 < 2 < abs(a, a)', 9],
+  ]) errorAt(source, column, variables);
+  assert.deepEqual(reads, []);
+});
+
+test('error columns follow token starts and UTF-16 offsets, including whitespace', () => {
+  for (const operator of ['/', '//', '%']) {
+    const source = `  5 \t ${operator} -0`;
+    errorAt(source, source.indexOf(operator) + 1);
+  }
+  for (const [source, column] of [
+    ['  missing', 3],
+    ['1 +   @', 7],
+    ['1 +   \u{1F600}', 7],
+    ['1 \uFEFF +\t @', 8],
+    ['1 +   )', 7],
+    ['1  2', 4],
+    ['1(2)', 2],
+    ['2 = 3', 3],
+    ['min(1, )', 8],
+    ['min(,1)', 5],
+    ['  abs(1, 2)', 3],
+    ['  unknown(1)', 3],
+  ]) errorAt(source, column);
+  for (const source of ['', '   ', '1 +   ', '(1  ', 'min(1,  ', '2 **  ']) {
+    errorAt(source, source.length + 1);
+  }
+  let reads = 0;
+  errorAt('a + 1  @', 8, { get a() { reads += 1; return 1; } });
+  errorAt('3 < 2 < (1 + )', 14);
+  assert.equal(reads, 0);
+});
+
+test('100,001-operand flat arithmetic and comparison chains stay linear and stack safe', () => {
+  const count = 100001;
+  const cases = [
+    [Array(count).fill('1').join('+'), count],
+    [Array(count).fill('1').join('*'), 1],
+    [Array(count).fill('1').join('=='), true],
+    [Array(count).fill('1').join('>'), false],
+  ];
+  for (const [source, expected] of cases) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected);
+    assert.ok(performance.now() - start < 1000, 'flat chain should evaluate in under one second');
+  }
+  assert.equal(evaluate(`max(${Array(count).fill('1').join(',')})`), 1);
+});
