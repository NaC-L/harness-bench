+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const previous = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = previous;
+    }
+  }
+  return row[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('exhaustive repetitive inputs have minimal, deterministic, ordered scripts and roundtrip', () => {
+  const inputs = [Object.freeze([])];
+  for (let length = 1; length <= 5; length++) {
+    for (let bits = 0; bits < 2 ** length; bits++) {
+      inputs.push(Object.freeze(Array.from({ length }, (_, i) => bits & (1 << i) ? '+' : '')));
+    }
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      checkScript(a, b);
+      for (const context of [0, 1, 3]) {
+        assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+      }
+    }
+  }
+});
+
+test('seeded varied inputs roundtrip with different context sizes', () => {
+  let seed = 12345;
+  const random = n => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  };
+  const alphabet = ['', ' ', '+text', '-text', 'same', 'other'];
+  const input = () => Object.freeze(Array.from({ length: random(25) }, () => alphabet[random(alphabet.length)]));
+  for (let trial = 0; trial < 500; trial++) {
+    const a = input();
+    const b = input();
+    checkScript(a, b);
+    for (const context of [0, 1, 2, 5, 30]) {
+      const hunks = unifiedHunks(a, b, { context });
+      for (const hunk of hunks) {
+        Object.freeze(hunk.lines);
+        Object.freeze(hunk);
+      }
+      assert.deepEqual(applyHunks(a, Object.freeze(hunks)), b);
+    }
+  }
+});
+
+test('zero-length ranges use the preceding complete-file coordinate', () => {
+  assert.deepEqual(unifiedHunks([], ['+one'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['++one'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['-one'], [], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['--one'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a', 'b'], ['a', '+', 'b', ''], { context: 0 }), [
+    { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['++'] },
+    { oldStart: 2, oldLines: 0, newStart: 4, newLines: 1, lines: ['+'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a', '-', 'b', ''], ['a', 'b'], { context: 0 }), [
+    { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['--'] },
+    { oldStart: 4, oldLines: 1, newStart: 2, newLines: 0, lines: ['-'] },
+  ]);
+});
+
+test('hunks merge exactly when their context touches, without duplicating lines', () => {
+  const a = ['before', 'old1', 'gap1', 'gap2', 'old2', 'after'];
+  const b = ['before', 'new1', 'gap1', 'gap2', 'new2', 'after'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' before', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' after'],
+  }]);
+  a.splice(4, 0, 'gap3');
+  b.splice(4, 0, 'gap3');
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+      lines: [' before', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+      lines: [' gap3', '-old2', '+new2', ' after'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+});
+
+test('application rejects bad contents, counts, coordinates, ordering and malformed entries', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  assert.deepEqual(applyHunks(a, [valid]), ['a', 'B', 'c']);
+  const invalid = [
+    null, {}, { ...valid, lines: null },
+    { ...valid, oldStart: 0 }, { ...valid, oldStart: -1 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: NaN },
+    { ...valid, oldStart: 5 }, { ...valid, oldLines: 2 },
+    { ...valid, oldLines: -1 }, { ...valid, newLines: 0 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 3 },
+    { ...valid, newLines: Infinity }, { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] }, { ...valid, lines: [42] },
+    { ...valid, lines: ['-b', '-c', '+B'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const insert = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] };
+  assert.throws(() => applyHunks(a, [insert, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('application accepts adjacent hunks and retains unmentioned original lines', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd']);
+  const hunks = [
+    { oldStart: 1, oldLines: 0, newStart: 2, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 2, oldLines: 1, newStart: 3, newLines: 0, lines: ['-b'] },
+    { oldStart: 3, oldLines: 1, newStart: 4, newLines: 1, lines: ['-c', '+C'] },
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['a', 'x', 'y', 'C', 'd']);
+});
+
+test('small edits in 20,000 repetitive lines roundtrip', () => {
+  const a = Object.freeze(Array.from({ length: 20000 }, (_, i) => String(i % 3)));
+  const b = a.slice();
+  b.splice(19000, 1);
+  b.splice(10000, 0, '+new');
+  b[100] = '-changed';
+  const script = diffLines(a, b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+  assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+});
+
+test('large empty-sided inputs and identical inputs take the linear paths', () => {
+  const lines = Object.freeze(Array.from({ length: 20000 }, (_, i) => String(i)));
+  assert.deepEqual(diffLines([], lines), lines.map(line => ({ op: 'insert', line })));
+  assert.deepEqual(diffLines(lines, []), lines.map(line => ({ op: 'delete', line })));
+  assert.deepEqual(diffLines(lines, lines), lines.map(line => ({ op: 'equal', line })));
+  assert.deepEqual(applyHunks([], unifiedHunks([], lines)), lines);
+  assert.deepEqual(applyHunks(lines, unifiedHunks(lines, [])), []);
+});
