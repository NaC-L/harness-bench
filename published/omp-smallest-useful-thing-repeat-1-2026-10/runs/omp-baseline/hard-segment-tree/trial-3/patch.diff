@@ -0,0 +1,160 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard older additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -3);
+  tree.assign(0, 8, 10);
+  tree.add(0, 8, 2);
+  assert.equal(tree.sum(2, 6), 48);
+  assert.equal(tree.get(0), 12);
+  assert.deepEqual(tree.toArray(), Array(8).fill(12));
+});
+
+test('partial maxima preserve negative values and empty ranges', () => {
+  const tree = new RangeTree([-9, -7, -5, -3, -1]);
+  assert.equal(tree.max(0, 3), -5);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 2);
+  assert.equal(tree.max(1, 3), -8);
+  assert.equal(tree.max(4, 5), -10);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold searches see pending additions and assignments before other reads', () => {
+  const added = new RangeTree([-10, -9, -8, -7, -6]);
+  added.add(0, 5, 20);
+  assert.equal(added.firstAtLeast(0, 12), 2);
+  assert.equal(added.firstAtLeast(3, 12), 3);
+  assert.equal(added.firstAtLeast(0, 15), -1);
+
+  const assigned = new RangeTree([10, 20, 30, 40, 50]);
+  assigned.assign(0, 5, -4);
+  assigned.add(0, 5, 2);
+  assert.equal(assigned.firstAtLeast(2, -2), 2);
+  assert.equal(assigned.firstAtLeast(0, -1), -1);
+  assigned.assign(1, 4, 8);
+  assert.equal(assigned.firstAtLeast(2, 8), 2);
+  assert.equal(assigned.firstAtLeast(4, 8), -1);
+  assert.equal(assigned.firstAtLeast(0, -Infinity), 0);
+  assert.equal(assigned.firstAtLeast(0, Infinity), -1);
+  assert.equal(assigned.firstAtLeast(5, -Infinity), -1);
+});
+
+test('mixed lazy updates agree with an array across deterministic randomized workloads', () => {
+  let state = 0x12345678;
+  const random = (limit) => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  };
+  for (const length of [1, 2, 3, 5, 8, 17, 33, 64]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    const range = () => {
+      const a = random(length + 1);
+      const b = random(length + 1);
+      return [Math.min(a, b), Math.max(a, b)];
+    };
+    for (let step = 0; step < 600; step++) {
+      // Accumulate tags before reading, including full, empty and overlapping ranges.
+      for (let update = 0; update < 3; update++) {
+        const [l, r] = update === 0 && step % 4 === 0 ? [0, length] : range();
+        const value = random(41) - 20;
+        if (random(2) === 0) {
+          assert.equal(tree.assign(l, r, value), undefined);
+          for (let i = l; i < r; i++) values[i] = value;
+        } else {
+          assert.equal(tree.add(l, r, value), undefined);
+          for (let i = l; i < r; i++) values[i] += value;
+        }
+      }
+      const lo = random(length + 1);
+      const threshold = step % 23 === 0 ? Infinity : step % 29 === 0 ? -Infinity : random(81) - 40;
+      const expected = values.findIndex((value, i) => i >= lo && value >= threshold);
+      assert.equal(tree.firstAtLeast(lo, threshold), expected, `search: n=${length}, step=${step}`);
+      for (let query = 0; query < 4; query++) {
+        const [l, r] = range();
+        const slice = values.slice(l, r);
+        assert.equal(tree.max(l, r), Math.max(-Infinity, ...slice));
+        assert.equal(tree.sum(l, r), slice.reduce((sum, value) => sum + value, 0));
+      }
+      const index = random(length);
+      assert.equal(tree.get(index), values[index]);
+      // Materialize infrequently so it cannot hide stale lazy tags in later reads.
+      if (step % 31 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, read-only length and array isolation preserve the API', () => {
+  for (const values of [[], null, undefined, '123', new Float64Array([1]), [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.add(0, 3, 4);
+  const expected = [5, 6, 7];
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 99; }, TypeError);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [2, 1], [0, 4], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]]) {
+      assert.throws(() => tree[method](l, r, 9), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+    }
+    for (const boundary of [0, 1, 3]) assert.equal(tree[method](boundary, boundary, 100), undefined);
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0']) assert.throws(() => tree.get(i), RangeError);
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0']) assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  for (const x of [NaN, '1', null, undefined]) assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  for (const boundary of [0, 1, 3]) {
+    assert.equal(tree.sum(boundary, boundary), 0);
+    assert.equal(tree.max(boundary, boundary), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), expected);
+  const copy = tree.toArray();
+  copy[0] = -99;
+  assert.deepEqual(tree.toArray(), expected);
+});
+
+test('construction and materialization are linear; updates and queries visit logarithmic nodes', () => {
+  // Count recursive visits instead of relying on noisy wall-clock timing.
+  class CountedTree extends RangeTree {
+    _build(...args) { this.visits = (this.visits || 0) + 1; return super._build(...args); }
+    _update(...args) { this.visits++; return super._update(...args); }
+    _sum(...args) { this.visits++; return super._sum(...args); }
+    _max(...args) { this.visits++; return super._max(...args); }
+    _first(...args) { this.visits++; return super._first(...args); }
+    _write(...args) { this.visits++; return super._write(...args); }
+  }
+  const length = 4097;
+  const tree = new CountedTree(Array(length).fill(-10));
+  assert.equal(tree.visits, 2 * length - 1);
+  const check = (operation) => {
+    tree.visits = 0;
+    const result = operation();
+    assert.ok(tree.visits <= 8 * Math.ceil(Math.log2(length)), `visited ${tree.visits} nodes`);
+    return result;
+  };
+  check(() => tree.assign(1, length - 1, -5));
+  check(() => tree.add(2, length - 2, 3));
+  assert.equal(check(() => tree.sum(2, length - 2)), -2 * (length - 4));
+  assert.equal(check(() => tree.max(1, length - 1)), -2);
+  assert.equal(check(() => tree.get(length - 1)), -10);
+  assert.equal(check(() => tree.firstAtLeast(1, -2)), 2);
+  assert.equal(check(() => tree.firstAtLeast(length - 2, -2)), -1);
+  tree.visits = 0;
+  assert.equal(tree.toArray().length, length);
+  assert.equal(tree.visits, 2 * length - 1);
+});
