+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { compare, satisfies } = require('./semver');
+
+const versions = deps => ({ '2.0.0': deps, '1.0.0': {} });
+
+test('orders every version component numerically', () => {
+  for (const [older, newer] of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    assert.deepEqual(resolve({ a: { [older]: {}, [newer]: {} } }, { a: '*' }), { a: newer });
+  }
+});
+
+test('root and dependency discovery collect constraints before processing', () => {
+  const registry = {
+    a: versions({ b: '1.0.0', c: '*' }),
+    b: versions({ c: '2.0.0' }),
+    c: versions({}),
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '2.0.0',
+  });
+});
+
+test('FIFO first-found selection retries the latest choice, not an earlier package', () => {
+  const registry = {
+    a: { '2.0.0': { x: '1.0.0' }, '1.0.0': { x: '2.0.0' } },
+    b: { '2.0.0': { x: '2.0.0' }, '1.0.0': { x: '1.0.0' } },
+    x: versions({}),
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', x: '1.0.0',
+  });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), {
+    b: '2.0.0', a: '1.0.0', x: '2.0.0',
+  });
+});
+
+test('rollback removes partially discovered dependencies after an immediate conflict', () => {
+  assert.deepEqual(resolve({ a: versions({ missing: '*', a: '1.0.0' }) }, { a: '*' }), {
+    a: '1.0.0',
+  });
+});
+
+test('rollback removes only the failed choice constraints', () => {
+  const registry = {
+    a: { '2.0.0': { c: '>=2.0.0' } },
+    b: { '2.0.0': { c: '<2.0.0' }, '1.0.0': { c: '>=2.0.0' } },
+    c: versions({}),
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '2.0.0',
+  });
+});
+
+test('rollback discards selected descendants and unreachable constraints', () => {
+  const registry = {
+    a: versions({ b: '*' }),
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': { missing: '*' }, '1.0.0': { missing: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0' });
+});
+
+test('cycles expand each selected package once and can backtrack', () => {
+  assert.deepEqual(resolve({ a: versions({ a: '*' }) }, { a: '*' }), { a: '2.0.0' });
+  assert.deepEqual(resolve({
+    a: versions({ b: '*' }),
+    b: versions({ a: '1.0.0' }),
+  }, { a: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({
+    a: { '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '2.0.0' } },
+  }, { a: '*' }), null);
+});
+
+test('long chains succeed and unwind without a recursion limit or iteration cap', () => {
+  const registry = {};
+  const length = 12000;
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': i + 1 < length ? { [`p${i + 1}`]: '*' } : {} };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length);
+  assert.equal(result[`p${length - 1}`], '1.0.0');
+  registry[`p${length - 1}`]['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('checks discovered constraints instead of enumerating a Cartesian product', () => {
+  const registry = {};
+  for (let i = 0; i < 40; i += 1) {
+    registry[`p${i}`] = {
+      '2.0.0': { [`p${i + 1}`]: '2.0.0' },
+      '1.0.0': { [`p${i + 1}`]: '1.0.0' },
+    };
+  }
+  registry.p40 = { '1.0.0': {} };
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, 41);
+  assert.ok(Object.values(result).every(version => version === '1.0.0'));
+});
+
+test('missing and empty catalogs are unsatisfiable; empty roots still validate eagerly', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.deepEqual(resolve({ a: versions({ missing: '*' }) }, {}), {});
+  assert.throws(() => resolve({ unused: { bad: {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { missing: '^bad' } } }, {}), TypeError);
+  for (const bad of [null, [], 1, 'map', new Date()]) {
+    assert.throws(() => resolve(bad, {}), TypeError);
+    assert.throws(() => resolve({}, bad), TypeError);
+    assert.throws(() => resolve({ unused: bad }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': bad } }, {}), TypeError);
+  }
+});
+
+test('null-prototype maps and special package names are safe, with no input mutation', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.freeze({ '1.0.0': Object.freeze(Object.create(null)) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), Object.keys(root));
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+});
+
+// A small, independent copying search is an oracle for order and rollback. It
+// deliberately uses recursion only on tiny generated registries, not in resolve.
+function reference(registry, root) {
+  function search(selected, constraints, queue, cursor) {
+    if (cursor === queue.length) return selected;
+    const name = queue[cursor];
+    if (Object.hasOwn(selected, name)) return search(selected, constraints, queue, cursor + 1);
+    const candidates = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of candidates) {
+      if (!constraints[name].every(range => satisfies(version, range))) continue;
+      const next = { ...selected, [name]: version };
+      const tests = Object.fromEntries(Object.entries(constraints).map(([key, ranges]) => [key, [...ranges]]));
+      const pending = [...queue];
+      let conflict = false;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        (tests[dependency] ||= []).push(range);
+        pending.push(dependency);
+        if (Object.hasOwn(next, dependency) && !satisfies(next[dependency], range)) {
+          conflict = true;
+          break;
+        }
+      }
+      if (!conflict) {
+        const result = search(next, tests, pending, cursor + 1);
+        if (result) return result;
+      }
+    }
+    return null;
+  }
+  return search({}, Object.fromEntries(Object.entries(root).map(([name, range]) => [name, [range]])), Object.keys(root), 0);
+}
+
+test('matches first-found copying search across generated cyclic registries', () => {
+  let seed = 1729;
+  const random = bound => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % bound;
+  };
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=2.0.0', '<2.0.0'];
+  for (let sample = 0; sample < 250; sample += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        const deps = {};
+        for (const dependency of [...names, 'missing']) {
+          if (random(5) === 0) deps[dependency] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names) {
+      if (random(2) === 0) root[name] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), reference(registry, root), `sample ${sample}`);
+  }
+});
