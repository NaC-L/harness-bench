+++ "{temp}\\hb-1200a372-i8uz_32p/evaluator.regression.test.js"
@@ -0,0 +1,115 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function assertError(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('arithmetic follows the documented precedence and associativity', () => {
+  const cases = [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['2 ** -2 ** 2', 1 / 16],
+    ['-2 ** -2', -0.25], ['--2 ** 2', 4], ['3 * -2 ** 2', -12],
+    ['20 - 3 - 2', 15], ['24 / 3 / 2', 4], ['20 // 3 * 2', 12],
+    ['20 % 6 % 3', 2], ['2 + 3 * 4 ** 2', 50], ['+-.5e+2', -50],
+    ['5. + 1E-1 + .5', 5.6]
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('division and remainder have Python signs and normalize zero', () => {
+  for (let a = -12; a <= 12; a += 1) {
+    for (let b = -5; b <= 5; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const operator of ['/', '//', '%']) {
+    assertError(`  7   ${operator} -0`, 7);
+  }
+});
+
+test('comparisons chain, convert booleans numerically, and preserve grouping', () => {
+  const cases = [
+    ['3 > 2 > 1', true], ['1 < 2 == 2 <= 3 != 4 > 0', true],
+    ['3 < 2 < 1', false], ['(3 > 2) > 1', false],
+    ['(1 < 2) + (3 < 2)', 1], ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true], ['2 ** (1 < 2)', 2],
+    ['1 + 2 < 2 * 2', true], ['abs(1 > 2)', 0],
+    ['max(1 < 2, 5, -3)', 5], ['min(3, 1 + 1, -1)', -1]
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('getter occurrences are read once, left to right, without mutation', () => {
+  const reads = [];
+  const variables = Object.create(null);
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; }
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  assert.equal(evaluate('max(a + b, abs(-c), a)', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'a']);
+  assert.equal(evaluate('c < b < a / 0 < missing', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('2 < 1 < missing'), false);
+  assert.equal(evaluate('2 < 1 < 1 / 0'), false);
+});
+
+test('the complete source is parsed before reading any variable', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['a + unknown(2)', 5], ['a + abs(1, 2)', 5],
+    ['a + min()', 5], ['a + 2 3', 7],
+    ['2 < 1 < abs()', 9], ['2 < 1 < min(3,)', 15], ['a + @', 5]
+  ]) assertError(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('errors point to tokens after whitespace and to the true end of source', () => {
+  for (const [source, column] of [
+    ['   missing', 4], ['1 +   missing', 7], ['  unknown(1)', 3],
+    ['  abs(1, 2)', 3], ['1 +   @', 7], ['1 +\t\n  @', 8],
+    ['1   2', 5], ['  2(3)', 4], ['min(1,   )', 10],
+    ['(1 + 2   ', 10], ['1 +   ', 7], ['   ', 4], ['', 1],
+    ['1 +  \ud83d\ude00', 6], ['1 === 1', 5], ['1e+', 2]
+  ]) assertError(source, column);
+  assertError('  inherited', 3, Object.create({ inherited: 1 }));
+  assertError('constructor', 1);
+  assert.equal(evaluate('constructor', { constructor: 7 }), 7);
+});
+
+test('flat arithmetic and comparison chains handle over 100,000 operands', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join(' + ')), count);
+  assert.equal(evaluate(Array(count).fill('1').join(' * ')), 1);
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  assert.equal(evaluate(Array(count).fill('x').join(' <= '), variables), true);
+  assert.equal(reads, count);
+  reads = 0;
+  assert.equal(evaluate('2 < ' + Array(count).fill('x').join(' <= '), variables), false);
+  assert.equal(reads, 1);
+  assert.equal(evaluate('max(' + Array(count).fill('1').join(',') + ')'), 1);
+});
