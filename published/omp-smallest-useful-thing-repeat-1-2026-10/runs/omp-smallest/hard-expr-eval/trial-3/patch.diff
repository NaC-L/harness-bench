@@ -0,0 +1,136 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('power is right associative and has asymmetric unary precedence', () => {
+  const cases = [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625], ['--2 ** 2', 4],
+    ['3 * -2 ** 2', -12], ['2 ** +3 * 4', 32],
+    ['20 / 2 * 3', 30], ['10 - 3 - 2', 5],
+    ['20 // 3 % 4 * 2', 4], ['+ .5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('division and modulo use the divisor sign and positive zero', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -7; b <= 7; b += 1) {
+      if (b === 0) continue;
+      const q = evaluate('a // b', { a, b });
+      const r = evaluate('a % b', { a, b });
+      assert.equal(q, Math.floor(a / b) || 0);
+      assert.equal(q * b + r, a);
+      if (r !== 0) assert.equal(Math.sign(r), Math.sign(b));
+      else assert.equal(Object.is(r, -0), false);
+      assert.equal(Object.is(q, -0), false);
+    }
+  }
+  for (const [source, expected] of [
+    ['-7.5 // 2', -4], ['-7.5 % 2', 0.5], ['7.5 % -2', -0.5],
+    ['1 // 0.1', 9], ['1 % 0.1', 0.09999999999999995],
+    ['-1 // 0.1', -10], ['1 // -0.1', -10], ['-1 // -0.1', 9],
+    ['0 // -2', 0], ['-0 % 2', 0], ['6 % -3', 0],
+  ]) assert.equal(evaluate(source), expected, source);
+  for (const op of ['/', '//', '%']) {
+    for (const zero of ['0', '-0', '(1 - 1)']) {
+      errorAt(`  7   ${op} ${zero}`, 7);
+    }
+  }
+});
+
+test('comparison chains retain shared operands and numeric boolean semantics', () => {
+  const cases = [
+    ['3 < 2 < 1', false], ['1 < 2 < 3', true], ['3 > 2 >= 2 != 1', true],
+    ['1 + 2 < 2 * 2 == 4', true], ['2 == 2 == 2', true],
+    ['(1 < 2) == 1', true], ['(2 < 1) == 0', true],
+    ['(1 < 2) + (2 < 1)', 1], ['-(1 < 2)', -1],
+    ['(1 < 2) ** 3', 1], ['(1 < 2) < 2 < 3', true],
+    ['min(3, 2 < 4, 5)', 1], ['max(1, 3, 2)', 3], ['abs(-3)', 3],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+  errorAt('3 < 2 < abs(1, 2)', 9);
+  errorAt('3 < 2 < unknown(1)', 9);
+  errorAt('3 < 2 < (1 + )', 14);
+});
+
+test('getter-backed variables are read once per occurrence in evaluation order', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of Object.entries({ a: 1, b: 2, c: 3, d: 4 })) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('d < b < c', variables), false);
+  assert.deepEqual(reads.splice(0), ['d', 'b']);
+  assert.equal(evaluate('a + b * c + a', variables), 8);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'a']);
+  assert.equal(evaluate('max(a, abs(-b), min(c, d))', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  for (const source of ['a + abs()', 'a + abs(1, 2)', 'a + nope(1)', 'a + 1 2']) {
+    assert.throws(() => evaluate(source, variables), ExprError);
+    assert.deepEqual(reads, []);
+  }
+  let count = 0;
+  const changing = { get x() { count += 1; return count; } };
+  assert.equal(evaluate('x < x < x', changing), true);
+  assert.equal(count, 3);
+});
+
+test('variables require own properties and calls are restricted to built-ins', () => {
+  errorAt('  inherited', 3, Object.create({ inherited: 5 }));
+  errorAt('toString', 1);
+  const variables = Object.create(null);
+  variables.__proto__ = 7;
+  variables.min = 4;
+  assert.equal(evaluate('__proto__ + min', variables), 11);
+  assert.equal(evaluate('min(min, 3)', variables), 3);
+  assert.equal(evaluate('min(1, 2)', { get min() { throw new Error('Not a variable read'); } }), 1);
+});
+
+test('error columns refer to token starts and UTF-16 source offsets', () => {
+  const cases = [
+    ['', 1], [' \t\n', 4], ['1 +   ', 7], ['1 +   missing', 7],
+    ['1   @', 5], ['1\n\t@', 4], ['1 +  💰', 6], ['1 +  \ud800', 6],
+    ['  abs()', 3], ['  abs(1, 2)', 3], ['  min()', 3], ['  max()', 3],
+    ['  unknown(1)', 3], ['abs(1,)', 7], ['min(,1)', 5],
+    ['(1 + 2   ', 10], ['1   2', 5], ['2 (3)', 3],
+    ['1 = 2', 3], ['1 ! 2', 3], ['1 ** ', 6], ['. ', 1],
+    ['1.2.3', 4], ['1e+', 2], ['[1]', 1], ['"1"', 1],
+  ];
+  for (const [source, column] of cases) errorAt(source, column);
+});
+
+test('long flat arithmetic, comparisons, and argument lists avoid recursive evaluation', t => {
+  const size = 100001;
+  for (const [label, source, expected] of [
+    ['sum', Array(size).fill('1').join(' + '), size],
+    ['product', Array(size).fill('1').join(' * '), 1],
+    ['comparison', Array(size).fill('1').join(' <= '), true],
+    ['short-circuit comparison', '2 < ' + Array(size).fill('1').join(' < '), false],
+    ['call', 'max(' + Array(size).fill('1').join(',') + ')', 1],
+  ]) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected);
+    t.diagnostic(`${label}: ${(performance.now() - start).toFixed(1)} ms for ${size} operands`);
+  }
+});
