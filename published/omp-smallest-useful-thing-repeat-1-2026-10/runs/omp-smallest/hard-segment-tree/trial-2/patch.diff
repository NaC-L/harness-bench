@@ -0,0 +1,164 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both the assigned node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 9);
+  tree.add(3, 7, -4);
+  tree.add(0, 7, 5);
+  tree.assign(0, 7, -6);
+  tree.add(0, 7, 2);
+  assert.equal(tree.sum(1, 6), -20);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-4));
+
+  tree.add(0, 7, 11);
+  tree.assign(1, 6, 0);
+  tree.add(2, 5, -3);
+  assert.deepEqual(tree.toArray(), [7, 0, -3, -3, -3, 0, 7]);
+});
+
+test('partial maxima use the correct identity for all-negative ranges', () => {
+  const tree = new RangeTree([-8, -3, -7, -4, -9]);
+  assert.equal(tree.max(1, 4), -3);
+  assert.equal(tree.max(2, 3), -7);
+  tree.assign(0, 5, -12);
+  tree.add(1, 4, 2);
+  assert.equal(tree.max(0, 4), -10);
+  assert.equal(tree.max(4, 5), -12);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search propagates lazy updates before inspecting children', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0]);
+  tree.assign(0, 5, 8);
+  assert.equal(tree.firstAtLeast(0, 8), 0);
+  assert.equal(tree.firstAtLeast(3, 8), 3);
+  tree.assign(0, 5, -7);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(2, 3), 2);
+  tree.assign(1, 4, -20);
+  tree.add(0, 5, 2);
+  assert.equal(tree.firstAtLeast(1, 5), 4);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('API preserves empty ranges, validation, length, and array independence', () => {
+  for (const values of [[], null, {}, [1, NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -4, 6];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 9; }, TypeError);
+  const output = tree.toArray();
+  output[1] = 99;
+  assert.deepEqual(tree.toArray(), [2, -4, 6]);
+
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 7), undefined);
+    assert.equal(tree.add(i, i, -3), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined, null]) {
+      assert.throws(() => tree.assign(i, i, value), RangeError);
+      assert.throws(() => tree.add(i, i, value), RangeError);
+    }
+  }
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', undefined, null]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), [2, -4, 6]);
+  assert.equal(tree.assign(0, 3, 0), undefined);
+  assert.equal(tree.add(0, 3, -2), undefined);
+  assert.deepEqual(tree.toArray(), [-2, -2, -2]);
+});
+
+test('mixed updates and queries agree with an array oracle across tree shapes', () => {
+  let state = 0x12345678;
+  const random = (limit) => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 600; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 7 === 0) [l, r] = [0, n];
+      const value = random(41) - 20;
+      if (random(2) === 0) {
+        tree.assign(l, r, value);
+        for (let i = l; i < r; i++) values[i] = value;
+      } else {
+        tree.add(l, r, value);
+        for (let i = l; i < r; i++) values[i] += value;
+      }
+
+      // Search first: materialization or other queries must not hide stale tags.
+      const lo = random(n + 1);
+      const threshold = random(101) - 50;
+      const expectedIndex = values.findIndex((v, i) => i >= lo && v >= threshold);
+      assert.equal(tree.firstAtLeast(lo, threshold), expectedIndex, `search n=${n} step=${step}`);
+      let a = random(n + 1);
+      let b = random(n + 1);
+      if (a > b) [a, b] = [b, a];
+      const slice = values.slice(a, b);
+      assert.equal(tree.max(a, b), Math.max(...slice), `max n=${n} step=${step}`);
+      assert.equal(tree.sum(a, b), slice.reduce((sum, v) => sum + v, 0), `sum n=${n} step=${step}`);
+      const index = random(n);
+      assert.equal(tree.get(index), values[index], `get n=${n} step=${step}`);
+      assert.equal(tree.sum(0, n), values.reduce((sum, v) => sum + v, 0));
+      if (step % 53 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('updates and queries retain logarithmic traversal and materialization is linear', () => {
+  const n = 16385;
+  const tree = new RangeTree(Array(n).fill(-10));
+  const calls = {};
+  for (const method of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[method];
+    tree[method] = function (...args) {
+      calls[method] = (calls[method] || 0) + 1;
+      return original.apply(this, args);
+    };
+  }
+  tree.add(0, n, 3);
+  tree.assign(1, n - 1, -5);
+  tree.add(2, n - 2, 6);
+  assert.equal(tree.sum(1, n - 1), n - 14);
+  assert.equal(tree.max(1, n - 1), 1);
+  assert.equal(tree.get(n - 2), -5);
+  assert.equal(tree.firstAtLeast(1, 1), 2);
+  const bound = 16 * (Math.ceil(Math.log2(n)) + 1);
+  for (const method of ['_update', '_sum', '_max', '_first']) {
+    assert.ok(calls[method] <= bound, `${method} visited ${calls[method]} nodes`);
+  }
+  const result = tree.toArray();
+  assert.equal(result.length, n);
+  assert.deepEqual(result.slice(0, 4), [-7, -5, 1, 1]);
+  assert.deepEqual(result.slice(-4), [1, 1, -5, -7]);
+  assert.equal(calls._write, 2 * n - 1);
+});
