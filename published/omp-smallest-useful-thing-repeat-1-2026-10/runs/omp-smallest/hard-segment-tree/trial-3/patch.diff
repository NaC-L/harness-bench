@@ -0,0 +1,162 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard additions at both ancestors and descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 9);
+  tree.add(3, 7, -4);
+  tree.add(0, 7, 6);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  assert.equal(tree.sum(1, 6), -10);
+  assert.equal(tree.max(1, 6), -2);
+  assert.equal(tree.firstAtLeast(1, -2), 1);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-2));
+  tree.assign(2, 5, 8);
+  assert.deepEqual(tree.toArray(), [-2, -2, 8, 8, 8, -2, -2]);
+});
+
+test('partial maximum queries use the identity for negative values', () => {
+  const tree = new RangeTree([-9, -4, -7, -2, -8]);
+  assert.equal(tree.max(0, 3), -4);
+  assert.equal(tree.max(2, 3), -7);
+  tree.assign(0, 5, -12);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(2, 5), -9);
+  assert.equal(tree.max(5, 5), -Infinity);
+});
+
+test('threshold search propagates pending assignments and additions before descent', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 7, 10);
+  assert.equal(tree.firstAtLeast(0, 14), 3);
+  tree.assign(0, 7, 20);
+  assert.equal(tree.firstAtLeast(2, 20), 2);
+  tree.add(0, 7, -30);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.assign(0, 7, -5);
+  assert.equal(tree.firstAtLeast(4, -5), 4);
+  tree.assign(0, 3, -9);
+  assert.equal(tree.firstAtLeast(0, -5), 3);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(6, -Infinity), 6);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+});
+
+test('mixed updates and queries agree with a deterministic array oracle', () => {
+  for (let seed = 1; seed <= 40; seed++) {
+    let state = seed;
+    const random = (limit) => {
+      state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+      return state % limit;
+    };
+    const n = 1 + random(39);
+    const values = Array.from({ length: n }, () => random(101) - 50);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 400; step++) {
+      const a = random(n + 1);
+      const b = random(n + 1);
+      const l = Math.min(a, b);
+      const r = Math.max(a, b);
+      const value = random(101) - 50;
+      const operation = random(8);
+      const context = `seed=${seed}, step=${step}, range=[${l}, ${r})`;
+      if (operation < 4) {
+        const assigning = operation < 2;
+        assert.equal(tree[assigning ? 'assign' : 'add'](l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      } else if (operation === 4) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((s, v) => s + v, 0), context);
+      } else if (operation === 5) {
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)), context);
+      } else if (operation === 6) {
+        assert.equal(tree.firstAtLeast(l, value), values.findIndex((v, i) => i >= l && v >= value), context);
+      } else {
+        const i = random(n);
+        assert.equal(tree.get(i), values[i], context);
+      }
+      if (step % 79 === 78) assert.deepEqual(tree.toArray(), values, context);
+    }
+    for (let l = 0; l <= n; l++) {
+      for (let r = l; r <= n; r++) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((s, v) => s + v, 0));
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+      }
+      for (const x of [-Infinity, -50, 0, 50, Infinity]) {
+        assert.equal(tree.firstAtLeast(l, x), values.findIndex((v, i) => i >= l && v >= x));
+      }
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, read-only length, and independent arrays retain their contracts', () => {
+  for (const values of [undefined, null, {}, '1', [], [NaN], [Infinity], [-Infinity], ['1'], Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  tree.add(0, 3, 5);
+  const expected = [7, 2, 9];
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], [0, Infinity], ['0', 2]]) {
+      assert.throws(() => tree[method](l, r, 99), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, undefined, null, '3', {}]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    for (let i = 0; i <= tree.length; i++) assert.equal(tree[method](i, i, 8), undefined);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  for (const i of [-1, 3, 1.5, NaN, Infinity, '0']) assert.throws(() => tree.get(i), RangeError);
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, undefined, null, '0', {}]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 9; }, TypeError);
+  assert.deepEqual(tree.toArray(), expected);
+  const output = tree.toArray();
+  output[1] = 100;
+  assert.deepEqual(tree.toArray(), expected);
+});
+
+test('range operations visit logarithmically many nodes and materialization is linear', () => {
+  const n = 16384;
+  const tree = new RangeTree(Array(n).fill(-3));
+  let visits = 0;
+  for (const method of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[method];
+    tree[method] = function (...args) {
+      visits++;
+      return original.apply(this, args);
+    };
+  }
+  const logarithmic = (operation) => {
+    visits = 0;
+    operation();
+    assert.ok(visits <= 8 * (Math.log2(n) + 1), `visited ${visits} nodes`);
+  };
+  logarithmic(() => tree.add(1, n - 1, 4));
+  logarithmic(() => tree.assign(2, n - 2, -8));
+  logarithmic(() => assert.equal(tree.sum(3, n - 3), -8 * (n - 6)));
+  logarithmic(() => assert.equal(tree.max(3, n - 3), -8));
+  logarithmic(() => assert.equal(tree.get(n - 2), 1));
+  logarithmic(() => assert.equal(tree.firstAtLeast(2, 0), n - 2));
+  logarithmic(() => assert.equal(tree.firstAtLeast(2, 2), -1));
+  visits = 0;
+  assert.equal(tree.toArray().length, n);
+  assert.equal(visits, 2 * n - 1);
+});
