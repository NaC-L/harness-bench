+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+const { splitLines, joinLines } = require('./src/lines');
+
+// A small quadratic oracle is appropriate only in tests, not in the module.
+function lcsLength(a, b) {
+  let previous = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const current = [0];
+    for (let j = 0; j < b.length; j++) {
+      current.push(line === b[j]
+        ? previous[j] + 1
+        : Math.max(previous[j + 1], current[j]));
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function verifyScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('minimal deterministic scripts and patch roundtrips for exhaustive repeated lines', () => {
+  const inputs = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 3; length++) {
+    level = level.flatMap(lines => ['', 'a', 'b'].map(line => Object.freeze([...lines, line])));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      verifyScript(a, b);
+      for (const context of [0, 1, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+      }
+    }
+  }
+});
+
+test('longer repetitive and prefixed lines retain minimality and roundtrip', () => {
+  let state = 123456789;
+  const random = () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state;
+  };
+  const alphabet = ['', 'a', 'b', '+plus', '-minus', ' space', '\r'];
+  for (let iteration = 0; iteration < 500; iteration++) {
+    const a = Object.freeze(Array.from({ length: random() % 25 }, () => alphabet[random() % alphabet.length]));
+    const b = Object.freeze(Array.from({ length: random() % 25 }, () => alphabet[random() % alphabet.length]));
+    verifyScript(a, b);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context: random() % 6 })), b);
+  }
+  const a = splitLines('head\n+old\n\n-tail\r\n');
+  const b = splitLines('head\n+new\n \n-tail\r\n');
+  assert.equal(joinLines(applyHunks(a, unifiedHunks(a, b))), joinLines(b));
+});
+
+test('zero-line ranges name the preceding line at top, middle, and end', () => {
+  const a = ['a', 'b'];
+  for (const [position, b] of [[0, ['x', 'a', 'b']], [1, ['a', 'x', 'b']], [2, ['a', 'b', 'x']]]) {
+    const inserted = [{ oldStart: position, oldLines: 0,
+      newStart: position + 1, newLines: 1, lines: ['+x'] }];
+    const deleted = [{ oldStart: position + 1, oldLines: 1,
+      newStart: position, newLines: 0, lines: ['-x'] }];
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), inserted);
+    assert.deepEqual(unifiedHunks(b, a, { context: 0 }), deleted);
+    assert.deepEqual(applyHunks(a, inserted), b);
+    assert.deepEqual(applyHunks(b, deleted), a);
+  }
+  assert.deepEqual(unifiedHunks([], [''], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+'] },
+  ]);
+  assert.deepEqual(unifiedHunks([''], [], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('context merges touching regions, without duplication, and leaves wider gaps separate', () => {
+  for (const context of [0, 1, 2, 3]) {
+    for (const gap of [2 * context, 2 * context + 1]) {
+      const a = ['left', 'old1', ...Array.from({ length: gap }, (_, i) => `gap${i}`), 'old2', 'right'];
+      const b = a.map(line => line === 'old1' ? 'new1' : line === 'old2' ? 'new2' : line);
+      const hunks = unifiedHunks(a, b, { context });
+      assert.equal(hunks.length, gap <= 2 * context ? 1 : 2);
+      assert.deepEqual(applyHunks(a, hunks), b);
+      const contextLines = hunks.flatMap(hunk => hunk.lines.filter(line => line[0] === ' '));
+      assert.equal(new Set(contextLines).size, contextLines.length);
+    }
+  }
+  assert.deepEqual(unifiedHunks(['a', 'old', 'b'], ['a', 'new', 'b']), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: [' a', '-old', '+new', ' b'] },
+  ]);
+  for (const context of [-1, 0.5, NaN, Infinity, '1']) {
+    assert.throws(() => unifiedHunks([], [], { context }), RangeError);
+  }
+});
+
+test('separate hunks use global coordinates after both insertions and deletions', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd', 'e', 'f']);
+  const b = ['top', 'a', 'b', 'c', 'e', 'f', 'tail'];
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 4, oldLines: 1, newStart: 4, newLines: 0, lines: ['-d'] },
+    { oldStart: 6, oldLines: 0, newStart: 7, newLines: 1, lines: ['+tail'] },
+  ];
+  assert.deepEqual(unifiedHunks(a, b, { context: 0 }), hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  // Distinct zero-width ranges at the same old boundary are applied in order.
+  assert.deepEqual(applyHunks(['a'], [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 0, oldLines: 0, newStart: 2, newLines: 1, lines: ['+y'] },
+  ]), ['x', 'y', 'a']);
+});
+
+test('malformed, mismatched, overlapping, and out-of-order hunks identify their index', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ['-a', '+x'] };
+  const invalid = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?a'] },
+    { ...valid, lines: ['-wrong', '+x'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, oldStart: 4 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 2 },
+    { ...valid, oldLines: 2 }, { ...valid, newLines: 2 },
+    { ...valid, oldStart: 4, oldLines: 0, lines: ['+x'] },
+    { ...valid, oldStart: 0, oldLines: 0, newStart: 0, lines: ['+x'] },
+  ];
+  for (const field of ['oldStart', 'oldLines', 'newStart', 'newLines']) {
+    for (const value of [undefined, -1, 0.5, NaN, Infinity, '1', Number.MAX_SAFE_INTEGER + 1]) {
+      invalid.push({ ...valid, [field]: value });
+    }
+  }
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  for (const hunks of [undefined, null, {}, 'patch']) {
+    assert.throws(() => applyHunks(a, hunks), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [
+    { oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' c'] }, valid,
+  ]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+x'] },
+  ]), /hunk 1 does not apply/);
+});
+
+test('small changes in 20,000-line unique and repetitive files stay well below one second', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? `repeat${i % 3}` : `line${i}`);
+    const b = a.slice();
+    b.splice(15000, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(5000, 0, 'inserted');
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const applied = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.deepEqual(applied, b);
+    assert.ok(elapsed < 750, `20,000-line roundtrip took ${elapsed.toFixed(1)}ms`);
+  }
+});
