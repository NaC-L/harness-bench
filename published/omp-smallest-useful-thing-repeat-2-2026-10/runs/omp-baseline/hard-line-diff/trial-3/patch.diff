@@ -0,0 +1,178 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const above = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(above, row[j - 1]);
+      diagonal = above;
+    }
+  }
+  return row[b.length];
+}
+
+function checkScript(a, b, script) {
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+    if (entry.op === 'insert') inserted = true;
+  }
+}
+
+test('exhaustive minimal scripts and patch roundtrips with repeated and empty lines', () => {
+  const arrays = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'x', '+x'].map(line => Object.freeze([...lines, line])));
+    arrays.push(...level);
+  }
+  for (const a of arrays) {
+    for (const b of arrays) {
+      const script = diffLines(a, b);
+      checkScript(a, b, script);
+      assert.deepEqual(diffLines(a, b), script);
+      for (const context of [0, 1, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        assert.deepEqual(applyHunks(a, Object.freeze(hunks)), b);
+      }
+    }
+  }
+});
+
+test('zero-length ranges use preceding line numbers at top, middle and end', () => {
+  const a = ['a', 'b'];
+  for (const position of [0, 1, 2]) {
+    const b = [...a.slice(0, position), 'inserted', ...a.slice(position)];
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [{
+      oldStart: position, oldLines: 0, newStart: position + 1, newLines: 1,
+      lines: ['+inserted'],
+    }]);
+    assert.deepEqual(unifiedHunks(b, a, { context: 0 }), [{
+      oldStart: position + 1, oldLines: 1, newStart: position, newLines: 0,
+      lines: ['-inserted'],
+    }]);
+  }
+  assert.deepEqual(unifiedHunks([], ['']), [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+'],
+  }]);
+  assert.deepEqual(unifiedHunks([''], []), [{
+    oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-'],
+  }]);
+});
+
+test('context merges exactly when unchanged gaps touch or overlap', () => {
+  for (const gap of [1, 2, 3]) {
+    const unchanged = Array.from({ length: gap }, (_, i) => `middle ${i}`);
+    const a = ['start', 'old first', ...unchanged, 'old last', 'end'];
+    const b = ['start', 'new first', ...unchanged, 'new last', 'end'];
+    const hunks = unifiedHunks(a, b, { context: 1 });
+    assert.equal(hunks.length, gap <= 2 ? 1 : 2);
+    if (gap <= 2) {
+      assert.deepEqual(hunks, [{
+        oldStart: 1, oldLines: a.length, newStart: 1, newLines: b.length,
+        lines: [' start', '-old first', '+new first', ...unchanged.map(line => ' ' + line),
+          '-old last', '+new last', ' end'],
+      }]);
+    } else {
+      assert.deepEqual(hunks.map(({ oldStart, newStart }) => [oldStart, newStart]), [[1, 1], [5, 5]]);
+    }
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+  const a = ['0', '1', '2', '3', '4', '5', '6', '7', '8'];
+  const b = [...a];
+  b[4] = 'changed';
+  assert.deepEqual(unifiedHunks(a, b)[0].lines,
+    [' 1', ' 2', ' 3', '-4', '+changed', ' 5', ' 6', ' 7']);
+});
+
+test('multiple hunks keep global coordinates after earlier insertions and deletions', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f'];
+  const b = ['top', 'a', 'b', 'd', 'e', 'f', 'bottom'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 3, oldLines: 1, newStart: 3, newLines: 0, lines: ['-c'] },
+    { oldStart: 6, oldLines: 0, newStart: 7, newLines: 1, lines: ['+bottom'] },
+  ]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+});
+
+test('application removes exactly one prefix and retains unmentioned lines', () => {
+  const a = Object.freeze(['-old', '+keep', ' context', '', 'tail']);
+  const hunks = [{
+    oldStart: 1, oldLines: 4, newStart: 1, newLines: 4,
+    lines: ['--old', '++new', ' +keep', '  context', ' '],
+  }];
+  assert.deepEqual(applyHunks(a, hunks), ['+new', '+keep', ' context', '', 'tail']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(unifiedHunks(a, a), []);
+});
+
+test('malformed and nonapplicable hunks identify their index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ['-a', '+A'] };
+  const invalid = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?a'] },
+    { ...valid, lines: ['-wrong', '+A'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, oldStart: 5 },
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: NaN }, { ...valid, oldLines: Infinity },
+    { ...valid, oldLines: -1 }, { ...valid, oldLines: 0 },
+    { ...valid, oldLines: 2 }, { ...valid, oldLines: 4 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 2 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: 2 },
+    { ...valid, newLines: '1' },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const last = { oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: ['-c', '+C'] };
+  assert.throws(() => applyHunks(a, [last, valid]), /hunk 1 does not apply/);
+  const insertion = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] };
+  assert.throws(() => applyHunks(a, [insertion, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+});
+
+test('small changes to 20,000 unique or repetitive lines stay fast', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => `line ${repetitive ? i % 7 : i}`);
+    const b = [...a];
+    b[1] = 'new near top';
+    b.splice(9999, 1);
+    b.splice(15000, 0, '+addition');
+    b[b.length - 2] = 'new near end';
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const patched = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(patched, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 6);
+    assert.ok(elapsed < 1000, `20,000-line diff and roundtrip took ${elapsed.toFixed(1)}ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} lines: ${elapsed.toFixed(1)}ms`);
+    const unchangedStart = performance.now();
+    assert.equal(diffLines(a, a).length, a.length);
+    assert.ok(performance.now() - unchangedStart < 1000);
+  }
+});
