+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small, independent oracle; production must not use a quadratic table.
+function editDistance(a, b) {
+  let previous = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const current = [0];
+    for (let j = 0; j < b.length; j++) {
+      current.push(line === b[j] ? previous[j] + 1 :
+        Math.max(previous[j + 1], current[j]));
+    }
+    previous = current;
+  }
+  return a.length + b.length - 2 * previous[b.length];
+}
+
+function checkPair(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, editDistance(a, b));
+  let sawInsert = false;
+  for (const entry of script) {
+    if (entry.op === 'equal') sawInsert = false;
+    else if (entry.op === 'insert') sawInsert = true;
+    else {
+      assert.equal(entry.op, 'delete');
+      assert.equal(sawInsert, false, 'deletes precede inserts in each region');
+    }
+  }
+  assert.deepEqual(diffLines(a, b), script);
+  for (const context of [0, 1, 2, 3]) {
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+  }
+}
+
+test('minimal deterministic scripts and roundtrips for exhaustive repetitive inputs', () => {
+  const arrays = [[]];
+  for (let length = 1; length <= 4; length++) {
+    for (let bits = 0; bits < 2 ** length; bits++) {
+      arrays.push(Array.from({ length }, (_, i) => bits & (1 << i) ? 'x' : ''));
+    }
+  }
+  for (const a of arrays) for (const b of arrays) checkPair(a, b);
+});
+
+test('seeded random roundtrips including literal hunk prefixes', () => {
+  let seed = 12345;
+  const random = bound => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % bound;
+  };
+  const alphabet = ['', 'repeat', 'other', '+literal', '-literal', ' literal'];
+  const lines = () => Array.from({ length: random(16) }, () => alphabet[random(alphabet.length)]);
+  for (let i = 0; i < 300; i++) checkPair(lines(), lines());
+});
+
+test('zero-line coordinates at top, middle, end and empty files', () => {
+  for (const a of [[], ['a', 'b', 'c']]) {
+    for (let index = 0; index <= a.length; index++) {
+      const b = [...a.slice(0, index), '+inserted', ...a.slice(index)];
+      const insertion = unifiedHunks(a, b, { context: 0 });
+      assert.deepEqual(insertion, [{
+        oldStart: index, oldLines: 0, newStart: index + 1, newLines: 1,
+        lines: ['++inserted'],
+      }]);
+      const deletion = unifiedHunks(b, a, { context: 0 });
+      assert.deepEqual(deletion, [{
+        oldStart: index + 1, oldLines: 1, newStart: index, newLines: 0,
+        lines: ['-+inserted'],
+      }]);
+      assert.deepEqual(applyHunks(a, insertion), b);
+      assert.deepEqual(applyHunks(b, deletion), a);
+    }
+  }
+});
+
+test('context windows merge exactly when they touch and do not duplicate context', () => {
+  for (const gap of [1, 2, 3]) {
+    const middle = Array.from({ length: gap }, (_, i) => `context ${i}`);
+    const a = ['before', 'old1', ...middle, 'old2', 'after'];
+    const b = ['before', 'new1', ...middle, 'new2', 'after'];
+    const hunks = unifiedHunks(a, b, { context: 1 });
+    assert.equal(hunks.length, gap <= 2 ? 1 : 2);
+    const includedMiddle = gap <= 2 ? middle : [middle[0], middle[gap - 1]];
+    assert.deepEqual(hunks.flatMap(h => h.lines), [
+      ' before', '-old1', '+new1', ...includedMiddle.map(line => ' ' + line),
+      '-old2', '+new2', ' after',
+    ]);
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+  assert.deepEqual(unifiedHunks(['same'], ['same']), []);
+  assert.throws(() => unifiedHunks([], [], { context: -1 }), RangeError);
+  assert.throws(() => unifiedHunks([], [], { context: 0.5 }), RangeError);
+});
+
+test('application validates original and new coordinates, contents, counts and ordering', () => {
+  const a = ['a', 'b', 'c', 'd'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 2,
+    lines: ['-b', '+B', '+extra'] };
+  const invalid = [
+    null, {}, { ...valid, oldStart: 0 }, { ...valid, oldStart: 6 },
+    { ...valid, oldStart: 1.5 }, { ...valid, newStart: 3 },
+    { ...valid, oldLines: 2 }, { ...valid, newLines: 1 },
+    { ...valid, oldLines: -1 }, { ...valid, newLines: Infinity },
+    { ...valid, lines: ['-wrong', '+B', '+extra'] },
+    { ...valid, lines: [' b', '+B', '+extra'] },
+    { ...valid, lines: ['?b'] }, { ...valid, lines: [''] },
+    { ...valid, lines: [null] }, { ...valid, lines: 'not an array' },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 4, oldLines: 1, newStart: 4, newLines: 1, lines: [' d'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [{
+    oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: [' wrong'],
+  }]), /hunk 0 does not apply/);
+  assert.deepEqual(applyHunks(a, [valid, {
+    oldStart: 4, oldLines: 1, newStart: 5, newLines: 1, lines: [' d'],
+  }]), ['a', 'B', 'extra', 'c', 'd']);
+});
+
+test('inputs and hunks are not mutated, and unchanged application returns a copy', () => {
+  const a = Object.freeze(['header', '-old', '', 'footer']);
+  const b = Object.freeze(['header', '+new', '', 'extra', 'footer']);
+  diffLines(a, b);
+  const hunks = unifiedHunks(a, b);
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.notEqual(copy, a);
+  assert.deepEqual(copy, a);
+});
+
+test('small edits on 20,000 repetitive lines are fast and roundtrip', () => {
+  const a = Array.from({ length: 20000 }, (_, i) => `line ${i % 7}`);
+  const b = a.slice();
+  b.splice(19000, 1);
+  b.splice(10000, 0, 'inserted');
+  b[100] = 'replacement';
+  const start = performance.now();
+  const script = diffLines(a, b);
+  const hunks = unifiedHunks(a, b);
+  const result = applyHunks(a, hunks);
+  const elapsed = performance.now() - start;
+  assert.deepEqual(result, b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+  assert.ok(elapsed < 1000, `small-edit roundtrip took ${elapsed.toFixed(1)} ms`);
+  assert.equal(diffLines(a, a).length, a.length);
+});
