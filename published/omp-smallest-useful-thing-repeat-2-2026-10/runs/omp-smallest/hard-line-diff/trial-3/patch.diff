+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+function lcs(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const previous = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = previous;
+    }
+  }
+  return row[b.length];
+}
+
+function verify(a, b, contexts) {
+  Object.freeze(a);
+  Object.freeze(b);
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, a.length + b.length - 2 * lcs(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserting = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserting = false;
+    if (entry.op === 'insert') inserting = true;
+    if (entry.op === 'delete') assert.equal(inserting, false);
+  }
+  for (const context of contexts) {
+    const hunks = unifiedHunks(a, b, { context });
+    for (const hunk of hunks) {
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+      assert.equal(hunk.oldLines, hunk.lines.filter(line => line[0] !== '+').length);
+      assert.equal(hunk.newLines, hunk.lines.filter(line => line[0] !== '-').length);
+      assert.ok(hunk.lines.some(line => line[0] !== ' '));
+    }
+    Object.freeze(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    if (a.length === b.length && a.every((line, i) => line === b[i])) assert.deepEqual(hunks, []);
+  }
+}
+
+test('exhaustive minimality, ordering, and roundtrips with repetitive/empty/prefixed lines', () => {
+  let sequences = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(a => ['', '+x', '-x'].map(line => [...a, line]));
+    sequences.push(...level);
+  }
+  for (const a of sequences) for (const b of sequences) verify(a, b, [0, 1, 3]);
+});
+
+test('random longer repetitive cases', () => {
+  let state = 1729;
+  const next = n => { state = (Math.imul(state, 1664525) + 1013904223) >>> 0; return state % n; };
+  for (let iteration = 0; iteration < 1000; iteration++) {
+    const a = Array.from({ length: next(35) }, () => ['', 'a', 'b', ' c', '-d', '+e'][next(6)]);
+    const b = Array.from({ length: next(35) }, () => ['', 'a', 'b', ' c', '-d', '+e'][next(6)]);
+    verify(a, b, [0, 1, 2, 3, 10]);
+  }
+});
+
+test('zero-range coordinates at top, middle, and end', () => {
+  const a = ['a', 'b'];
+  assert.deepEqual(unifiedHunks(a, ['x', ...a], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }
+  ]);
+  assert.deepEqual(unifiedHunks(a, ['a', 'x', 'b'], { context: 0 }), [
+    { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }
+  ]);
+  assert.deepEqual(unifiedHunks(a, [...a, 'x'], { context: 0 }), [
+    { oldStart: 2, oldLines: 0, newStart: 3, newLines: 1, lines: ['+x'] }
+  ]);
+  assert.deepEqual(unifiedHunks(a, ['b'], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-a'] }
+  ]);
+  assert.deepEqual(unifiedHunks(a, ['a'], { context: 0 }), [
+    { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-b'] }
+  ]);
+});
+
+test('context accepts any nonnegative integer and rejects invalid values', () => {
+  for (const context of [0, 1, 3, Number.MAX_SAFE_INTEGER, 1e20]) {
+    assert.deepEqual(applyHunks(['old'], unifiedHunks(['old'], ['new'], { context })), ['new']);
+  }
+  for (const context of [-1, 0.5, NaN, Infinity, '3']) {
+    assert.throws(() => unifiedHunks(['old'], ['new'], { context }), RangeError);
+  }
+});
+
+test('touching context merges; separated context remains distinct', () => {
+  for (let gap = 0; gap <= 8; gap++) {
+    const middle = Array.from({ length: gap }, (_, i) => `same${i}`);
+    const a = ['before', 'old1', ...middle, 'old2', 'after'];
+    const b = ['before', 'new1', ...middle, 'new2', 'after'];
+    for (let context = 0; context <= 4; context++) {
+      const hunks = unifiedHunks(a, b, { context });
+      assert.equal(hunks.length, gap <= 2 * context ? 1 : 2);
+      assert.deepEqual(applyHunks(a, hunks), b);
+      if (gap <= 2 * context) {
+        assert.deepEqual(hunks[0].lines, [
+          ...(context ? [' before'] : []),
+          ...(gap === 0 ? ['-old1', '-old2', '+new1', '+new2'] :
+            ['-old1', '+new1', ...middle.map(line => ' ' + line), '-old2', '+new2']),
+          ...(context ? [' after'] : [])
+        ]);
+      }
+    }
+  }
+});
+
+test('invalid counts, contents, prefixes, coordinates, order, and overlap fail with index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const bad = [null, {}, { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] }, { ...valid, lines: [null] },
+    { ...valid, lines: {} }, { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 5 }, { ...valid, newStart: 0 },
+    { ...valid, newStart: 3 }, { ...valid, oldLines: 2 },
+    { ...valid, newLines: 2 }, { ...valid, oldLines: -1 },
+    { ...valid, oldStart: 1.5 }, { ...valid, newLines: NaN },
+    { ...valid, newStart: Infinity }, { ...valid, oldStart: '2' },
+    { ...valid, oldLines: Number.MAX_SAFE_INTEGER + 1 }];
+  for (const hunk of bad) assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] }]), /hunk 1 does not apply/);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(applyHunks(a, [valid]), ['a', 'B', 'c']);
+  assert.deepEqual(a, ['a', 'b', 'c']);
+});
+
+test('multiple hunks use complete-file old and new coordinates', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f'];
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 2, oldLines: 1, newStart: 3, newLines: 0, lines: ['-b'] },
+    { oldStart: 4, oldLines: 1, newStart: 5, newLines: 2, lines: ['-d', '+D1', '+D2'] },
+    { oldStart: 6, oldLines: 0, newStart: 9, newLines: 1, lines: ['+z'] }
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['x', 'y', 'a', 'c', 'D1', 'D2', 'e', 'f', 'z']);
+});
+
+test('20,000-line small edits stay well under one second', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? String(i % 3) : `line ${i}`);
+    const b = [...a];
+    b.splice(18000, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(1000, 0, 'insertion');
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    const elapsed = performance.now() - start;
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `${elapsed} ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} lines: ${elapsed.toFixed(1)} ms`);
+  }
+});
