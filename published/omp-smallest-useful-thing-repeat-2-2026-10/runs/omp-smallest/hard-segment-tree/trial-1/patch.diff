+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards pending additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 7, 20);
+  tree.assign(0, 7, -4);
+  tree.add(0, 7, 2);
+  assert.equal(tree.sum(1, 6), -10);
+  tree.add(0, 3, 9);
+  tree.assign(0, 7, 0);
+  tree.add(2, 5, -3);
+  assert.deepEqual(tree.toArray(), [0, 0, -3, -3, -3, 0, 0]);
+  assert.equal(tree.sum(0, 7), -9);
+});
+
+test('partial maxima use the identity for negative values', () => {
+  const tree = new RangeTree([-9, -2, -7, -5, -3]);
+  assert.equal(tree.max(0, 2), -2);
+  assert.equal(tree.max(2, 5), -3);
+  assert.equal(tree.max(2, 3), -7);
+  assert.equal(tree.max(3, 3), -Infinity);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 4), -7);
+});
+
+test('threshold search propagates lazy tags before visiting children', () => {
+  const tree = new RangeTree([100, -100, 100, -100, 100]);
+  tree.assign(0, 5, -5);
+  assert.equal(tree.firstAtLeast(0, -4), -1);
+  assert.equal(tree.firstAtLeast(1, -5), 1);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(1, 5), 1);
+  tree.assign(0, 5, -8);
+  tree.add(2, 5, 20);
+  assert.equal(tree.firstAtLeast(0, 12), 2);
+  assert.equal(tree.firstAtLeast(3, 12), 3);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+});
+
+test('mixed operations match an array oracle for uneven and singleton trees', () => {
+  let state = 0x12345678;
+  const random = limit => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 33]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 600; step++) {
+      const a = random(n + 1);
+      const b = random(n + 1);
+      const l = Math.min(a, b);
+      const r = Math.max(a, b);
+      const value = random(41) - 20;
+      if (random(2)) {
+        assert.equal(tree.assign(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] = value;
+      } else {
+        assert.equal(tree.add(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] += value;
+      }
+      // Search first: materialization or other queries must not repair its tags.
+      for (const threshold of [-Infinity, value, 0, 25, Infinity]) {
+        const lo = random(n + 1);
+        assert.equal(tree.firstAtLeast(lo, threshold),
+          values.findIndex((v, i) => i >= lo && v >= threshold));
+      }
+      const q1 = random(n + 1);
+      const q2 = random(n + 1);
+      const ql = Math.min(q1, q2);
+      const qr = Math.max(q1, q2);
+      const slice = values.slice(ql, qr);
+      assert.equal(tree.sum(ql, qr), slice.reduce((sum, v) => sum + v, 0));
+      assert.equal(tree.max(ql, qr), Math.max(-Infinity, ...slice));
+      const index = random(n);
+      assert.equal(tree.get(index), values[index]);
+      if (step % 37 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+    for (let l = 0; l <= n; l++) {
+      for (let r = l; r <= n; r++) {
+        const slice = values.slice(l, r);
+        assert.equal(tree.sum(l, r), slice.reduce((sum, v) => sum + v, 0));
+        assert.equal(tree.max(l, r), Math.max(-Infinity, ...slice));
+      }
+    }
+  }
+});
+
+test('API validation, empty ranges, read-only length, and independent arrays', () => {
+  for (const input of [null, {}, [], [NaN], [Infinity], [1, '2'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 4; }, TypeError);
+  tree.add(0, 3, 2);
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 9), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', undefined, null]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const [lo, x] of [[-1, 0], [4, 0], [0.5, 0], ['0', 0], [0, NaN], [0, '1']]) {
+    assert.throws(() => tree.firstAtLeast(lo, x), RangeError);
+  }
+  for (let i = 0; i <= 3; i++) {
+    assert.equal(tree.assign(i, i, 99), undefined);
+    assert.equal(tree.add(i, i, 99), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  const output = tree.toArray();
+  assert.deepEqual(output, [3, 4, 5]);
+  output[1] = 100;
+  assert.deepEqual(tree.toArray(), [3, 4, 5]);
+});
+
+test('updates and queries visit logarithmically many nodes; materialization is linear', () => {
+  const n = 16384;
+  const tree = new RangeTree(Array(n).fill(0));
+  let visits = 0;
+  for (const method of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[method];
+    tree[method] = function (...args) {
+      visits++;
+      return original.apply(this, args);
+    };
+  }
+  const logarithmic = operation => {
+    visits = 0;
+    operation();
+    assert.ok(visits <= 8 * Math.ceil(Math.log2(n)) + 1, `visited ${visits} nodes`);
+  };
+  logarithmic(() => tree.assign(0, n, -8));
+  logarithmic(() => tree.add(1, n - 1, 3));
+  logarithmic(() => tree.assign(3, n - 3, 7));
+  logarithmic(() => assert.equal(tree.firstAtLeast(5, 7), 5));
+  logarithmic(() => assert.equal(tree.firstAtLeast(0, 8), -1));
+  logarithmic(() => assert.equal(tree.sum(1, n - 1), (n - 6) * 7 - 20));
+  logarithmic(() => assert.equal(tree.max(1, n - 1), 7));
+  logarithmic(() => assert.equal(tree.get(n - 2), -5));
+  visits = 0;
+  assert.equal(tree.toArray().length, n);
+  assert.equal(visits, 2 * n - 1);
+});
