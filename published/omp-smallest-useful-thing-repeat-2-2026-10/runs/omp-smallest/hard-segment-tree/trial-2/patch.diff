@@ -0,0 +1,145 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 9);
+  tree.add(3, 7, -4);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  assert.equal(tree.sum(1, 6), -10);
+  assert.equal(tree.max(1, 6), -2);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-2));
+
+  tree.add(0, 7, 5);
+  tree.assign(0, 7, 10);
+  tree.add(0, 7, 2);
+  assert.equal(tree.sum(2, 6), 48);
+  assert.deepEqual(tree.toArray(), Array(7).fill(12));
+});
+
+test('partial maxima retain negative values', () => {
+  const tree = new RangeTree([-9, -4, -7, -2, -6]);
+  assert.equal(tree.max(0, 2), -4);
+  assert.equal(tree.max(2, 3), -7);
+  assert.equal(tree.max(1, 4), -2);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 1), -10);
+  assert.equal(tree.max(2, 5), -7);
+});
+
+test('threshold search sees lazy assignment and addition before other queries', () => {
+  const tree = new RangeTree([9, 0, 0, 9, 0]);
+  tree.assign(0, 5, 4);
+  assert.equal(tree.firstAtLeast(0, 4), 0);
+  assert.equal(tree.firstAtLeast(1, 4), 1);
+  assert.equal(tree.firstAtLeast(0, 5), -1);
+  tree.add(0, 5, 3);
+  assert.equal(tree.firstAtLeast(2, 7), 2);
+  tree.assign(0, 3, -8);
+  tree.add(3, 5, -2);
+  assert.equal(tree.firstAtLeast(0, 5), 3);
+  assert.equal(tree.firstAtLeast(4, 5), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+});
+
+test('API validation, empty ranges, read-only length, and array independence', () => {
+  for (const input of [[], null, undefined, {}, '123', [1, NaN], [Infinity],
+    [-Infinity], ['1'], [undefined], new Array(2), new Float64Array([1])]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [2, -3, 5];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 99; }, TypeError);
+  const output = tree.toArray();
+  output[1] = 99;
+  assert.deepEqual(tree.toArray(), [2, -3, 5]);
+
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, 2.5],
+    [NaN, 2], [0, Infinity], ['0', 2], [0, undefined]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined, {}]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', undefined, null, {}]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 8), undefined);
+    assert.equal(tree.add(i, i, -8), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), [2, -3, 5]);
+  assert.equal(tree.assign(0, 1, 6), undefined);
+  assert.equal(tree.add(0, 1, 2), undefined);
+  assert.equal(tree.get(0), 8);
+});
+
+test('mixed lazy updates and queries agree with a seeded plain-array oracle', () => {
+  let seed = 0x9e3779b9;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 5, 8, 17, 31, 64]) {
+    for (let trial = 0; trial < 12; trial++) {
+      const values = Array.from({ length }, () => random(41) - 20);
+      const tree = new RangeTree(values);
+      for (let step = 0; step < 250; step++) {
+        let l = random(length + 1);
+        let r = random(length + 1);
+        if (l > r) [l, r] = [r, l];
+        if (step % 4 === 0) [l, r] = [0, length];
+        const value = random(41) - 20;
+        const assigning = random(2) === 0;
+        tree[assigning ? 'assign' : 'add'](l, r, value);
+        for (let i = l; i < r; i++) {
+          values[i] = assigning ? value : values[i] + value;
+        }
+
+        // Search first: materializing or querying leaves could hide stale tags.
+        const lo = random(length + 1);
+        const threshold = step % 11 === 0 ? -Infinity :
+          step % 13 === 0 ? Infinity : random(61) - 30;
+        const found = values.findIndex((v, i) => i >= lo && v >= threshold);
+        const context = `length=${length}, trial=${trial}, step=${step}`;
+        assert.equal(tree.firstAtLeast(lo, threshold), found, context);
+        for (let query = 0; query < 3; query++) {
+          let start = random(length + 1);
+          let end = random(length + 1);
+          if (start > end) [start, end] = [end, start];
+          const slice = values.slice(start, end);
+          assert.equal(tree.sum(start, end), slice.reduce((a, b) => a + b, 0), context);
+          assert.equal(tree.max(start, end), Math.max(...slice), context);
+        }
+        const index = random(length);
+        assert.equal(tree.get(index), values[index], context);
+        assert.equal(tree.sum(0, length), values.reduce((a, b) => a + b, 0), context);
+        assert.equal(tree.max(0, length), Math.max(...values), context);
+        if (step % 17 === 0) assert.deepEqual(tree.toArray(), values, context);
+      }
+      assert.deepEqual(tree.toArray(), values);
+    }
+  }
+});
