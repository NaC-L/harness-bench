+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both the assigned node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(3, 7, -10);
+  tree.add(0, 7, 4);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -3);
+  tree.assign(1, 6, -8);
+  tree.add(2, 5, 2);
+  assert.equal(tree.sum(1, 6), -34);
+  assert.deepEqual(tree.toArray(), [-3, -8, -6, -6, -6, -8, -3]);
+});
+
+test('partial maxima remain negative', () => {
+  const tree = new RangeTree([-9, -8, -7, -6, -5]);
+  assert.equal(tree.max(0, 2), -8);
+  assert.equal(tree.max(2, 4), -6);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 4), -17);
+  assert.equal(tree.max(4, 5), -20);
+});
+
+test('threshold searches push pending updates before reading children', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.assign(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(2, 10), 2);
+  tree.add(0, 5, -20);
+  assert.equal(tree.firstAtLeast(0, -9), -1);
+  tree.add(2, 5, 11);
+  assert.equal(tree.firstAtLeast(0, 0), 2);
+  tree.assign(0, 5, -2);
+  tree.add(0, 5, 9);
+  assert.equal(tree.firstAtLeast(1, 7), 1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(3, -Infinity), 3);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('API validation, empty ranges, and array ownership are preserved', () => {
+  for (const values of [[], null, undefined, '1', new Float64Array([1]),
+    [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 9; }, TypeError);
+  const invalidRanges = [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN],
+    ['0', 2], [0, Infinity], [undefined, 2]];
+  for (const [l, r] of invalidRanges) {
+    for (const method of ['sum', 'max', 'assign', 'add']) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '2', null, undefined]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    for (let i = 0; i <= tree.length; i++) {
+      assert.equal(tree[method](i, i, 7), undefined);
+    }
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), [2, -3, 4]);
+  const output = tree.toArray();
+  output[0] = 100;
+  assert.equal(tree.get(0), 2);
+  assert.equal(tree.assign(0, 1, 5), undefined);
+  assert.equal(tree.add(0, 1, -2), undefined);
+  assert.equal(tree.get(0), 3);
+});
+
+test('mixed lazy operations agree with a plain array across many tree shapes', () => {
+  let seed = 0x12345678;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 8) % limit;
+  };
+  for (const n of [1, 2, 3, 7, 8, 17, 32, 65, 129]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    const checkSearch = () => {
+      const lo = random(n + 1);
+      const x = random(81) - 40;
+      assert.equal(tree.firstAtLeast(lo, x),
+        values.findIndex((value, i) => i >= lo && value >= x));
+    };
+    for (let step = 0; step < 600; step++) {
+      const a = random(n + 1);
+      const b = random(n + 1);
+      const l = step % 5 === 0 ? 0 : Math.min(a, b);
+      const r = step % 5 === 0 ? n : Math.max(a, b);
+      const value = random(41) - 20;
+      if (random(2) === 0) {
+        tree.assign(l, r, value);
+        values.fill(value, l, r);
+      } else {
+        tree.add(l, r, value);
+        for (let i = l; i < r; i++) values[i] += value;
+      }
+      // Leave batches of tags pending; search first so other queries cannot
+      // accidentally repair stale children before the search is exercised.
+      if (step % 11 !== 0) continue;
+      for (let query = 0; query < 10; query++) {
+        checkSearch();
+        const a = random(n + 1);
+        const b = random(n + 1);
+        const l = Math.min(a, b);
+        const r = Math.max(a, b);
+        const slice = values.slice(l, r);
+        assert.equal(tree.sum(l, r), slice.reduce((sum, v) => sum + v, 0));
+        assert.equal(tree.max(l, r), Math.max(-Infinity, ...slice));
+        const i = random(n);
+        assert.equal(tree.get(i), values[i]);
+      }
+      assert.deepEqual(tree.toArray(), values);
+    }
+    checkSearch();
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
