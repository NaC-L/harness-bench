@@ -0,0 +1,186 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+// A small, independent oracle; never used for the large-file checks.
+function editDistance(a, b) {
+  let previous = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const next = [0];
+    for (let j = 0; j < b.length; j++) {
+      next.push(line === b[j]
+        ? previous[j] + 1
+        : Math.max(previous[j + 1], next[j]));
+    }
+    previous = next;
+  }
+  return a.length + b.length - 2 * previous[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length, editDistance(a, b));
+  let inserting = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserting = false;
+    if (entry.op === 'insert') inserting = true;
+    if (entry.op === 'delete') assert.equal(inserting, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+function checkRoundtrip(a, b, context) {
+  const hunks = unifiedHunks(a, b, { context });
+  for (const hunk of hunks) {
+    assert.equal(hunk.oldLines, hunk.lines.filter(line => line[0] !== '+').length);
+    assert.equal(hunk.newLines, hunk.lines.filter(line => line[0] !== '-').length);
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+}
+
+test('exhaustive minimal scripts and patch roundtrips with repeated and empty lines', () => {
+  const inputs = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'repeat'].map(line => Object.freeze([...lines, line])));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      checkScript(a, b);
+      for (const context of [0, 1, 2, 3]) checkRoundtrip(a, b, context);
+    }
+  }
+});
+
+test('deterministic random inputs include prefix characters and ambiguous subsequences', () => {
+  let seed = 123456789;
+  const next = () => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed;
+  };
+  const alphabet = ['', 'a', 'b', 'c', '+plus', '-minus', ' space'];
+  const input = () => Object.freeze(Array.from({ length: next() % 20 }, () => alphabet[next() % alphabet.length]));
+  for (let i = 0; i < 300; i++) {
+    const a = input();
+    const b = input();
+    checkScript(a, b);
+    for (const context of [0, 1, 3, 20]) checkRoundtrip(a, b, context);
+  }
+});
+
+test('zero-line ranges use the preceding line, including beginning and end', () => {
+  const cases = [
+    [[], ['x'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['x'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a'], ['x', 'a'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a'], ['a', 'x'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['x', 'a'], ['a'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x'], ['a'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, hunk] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [hunk]);
+    assert.deepEqual(applyHunks(a, [hunk]), b);
+  }
+});
+
+test('context touching merges hunks once; larger gaps retain complete-file coordinates', () => {
+  const a = ['top', 'old1', 'gap1', 'gap2', 'old2', 'bottom'];
+  const b = ['top', 'new1', 'gap1', 'gap2', 'new2', 'bottom'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' top', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' bottom'],
+  }]);
+  a.splice(3, 0, 'gap-extra');
+  b.splice(3, 0, 'gap-extra');
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: [' top', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3, lines: [' gap2', '-old2', '+new2', ' bottom'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  for (const context of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => unifiedHunks(a, b, { context }), RangeError);
+  }
+});
+
+test('application retains unmentioned lines and tracks earlier insertions and deletions', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd', 'e']);
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 2, oldLines: 2, newStart: 3, newLines: 0, lines: ['-b', '-c'] },
+    { oldStart: 5, oldLines: 0, newStart: 6, newLines: 1, lines: ['+z'] },
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['x', 'y', 'a', 'd', 'e', 'z']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  const prefixed = ['+a', '-b', ' c', ''];
+  checkRoundtrip(prefixed, ['+a', '-changed', ' ', '', '+'], 3);
+});
+
+test('application rejects malformed, mismatched, unordered, and overlapping hunks', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null,
+    {},
+    { ...valid, oldStart: -1 },
+    { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 5 },
+    { ...valid, oldStart: 1.5 },
+    { ...valid, oldLines: -1 },
+    { ...valid, oldLines: 3 },
+    { ...valid, oldLines: NaN },
+    { ...valid, newStart: 0 },
+    { ...valid, newStart: 1 },
+    { ...valid, newStart: Infinity },
+    { ...valid, newLines: 2 },
+    { ...valid, lines: null },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] },
+    { ...valid, lines: [42] },
+    { ...valid, lines: ['-b', '-c', '+B'] },
+    { ...valid, lines: ['-b', '+B', '+extra'] },
+    { ...valid, lines: ['-b'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 3, oldLines: 0, newStart: 3, newLines: 1, lines: ['+x'],
+  }]), /hunk 1 does not apply/);
+});
+
+test('small changes to 20,000-line files run in under a second', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'repeated' : `line ${i}`);
+    const b = a.slice();
+    b.splice(19000, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(100, 0, 'inserted');
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const result = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(result, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `small diff took ${elapsed.toFixed(1)}ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} lines: ${elapsed.toFixed(1)}ms`);
+  }
+});
