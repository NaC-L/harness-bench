+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A quadratic oracle is deliberately limited to tiny test inputs.
+function lcsLength(a, b) {
+  let previous = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const current = [0];
+    for (let j = 0; j < b.length; j++) {
+      current.push(line === b[j] ? previous[j] + 1
+        : Math.max(previous[j + 1], current[j]));
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function verifyScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+  return script;
+}
+
+test('exhaustive short repetitive inputs have minimal ordered scripts and patch roundtrips', () => {
+  const arrays = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 3; length++) {
+    level = level.flatMap(prefix => ['', 'a', 'b'].map(line => [...prefix, line]));
+    arrays.push(...level);
+  }
+  for (const a of arrays) {
+    for (const b of arrays) {
+      verifyScript(a, b);
+      for (const context of [0, 1, 2, 3]) {
+        assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+      }
+    }
+  }
+});
+
+test('seeded larger repetitive inputs preserve minimality and exact prefixed lines', () => {
+  let state = 123456;
+  const random = limit => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  };
+  const alphabet = ['', 'same', 'same', '+plus', '-minus', ' space', '\r'];
+  for (let trial = 0; trial < 200; trial++) {
+    const a = Object.freeze(Array.from({ length: random(30) }, () => alphabet[random(alphabet.length)]));
+    const b = Object.freeze(Array.from({ length: random(30) }, () => alphabet[random(alphabet.length)]));
+    verifyScript(a, b);
+    for (const context of [0, 1, 3, 100]) {
+      const hunks = unifiedHunks(a, b, { context });
+      for (const hunk of hunks) {
+        Object.freeze(hunk.lines);
+        Object.freeze(hunk);
+      }
+      assert.deepEqual(applyHunks(a, Object.freeze(hunks)), b);
+    }
+  }
+});
+
+test('zero-length ranges use preceding global line numbers across multiple hunks', () => {
+  const a = ['a', 'b', 'c', 'd', 'e'];
+  const b = ['x', 'a', 'b', 'd', 'e', 'y'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 3, oldLines: 1, newStart: 3, newLines: 0, lines: ['-c'] },
+    { oldStart: 5, oldLines: 0, newStart: 6, newLines: 1, lines: ['+y'] },
+  ]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(unifiedHunks(['a'], [], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-a'] },
+  ]);
+  assert.deepEqual(unifiedHunks([], ['a'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+a'] },
+  ]);
+});
+
+test('context merges touching regions but not separated regions', () => {
+  const a = Array.from({ length: 10 }, (_, i) => String(i));
+  const touching = a.slice();
+  touching[2] = 'two';
+  touching[5] = 'five';
+  assert.deepEqual(unifiedHunks(a, touching, { context: 1 }), [{
+    oldStart: 2, oldLines: 6, newStart: 2, newLines: 6,
+    lines: [' 1', '-2', '+two', ' 3', ' 4', '-5', '+five', ' 6'],
+  }]);
+  const separated = a.slice();
+  separated[2] = 'two';
+  separated[6] = 'six';
+  assert.deepEqual(unifiedHunks(a, separated, { context: 1 }), [
+    { oldStart: 2, oldLines: 3, newStart: 2, newLines: 3, lines: [' 1', '-2', '+two', ' 3'] },
+    { oldStart: 6, oldLines: 3, newStart: 6, newLines: 3, lines: [' 5', '-6', '+six', ' 7'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  assert.equal(unifiedHunks(a, separated)[0].oldStart, 1);
+});
+
+test('applying hunks strips exactly one prefix and returns independent arrays', () => {
+  const a = Object.freeze(['+old', '-keep', ' space', '']);
+  const b = ['-new', '-keep', ' space', '', '+end'];
+  assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+  const copied = applyHunks(a, []);
+  assert.deepEqual(copied, a);
+  assert.notEqual(copied, a);
+});
+
+test('malformed coordinates, counts, prefixes and original lines fail with the hunk index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ['-a', '+x'] };
+  const invalid = [
+    null, {},
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: '1' },
+    { ...valid, oldStart: 5 }, { ...valid, oldLines: 4 },
+    { ...valid, oldLines: -1 }, { ...valid, oldLines: NaN },
+    { ...valid, oldLines: Infinity }, { ...valid, oldLines: 0 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 2 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: 2 },
+    { ...valid, lines: null }, { ...valid, lines: [''] },
+    { ...valid, lines: [1] }, { ...valid, lines: ['?a'] },
+    { ...valid, lines: ['-wrong', '+x'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['-a', '-b', '+x'] },
+    { ...valid, lines: ['+x'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [
+    { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-b'] },
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-a'] },
+  ]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' c'] },
+  ]), /hunk 1 does not apply/);
+  assert.deepEqual(a, ['a', 'b', 'c']);
+});
+
+test('invalid context values are rejected', () => {
+  for (const context of [-1, 0.5, NaN, Infinity, '3', null]) {
+    assert.throws(() => unifiedHunks([], [], { context }), RangeError);
+  }
+});
+
+test('small edits on 20,000-line inputs complete well under one second', t => {
+  const start = performance.now();
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? `line ${i % 3}` : `line ${i}`);
+    const b = a.slice();
+    b.splice(10, 0, 'inserted');
+    b[10000] = 'replacement';
+    b.splice(19000, 1);
+    const script = diffLines(a, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+    assert.deepEqual(diffLines(a, a).map(entry => entry.op), new Array(a.length).fill('equal'));
+  }
+  const elapsed = performance.now() - start;
+  t.diagnostic(`20,000-line distinct/repetitive scenarios: ${elapsed.toFixed(1)} ms`);
+  assert.ok(elapsed < 1000, `small edits took ${elapsed.toFixed(1)} ms`);
+});
