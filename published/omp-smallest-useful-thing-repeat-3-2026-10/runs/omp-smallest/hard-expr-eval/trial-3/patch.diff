@@ -0,0 +1,136 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('power is right associative with Python unary precedence', () => {
+  const examples = [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625], ['+2 ** +3', 8],
+    ['--2 ** 2', 4], ['3 * -2 ** 2', -12],
+    ['8 / 2 * 3', 12], ['10 - 3 - 2', 5], ['17 // 3 % 2', 1],
+  ];
+  for (const [source, expected] of examples) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo preserve the integer identity and divisor sign', () => {
+  for (let a = -30; a <= 30; a += 1) {
+    for (let b = -10; b <= 10; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      if (quotient === 0) assert.equal(Object.is(quotient, -0), false);
+      if (remainder === 0) assert.equal(Object.is(remainder, -0), false);
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+});
+
+test('comparisons chain, return booleans, and coerce to numbers in arithmetic', () => {
+  const examples = [
+    ['1 < 2 < 3', true], ['3 > 2 > 1', true], ['1 < 2 > 1', true],
+    ['1 < 2 == 2 != 3 <= 4 >= 4', true], ['3 < 2 < 1', false],
+    ['2 == 2 == 2', true], ['1 + 2 < 2 * 2', true],
+    ['(1 < 2) == 1', true], ['(2 < 1) == 0', true],
+    ['(1 < 2) + (2 < 1)', 1], ['-(1 < 2)', -1],
+    ['(1 < 2) ** 3', 1], ['1 < (2 < 3)', false],
+  ];
+  for (const [source, expected] of examples) assert.equal(evaluate(source), expected, source);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+});
+
+test('getters are read once per occurrence, left to right, without mutation', () => {
+  const reads = [];
+  let b = 1;
+  const variables = Object.freeze(Object.defineProperties({}, {
+    a: { get() { reads.push('a'); return 0; } },
+    b: { get() { reads.push('b'); return b++; } },
+    c: { get() { reads.push('c'); return 2; } },
+    d: { get() { reads.push('d'); return 4; } },
+  }));
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a + b, abs(-c), d)', variables), 4);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+  reads.length = 0;
+  assert.equal(evaluate('d < a < b', variables), false);
+  assert.deepEqual(reads, ['d', 'a']);
+  reads.length = 0;
+  assert.equal(evaluate('b + b', variables), 7);
+  assert.deepEqual(reads, ['b', 'b']);
+});
+
+test('numbers, own variables, parentheses and built-in calls', () => {
+  assert.equal(evaluate('1.5e-3 + .5 + 5. + 2E+1'), 25.5015);
+  assert.equal(evaluate('min(4, max(2, 3), abs(-1))'), 1);
+  assert.equal(evaluate('min(7)'), 7);
+  assert.equal(evaluate('max(7)'), 7);
+  assert.equal(evaluate('abs(1 < 2)'), 1);
+  assert.equal(evaluate('_a1 + Z9', { _a1: 4, Z9: 6 }), 10);
+  assert.equal(evaluate('min + max + abs', { min: 1, max: 2, abs: 3 }), 6);
+  assert.equal(evaluate('constructor', { constructor: 8 }), 8);
+  errorAt('toString', 1, {});
+  errorAt('inherited', 1, Object.create({ inherited: 5 }));
+  assert.equal(evaluate('x', Object.assign(Object.create(null), { x: 3 })), 3);
+});
+
+test('error columns point to tokens after whitespace and include trailing whitespace at EOF', () => {
+  for (const operator of ['/', '//', '%']) {
+    const source = `  4   ${operator} -0`;
+    errorAt(source, source.indexOf(operator) + 1);
+  }
+  for (const [source, column] of [
+    ['  missing', 3], ['1 +\n  missing', 7], [' \t@', 3], ['  😀', 3],
+    ['  1  2', 6], ['  1 + )', 7], ['1 +   ', 7], ['', 1],
+    [' \t\n', 4], ['(1  ', 5], ['max(1,   ', 10], ['max(1,)', 7],
+    ['  nope(1)', 3], ['  abs()', 3], ['  abs(1,2)', 3],
+    ['  min()', 3], ['  max()', 3], ['2(3)', 2], ['x = 2', 3],
+    ['1 ! 2', 3], ['1 + "x"', 5], ['1e+', 2],
+  ]) errorAt(source, column);
+});
+
+test('the entire formula is parsed before any getter or arithmetic is evaluated', () => {
+  const variables = { get x() { assert.fail('getter must not run for invalid source'); } };
+  errorAt('x + unknown(1)', 5, variables);
+  errorAt('x + abs(1, 2)', 5, variables);
+  errorAt('x + 1 2', 7, variables);
+  errorAt('1 / 0 + abs()', 9);
+  errorAt('3 < 2 < unknown(1)', 9);
+  errorAt('3 < 2 < abs(1, 2)', 9);
+  errorAt('3 < 2 < (1 + )', 14);
+});
+
+test('100,001-operand flat formulas evaluate iteratively in linear time', () => {
+  const count = 100001;
+  const cases = [
+    [Array(count).fill('1').join('+'), count],
+    [Array(count).fill('1').join('*'), 1],
+    [Array.from({ length: count }, (_, i) => String(i)).join('<'), true],
+    [`max(${Array(count).fill('1').join(',')})`, 1],
+  ];
+  for (const [source, expected] of cases) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected);
+    const elapsed = performance.now() - start;
+    assert.ok(elapsed < 1000, `${source.length}-character formula took ${elapsed.toFixed(1)}ms`);
+  }
+});
