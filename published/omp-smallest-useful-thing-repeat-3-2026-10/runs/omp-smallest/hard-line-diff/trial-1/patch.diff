+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// The quadratic oracle is deliberately restricted to tiny test inputs.
+function lcsLength(a, b) {
+  let previous = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const current = [0];
+    for (let j = 0; j < b.length; j++) {
+      current.push(line === b[j] ? previous[j] + 1 :
+        Math.max(previous[j + 1], current[j]));
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function verifyScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('minimal, deterministic scripts and patch roundtrips on exhaustive repeated lines', () => {
+  const inputs = [[]];
+  let layer = [[]];
+  for (let length = 1; length <= 3; length++) {
+    layer = layer.flatMap(lines => ['', 'a', 'b'].map(line => [...lines, line]));
+    inputs.push(...layer);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      verifyScript(a, b);
+      for (const context of [0, 1, 2, 3]) {
+        assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+      }
+    }
+  }
+});
+
+test('larger seeded cases retain minimality, prefixes, and untouched inputs', () => {
+  let seed = 1234567;
+  const random = () => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed;
+  };
+  const alphabet = ['', 'same', '+plus', '-minus', ' space', '\r'];
+  for (let trial = 0; trial < 400; trial++) {
+    const a = Object.freeze(Array.from({ length: random() % 15 },
+      () => alphabet[random() % alphabet.length]));
+    const b = Object.freeze(Array.from({ length: random() % 15 },
+      () => alphabet[random() % alphabet.length]));
+    verifyScript(a, b);
+    const hunks = unifiedHunks(a, b, { context: trial % 5 });
+    for (const hunk of hunks) {
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+    }
+    Object.freeze(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+});
+
+test('zero-length ranges use preceding line coordinates at every boundary', () => {
+  for (const [a, b, expected] of [
+    [[], ['x'], [0, 0, 1, 1, ['+x']]],
+    [['x'], [], [1, 1, 0, 0, ['-x']]],
+    [['a'], ['x', 'a'], [0, 0, 1, 1, ['+x']]],
+    [['a'], ['a', 'x'], [1, 0, 2, 1, ['+x']]],
+    [['a', 'b'], ['a', 'x', 'b'], [1, 0, 2, 1, ['+x']]],
+    [['a', 'b'], ['b'], [1, 1, 0, 0, ['-a']]],
+    [['a', 'b'], ['a'], [2, 1, 1, 0, ['-b']]],
+    [['a', 'x', 'b'], ['a', 'b'], [2, 1, 1, 0, ['-x']]],
+  ]) {
+    const [oldStart, oldLines, newStart, newLines, lines] = expected;
+    const hunks = unifiedHunks(a, b, { context: 0 });
+    assert.deepEqual(hunks, [{ oldStart, oldLines, newStart, newLines, lines }]);
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+});
+
+test('context merges touching regions but leaves larger gaps separate', () => {
+  assert.deepEqual(unifiedHunks(['same'], ['same']), []);
+  for (const gap of [0, 1, 2, 3, 4, 5]) {
+    const between = Array.from({ length: gap }, (_, i) => `context ${i}`);
+    const a = ['first', ...between, 'last'];
+    const b = ['new first', ...between, 'new last'];
+    const hunks = unifiedHunks(a, b, { context: 1 });
+    assert.equal(hunks.length, gap <= 2 ? 1 : 2);
+    if (gap <= 2) {
+      assert.deepEqual(hunks, [{
+        oldStart: 1, oldLines: a.length, newStart: 1, newLines: b.length,
+        lines: gap === 0 ? ['-first', '-last', '+new first', '+new last'] :
+          ['-first', '+new first', ...between.map(line => ` ${line}`),
+            '-last', '+new last'],
+      }]);
+    } else {
+      assert.deepEqual(hunks, [
+        { oldStart: 1, oldLines: 2, newStart: 1, newLines: 2,
+          lines: ['-first', '+new first', ` ${between[0]}`] },
+        { oldStart: a.length - 1, oldLines: 2, newStart: b.length - 1, newLines: 2,
+          lines: [` ${between[gap - 1]}`, '-last', '+new last'] },
+      ]);
+    }
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+});
+
+test('application checks content, counts, bounds, order, and result coordinates', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1,
+    lines: ['-b', '+B'] };
+  const invalid = [
+    null,
+    { ...valid, oldStart: 0 },
+    { ...valid, newStart: 0 },
+    { ...valid, oldStart: 5 },
+    { ...valid, oldStart: 1.5 },
+    { ...valid, oldLines: -1 },
+    { ...valid, oldLines: 2 },
+    { ...valid, newLines: 2 },
+    { ...valid, newStart: 1 },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] },
+    { ...valid, lines: [null] },
+    { ...valid, lines: null },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const first = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] };
+  assert.throws(() => applyHunks(a, [first, valid]), /hunk 1 does not apply/);
+  assert.deepEqual(applyHunks(a, [first, { ...valid, newStart: 3 }]),
+    ['top', 'a', 'B', 'c']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('small edits to 20,000 lines, including repetitions, run below one second', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(100, 1, 'replacement');
+    b.splice(10000, 0, 'inserted');
+    b.splice(19000, 1);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const result = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+    assert.deepEqual(result, b);
+    assert.ok(elapsed < 1000, `small edit took ${elapsed.toFixed(1)} ms`);
+    t.diagnostic(`${repetitive ? 'repeated' : 'unique'} lines: ${elapsed.toFixed(1)} ms`);
+  }
+});
