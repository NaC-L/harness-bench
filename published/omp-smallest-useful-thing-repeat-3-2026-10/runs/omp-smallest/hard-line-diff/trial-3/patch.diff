@@ -0,0 +1,171 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+const { splitLines, joinLines } = require('./lines');
+
+// A deliberately quadratic oracle is only used for tiny test inputs.
+function lcsLength(a, b) {
+  let row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const next = [0];
+    for (let j = 0; j < b.length; j++) {
+      next.push(line === b[j] ? row[j] + 1 : Math.max(row[j + 1], next[j]));
+    }
+    row = next;
+  }
+  return row[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  return script;
+}
+
+test('exhaustive minimality, deletion ordering, and repetitive-line roundtrips', () => {
+  const inputs = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'a', 'b'].map(line => [...lines, line]));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      checkScript(a, b);
+      for (const context of [0, 1, 3]) {
+        assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+      }
+    }
+  }
+});
+
+test('deterministic scripts with repeated lines and longer mixed edits', () => {
+  let seed = 123456789;
+  const random = max => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % max;
+  };
+  for (let trial = 0; trial < 200; trial++) {
+    const a = Array.from({ length: random(40) }, () => ['', 'x', 'y', 'z'][random(4)]);
+    const b = Array.from({ length: random(40) }, () => ['', 'x', 'y', 'z'][random(4)]);
+    assert.deepEqual(diffLines(a, b), checkScript(a, b));
+    for (const context of [0, 1, 2, 5]) {
+      assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+    }
+  }
+});
+
+test('zero-length ranges use preceding line coordinates at top and bottom', () => {
+  const cases = [
+    [[], ['x'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['x'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a'], ['x', 'a'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a'], ['a', 'x'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['x', 'a'], ['a'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x'], ['a'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, hunk] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [hunk]);
+    assert.deepEqual(applyHunks(a, [hunk]), b);
+  }
+});
+
+test('context merges exactly when gaps touch and is not duplicated', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];
+  const b = ['A', 'b', 'c', 'd', 'e', 'f', 'G'];
+  assert.deepEqual(unifiedHunks(a, b), [{
+    oldStart: 1, oldLines: 7, newStart: 1, newLines: 7,
+    lines: ['-a', '+A', ' b', ' c', ' d', ' e', ' f', '-g', '+G'],
+  }]);
+  assert.deepEqual(unifiedHunks(a, b, { context: 2 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: ['-a', '+A', ' b', ' c'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3, lines: [' e', ' f', '-g', '+G'] },
+  ]);
+  const touchingA = ['a', 'b', 'c', 'd', 'e', 'f'];
+  const touchingB = ['A', 'b', 'c', 'd', 'e', 'F'];
+  const touching = unifiedHunks(touchingA, touchingB, { context: 2 });
+  assert.equal(touching.length, 1);
+  assert.deepEqual(touching[0].lines, ['-a', '+A', ' b', ' c', ' d', ' e', '-f', '+F']);
+});
+
+test('multiple hunks use complete-file coordinates and preserve omitted lines', () => {
+  const a = ['a', 'b', 'c', 'd', 'e'];
+  const b = ['top', 'a', 'b', 'c', 'e', 'end'];
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 4, oldLines: 1, newStart: 4, newLines: 0, lines: ['-d'] },
+    { oldStart: 5, oldLines: 0, newStart: 6, newLines: 1, lines: ['+end'] },
+  ];
+  assert.deepEqual(unifiedHunks(a, b, { context: 0 }), hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+});
+
+test('prefix characters, empty lines, exact whitespace, and immutable inputs', () => {
+  const a = Object.freeze(splitLines(' header\n-old\n+unchanged\n\nend\n'));
+  const b = Object.freeze(splitLines(' header\n+new\n+unchanged\n \nend\n'));
+  const hunks = unifiedHunks(a, b);
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.equal(joinLines(applyHunks(a, hunks)), joinLines(b));
+  assert.deepEqual(unifiedHunks(a, a), []);
+  const copy = applyHunks(a, []);
+  assert.notEqual(copy, a);
+  assert.deepEqual(copy, a);
+});
+
+test('malformed, inconsistent, mismatching, unordered, and overlapping hunks fail', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] };
+  const malformed = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [''] },
+    { ...valid, lines: ['?a'] }, { ...valid, lines: [42] },
+    { ...valid, lines: [' wrong'] }, { ...valid, lines: ['-wrong', '+a'] },
+    { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: 4 }, { ...valid, newStart: 2 },
+    { ...valid, oldLines: 2 }, { ...valid, newLines: 2 },
+    { ...valid, oldLines: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, newLines: Infinity }, { ...valid, oldLines: Number.MAX_SAFE_INTEGER + 1 },
+  ];
+  for (const hunk of malformed) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const later = { oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' c'] };
+  assert.throws(() => applyHunks(a, [later, valid]), /hunk 1 does not apply/);
+  const insertion = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] };
+  assert.throws(() => applyHunks(a, [insertion, later]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+});
+
+test('small edits in 20,000-line unique and repetitive files remain fast', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? `line ${i % 7}` : `line ${i}`);
+    const b = a.slice();
+    b[7] = 'replacement';
+    b.splice(10000, 0, 'inserted');
+    b.splice(19995, 1);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+    const elapsed = performance.now() - start;
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} 20,000-line diff and roundtrip: ${elapsed.toFixed(1)} ms`);
+    assert.ok(elapsed < 1000, `small edit took ${elapsed.toFixed(1)} ms`);
+  }
+});
