+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(3, 7, -10);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  assert.equal(tree.sum(1, 6), -10);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-2));
+  tree.add(0, 7, 8);
+  tree.assign(0, 7, -5);
+  tree.assign(2, 5, 3);
+  assert.deepEqual(tree.toArray(), [-5, -5, 3, 3, 3, -5, -5]);
+});
+
+test('partial maximum queries have a negative-infinity identity', () => {
+  const tree = new RangeTree([-7, -3, -9, -4, -8]);
+  assert.equal(tree.max(0, 2), -3);
+  assert.equal(tree.max(2, 5), -4);
+  tree.assign(0, 5, -12);
+  tree.add(1, 4, 2);
+  assert.equal(tree.max(2, 3), -10);
+  assert.equal(tree.max(0, 0), -Infinity);
+});
+
+test('threshold search propagates pending assignments and additions', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0]);
+  tree.assign(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 8), 0);
+  assert.equal(tree.firstAtLeast(3, 8), 3);
+  tree.add(0, 5, 5);
+  assert.equal(tree.firstAtLeast(1, 14), 1);
+  tree.assign(0, 5, -10);
+  tree.assign(4, 5, 3);
+  assert.equal(tree.firstAtLeast(0, 0), 4);
+  tree.add(0, 5, -5);
+  assert.equal(tree.firstAtLeast(0, -1), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('validation, empty ranges, read-only length, and independent arrays', () => {
+  for (const values of [null, {}, '123', [], [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  tree.assign(0, 3, 4);
+  tree.add(0, 3, 2);
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, 1.5], [NaN, 2], [0, Infinity], ['0', 2], [0, null]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 9), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '2', null, undefined, {}]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, Infinity, '1', null]) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '1', null]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', null, undefined, {}]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 100), undefined);
+    assert.equal(tree.add(i, i, -100), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), [6, 6, 6]);
+  const output = tree.toArray();
+  output[1] = 100;
+  assert.equal(tree.get(1), 6);
+  assert.equal(tree.assign(1, 2, 0), undefined);
+  assert.equal(tree.add(1, 2, -1), undefined);
+  assert.deepEqual(tree.toArray(), [6, -1, 6]);
+});
+
+test('seeded mixed workloads agree with an independent array model', () => {
+  for (const size of [1, 2, 3, 7, 16, 31, 65]) {
+    for (const seed of [1, 12345, 0xdeadbeef]) {
+      let state = seed;
+      const random = (limit) => {
+        state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+        return state % limit;
+      };
+      const values = Array.from({ length: size }, () => random(41) - 20);
+      const tree = new RangeTree(values);
+      const model = values.slice();
+      for (let step = 0; step < 1000; step++) {
+        let l = random(size + 1);
+        let r = random(size + 1);
+        if (l > r) [l, r] = [r, l];
+        // Regular full-cover updates leave tags above older child tags.
+        if (step % 11 === 0) [l, r] = [0, size];
+        const value = random(41) - 20;
+        const operation = random(7);
+        const context = `size=${size}, seed=${seed}, step=${step}`;
+        if (operation === 0 || operation === 1) {
+          const method = operation === 0 ? 'assign' : 'add';
+          assert.equal(tree[method](l, r, value), undefined, context);
+          for (let i = l; i < r; i++) {
+            model[i] = operation === 0 ? value : model[i] + value;
+          }
+        } else if (operation === 2) {
+          assert.equal(tree.sum(l, r), model.slice(l, r).reduce((a, b) => a + b, 0), context);
+        } else if (operation === 3) {
+          assert.equal(tree.max(l, r), Math.max(-Infinity, ...model.slice(l, r)), context);
+        } else if (operation === 4) {
+          const i = random(size);
+          assert.equal(tree.get(i), model[i], context);
+        } else {
+          const lo = random(size + 1);
+          const threshold = operation === 5 ? value : (step % 2 ? Infinity : -Infinity);
+          const expected = model.findIndex((v, i) => i >= lo && v >= threshold);
+          assert.equal(tree.firstAtLeast(lo, threshold), expected, context);
+        }
+        if (step % 97 === 96) assert.deepEqual(tree.toArray(), model, context);
+      }
+      assert.deepEqual(tree.toArray(), model);
+      for (let l = 0; l <= size; l++) {
+        for (let r = l; r <= size; r++) {
+          assert.equal(tree.sum(l, r), model.slice(l, r).reduce((a, b) => a + b, 0));
+          assert.equal(tree.max(l, r), Math.max(-Infinity, ...model.slice(l, r)));
+        }
+      }
+    }
+  }
+});
+
+test('range operations visit logarithmically many nodes and toArray visits each node once', () => {
+  const size = 4097;
+  const tree = new RangeTree(Array(size).fill(0));
+  const counts = {};
+  for (const name of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[name];
+    counts[name] = 0;
+    tree[name] = function (...args) {
+      counts[name]++;
+      return original.apply(this, args);
+    };
+  }
+  const check = (name, operation) => {
+    counts[name] = 0;
+    operation();
+    assert.ok(counts[name] <= 8 * Math.ceil(Math.log2(size)), `${name}: ${counts[name]} visits`);
+  };
+  check('_update', () => tree.assign(0, size, -2));
+  check('_update', () => tree.add(1, size - 1, 1));
+  check('_sum', () => assert.equal(tree.sum(1, size - 1), -(size - 2)));
+  check('_max', () => assert.equal(tree.max(1, size - 1), -1));
+  check('_sum', () => assert.equal(tree.get(size - 1), -2));
+  check('_first', () => assert.equal(tree.firstAtLeast(size - 2, -1), size - 2));
+  check('_first', () => assert.equal(tree.firstAtLeast(1, 0), -1));
+  check('_update', () => tree.assign(size - 1, size, 5));
+  check('_first', () => assert.equal(tree.firstAtLeast(1, 0), size - 1));
+  const values = tree.toArray();
+  assert.equal(values.length, size);
+  assert.equal(counts._write, 2 * size - 1);
+});
