@@ -0,0 +1,145 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+function expectedFirst(values, lo, threshold) {
+  return values.findIndex((value, index) => index >= lo && value >= threshold);
+}
+
+function checkState(tree, values) {
+  // Search first: get(), partial queries, and toArray() can push lazy tags and
+  // accidentally hide a missing push in threshold search.
+  for (let lo = 0; lo <= values.length; lo++) {
+    for (const threshold of [-Infinity, -10, 0, 5, 20, Infinity]) {
+      assert.equal(tree.firstAtLeast(lo, threshold), expectedFirst(values, lo, threshold));
+    }
+  }
+  for (let l = 0; l <= values.length; l++) {
+    for (let r = l; r <= values.length; r++) {
+      const slice = values.slice(l, r);
+      assert.equal(tree.sum(l, r), slice.reduce((sum, value) => sum + value, 0));
+      assert.equal(tree.max(l, r), Math.max(...slice));
+    }
+    if (l < values.length) assert.equal(tree.get(l), values[l]);
+  }
+  assert.deepEqual(tree.toArray(), values);
+}
+
+test('assignment discards additions at both the overwritten node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(4, 8, -3);
+  tree.add(0, 8, 6);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -2);
+  assert.equal(tree.sum(2, 6), -8);
+  checkState(tree, Array(8).fill(-2));
+
+  tree.add(0, 8, 9);
+  tree.assign(1, 7, -5);
+  tree.add(2, 6, 3);
+  tree.assign(3, 5, -8);
+  checkState(tree, [7, -5, -2, -8, -8, -2, -5, 7]);
+});
+
+test('partial maxima use negative infinity as the identity', () => {
+  const tree = new RangeTree([-9, -7, -5, -3, -1]);
+  assert.equal(tree.max(0, 4), -3);
+  assert.equal(tree.max(1, 2), -7);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 2);
+  checkState(tree, [-20, -18, -18, -18, -20]);
+});
+
+test('threshold search propagates updates before inspecting child maxima', () => {
+  const tree = new RangeTree([-5, -4, -3, -2, -1]);
+  tree.assign(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(3, 10), 3);
+  tree.add(0, 5, 7);
+  assert.equal(tree.firstAtLeast(1, 17), 1);
+  tree.assign(0, 3, -20);
+  assert.equal(tree.firstAtLeast(0, 0), 3);
+  tree.add(0, 5, -30);
+  assert.equal(tree.firstAtLeast(0, -10), -1);
+  checkState(tree, [-50, -50, -50, -13, -13]);
+});
+
+test('deterministic mixed updates and queries agree with an array oracle', () => {
+  for (const length of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    let seed = 0x12345678 ^ length;
+    const random = (limit) => {
+      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+      return seed % limit;
+    };
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 500; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 7 === 0) [l, r] = [0, length];
+      const value = random(41) - 20;
+      const assigning = random(2) === 0;
+      assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+
+      const lo = random(length + 1);
+      const threshold = random(81) - 40;
+      assert.equal(tree.firstAtLeast(lo, threshold), expectedFirst(values, lo, threshold));
+      let ql = random(length + 1);
+      let qr = random(length + 1);
+      if (ql > qr) [ql, qr] = [qr, ql];
+      const slice = values.slice(ql, qr);
+      assert.equal(tree.sum(ql, qr), slice.reduce((sum, item) => sum + item, 0));
+      assert.equal(tree.max(ql, qr), Math.max(...slice));
+      const index = random(length);
+      assert.equal(tree.get(index), values[index]);
+      if (step % 53 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    checkState(tree, values);
+  }
+});
+
+test('validation, empty ranges, read-only length, and array independence are preserved', () => {
+  for (const input of [null, {}, [], [NaN], [Infinity], [-Infinity], ['1'], Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1.5, -2.25, 3.75];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  const output = tree.toArray();
+  output[1] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 1]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', undefined, null]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 100), undefined);
+    assert.equal(tree.add(i, i, 100), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.equal(tree.firstAtLeast(3, -Infinity), -1);
+  checkState(tree, [1.5, -2.25, 3.75]);
+});
