+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('missing packages and empty version maps are unsatisfiable', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('validates unreachable versions, ranges and maps eagerly', () => {
+  for (const registry of [
+    { unused: [] }, { unused: null }, { unused: { bad: {} } },
+    { unused: { '1.0.0\n': {} } }, { unused: { '1.0.0': [] } },
+    { unused: { '1.0.0': { missing: '' } } },
+    { unused: { '1.0.0': { missing: '>bad' } } },
