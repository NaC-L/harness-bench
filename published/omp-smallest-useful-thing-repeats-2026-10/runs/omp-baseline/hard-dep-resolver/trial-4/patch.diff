+  }
+  assert.throws(() => resolve({}, { missing: 1 }), TypeError);
+  assert.throws(() => resolve({ unused: { bad: {} } }, { missing: '*' }), TypeError);
+});
+
+test('honors own enumerable string keys, null prototypes and special names without mutation', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.freeze({ '1.0.0': Object.freeze({}) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'hidden', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(root, 'hidden', { value: 'invalid' });
+  root[Symbol('ignored')] = 'invalid';
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+  assert.deepEqual(resolve(registry, root), result);
+});
+
+test('long chains and deep backtracking do not use recursive stack depth', () => {
+  const count = 15000;
+  const registry = {};
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': i + 1 === count ? { p0: '1.0.0' } : { [`p${i + 1}`]: '*' } };
+  }
+  registry.p0['2.0.0'] = { p1: '*' };
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, count);
+  assert.equal(result.p0, '1.0.0');
+  assert.equal(result[`p${count - 1}`], '1.0.0');
+});
+
+test('rejects discovered conflicts before exploring unrelated Cartesian choices', { timeout: 5000 }, () => {
+  const registry = { guard: { '1.0.0': {}, '2.0.0': {} } };
+  const root = {};
+  for (let i = 0; i < 40; i += 1) {
+    registry[`p${i}`] = { '2.0.0': { guard: '2.0.0' }, '1.0.0': {} };
+    root[`p${i}`] = '*';
+  }
+  root.guard = '1.0.0';
+  const result = resolve(registry, root);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+});
+
+// Small independent copy-on-branch oracle: no reversible trails or early pruning.
+function reference(registry, root) {
+  function search(selected, queue, cursor, constraints) {
+    while (cursor < queue.length && Object.hasOwn(selected, queue[cursor])) cursor += 1;
+    if (cursor === queue.length) return selected;
+    const name = queue[cursor];
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints[name].every(range => satisfies(version, range))) continue;
+      const next = { ...selected, [name]: version };
+      const pending = queue.slice();
+      const tests = Object.fromEntries(Object.entries(constraints).map(([key, ranges]) => [key, ranges.slice()]));
+      let valid = true;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        (tests[dependency] ||= []).push(range);
+        pending.push(dependency);
+        if (Object.hasOwn(next, dependency) && !satisfies(next[dependency], range)) {
+          valid = false;
+          break;
+        }
+      }
+      if (valid) {
+        const result = search(next, pending, cursor + 1, tests);
+        if (result !== null) return result;
+      }
+    }
+    return null;
+  }
+  return search({}, Object.keys(root), 0, Object.fromEntries(Object.entries(root).map(([name, range]) => [name, [range]])));
+}
+
+test('matches first-found reference search on generated cyclic registries', () => {
+  let seed = 123456789;
+  const random = bound => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % bound;
+  };
+  const ranges = ['*', '1.0.0', '2.0.0', '>=2.0.0', '<3.0.0'];
+  const names = ['a', 'b', 'c'];
+  for (let sample = 0; sample < 300; sample += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (let major = 1; major <= 3; major += 1) {
+        const deps = {};
+        for (const dependency of [...names, 'missing']) {
+          if (random(5) === 0) deps[dependency] = ranges[random(ranges.length)];
+        }
+        registry[name][`${major}.0.0`] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names.slice().reverse()) {
+      if (random(2) === 0) root[name] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), reference(registry, root), `sample ${sample}`);
+  }
+});
