+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { compare, satisfies } = require('./semver');
+
+test('sorts every version component numerically', () => {
+  const versions = { '2.0.0': {}, '10.0.0': {}, '10.9.0': {}, '10.10.9': {}, '10.10.10': {} };
+  assert.deepEqual(resolve({ a: versions }, { a: '*' }), { a: '10.10.10' });
+});
+
+test('first-found selection follows root and FIFO dependency order', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+  assert.deepEqual(resolve({
+    a: { '1.0.0': { c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '*' }), { a: '1.0.0', b: '2.0.0', c: '1.0.0' });
+});
+
+test('collects all discovered constraints before choosing a queued dependency', () => {
+  assert.deepEqual(resolve({
+    a: { '1.0.0': { c: '*' } },
+    b: { '1.0.0': { c: '<2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0' });
+});
+
+test('rolls back constraints and partially appended dependencies', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '1.0.0', missing: '*' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*' }), { a: '1.0.0', b: '2.0.0' });
+});
+
+test('backtracks through descendants and removes abandoned reachability', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { d: '*' } },
+    b: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+    d: { '1.0.0': {} },
