+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { compare, satisfies } = require('./semver');
+
+function frozen(value) {
+  for (const child of Object.values(value)) {
+    if (child && typeof child === 'object') frozen(child);
+  }
+  return Object.freeze(value);
+}
+
+test('versions are ordered numerically by every component', () => {
+  for (const versions of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    const registry = { p: Object.fromEntries(versions.map(version => [version, {}])) };
+    assert.deepEqual(resolve(registry, { p: '*' }), { p: versions[1] });
+  }
+});
+
+test('rollback removes failed choices, dependencies, and their constraints', () => {
+  const registry = frozen({
+    a: { '2.0.0': { b: '1.0.0', ghost: '*' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': { a: '1.0.0' } },
+  });
+  assert.deepEqual(resolve(registry, frozen({ a: '*' })), { a: '1.0.0', b: '2.0.0' });
+  assert.deepEqual(resolve(registry, { a: '2.0.0' }), null);
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0' });
+});
+
+test('rollback removes packages already selected on an abandoned branch', () => {
+  const registry = {
+    a: { '2.0.0': { obsolete: '*', b: '*' }, '1.0.0': { replacement: '*' } },
+    obsolete: { '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { missing: '*' } },
+    replacement: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', replacement: '1.0.0' });
+});
+
+test('partial dependency discovery is undone before retrying the same frame', () => {
+  const registry = {
+    a: { '3.0.0': { a: '1.0.0', missing: '*' }, '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0' });
+});
+
+test('root key order determines the first solution, not a global version maximum', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+});
+
+test('requirements are processed FIFO, not by recursively visiting dependencies', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': {} },
+    c: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '2.0.0', c: '1.0.0' });
+});
+
+test('dependency key order determines discovery order', () => {
+  const registry = {
+    a: { '1.0.0': { b: '*', c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': {} },
+    c: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0', c: '1.0.0' });
+  registry.a['1.0.0'] = { c: '*', b: '*' };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', c: '2.0.0', b: '1.0.0' });
+});
+
+test('all discovered requirements constrain candidates, including later root keys', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '1.0.0' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('cycles expand each selected package only once and conflicts can backtrack', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve(registry, { a: '2.0.0' }), null);
+});
+
+test('long chains, cyclic chains, and rollback do not use the recursive call stack', () => {
+  const size = 15000;
+  const registry = {};
+  for (let i = 0; i < size; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % size}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, size);
+  assert.equal(result[`p${size - 1}`], '1.0.0');
+  registry.p0['0.0.0'] = {};
+  registry[`p${size - 1}`]['1.0.0'] = { missing: '*' };
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '0.0.0' });
+});
+
+test('discovered conflicts are checked before enumerating unrelated combinations', () => {
+  const registry = { a: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} } };
+  const root = { a: '*' };
+  const expected = { a: '1.0.0' };
+  for (let i = 0; i < 60; i += 1) {
+    registry[`p${i}`] = { '2.0.0': {}, '1.0.0': {} };
+    root[`p${i}`] = '*';
+    expected[`p${i}`] = '2.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('only selected dependencies participate in reachability', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': { missing: '*' } },
+    unrelated: { '1.0.0': { missing: '*' } },
+  };
+  assert.deepEqual(resolve(registry, {}), {});
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0' });
+  assert.equal(resolve(registry, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+});
+
+test('plain and null-prototype maps and special own string keys are safe', () => {
+  const names = ['__proto__', 'constructor', 'toString', 'hasOwnProperty'];
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of names) {
+    registry[name] = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(root, 'ignored', { value: null });
+  root[Symbol('ignored')] = null;
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), names);
+  for (const name of names) assert.equal(result[name], '1.0.0');
+  assert.equal(resolve({}, { toString: '*' }), null);
+});
+
+test('malformed maps, versions, and ranges are validated even when unreachable', () => {
+  const invalidMaps = [null, [], new Date(), new Map(), Object.create({}), 1, 'map', () => {}];
+  for (const value of invalidMaps) {
+    assert.throws(() => resolve(value, {}), TypeError);
+    assert.throws(() => resolve({}, value), TypeError);
+    assert.throws(() => resolve({ unused: value }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': value } }, {}), TypeError);
+  }
+  for (const version of ['1.2', '01.2.3', '1.2.3\n', '1.2.3-beta', '9007199254740992.0.0']) {
+    assert.throws(() => resolve({ unused: { [version]: {} } }, {}), TypeError);
+  }
+  for (const range of ['', ' ', null, 1, '||', '>= 1.0.0', '^01.0.0', '* nope']) {
+    assert.throws(() => resolve({ unused: { '1.0.0': { missing: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { missing: range }), TypeError);
+  }
+});
+
+// An intentionally small, copy-on-branch reference implementation. Unlike the
+// production trail, independent snapshots cannot retain abandoned constraints.
+function referenceResolve(registry, root) {
+  function search(selected, queue, constraints, cursor) {
+    if (cursor === queue.length) return selected;
+    const name = queue[cursor];
+    if (Object.hasOwn(selected, name)) return search(selected, queue, constraints, cursor + 1);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints[name].every(range => satisfies(version, range))) continue;
+      const nextSelected = { ...selected, [name]: version };
+      const nextQueue = queue.slice();
+      const nextConstraints = Object.fromEntries(Object.entries(constraints).map(([key, ranges]) => [key, ranges.slice()]));
+      let valid = true;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        (nextConstraints[dependency] ||= []).push(range);
+        nextQueue.push(dependency);
+        if (Object.hasOwn(nextSelected, dependency) && !satisfies(nextSelected[dependency], range)) {
+          valid = false;
+          break;
+        }
+      }
+      if (valid) {
+        const result = search(nextSelected, nextQueue, nextConstraints, cursor + 1);
+        if (result !== null) return result;
+      }
+    }
+    return null;
+  }
+  return search({}, Object.keys(root), Object.fromEntries(Object.entries(root).map(([name, range]) => [name, [range]])), 0);
+}
+
+test('first-found results match independent snapshot search on seeded cyclic graphs', () => {
+  let seed = 0x51f15e;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  }
+  const names = ['a', 'b', 'c', 'd', 'e'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=1.0.0 <2.0.0'];
+  for (let trial = 0; trial < 1000; trial += 1) {
+    const registry = {};
+    const root = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0']) {
+        const deps = {};
+        for (let i = random(4); i > 0; i -= 1) {
+          const dependency = random(7);
+          deps[names[dependency] || 'missing'] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+      if (random(3) === 0) root[name] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `trial ${trial}`);
+  }
+});
