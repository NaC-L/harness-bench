+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+
+test('semver uses canonical safe integer triples and numeric ordering', () => {
+  assert.deepEqual(parse('9007199254740991.10.0'), [Number.MAX_SAFE_INTEGER, 10, 0]);
+  assert.equal(compare('1.10.0', '1.9.99'), 1);
+  assert.equal(compare('2.0.0', '10.0.0'), -1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+  for (const value of [null, 123, '', '1.2', '01.2.3', '1.02.3', '1.2.03',
+    '-1.2.3', '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3 ', '1.2.3\n',
+    '1.2.3\r', '1.2.3\u2028', '9007199254740992.0.0']) {
+    assert.throws(() => parse(value), TypeError);
+  }
+});
+
+test('semver range operators, conjunctions, zero-major carets, and boundary values', () => {
+  const cases = [
+    ['0.2.3', '^0.2.3', true], ['0.2.9', '^0.2.3', true],
+    ['0.2.2', '^0.2.3', false], ['0.3.0', '^0.2.3', false],
+    ['0.0.3', '^0.0.3', true], ['0.0.4', '^0.0.3', false],
+    ['0.0.0', '^0.0.0', true], ['0.0.1', '^0.0.0', false],
+    ['1.9.9', '^1.2.3', true], ['2.0.0', '^1.2.3', false],
+    ['0.0.9', '~0.0.3', true], ['0.1.0', '~0.0.3', false],
+    ['1.2.9', '~1.2.3', true], ['1.3.0', '~1.2.3', false],
+    ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false],
+    ['1.2.3', '>=1.2.3', true], ['1.2.3', '>1.2.3', false],
+    ['1.2.3', '<=1.2.3', true], ['1.2.3', '<1.2.3', false],
+    ['1.5.0', ' \t>=1.0.0 <2.0.0 *\n', true],
+    ['2.0.0', '>=1.0.0 <2.0.0', false],
+    ['9007199254740991.0.0', '^9007199254740991.0.0', true],
+    ['0.9007199254740991.0', '^0.9007199254740991.0', true],
+    ['0.0.9007199254740991', '^0.0.9007199254740991', true],
+    ['1.9007199254740991.0', '~1.9007199254740991.0', true],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected);
+  }
+  for (const range of [null, 1, '', ' \t\n', '^', '~', '>=', '1.2', 'v1.2.3',
+    '1.x', '>= 1.2.3', '1.2.3 || 2.0.0', '*junk', '=>1.2.3', '^01.2.3']) {
+    assert.throws(() => compileRange(range), TypeError);
+  }
+});
+
+test('numeric candidate sorting covers all three components', () => {
+  assert.deepEqual(resolve({
+    a: { '9.99.99': {}, '10.0.0': {} },
+    b: { '1.9.99': {}, '1.10.0': {} },
+    c: { '1.0.9': {}, '1.0.10': {} },
+  }, { a: '*', b: '*', c: '*' }), { a: '10.0.0', b: '1.10.0', c: '1.0.10' });
+});
+
+test('FIFO discovery gathers constraints before processing and preserves first-found choices', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+
+  assert.deepEqual(resolve({
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+    c: { '2.0.0': { b: '2.0.0' }, '1.0.0': {} },
+  }, { a: '*', b: '*', c: '*' }), { a: '2.0.0', b: '1.0.0', c: '1.0.0' });
+});
+
+test('rollback removes constraints, queued dependencies, and abandoned selections', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { x: '*', a: '1.0.0', never: '*' }, '1.0.0': {} },
+    x: { '1.0.0': {} },
+  }, { a: '*' }), { a: '1.0.0' });
+
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '*' }, '1.0.0': {} },
+    b: { '1.0.0': { missing: '*' } },
+  }, { a: '*' }), { a: '1.0.0' });
+
+  assert.deepEqual(resolve({
+    a: { '1.0.0': { b: '*', c: '*' } },
+    b: { '2.0.0': { shared: '2.0.0' }, '1.0.0': { shared: '1.0.0' } },
+    c: { '1.0.0': { shared: '1.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0', shared: '1.0.0' });
+});
+
+test('cycles terminate, satisfy all incoming constraints, and backtrack on conflicts', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  }, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+  assert.equal(resolve({}, { absent: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+});
+
+test('maps are eagerly validated, own-enumerable only, immutable, and prototype-safe', () => {
+  for (const value of [null, [], 1, new Date(), Object.create({})]) {
+    assert.throws(() => resolve(value, {}), TypeError);
+    assert.throws(() => resolve({}, value), TypeError);
+    assert.throws(() => resolve({ unused: value }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': value } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { 'bad': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { missing: '^' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '^' }), TypeError);
+  assert.throws(() => resolve({ a: {}, unused: { '1.0.0': [] } }, { a: '*' }), TypeError);
+
+  const names = ['__proto__', 'constructor', 'toString'];
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of names) {
+    registry[name] = Object.freeze({ '1.0.0': Object.freeze({}) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'hidden', { value: null });
+  Object.defineProperty(root, 'hidden', { value: null });
+  registry[Symbol('ignored')] = null;
+  root[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), names);
+  for (const name of names) assert.equal(result[name], '1.0.0');
+  assert.deepEqual(resolve(registry, {}), {});
+});
+
+test('deep chains and cycles do not depend on call-stack depth or an iteration cap', () => {
+  const length = 15000;
+  const registry = {};
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % length}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length);
+  assert.equal(result[`p${length - 1}`], '1.0.0');
+
+  registry.start = { '2.0.0': { p0: '*' }, '1.0.0': {} };
+  registry[`p${length - 1}`] = { '1.0.0': { absent: '*' } };
+  assert.deepEqual(resolve(registry, { start: '*' }), { start: '1.0.0' });
+});
+
+test('discovered conflicts prune before any Cartesian product of unrelated choices', { timeout: 5000 }, () => {
+  const registry = { a: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} } };
+  const root = { a: '*' };
+  for (let i = 0; i < 80; i += 1) {
+    registry[`p${i}`] = { '2.0.0': {}, '1.0.0': {} };
+    root[`p${i}`] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(result.a, '1.0.0');
+  for (let i = 0; i < 80; i += 1) assert.equal(result[`p${i}`], '2.0.0');
+});
+
+// A small, independent copy-on-branch reference search: recursion is bounded to
+// four packages here, while production must handle arbitrary chain lengths.
+function referenceResolve(registry, root) {
+  function search(selected, requirements, cursor) {
+    for (const [name, range] of requirements) {
+      if (Object.hasOwn(selected, name) && !satisfies(selected[name], range)) return null;
+    }
+    if (cursor === requirements.length) return selected;
+    const name = requirements[cursor][0];
+    if (Object.hasOwn(selected, name)) return search(selected, requirements, cursor + 1);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!requirements.every(([other, range]) => other !== name || satisfies(version, range))) continue;
+      const result = search({ ...selected, [name]: version },
+        requirements.concat(Object.entries(registry[name][version])), cursor + 1);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search({}, Object.entries(root), 0);
+}
+
+test('first-found assignment agrees with a copy-on-branch reference on generated graphs', () => {
+  let seed = 0x53a92;
+  function random(n) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '3.0.0', '>=2.0.0', '<3.0.0'];
+  for (let iteration = 0; iteration < 400; iteration += 1) {
+    const registry = {};
+    for (const name of names) {
+      const versions = registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        if (random(5) === 0) continue;
+        const deps = versions[version] = {};
+        for (let j = 0, count = random(4); j < count; j += 1) {
+          const dependency = random(8) === 0 ? 'missing' : names[random(names.length)];
+          deps[dependency] = ranges[random(ranges.length)];
+        }
+      }
+    }
+    const root = {};
+    for (let j = 0, count = random(5); j < count; j += 1) {
+      root[names[random(names.length)]] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root),
+      JSON.stringify({ iteration, registry, root }));
+  }
+});
