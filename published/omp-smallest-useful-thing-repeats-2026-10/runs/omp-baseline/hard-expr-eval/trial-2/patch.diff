@@ -0,0 +1,184 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('literals, grouping, built-ins and left-associative arithmetic', () => {
+  const cases = [
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['8 - 3 - 2', 3],
+    ['24 / 4 / 2', 3],
+    ['20 // 3 * 2 % 5', 2],
+    ['2 + 3 * 4', 14],
+    ['(2 + 3) * 4', 20],
+    ['min(4, max(1, 7, 3), abs(-2))', 2],
+    ['max(1)', 1],
+    ['min(1)', 1],
+    ['1 < 2 + 3 * 4', true],
+    ['(1 < 2) + (2 < 1)', 1],
+    ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true],
+    ['(1 < 2) ** 3', 1],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+  assert.equal(evaluate('_amount + rate2', { _amount: 3, rate2: 4 }), 7);
+});
+
+test('power is right associative and has asymmetric unary precedence', () => {
+  const cases = [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['-2 ** 3 ** 2', -512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['2 ** +3 ** 2', 512],
+    ['--2 ** 2', 4],
+    ['3 * -2 ** 2', -12],
+    ['-2 ** 2 * 3', -12],
+    ['2 ** -1 * 4', 2],
+    ['1 - -2 ** 2', 5],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo obey sign, integer identity and positive-zero rules', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -7; b <= 7; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      const expected = Math.floor(a / b);
+      assert.equal(quotient, expected === 0 ? 0 : expected);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      assert.ok(!Object.is(quotient, -0));
+      assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  // Adding the divisor unconditionally would lose this small positive remainder.
+  assert.equal(evaluate('0.1 % 1e20'), 0.1);
+  for (const operator of ['/', '//', '%']) {
+    for (const zero of ['0', '-0', '(1 > 2)']) {
+      const source = `  7   ${operator} ${zero}`;
+      errorAt(source, source.indexOf(operator) + 1);
+    }
+  }
+});
+
+test('comparison chains share operands, short circuit and preserve grouping', () => {
+  const cases = [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2', true],
+    ['3 > 2 >= 2 != 1 == 1', true],
+    ['1 == 1 != 2', true],
+    ['3 < 2 < missing', false],
+    ['3 < 2 < 1 / 0', false],
+    ['(3 < 2) < 1', true],
+    ['0 < (3 < 2)', false],
+    ['2 > 1 > 0', true],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < d', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a + b, c, abs(-d))', variables), 4);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+});
+
+test('variables are own properties and each occurrence is read in source order', () => {
+  let count = 0;
+  const variables = Object.freeze({ get x() { return ++count; } });
+  assert.equal(evaluate('x + x * x', variables), 7);
+  assert.equal(count, 3);
+  count = 0;
+  assert.equal(evaluate('x ** x ** x', variables), 1);
+  assert.equal(count, 3);
+  errorAt('  inherited', 3, Object.create({ inherited: 1 }));
+  errorAt('toString', 1, {});
+  const own = Object.create(null);
+  own.__proto__ = 7;
+  assert.equal(evaluate('__proto__', own), 7);
+});
+
+test('errors use actual token columns and include all trailing whitespace at EOF', () => {
+  const cases = [
+    ['  missing', 3],
+    ['1 + \t missing', 7],
+    ['1 + \t @', 7],
+    ['1 + \t \u{1F600}', 7],
+    ['  1   2', 7],
+    ['  2(3)', 4],
+    ['  (1 + 2   ]', 12],
+    ['  nope(1)', 3],
+    ['  min()', 3],
+    ['  max()', 3],
+    ['  abs()', 3],
+    ['  abs(1, 2)', 3],
+    ['  min(1,)', 9],
+    ['1e+', 2],
+    ['1 = 2', 3],
+  ];
+  for (const [source, column] of cases) errorAt(source, column);
+  for (const source of ['', '  \t', '1 +   ', 'min(1,   ', '(1 + 2   ', '2 **   ']) {
+    errorAt(source, source.length + 1);
+  }
+});
+
+test('the entire source is parsed before evaluating any variables or operands', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  for (const source of ['x + abs(1, 2)', 'x + nope(2)', 'x + min()', 'x + (2', 'x @']) {
+    assert.throws(() => evaluate(source, variables), ExprError);
+    assert.equal(reads, 0);
+  }
+  errorAt('3 < 2 < nope(1)', 9);
+  errorAt('3 < 2 < abs(1, 2)', 9);
+  errorAt('3 < 2 < (1 + )', 14);
+  errorAt('1 / 0 + abs(1, 2)', 9);
+});
+
+test('100,001-operand flat arithmetic, comparisons and calls are stack safe', t => {
+  const count = 100001;
+  const cases = [
+    ['addition', '1+'.repeat(count - 1) + '1', count],
+    ['subtraction', '1-'.repeat(count - 1) + '1', 2 - count],
+    ['product', '1*'.repeat(count - 1) + '1', 1],
+    ['comparison', '1<='.repeat(count - 1) + '1', true],
+    ['call', 'max(' + '1,'.repeat(count - 1) + '1)', 1],
+  ];
+  for (const [name, source, expected] of cases) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected, name);
+    t.diagnostic(`${name}: ${(performance.now() - start).toFixed(1)} ms`);
+  }
+  let reads = 0;
+  const variables = { get x() { reads += 1; return reads; } };
+  assert.equal(evaluate('x<'.repeat(count - 1) + 'x', variables), true);
+  assert.equal(reads, count);
+});
