@@ -0,0 +1,158 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('numeric literals, arithmetic precedence, and left associativity', () => {
+  for (const [source, expected] of [
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['10 - 3 - 2', 5],
+    ['24 / 4 / 2', 3],
+    ['20 // 3 * 2 % 5', 2],
+    ['2 + 3 * 4', 14],
+    ['(2 + 3) * 4', 20],
+    ['--2 + +-3', -1],
+    ['1\t+\n2', 3],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('power is right associative and binds above unary on its left', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625],
+    ['2 ** +3 ** 2', 512],
+    ['3 * -2 ** 2 + 1', -11],
+    ['2 ** 3 * 2', 16],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo obey signs and the integer identity', () => {
+  for (let a = -15; a <= 15; a++) {
+    for (let b = -7; b <= 7; b++) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const source of ['-0 // 2', '0 // -2', '-6 % 3', '6 % -3', '-0 % 2']) {
+    assert.ok(Object.is(evaluate(source), 0), source);
+  }
+});
+
+test('comparison chains compare shared operands, not intermediate booleans', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 != 3 > 0', true],
+    ['3 > 2 > 1', true],
+    ['1 == 1 == 1', true],
+    ['1 != 2 != 1', true],
+    ['2 >= 2 > 1', true],
+    ['1 + 2 < 2 * 2', true],
+    ['(3 < 2) < 1', true],
+    ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true],
+    ['(1 < 2) + (2 < 1)', 1],
+    ['-(1 < 2)', -1],
+    ['(1 < 2) ** 3', 1],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('getters are read once per occurrence, from left to right', () => {
+  const reads = [];
+  const variables = Object.create(null);
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('a + b * c + a', variables), 8);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'a']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a, abs(-b), min(c, a))', variables), 2);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'a']);
+});
+
+test('false comparisons skip later operands but never skip parsing', () => {
+  const variables = { a: 3, b: 2, get c() { throw new Error('must not read'); } };
+  assert.equal(evaluate('a < b < c', variables), false);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < 1 / 0'), false);
+  errorAt('3 < 2 < abs()', 9);
+  errorAt('3 < 2 < unknown(1)', 9);
+  errorAt('3 < 2 < (1 + )', 14);
+});
+
+test('only own variable properties are used and variables are not mutated', () => {
+  const variables = Object.freeze(Object.assign(Object.create({ inherited: 7 }), {
+    amount_2: 4, _rate: 0.5, constructor: 3,
+  }));
+  assert.equal(evaluate('amount_2 * _rate + constructor', variables), 5);
+  errorAt('  inherited', 3, variables);
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('__proto__', Object.assign(Object.create(null), { __proto__: null },
+    JSON.parse('{"__proto__":5}'))), 5);
+});
+
+test('built-ins accept expressions and enforce arity before any evaluation', () => {
+  assert.equal(evaluate('min(4, 2 + 1, -1)'), -1);
+  assert.equal(evaluate('max(-4)'), -4);
+  assert.equal(evaluate('abs(-7)'), 7);
+  assert.equal(evaluate('min(1 < 2, 3)'), 1);
+  const variables = { get x() { throw new Error('must not read'); } };
+  for (const [source, column] of [
+    ['x + abs()', 5], ['x + abs(1, 2)', 5],
+    ['x + min()', 5], ['x + max()', 5], ['x + other(1)', 5],
+  ]) errorAt(source, column, variables);
+});
+
+test('errors identify the offending token after whitespace', () => {
+  for (const operator of ['/', '//', '%']) {
+    for (const divisor of ['0', '-0', '(1 == 2)']) {
+      const source = `  7   ${operator} ${divisor}`;
+      errorAt(source, source.indexOf(operator) + 1);
+    }
+  }
+  for (const [source, column] of [
+    ['   missing', 4], ['1 +   @', 7], ['1 +\n\t?', 6],
+    ['1 +   )', 7], ['(1  2)', 5], ['  foo(1)', 3],
+    ['  abs()', 3], ['  min()', 3], ['  max()', 3],
+    ['abs(1, 2)', 1], ['min(1, )', 8], ['2(3)', 2],
+    ['2 3', 3], ['1 = 2', 3], ['"x"', 1], ['1 +  💰', 6],
+  ]) errorAt(source, column);
+  for (const source of ['', '   ', '1 +   ', '(1\n ', 'min(1,\t']) {
+    errorAt(source, source.length + 1);
+  }
+});
+
+test('flat arithmetic, comparison chains, and calls scale beyond 100,000 operands', () => {
+  const count = 120001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('-')), 2 - count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array(count).fill('1').join('<=')), true);
+  assert.equal(evaluate(`max(${Array(count).fill('1').join(',')})`), 1);
+});
