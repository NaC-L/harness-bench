@@ -0,0 +1,125 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('numbers, arithmetic associativity, and Python power/unary precedence', () => {
+  const cases = [
+    ['1.5 + .5 + 5. + 1.5e-3 + 2E+1', 27.0015],
+    ['10 - 3 - 2', 5], ['24 / 4 / 2', 3], ['17 // 3 % 2', 1],
+    ['2 + 3 * 4', 14], ['-2 ** 2', -4], ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5], ['2 ** 3 ** 2', 512],
+    ['-2 ** -2', -0.25], ['2 ** -2 ** 2', 0.0625],
+    ['2 * -3 ** 2', -18], ['--2 ** 2', 4], ['2 ** +3', 8],
+    ['2 ** 3 * 4', 32], ['+(-3)', -3],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and divisor-signed modulo, including normalized zeros', () => {
+  for (let a = -20; a <= 20; a++) {
+    for (let b = -7; b <= 7; b++) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+      else assert.ok(Object.is(remainder, 0));
+      if (quotient === 0) assert.ok(Object.is(quotient, 0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const op of ['/', '//', '%']) {
+    errorAt(`  1  ${op} -0`, 6);
+    errorAt(`  1  ${op} (2 - 2)`, 6);
+  }
+  assert.ok(Object.is(evaluate('-0 // -2'), 0));
+  assert.ok(Object.is(evaluate('-0 % -2'), 0));
+});
+
+test('comparisons chain, short circuit, and coerce booleans in arithmetic', () => {
+  const cases = [
+    ['3 < 2 < 1', false], ['1 < 2 <= 2 != 3', true],
+    ['3 > 2 >= 2 == 2', true], ['1 + 2 * 3 == 7', true],
+    ['(2 < 3) + (2 > 3)', 1], ['(2 < 3) == 1', true],
+    ['(2 > 3) == 0', true], ['(2 < 3) ** 2', 1],
+    ['(2 > 3) < 1', true], ['3 < 2 < missing', false],
+    ['3 < 2 < (1 / 0)', false], ['abs(3 > 2)', 1],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+  errorAt('3 < 2 < abs()', 9);
+  errorAt('3 < 2 <  ', 10);
+});
+
+test('variables and call arguments are read once per occurrence, left to right', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 5 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('a + b * a', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'a']);
+  assert.equal(evaluate('max(a, min(c, b), abs(-a))', variables), 2);
+  assert.deepEqual(reads.splice(0), ['a', 'c', 'b', 'a']);
+  assert.equal(evaluate('a ** b ** c', variables), 1);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  errorAt('  inherited', 3, variables);
+  errorAt('  missing', 3, variables);
+  assert.equal(evaluate('_rate2', Object.freeze({ _rate2: 9 })), 9);
+  assert.equal(evaluate('constructor', Object.assign(Object.create(null), { constructor: 7 })), 7);
+});
+
+test('the entire source is parsed before variables are read', () => {
+  let reads = 0;
+  const variables = { get x() { reads++; return 1; } };
+  for (const [source, column] of [
+    ['x + unknown(1)', 5], ['x + abs()', 5], ['x + abs(1, 2)', 5],
+    ['x + min()', 5], ['x + max()', 5], ['x + min(1,)', 11],
+    ['x + 1 2', 7], ['x + (1', 7], ['x + @', 5],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+  assert.equal(evaluate('min(3)'), 3);
+  assert.equal(evaluate('max(3)'), 3);
+  assert.equal(evaluate('abs(-3)'), 3);
+});
+
+test('error columns count UTF-16 offsets after whitespace, including end of source', () => {
+  for (const [source, column] of [
+    ['  @', 3], ['\t\n  !', 5], ['1 +   )', 7], ['1 +   ', 7],
+    ['', 1], ['   ', 4], ['  foo(1)', 3], ['  abs(1,2)', 3],
+    ['  1 / 0', 5], ['  1 // 0', 5], ['  1 % 0', 5],
+    ['\u2003\u00a0missing', 3], ['  😀', 3], ['1 + \u2003😀', 6],
+    ['2(3)', 2], ['1 = 2', 3], ['1e+', 2], ['.e2', 1],
+  ]) errorAt(source, column);
+});
+
+test('100,001-operand flat arithmetic and comparisons do not recurse per operand', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join(' + ')), count);
+  assert.equal(evaluate(Array(count).fill('1').join(' * ')), 1);
+  let reads = 0;
+  const variables = { get x() { reads++; return 1; } };
+  assert.equal(evaluate(Array(count).fill('x').join(' <= '), variables), true);
+  assert.equal(reads, count);
+  assert.equal(evaluate('2 < 1 < ' + Array(count).fill('missing').join(' < ')), false);
+  assert.equal(evaluate('max(' + Array(count).fill('1').join(',') + ')'), 1);
+});
