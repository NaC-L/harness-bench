@@ -0,0 +1,141 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('literal formats and left-associative arithmetic', () => {
+  for (const [source, expected] of [
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['10 - 3 - 2', 5], ['24 / 3 / 2', 4],
+    ['20 // 3 * 2 % 5', 2], ['2 + 3 * 4', 14],
+    ['(2 + 3) * 4', 20], ['--2 * +-3', -6],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('power is right associative and binds asymmetrically with unary signs', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625], ['2 * -3 ** 2', -18],
+    ['--2 ** 2', 4], ['2 ** +3 ** 2', 512],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo obey signed integer identities and normalize zero', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -5; b <= 5; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+});
+
+test('comparisons chain and booleans become numbers in arithmetic and equality', () => {
+  for (const [source, expected] of [
+    ['3 > 2 > 1', true], ['1 < 3 < 2', false],
+    ['1 < 2 <= 2 == 2 != 3 >= 1', true],
+    ['(1 < 2) + (3 < 2)', 1], ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true], ['(3 > 2) > 1', false],
+    ['2 + 3 < 2 * 3', true], ['-(1 < 2) ** 2', -1],
+    ['min(1 < 2, 3 > 4)', 0], ['abs(2 < 1)', 0],
+  ]) assert.equal(evaluate(source), expected, source);
+  assert.equal(evaluate('2 < 1 < missing'), false);
+  assert.equal(evaluate('2 < 1 < (1 / 0)'), false);
+});
+
+test('each variable occurrence is read once, left to right, without mutation', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 9 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, { get() { reads.push(name); return value; } });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  reads.length = 0;
+  assert.equal(evaluate('a + a * b', variables), 3);
+  assert.deepEqual(reads, ['a', 'a', 'b']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a, min(b, c), abs(-a))', variables), 2);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'a']);
+  errorAt('  inherited', 3, variables);
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('_a1', { _a1: 42 }), 42);
+});
+
+test('built-in calls validate before any evaluation, even in skipped operands', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 1; } };
+  for (const [source, name] of [
+    ['a + mystery(1)', 'mystery'], ['a + min()', 'min'],
+    ['a + max()', 'max'], ['a + abs()', 'abs'],
+    ['a + abs(1, 2)', 'abs'], ['2 < 1 < unknown(3)', 'unknown'],
+    ['a + constructor(1)', 'constructor'],
+  ]) errorAt(source, source.indexOf(name) + 1, variables);
+  assert.equal(reads, 0);
+  assert.equal(evaluate('min(3, -2, 8)'), -2);
+  assert.equal(evaluate('max(3, -2, 8)'), 8);
+  assert.equal(evaluate('abs(-3)'), 3);
+  assert.equal(evaluate('min(7) + max(2)'), 9);
+  assert.equal(evaluate('min + abs', { min: 2, abs: 3 }), 5);
+});
+
+test('errors use the actual token UTF-16 column, including whitespace and EOF', () => {
+  for (const operator of ['/', '//', '%']) {
+    const source = ` \t 12  ${operator}  -0`;
+    errorAt(source, source.indexOf(operator) + 1);
+  }
+  for (const [source, column] of [
+    [' \t missing', 4], ['1 + \n  @', 8], ['1 +  \uD800\uDC00', 6],
+    ['1   2', 5], ['1 +   )', 7], ['min(1,  )', 9],
+    ['2 (3)', 3], ['1 = 2', 3], ['1 ! 2', 3],
+    ['1e+', 2], ['.', 1],
+  ]) errorAt(source, column);
+  for (const source of ['', ' \t\n', '1 +   ', '(1 + 2  ', 'min(1,  ']) {
+    errorAt(source, source.length + 1);
+  }
+});
+
+test('the complete source is parsed before evaluating or short-circuiting', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 1; } };
+  errorAt('a + 1   2', 9, variables);
+  errorAt('2 < 1 < (3 + )', 14, variables);
+  errorAt('1 / 0 + abs()', 9, variables);
+  assert.equal(reads, 0);
+});
+
+test('100,001-operand arithmetic and comparison chains do not consume the call stack', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('-')), 2 - count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  let reads = 0;
+  const variables = { get x() { reads += 1; return reads; } };
+  assert.equal(evaluate(Array(count).fill('x').join('<'), variables), true);
+  assert.equal(reads, count);
+  assert.equal(evaluate(`max(${Array(count).fill('1').join(',')})`), 1);
+});
