@@ -0,0 +1,136 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+test('numeric literals, precedence, associativity and built-ins', () => {
+  const cases = [
+    ['1 + 2 * 3', 7], ['20 - 3 - 2', 15], ['24 / 3 * 2', 16],
+    ['20 // 3 % 4 * 2', 4], ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25], ['3 * -2 ** 2', -12], ['--2 ** 2', 4],
+    ['+2 ** +3 ** 2', 512], ['2 ** 3 * 4', 32], ['2 * 3 ** 2', 18],
+    ['min(8, 2 + 3, abs(-4))', 4], ['max(-8, -2, -3)', -2],
+    ['min(7)', 7], ['max(7)', 7], ['abs(-2 ** 2)', 4],
+    [' (1 < 2) + (3 == 4) ', 1], ['(1 < 2) == 1', true],
+    ['(1 > 2) * 9', 0], ['1 < 2 < 3', true], ['3 > 2 >= 2', true],
+    ['3 > 2 > 4', false], ['1 == 1 != 2 <= 3', true],
+    ['2 < 1 < 3', false], ['(2 < 1) < 3', true],
+    ['1 + 2 < 2 * 2 == 4', true], ['2 != 2', false],
+    ['1 < 2 <= 2 > 1 >= 1 == 1 != 0', true],
+  ];
+  for (const [source, expected] of cases) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('floor division and signed modulo preserve integer identities and positive zero', () => {
+  for (let a = -25; a <= 25; a += 1) {
+    for (let b = -7; b <= 7; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+    }
+  }
+  for (const [source, expected] of [
+    ['-7.5 // 2', -4], ['-7.5 % 2', 0.5], ['7.5 % -2', -0.5],
+    ['-0 // 2', 0], ['-0 % 2', 0], ['0 % -2', 0],
+  ]) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('variables and call arguments are read once in left-to-right order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 123 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  assert.equal(evaluate('max(a + b, abs(-c), a)', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'a']);
+  assert.equal(evaluate('a + a * b', variables), 3);
+  assert.deepEqual(reads, ['a', 'a', 'b']);
+  assert.throws(() => evaluate('inherited', variables), ExprError);
+  const own = Object.create(null);
+  own.constructor = 9;
+  own.__proto__ = 4;
+  assert.equal(evaluate('constructor + __proto__', own), 13);
+});
+
+test('comparison chains short-circuit operands, but not parsing', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 10; } };
+  assert.equal(evaluate('2 < 1 < x', variables), false);
+  assert.equal(evaluate('2 < 1 < missing'), false);
+  assert.equal(evaluate('2 < 1 < 1 / 0'), false);
+  assert.equal(evaluate('3 < 2 < max(x, x)', variables), false);
+  assert.equal(reads, 0);
+  assert.equal(evaluate('1 < 2 < x', variables), true);
+  assert.equal(reads, 1);
+  for (const source of ['x + unknown(1)', 'x + abs(1, 2)', 'x + min()',
+    '2 < 1 < unknown(1)', '2 < 1 < abs()', '2 < 1 < (']) {
+    reads = 0;
+    assert.throws(() => evaluate(source, variables), ExprError, source);
+    assert.equal(reads, 0, source);
+  }
+});
+
+test('errors identify the offending token using 1-based UTF-16 columns', () => {
+  // The marker denotes the expected error column, and is removed before parsing.
+  const cases = [
+    '|', '   |', '1 +   |', '  |missing', '1 +\t |missing',
+    '  |@', '1 +\n  |\u{10400}', '1 |\u{10400}', ' 1 |2', '2 |(3)',
+    ' 1 |=', '1 |!', '2 |^ 3', '1 |e+', '0|x10', '|..',
+    '  |unknown(1)', '1 +  |abs(1, 2)', '  |min()', '  |max()',
+    '  |abs()', 'min(1, |)', 'abs(1 |2)', '(1 + 2 |',
+    '1 + |)', '1 |)', 'min(1|; 2)',
+    ' 1  |/ 0', ' 1  |// -0', ' 1  |% (2 - 2)',
+  ];
+  for (const marked of cases) {
+    const column = marked.indexOf('|') + 1;
+    const source = marked.replace('|', '');
+    assert.throws(() => evaluate(source), error => {
+      assert.ok(error instanceof ExprError, source);
+      assert.equal(error.name, 'ExprError');
+      assert.equal(error.column, column, source);
+      return true;
+    });
+  }
+  const source = '1 + (2 > 1) / 0';
+  assert.throws(() => evaluate(source), error => error instanceof ExprError &&
+    error.column === source.indexOf('/') + 1);
+});
+
+test('100,001-operand flat arithmetic, comparisons and calls remain linear', t => {
+  const count = 100001;
+  const scenarios = [
+    [Array(count).fill('1').join('+'), count],
+    [Array(count).fill('1').join('-'), 2 - count],
+    [Array(count).fill('1').join('*'), 1],
+    [Array(count).fill('1').join('=='), true],
+    [Array(count).fill('x').join('<'), true],
+    [`min(${Array(count).fill('1').join(',')})`, 1],
+  ];
+  for (const [source, expected] of scenarios) {
+    let reads = 0;
+    const start = performance.now();
+    assert.equal(evaluate(source, { get x() { return reads++; } }), expected);
+    const elapsed = performance.now() - start;
+    if (source.startsWith('x')) assert.equal(reads, count);
+    t.diagnostic(`${source.slice(0, 12)}… (${count} operands): ${elapsed.toFixed(1)} ms`);
+    assert.ok(elapsed < 1000, `flat evaluation took ${elapsed.toFixed(1)} ms`);
+  }
+});
