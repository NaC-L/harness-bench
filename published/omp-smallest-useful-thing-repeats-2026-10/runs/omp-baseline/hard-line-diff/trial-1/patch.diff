+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A deliberately small quadratic oracle, used only by these tests.
+function editDistance(a, b) {
+  let previous = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 0; i < a.length; i++) {
+    const current = [i + 1];
+    for (let j = 0; j < b.length; j++) {
+      current[j + 1] = a[i] === b[j]
+        ? previous[j]
+        : Math.min(previous[j + 1], current[j]) + 1;
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function checkPair(a, b) {
+  Object.freeze(a);
+  Object.freeze(b);
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, editDistance(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  for (const context of [0, 1, 2, 3]) {
+    const hunks = unifiedHunks(a, b, { context });
+    for (const hunk of hunks) {
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+    }
+    Object.freeze(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    if (a.length === b.length && a.every((line, i) => line === b[i])) {
+      assert.deepEqual(hunks, []);
+    }
+  }
+}
+
+test('exhaustive minimality, edit ordering and roundtrips with repeated/empty lines', () => {
+  const arrays = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 3; length++) {
+    level = level.flatMap(a => ['', 'a', 'b'].map(line => [...a, line]));
+    arrays.push(...level);
+  }
+  for (const a of arrays) for (const b of arrays) checkPair(a, b);
+});
+
+test('seeded larger repetitive inputs match the minimal-distance oracle', () => {
+  let seed = 123456789;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  const alphabet = ['', 'a', 'b', 'c', '+prefix', '-prefix', ' prefix'];
+  for (let trial = 0; trial < 200; trial++) {
+    const make = () => Array.from({ length: random(30) }, () => alphabet[random(alphabet.length)]);
+    checkPair(make(), make());
+  }
+});
+
+test('zero-length ranges use the preceding line in complete-file coordinates', () => {
+  const cases = [
+    [[], ['x'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['x'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'b'], ['x', 'a', 'b'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a', 'b'], ['a', 'x', 'b'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['a', 'b'], ['a', 'b', 'x'], { oldStart: 2, oldLines: 0, newStart: 3, newLines: 1, lines: ['+x'] }],
+    [['x', 'a', 'b'], ['a', 'b'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x', 'b'], ['a', 'b'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+    [['a', 'b', 'x'], ['a', 'b'], { oldStart: 3, oldLines: 1, newStart: 2, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, expected] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [expected]);
+    assert.deepEqual(applyHunks(a, [expected]), b);
+  }
+});
+
+test('context windows merge at the boundary, without duplicated context', () => {
+  const a = ['top', 'old1', 'gap1', 'gap2', 'old2', 'bottom'];
+  const b = ['top', 'new1', 'gap1', 'gap2', 'new2', 'bottom'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' top', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' bottom'],
+  }]);
+  const c = ['top', 'old1', 'gap1', 'gap2', 'gap3', 'old2', 'bottom'];
+  const d = ['top', 'new1', 'gap1', 'gap2', 'gap3', 'new2', 'bottom'];
+  assert.deepEqual(unifiedHunks(c, d, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: [' top', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3, lines: [' gap3', '-old2', '+new2', ' bottom'] },
+  ]);
+  assert.deepEqual(unifiedHunks(c, d), unifiedHunks(c, d, { context: 3 }));
+});
+
+test('application tracks earlier edits and strips exactly one prefix', () => {
+  const a = ['-old', '', ' keep', '+remove', 'tail'];
+  const b = ['+new', '-extra', '', ' keep', 'tail', ''];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks, [
+    { oldStart: 1, oldLines: 1, newStart: 1, newLines: 2, lines: ['--old', '++new', '+-extra'] },
+    { oldStart: 4, oldLines: 1, newStart: 4, newLines: 0, lines: ['-+remove'] },
+    { oldStart: 5, oldLines: 0, newStart: 6, newLines: 1, lines: ['+'] },
+  ]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('malformed and nonapplicable hunks identify the offending index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const bad = [
+    null, {}, { ...valid, oldStart: 0 }, { ...valid, oldStart: 5 },
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldLines: 4 }, { ...valid, oldLines: -1 },
+    { ...valid, oldLines: '1' }, { ...valid, newStart: 0 },
+    { ...valid, newStart: 3 }, { ...valid, newLines: 2 },
+    { ...valid, newLines: NaN }, { ...valid, lines: null },
+    { ...valid, lines: [''] }, { ...valid, lines: [null] },
+    { ...valid, lines: ['?b'] }, { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] }, { ...valid, lines: ['-b', '-c', '+B'] },
+    { ...valid, lines: ['+B'] },
+  ];
+  for (const hunk of bad) assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, { ...valid, oldStart: 1, newStart: 1 }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' wrong'],
+  }]), /hunk 1 does not apply/);
+  assert.deepEqual(a, ['a', 'b', 'c']);
+});
+
+test('invalid context values are rejected', () => {
+  for (const context of [-1, 0.5, NaN, Infinity, '3', null]) {
+    assert.throws(() => unifiedHunks([], [], { context }), RangeError);
+  }
+});
+
+test('small edits in 20,000-line files, including repeated lines, are fast', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(17000, 2);
+    b.splice(10000, 1, 'replacement');
+    b.splice(200, 0, 'inserted');
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const patched = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(patched, b);
+    assert.equal(script.filter(e => e.op !== 'equal').length, 5);
+    assert.ok(elapsed < 1000, `diff/hunks/application took ${elapsed.toFixed(1)}ms`);
+  }
+});
