+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+const { splitLines, joinLines } = require('./src/lines');
+
+// A small quadratic oracle belongs only in tests, never in the implementation.
+function lcsLength(a, b) {
+  let previous = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const current = [0];
+    for (let j = 0; j < b.length; j++) {
+      current.push(line === b[j] ? previous[j] + 1 : Math.max(previous[j + 1], current[j]));
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const { op } of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(op));
+    if (op === 'equal') inserted = false;
+    else if (op === 'insert') inserted = true;
+    else assert.equal(inserted, false, 'deletes must precede inserts');
+  }
+  assert.deepEqual(diffLines(a, b), script);
+  for (const context of [0, 1, 2, 3]) {
+    const hunks = unifiedHunks(a, b, { context });
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+}
+
+test('minimal, deterministic scripts and roundtrips for exhaustive repeated/empty lines', () => {
+  const sequences = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 3; length++) {
+    level = level.flatMap(prefix => ['', 'x', 'y'].map(line => [...prefix, line]));
+    sequences.push(...level);
+  }
+  for (const a of sequences) {
+    for (const b of sequences) checkScript(Object.freeze(a), Object.freeze(b));
+  }
+});
+
+test('randomized minimality and patch roundtrips with repetitive prefix-like strings', () => {
+  let seed = 123456789;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  const alphabet = ['', 'a', 'b', '+added', '-removed', ' context'];
+  for (let trial = 0; trial < 500; trial++) {
+    const a = Array.from({ length: random(20) }, () => alphabet[random(alphabet.length)]);
+    const b = Array.from({ length: random(20) }, () => alphabet[random(alphabet.length)]);
+    checkScript(Object.freeze(a), Object.freeze(b));
+  }
+});
+
+test('zero-length ranges use preceding-line coordinates at top, middle, and end', () => {
+  const a = ['a', 'b'];
+  for (let at = 0; at <= a.length; at++) {
+    const b = [...a.slice(0, at), 'new', ...a.slice(at)];
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [{
+      oldStart: at, oldLines: 0, newStart: at + 1, newLines: 1, lines: ['+new'],
+    }]);
+    assert.deepEqual(unifiedHunks(b, a, { context: 0 }), [{
+      oldStart: at + 1, oldLines: 1, newStart: at, newLines: 0, lines: ['-new'],
+    }]);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context: 0 })), b);
+    assert.deepEqual(applyHunks(b, unifiedHunks(b, a, { context: 0 })), a);
+  }
+});
+
+test('context touching merges, separated context does not, and context is not duplicated', () => {
+  for (const gap of [1, 2, 3]) {
+    const middle = Array.from({ length: gap }, (_, i) => `middle ${i}`);
+    const a = ['before', 'old1', ...middle, 'old2', 'after'];
+    const b = ['before', 'new1', ...middle, 'new2', 'after'];
+    const hunks = unifiedHunks(a, b, { context: 1 });
+    if (gap <= 2) {
+      assert.deepEqual(hunks, [{
+        oldStart: 1, oldLines: a.length, newStart: 1, newLines: b.length,
+        lines: [' before', '-old1', '+new1', ...middle.map(line => ` ${line}`), '-old2', '+new2', ' after'],
+      }]);
+    } else {
+      assert.deepEqual(hunks, [
+        { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: [' before', '-old1', '+new1', ' middle 0'] },
+        { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3, lines: [' middle 2', '-old2', '+new2', ' after'] },
+      ]);
+    }
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+});
+
+test('application tracks offsets, preserves unmentioned lines, and mutates neither input', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd', 'e']);
+  const b = ['top', 'a', 'c', 'd', 'e', 'end'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  assert.deepEqual(applyHunks(['a'], [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 0, oldLines: 0, newStart: 2, newLines: 1, lines: ['+y'] },
+  ]), ['x', 'y', 'a']);
+});
+
+test('malformed, mismatched, overlapping, unordered, and out-of-bounds hunks are rejected', () => {
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ['-a', '+x'] };
+  const invalid = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?a'] },
+    { ...valid, lines: ['-wrong', '+x'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: 4 }, { ...valid, newStart: 2 },
+    { ...valid, oldLines: 0 }, { ...valid, oldLines: 2 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: 2 },
+    { ...valid, oldStart: -1 }, { ...valid, oldLines: 0.5 },
+    { ...valid, newStart: NaN }, { ...valid, newLines: Infinity },
+    { ...valid, oldStart: '1' }, { ...valid, newLines: Number.MAX_SAFE_INTEGER + 1 },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(['a', 'b', 'c'], [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(['a', 'b', 'c'], [valid, valid]), /hunk 1 does not apply/);
+  const later = { oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: ['-c', '+z'] };
+  assert.throws(() => applyHunks(['a', 'b', 'c'], [later, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(['a'], [{ ...valid, lines: ['-a', '-undefined', '+x'] }]), /hunk 0 does not apply/);
+});
+
+test('text helpers preserve trailing empty lines and prefixed content through patches', () => {
+  const original = '+one\n-two\n three\n';
+  const revised = '\n+one\n+new\n three\n';
+  const a = splitLines(original);
+  const b = splitLines(revised);
+  assert.equal(joinLines(applyHunks(a, unifiedHunks(a, b))), revised);
+});
+
+test('20,000-line small changes run well below one second', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? `line ${i % 5}` : `line ${i}`);
+    const b = a.slice();
+    b.splice(100, 0, 'inserted');
+    b.splice(10000, 1, 'replacement');
+    b.splice(19000, 1);
+    const start = performance.now();
+    const hunks = unifiedHunks(a, b);
+    const result = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(result, b);
+    assert.ok(elapsed < 1000, `small-change roundtrip took ${elapsed.toFixed(1)}ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} lines: ${elapsed.toFixed(1)}ms`);
+  }
+});
