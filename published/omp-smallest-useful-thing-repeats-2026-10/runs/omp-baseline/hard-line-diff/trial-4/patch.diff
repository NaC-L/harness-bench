@@ -0,0 +1,140 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+function lcsLength(a, b) {
+  const row = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const above = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = above;
+    }
+  }
+  return row[b.length];
+}
+
+function verify(a, b) {
+  Object.freeze(a);
+  Object.freeze(b);
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserting = false;
+  for (const { op } of script) {
+    if (op === 'equal') inserting = false;
+    if (op === 'insert') inserting = true;
+    if (op === 'delete') assert.equal(inserting, false);
+  }
+  for (const context of [0, 1, 2, 3, 20]) {
+    const hunks = unifiedHunks(a, b, { context });
+    for (const hunk of hunks) {
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+    }
+    Object.freeze(hunks);
+    const patched = applyHunks(a, hunks);
+    assert.deepEqual(patched, b);
+    assert.notEqual(patched, a);
+  }
+}
+
+test('exhaustive minimal scripts and patch roundtrips for repeated and empty lines', () => {
+  const arrays = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'x'].map(line => [...lines, line]));
+    arrays.push(...level);
+  }
+  for (const a of arrays) {
+    for (const b of arrays) verify(a.slice(), b.slice());
+  }
+});
+
+test('seeded mixed-line scripts remain minimal and roundtrip', () => {
+  let seed = 123456789;
+  const random = n => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  };
+  const alphabet = ['', 'a', 'b', 'c', '+prefix', '-prefix', ' prefix', '\r'];
+  for (let trial = 0; trial < 1000; trial++) {
+    const makeLines = () => Array.from({ length: random(20) }, () => alphabet[random(alphabet.length)]);
+    verify(makeLines(), makeLines());
+  }
+});
+
+test('zero-length ranges use preceding line coordinates, including file boundaries', () => {
+  assert.deepEqual(unifiedHunks(['a'], ['x', 'a', 'y'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 1, oldLines: 0, newStart: 3, newLines: 1, lines: ['+y'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['x', 'a', 'y'], ['a'], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] },
+    { oldStart: 3, oldLines: 1, newStart: 1, newLines: 0, lines: ['-y'] },
+  ]);
+  assert.deepEqual(unifiedHunks([], []), []);
+});
+
+test('touching context merges but a larger gap stays separate', () => {
+  const a = ['0', '1', '2', '3', '4', '5', '6', '7'];
+  const b = ['0', 'x', '2', '3', 'y', '5', '6', '7'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' 0', '-1', '+x', ' 2', ' 3', '-4', '+y', ' 5'],
+  }]);
+  const c = ['0', 'x', '2', '3', '4', 'y', '6', '7'];
+  assert.deepEqual(unifiedHunks(a, c, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3, lines: [' 0', '-1', '+x', ' 2'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3, lines: [' 4', '-5', '+y', ' 6'] },
+  ]);
+});
+
+test('application rejects malformed counts, coordinates, prefixes, and mismatches', () => {
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ['-a', '+x'] };
+  const invalid = [
+    null,
+    { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 3 },
+    { ...valid, oldStart: 1.5 },
+    { ...valid, oldLines: -1 },
+    { ...valid, oldLines: 0 },
+    { ...valid, oldLines: 3 },
+    { ...valid, newStart: 0 },
+    { ...valid, newStart: 2 },
+    { ...valid, newLines: 0 },
+    { ...valid, newLines: 2 },
+    { ...valid, lines: null },
+    { ...valid, lines: [''] },
+    { ...valid, lines: [null] },
+    { ...valid, lines: ['?a'] },
+    { ...valid, lines: ['-b', '+x'] },
+    { ...valid, lines: [' b'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(['a', 'b'], [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(['a', 'b'], [valid, valid]), /hunk 1 does not apply/);
+  const insertion = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] };
+  assert.throws(() => applyHunks(['a', 'b'], [insertion, valid]), /hunk 1 does not apply/);
+  assert.deepEqual(applyHunks(['a', 'b'], [insertion, { ...valid, newStart: 2 }]), ['x', 'x', 'b']);
+});
+
+test('small edits to 20,000 lines roundtrip, including repetitive files', () => {
+  for (const repeated of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repeated ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(18000, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(100, 0, 'inserted');
+    const script = diffLines(a, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+  }
+});
