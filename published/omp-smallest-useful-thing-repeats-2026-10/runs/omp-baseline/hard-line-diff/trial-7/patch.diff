+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+function lcsLength(a, b) {
+  let previous = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const next = [0];
+    for (let j = 0; j < b.length; j++) {
+      next.push(line === b[j] ? previous[j] + 1 : Math.max(previous[j + 1], next[j]));
+    }
+    previous = next;
+  }
+  return previous[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+    if (entry.op === 'insert') inserted = true;
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('exhaustive minimal scripts and patch roundtrips with repeated and empty lines', () => {
+  const arrays = [[]];
+  let layer = [[]];
+  for (let length = 1; length <= 4; length++) {
+    layer = layer.flatMap(lines => ['', '+'].map(line => Object.freeze([...lines, line])));
+    arrays.push(...layer);
+  }
+  for (const a of arrays) {
+    for (const b of arrays) {
+      checkScript(a, b);
+      for (const context of [0, 1, 2, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+      }
+    }
+  }
+});
+
+test('seeded mixed-prefix inputs have minimal scripts and roundtrip', () => {
+  let seed = 123456789;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  const alphabet = ['', 'same', '+insert', '-delete', ' context', 'other'];
+  for (let trial = 0; trial < 300; trial++) {
+    const a = Object.freeze(Array.from({ length: random(20) }, () => alphabet[random(alphabet.length)]));
+    const b = Object.freeze(Array.from({ length: random(20) }, () => alphabet[random(alphabet.length)]));
+    checkScript(a, b);
+    for (const context of [0, 1, 3, 30]) {
+      assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+    }
+  }
+});
+
+test('zero-length ranges use preceding-line coordinates at either boundary', () => {
+  const cases = [
+    [[], ['x'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['x'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a'], ['x', 'a'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a'], ['a', 'x'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['x', 'a'], ['a'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x'], ['a'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, hunk] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [hunk]);
+    assert.deepEqual(applyHunks(a, [hunk]), b);
+  }
+});
+
+test('context merges touching regions once and separates larger gaps', () => {
+  for (const gap of [0, 1, 2, 3, 4, 5]) {
+    const middle = Array.from({ length: gap }, (_, i) => `context ${i}`);
+    const a = ['before', 'old first', ...middle, 'old last', 'after'];
+    const b = ['before', 'new first', ...middle, 'new last', 'after'];
+    const hunks = unifiedHunks(a, b, { context: 2 });
+    assert.equal(hunks.length, gap <= 4 ? 1 : 2);
+    if (gap <= 4) {
+      assert.deepEqual(hunks, [{
+        oldStart: 1, oldLines: a.length, newStart: 1, newLines: b.length,
+        lines: gap === 0
+          ? [' before', '-old first', '-old last', '+new first', '+new last', ' after']
+          : [' before', '-old first', '+new first', ...middle.map(line => ' ' + line),
+            '-old last', '+new last', ' after'],
+      }]);
+    }
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+});
+
+test('applying separated hunks tracks original coordinates and output offsets', () => {
+  const a = ['a', 'b', 'c', 'd', 'e'];
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+top', '+extra'] },
+    { oldStart: 2, oldLines: 1, newStart: 3, newLines: 0, lines: ['-b'] },
+    { oldStart: 4, oldLines: 1, newStart: 5, newLines: 2, lines: ['-d', '+D', '+another'] },
+    { oldStart: 5, oldLines: 0, newStart: 8, newLines: 1, lines: ['+end'] },
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['top', 'extra', 'a', 'c', 'D', 'another', 'e', 'end']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(unifiedHunks(a, a), []);
+});
+
+test('malformed, mismatched, overlapping, and out-of-order hunks identify their index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+B'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['-b', '-c', '+B'] }, { ...valid, lines: ['-b', '+B', '+extra'] },
+    { ...valid, lines: ['-b'] }, { ...valid, lines: ['+B'] },
+    { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: 5 }, { ...valid, newStart: 3 },
+    { ...valid, oldLines: 3 }, { ...valid, newLines: 2 },
+  ];
+  for (const field of ['oldStart', 'oldLines', 'newStart', 'newLines']) {
+    for (const value of [-1, 0.5, NaN, Infinity, '1', undefined, Number.MAX_SAFE_INTEGER + 1]) {
+      invalid.push({ ...valid, [field]: value });
+    }
+  }
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid,
+    { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] },
+  ]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+  for (const context of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => unifiedHunks(a, a, { context }), RangeError);
+  }
+});
+
+test('small changes to 20,000 unique or repetitive lines run under a second', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(18000, 1);
+    b.splice(10000, 0, '+inserted');
+    b[1000] = '-replacement';
+    const started = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const actual = applyHunks(a, hunks);
+    const elapsed = performance.now() - started;
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.deepEqual(actual, b);
+    assert.ok(elapsed < 1000, `20,000-line diff and roundtrip took ${elapsed.toFixed(1)} ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} lines: ${elapsed.toFixed(1)} ms`);
+  }
+});
