@@ -0,0 +1,132 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard additions on both parent and child lazy tags', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(4, 8, -3);
+  tree.add(0, 8, 5);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -2);
+  tree.assign(2, 6, -9);
+  tree.add(3, 7, 4);
+  assert.equal(tree.firstAtLeast(0, 0), 6);
+  assert.equal(tree.sum(1, 7), -24);
+  assert.equal(tree.max(2, 6), -5);
+  assert.deepEqual(tree.toArray(), [-2, -2, -9, -5, -5, -5, 2, -2]);
+});
+
+test('partial maxima use negative infinity as their identity', () => {
+  const tree = new RangeTree([-8, -3, -7, -4, -9]);
+  assert.equal(tree.max(1, 4), -3);
+  assert.equal(tree.max(2, 3), -7);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 2);
+  assert.equal(tree.max(0, 4), -18);
+  assert.equal(tree.max(4, 5), -20);
+});
+
+test('threshold searches propagate assignment and addition before descent', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.assign(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(3, 10), 3);
+  tree.add(0, 5, -20);
+  assert.equal(tree.firstAtLeast(1, -10), 1);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.assign(0, 2, -30);
+  tree.add(0, 5, 15);
+  assert.equal(tree.firstAtLeast(0, 5), 2);
+  assert.equal(tree.firstAtLeast(4, 5), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('deterministic mixed workloads agree with a plain array', () => {
+  for (const size of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    let state = size;
+    const random = (limit) => {
+      state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+      return (state >>> 16) % limit;
+    };
+    const values = Array.from({ length: size }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    const range = () => {
+      const a = random(size + 1);
+      const b = random(size + 1);
+      return [Math.min(a, b), Math.max(a, b)];
+    };
+    for (let step = 0; step < 600; step++) {
+      const [l, r] = step % 5 === 0 ? [0, size] : range();
+      const value = random(41) - 20;
+      const assigning = random(2) === 0;
+      assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      // Keep consecutive updates lazy; search before any query can push tags.
+      if (step % 12 !== 11) continue;
+      for (let query = 0; query < 16; query++) {
+        const lo = random(size + 1);
+        const threshold = query === 0 ? -Infinity : query === 1 ? Infinity : random(81) - 40;
+        assert.equal(tree.firstAtLeast(lo, threshold),
+          values.findIndex((v, i) => i >= lo && v >= threshold));
+        const [a, b] = range();
+        const slice = values.slice(a, b);
+        assert.equal(tree.sum(a, b), slice.reduce((sum, v) => sum + v, 0));
+        assert.equal(tree.max(a, b), Math.max(...slice));
+        const index = random(size);
+        assert.equal(tree.get(index), values[index]);
+      }
+      assert.deepEqual(tree.toArray(), values);
+    }
+  }
+});
+
+test('API validates inputs without mutation and preserves empty ranges and copies', () => {
+  for (const values of [undefined, null, [], [NaN], [Infinity], [-Infinity], ['1'], new Array(2), new Float64Array([1])]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 999;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 9; }, TypeError);
+  tree.add(0, 3, 2);
+  const expected = [4, -1, 6];
+  for (const [l, r] of [[-1, 2], [2, 1], [0, 4], [0.5, 1], [0, NaN], ['0', 1], [0, Infinity]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '2', null, undefined]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    for (let i = 0; i <= tree.length; i++) {
+      assert.equal(tree[method](i, i, 7), undefined);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(3, -Infinity), -1);
+  assert.deepEqual(tree.toArray(), expected);
+  const copy = tree.toArray();
+  copy[0] = 999;
+  assert.deepEqual(tree.toArray(), expected);
+});
