@@ -0,0 +1,170 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards pending additions at parents and descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 9);
+  tree.add(3, 7, -4);
+  tree.add(0, 7, 6);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  tree.assign(1, 6, -5);
+  assert.equal(tree.sum(0, 7), -29);
+  assert.equal(tree.sum(2, 5), -15);
+  assert.equal(tree.max(1, 6), -5);
+  assert.deepEqual(tree.toArray(), [-2, -5, -5, -5, -5, -5, -2]);
+
+  tree.add(0, 7, 10);
+  tree.assign(0, 7, 3);
+  tree.assign(0, 7, -1);
+  assert.equal(tree.get(6), -1);
+  assert.equal(tree.sum(0, 7), -7);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-1));
+});
+
+test('partial maxima preserve negative values and empty-range identity', () => {
+  const tree = new RangeTree([-8, -2, -7, -4, -9]);
+  assert.equal(tree.max(0, 2), -2);
+  assert.equal(tree.max(2, 5), -4);
+  assert.equal(tree.max(2, 3), -7);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 4), -7);
+  assert.equal(tree.max(4, 5), -10);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search propagates updates before inspecting children', () => {
+  const tree = new RangeTree([-5, -4, -3, -2, -1]);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 7), 2);
+  assert.equal(tree.firstAtLeast(3, 7), 3);
+  tree.assign(0, 5, 12);
+  assert.equal(tree.firstAtLeast(1, 12), 1);
+  tree.add(0, 5, -20);
+  assert.equal(tree.firstAtLeast(0, -7), -1);
+  tree.assign(0, 5, -6);
+  tree.assign(2, 5, -2);
+  tree.add(0, 5, 1);
+  assert.equal(tree.firstAtLeast(0, -1), 2);
+  assert.equal(tree.firstAtLeast(4, -1), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+});
+
+test('validation is atomic, including empty updates, and arrays do not alias', () => {
+  for (const input of [undefined, null, {}, '123', [], [NaN], [Infinity],
+    [-Infinity], ['1'], [undefined], new Array(2), new Float64Array([1])]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.assign(0, 3, 4);
+  tree.add(0, 3, 2);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2],
+      [0, 1.5], [NaN, 2], [0, Infinity], ['0', 2], [0, undefined]]) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '2', null, undefined, {}]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](2, 2, value), RangeError);
+    }
+    assert.equal(tree[method](0, 0, 10), undefined);
+    assert.equal(tree[method](3, 3, 10), undefined);
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', null, undefined, {}]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 9; }, TypeError);
+  assert.deepEqual(tree.toArray(), [6, 6, 6]);
+  const output = tree.toArray();
+  output[1] = -100;
+  assert.deepEqual(tree.toArray(), [6, 6, 6]);
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(0, 0), -Infinity);
+  assert.equal(tree.assign(0, 1, -3), undefined);
+  assert.equal(tree.add(0, 1, 1), undefined);
+  assert.equal(tree.get(0), -2);
+});
+
+function randomGenerator(seed) {
+  let state = seed;
+  return (limit) => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return Math.floor((state / 0x100000000) * limit);
+  };
+}
+
+function expectedFirst(values, lo, x) {
+  for (let i = lo; i < values.length; i++) {
+    if (values[i] >= x) return i;
+  }
+  return -1;
+}
+
+test('mixed lazy operations match a plain-array oracle across tree shapes', () => {
+  for (const length of [1, 2, 3, 7, 8, 17, 31, 64, 65]) {
+    for (let seed = 1; seed <= 12; seed++) {
+      const random = randomGenerator(seed * 97 + length);
+      const values = Array.from({ length }, () => random(41) - 20);
+      const tree = new RangeTree(values);
+      for (let step = 0; step < 600; step++) {
+        let l = random(length + 1);
+        let r = random(length + 1);
+        if (l > r) [l, r] = [r, l];
+        // Leave full-range tags pending across batches of mixed updates.
+        if (step % 5 === 0) [l, r] = [0, length];
+        const value = random(41) - 20;
+        const operation = random(8);
+        const context = `length=${length}, seed=${seed}, step=${step}`;
+        if (operation < 2) {
+          assert.equal(tree.assign(l, r, value), undefined, context);
+          values.fill(value, l, r);
+        } else if (operation < 4) {
+          assert.equal(tree.add(l, r, value), undefined, context);
+          for (let i = l; i < r; i++) values[i] += value;
+        } else if (operation === 4) {
+          const expected = values.slice(l, r).reduce((a, b) => a + b, 0);
+          assert.equal(tree.sum(l, r), expected, context);
+        } else if (operation === 5) {
+          assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)), context);
+        } else if (operation === 6) {
+          const x = step % 7 === 0 ? Infinity : step % 11 === 0 ? -Infinity : value;
+          assert.equal(tree.firstAtLeast(l, x), expectedFirst(values, l, x), context);
+        } else {
+          const i = random(length);
+          assert.equal(tree.get(i), values[i], context);
+        }
+        // Check root aggregates without flushing the pending tags.
+        assert.equal(tree.sum(0, length), values.reduce((a, b) => a + b, 0), context);
+        assert.equal(tree.max(0, length), Math.max(...values), context);
+        if (step % 97 === 96) assert.deepEqual(tree.toArray(), values, context);
+      }
+      for (let l = 0; l <= length; l++) {
+        for (let r = l; r <= length; r++) {
+          assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0));
+          assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+        }
+        for (const x of [-Infinity, -30, -1, 0, 1, 30, Infinity]) {
+          assert.equal(tree.firstAtLeast(l, x), expectedFirst(values, l, x));
+        }
+      }
+      assert.deepEqual(tree.toArray(), values);
+    }
+  }
+});
