@@ -0,0 +1,166 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both the assigned node and its children', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(4, 8, -3);
+  tree.add(0, 8, 5);
+  tree.assign(0, 8, -4);
+  tree.add(0, 8, 2);
+  assert.equal(tree.sum(1, 7), -12);
+  assert.equal(tree.max(2, 5), -2);
+  tree.assign(2, 6, 0);
+  tree.add(3, 8, -1);
+  assert.deepEqual(tree.toArray(), [-2, -2, 0, -1, -1, -1, -3, -3]);
+  assert.equal(tree.sum(0, 8), -13);
+});
+
+test('partial maxima use negative infinity rather than zero as the identity', () => {
+  const tree = new RangeTree([-9, -4, -8, -6, -2]);
+  assert.equal(tree.max(0, 1), -9);
+  assert.equal(tree.max(1, 4), -4);
+  assert.equal(tree.max(3, 5), -2);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(2, 3), -7);
+  assert.equal(tree.max(4, 5), -10);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold searches propagate lazy updates before inspecting children', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0]);
+  tree.assign(0, 5, 8);
+  assert.equal(tree.firstAtLeast(0, 8), 0);
+  tree.add(0, 5, 4);
+  assert.equal(tree.firstAtLeast(3, 12), 3);
+  tree.assign(0, 5, -6);
+  tree.assign(3, 5, 2);
+  tree.add(0, 5, 1);
+  assert.equal(tree.firstAtLeast(0, 0), 3);
+  assert.equal(tree.firstAtLeast(4, 3), 4);
+  assert.equal(tree.firstAtLeast(0, 4), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+function randomGenerator(seed) {
+  let state = seed >>> 0;
+  return limit => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return Math.floor((state / 0x100000000) * limit);
+  };
+}
+
+function expectedFirst(values, lo, threshold) {
+  for (let i = lo; i < values.length; i++) {
+    if (values[i] >= threshold) return i;
+  }
+  return -1;
+}
+
+test('mixed lazy operations agree with an array model across deterministic workloads', () => {
+  for (const length of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    for (let seed = 1; seed <= 8; seed++) {
+      const random = randomGenerator(seed * 101 + length);
+      const values = Array.from({ length }, () => random(41) - 20);
+      const tree = new RangeTree(values);
+      for (let step = 0; step < 200; step++) {
+        // Bursts leave tags stacked; querying every leaf after each update would
+        // conceal propagation bugs by eagerly flushing the tree.
+        const updates = 1 + random(5);
+        for (let update = 0; update < updates; update++) {
+          let l = random(length + 1);
+          let r = random(length + 1);
+          if (l > r) [l, r] = [r, l];
+          if (random(4) === 0) [l, r] = [0, length];
+          const value = random(41) - 20;
+          if (random(2) === 0) {
+            assert.equal(tree.assign(l, r, value), undefined);
+            for (let i = l; i < r; i++) values[i] = value;
+          } else {
+            assert.equal(tree.add(l, r, value), undefined);
+            for (let i = l; i < r; i++) values[i] += value;
+          }
+        }
+        const context = `length=${length}, seed=${seed}, step=${step}`;
+        const lo = random(length + 1);
+        const threshold = random(81) - 40;
+        // Search first so other queries cannot flush the tags it needs.
+        assert.equal(tree.firstAtLeast(lo, threshold),
+          expectedFirst(values, lo, threshold), context);
+        let l = random(length + 1);
+        let r = random(length + 1);
+        if (l > r) [l, r] = [r, l];
+        const slice = values.slice(l, r);
+        assert.equal(tree.sum(l, r), slice.reduce((sum, value) => sum + value, 0), context);
+        assert.equal(tree.max(l, r), Math.max(-Infinity, ...slice), context);
+        const index = random(length);
+        assert.equal(tree.get(index), values[index], context);
+        if (step % 37 === 0) assert.deepEqual(tree.toArray(), values, context);
+      }
+      assert.deepEqual(tree.toArray(), values);
+      for (let l = 0; l <= length; l++) {
+        for (let r = l; r <= length; r++) {
+          const slice = values.slice(l, r);
+          assert.equal(tree.sum(l, r), slice.reduce((sum, value) => sum + value, 0));
+          assert.equal(tree.max(l, r), Math.max(-Infinity, ...slice));
+        }
+      }
+    }
+  }
+});
+
+test('construction, validation, empty ranges, and array ownership retain the API contract', () => {
+  for (const values of [undefined, null, {}, '123', [], [NaN], [Infinity],
+    [-Infinity], ['1'], [1, undefined], new Array(2), new Float64Array([1])]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1.5, -2.5, 3.5];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 100; }, TypeError);
+  tree.assign(0, 3, -1.5);
+  tree.add(0, 3, 0.5);
+  const expected = [-1, -1, -1];
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, 1.5],
+    [NaN, 2], [0, Infinity], ['0', 2], [0, undefined]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](2, 2, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', undefined, null]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+    assert.throws(() => tree.firstAtLeast(3, threshold), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), expected);
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 7), undefined);
+    assert.equal(tree.add(i, i, -7), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  const result = tree.toArray();
+  result[0] = 200;
+  assert.deepEqual(tree.toArray(), expected);
+  assert.equal(tree.sum(0, 3), -3);
+  assert.equal(tree.max(0, 3), -1);
+});
