@@ -0,0 +1,136 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions pending at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, -10);
+  tree.add(0, 8, 2);
+  assert.equal(tree.sum(1, 3), -16);
+  assert.equal(tree.sum(0, 8), -64);
+  assert.deepEqual(tree.toArray(), Array(8).fill(-8));
+
+  tree.add(2, 6, 9);
+  tree.assign(3, 5, 0);
+  assert.deepEqual(tree.toArray(), [-8, -8, 1, 0, 0, 1, -8, -8]);
+});
+
+test('partial maxima use negative infinity as the identity', () => {
+  const tree = new RangeTree([-9, -4, -7, -2, -6]);
+  assert.equal(tree.max(0, 1), -9);
+  assert.equal(tree.max(1, 4), -2);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(2, 5), -17);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search propagates lazy tags before examining children', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0]);
+  tree.add(0, 5, 7);
+  assert.equal(tree.firstAtLeast(0, 7), 0);
+  tree.assign(0, 5, -8);
+  tree.add(0, 5, 2);
+  assert.equal(tree.firstAtLeast(2, -6), 2);
+  assert.equal(tree.firstAtLeast(0, -5), -1);
+  tree.assign(2, 5, 4);
+  assert.equal(tree.firstAtLeast(0, 4), 2);
+  assert.equal(tree.firstAtLeast(3, 4), 3);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+});
+
+test('mixed updates and queries agree with an array model', () => {
+  let state = 0x12345678;
+  const random = (limit) => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 33]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 250; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 7 === 0) [l, r] = [0, n];
+      const value = random(41) - 20;
+      if (random(2) === 0) {
+        tree.assign(l, r, value);
+        for (let i = l; i < r; i++) values[i] = value;
+      } else {
+        tree.add(l, r, value);
+        for (let i = l; i < r; i++) values[i] += value;
+      }
+      // Search first: materializing or reading every leaf would mask lazy bugs.
+      for (let lo = 0; lo <= n; lo++) {
+        const x = random(81) - 40;
+        const expected = values.findIndex((v, i) => i >= lo && v >= x);
+        assert.equal(tree.firstAtLeast(lo, x), expected, `n=${n}, step=${step}, lo=${lo}`);
+      }
+      for (let query = 0; query < 8; query++) {
+        let a = random(n + 1);
+        let b = random(n + 1);
+        if (a > b) [a, b] = [b, a];
+        const slice = values.slice(a, b);
+        assert.equal(tree.sum(a, b), slice.reduce((sum, v) => sum + v, 0));
+        assert.equal(tree.max(a, b), Math.max(...slice));
+      }
+      const index = random(n);
+      assert.equal(tree.get(index), values[index]);
+      if (step % 29 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, return values, and copy isolation preserve the API', () => {
+  for (const input of [null, {}, '123', [], [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  const output = tree.toArray();
+  output[1] = 100;
+  assert.deepEqual(tree.toArray(), [1, 2, 3]);
+
+  tree.add(0, 3, 4);
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 9), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 20), undefined);
+    assert.equal(tree.add(i, i, 20), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), [5, 6, 7]);
+  assert.equal(tree.assign(0, 1, 2), undefined);
+  assert.equal(tree.add(0, 1, 3), undefined);
+  assert.deepEqual(tree.toArray(), [5, 6, 7]);
+});
