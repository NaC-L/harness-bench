+++ "{temp}\\hb-2738bf61-_ofher50/range-tree.regression.test.js"
@@ -0,0 +1,181 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+function checkRange(tree, values, l, r) {
+  const slice = values.slice(l, r);
+  assert.equal(tree.sum(l, r), slice.reduce((sum, value) => sum + value, 0));
+  assert.equal(tree.max(l, r), Math.max(...slice));
+}
+
+function checkSearch(tree, values, lo, x) {
+  const expected = values.findIndex((value, i) => i >= lo && value >= x);
+  assert.equal(tree.firstAtLeast(lo, x), expected);
+}
+
+test('assignment discards additions at both the assigned node and its children', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 20);
+  tree.add(4, 8, -30);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -2);
+  assert.equal(tree.sum(1, 7), -12);
+  assert.equal(tree.max(1, 7), -2);
+  tree.assign(2, 6, 5);
+  tree.add(3, 7, 2);
+  const expected = [-2, -2, 5, 7, 7, 7, 0, -2];
+  for (let l = 0; l <= tree.length; l++) {
+    for (let r = l; r <= tree.length; r++) checkRange(tree, expected, l, r);
+  }
+  assert.deepEqual(tree.toArray(), expected);
+});
+
+test('partial maxima use negative infinity, not zero, as the identity', () => {
+  const tree = new RangeTree([-8, -6, -4, -2, -10]);
+  assert.equal(tree.max(1, 4), -2);
+  assert.equal(tree.max(0, 1), -8);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(1, 3), -17);
+  assert.equal(tree.max(4, 5), -20);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold searches propagate assignments and additions before descending', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0, 0, 0, 0]);
+  tree.add(0, 8, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(3, 10), 3);
+  tree.assign(0, 8, -5);
+  tree.assign(4, 8, 7);
+  assert.equal(tree.firstAtLeast(0, 0), 4);
+  assert.equal(tree.firstAtLeast(5, 7), 5);
+  tree.add(4, 8, -20);
+  assert.equal(tree.firstAtLeast(0, -4), -1);
+  tree.assign(0, 8, 0);
+  assert.equal(tree.firstAtLeast(2, 0), 2);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(7, -Infinity), 7);
+  assert.equal(tree.firstAtLeast(8, -Infinity), -1);
+});
+
+test('the complete public API preserves validation, empty ranges, and copying', () => {
+  for (const values of [[], null, undefined, {}, '123', [NaN], [Infinity],
+    [-Infinity], ['1'], [1, undefined], new Array(2), new Float64Array([1])]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, -2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 7; }, TypeError);
+  assert.equal(tree.get(0), 1);
+  tree.assign(0, 3, 4);
+  const output = tree.toArray();
+  output[0] = 100;
+  assert.deepEqual(tree.toArray(), [4, 4, 4]);
+
+  const badRanges = [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, 1.5],
+    [NaN, 2], [0, Infinity], ['0', 2], [0, undefined]];
+  for (const [l, r] of badRanges) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 9), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined, {}]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](2, 2, value), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', null, undefined, {}]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+    assert.throws(() => tree.firstAtLeast(3, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), [4, 4, 4]);
+  assert.equal(tree.assign(0, 3, 2), undefined);
+  assert.equal(tree.add(0, 3, -1), undefined);
+  assert.deepEqual(tree.toArray(), [1, 1, 1]);
+});
+
+test('mixed lazy operations agree with a seeded array model', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 31, 64, 129]) {
+    const values = Array.from({ length: n }, () => (random(161) - 80) / 4);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 600; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 7 === 0) [l, r] = [0, n];
+      const value = (random(161) - 80) / 4;
+      const assigning = random(2) === 0;
+      tree[assigning ? 'assign' : 'add'](l, r, value);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+
+      // Search first so materialization cannot mask stale lazy descendants.
+      const lo = random(n + 1);
+      checkSearch(tree, values, lo, value);
+      checkSearch(tree, values, lo, -Infinity);
+      checkSearch(tree, values, lo, Infinity);
+      let a = random(n + 1);
+      let b = random(n + 1);
+      if (a > b) [a, b] = [b, a];
+      checkRange(tree, values, a, b);
+      checkRange(tree, values, 0, n);
+      const i = random(n);
+      assert.equal(tree.get(i), values[i]);
+      if (step % 53 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('tree traversals retain logarithmic queries and updates and linear materialization', () => {
+  const n = 4097;
+  const tree = new RangeTree(Array(n).fill(-1));
+  const counts = {};
+  for (const name of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[name];
+    tree[name] = function (...args) {
+      counts[name] = (counts[name] || 0) + 1;
+      return original.apply(this, args);
+    };
+  }
+  const logarithmicBound = 8 * Math.ceil(Math.log2(n));
+  const checkVisits = (name, operation) => {
+    counts[name] = 0;
+    operation();
+    assert.ok(counts[name] <= logarithmicBound, `${name}: ${counts[name]} visits`);
+  };
+  checkVisits('_update', () => tree.assign(1, n - 1, -5));
+  checkVisits('_update', () => tree.add(2, n - 2, 3));
+  checkVisits('_sum', () => assert.equal(tree.sum(1, n - 1), -2 * (n - 4) - 10));
+  checkVisits('_max', () => assert.equal(tree.max(1, n - 1), -2));
+  checkVisits('_sum', () => assert.equal(tree.get(n - 2), -5));
+  checkVisits('_first', () => assert.equal(tree.firstAtLeast(1, -1), n - 1));
+  tree.assign(0, n, 7);
+  checkVisits('_first', () => assert.equal(tree.firstAtLeast(n - 2, 7), n - 2));
+  counts._write = 0;
+  assert.deepEqual(tree.toArray(), Array(n).fill(7));
+  assert.equal(counts._write, 2 * n - 1);
+});
