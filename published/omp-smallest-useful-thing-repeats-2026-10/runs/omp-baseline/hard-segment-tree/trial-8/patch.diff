@@ -0,0 +1,146 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard older additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.add(0, 2, 9);
+  tree.add(0, 5, 3);
+  tree.assign(0, 5, -4);
+  tree.add(0, 5, 2);
+  assert.equal(tree.sum(1, 4), -6);
+  assert.deepEqual(tree.toArray(), [-2, -2, -2, -2, -2]);
+  tree.add(0, 2, 7);
+  tree.assign(0, 2, 0);
+  assert.equal(tree.get(0), 0);
+  assert.equal(tree.get(1), 0);
+});
+
+test('partial maximum queries preserve negative values', () => {
+  const tree = new RangeTree([-8, -3, -6, -2, -7]);
+  assert.equal(tree.max(0, 2), -3);
+  assert.equal(tree.max(2, 3), -6);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 2);
+  assert.equal(tree.max(1, 5), -8);
+  assert.equal(tree.max(5, 5), -Infinity);
+});
+
+test('threshold search pushes pending assignments and additions before descending', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.assign(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(3, 20), 3);
+  tree.assign(0, 5, -10);
+  tree.add(0, 5, 3);
+  assert.equal(tree.firstAtLeast(2, -7), 2);
+  assert.equal(tree.firstAtLeast(0, -6), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(1, -Infinity), 1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('API validation, empty ranges, and independent arrays are preserved', () => {
+  for (const values of [null, {}, [], [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -1, 4];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 5; }, TypeError);
+  tree.add(0, 3, 5);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [2, 1], [0, 4], [0.5, 2], [0, NaN], ['0', 2]]) {
+      assert.throws(() => tree[method](l, r, 1), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](2, 2, value), RangeError);
+    }
+    assert.equal(tree[method](0, 0, 42), undefined);
+    assert.equal(tree[method](3, 3, 42), undefined);
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', undefined, null]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  const output = tree.toArray();
+  assert.deepEqual(output, [7, 4, 9]);
+  output[0] = 100;
+  assert.equal(tree.get(0), 7);
+  assert.equal(tree.assign(1, 2, 0), undefined);
+  assert.equal(tree.add(1, 2, 1), undefined);
+  assert.deepEqual(tree.toArray(), [7, 1, 9]);
+});
+
+test('mixed lazy workloads agree with an array oracle', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    const checkRange = (l, r) => {
+      const slice = values.slice(l, r);
+      assert.equal(tree.sum(l, r), slice.reduce((a, b) => a + b, 0));
+      assert.equal(tree.max(l, r), Math.max(...slice));
+    };
+    const checkSearch = (lo, x) => {
+      const expected = values.findIndex((value, i) => i >= lo && value >= x);
+      assert.equal(tree.firstAtLeast(lo, x), expected);
+    };
+    for (let step = 0; step < 1200; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      // Frequent full-range updates retain tags high in the tree.
+      if (step % 7 === 0) { l = 0; r = length; }
+      const value = random(61) - 30;
+      switch (random(6)) {
+        case 0:
+          tree.assign(l, r, value);
+          values.fill(value, l, r);
+          break;
+        case 1:
+        case 2:
+          tree.add(l, r, value);
+          for (let i = l; i < r; i++) values[i] += value;
+          break;
+        case 3:
+          checkRange(l, r);
+          break;
+        case 4:
+          assert.equal(tree.get(l % length), values[l % length]);
+          break;
+        case 5:
+          assert.deepEqual(tree.toArray(), values);
+          break;
+      }
+      // Search before other queries can flush away pending tags.
+      checkSearch(random(length + 1), value);
+      checkRange(l, r);
+    }
+    assert.deepEqual(tree.toArray(), values);
+    for (let l = 0; l <= length; l++) {
+      for (let r = l; r <= length; r++) checkRange(l, r);
+      for (const x of [-Infinity, -30, 0, 30, Infinity]) checkSearch(l, x);
+    }
+  }
+});
