+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { compare, satisfies } = require('./semver');
+
+test('numeric ordering applies to every version component', () => {
+  for (const versions of [['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10']]) {
+    const registry = { a: Object.fromEntries(versions.map(version => [version, {}])) };
+    assert.deepEqual(resolve(registry, { a: '*' }), { a: versions[1] });
+  }
+});
+
+test('backtracking removes abandoned dependencies, constraints, and selections', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0', abandoned: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': { missing: '*' }, '1.0.0': { c: '*' } },
+    abandoned: { '1.0.0': {} },
+    c: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0' });
+});
+
+test('an immediately conflicting candidate rolls back even partially appended dependencies', () => {
+  const registry = {
+    a: { '2.0.0': { ghost: '*', a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0' });
+});
+
+test('FIFO first-found selection is not dependency-first or globally newest', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '2.0.0', c: '1.0.0',
+  });
+});
+
+test('root key order and dependency key order decide the most recent choice', () => {
+  const registry = {
+    a: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+    parent: { '1.0.0': { b: '*', a: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0', c: '2.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0', c: '1.0.0' });
+  assert.deepEqual(resolve(registry, { parent: '*' }), {
+    parent: '1.0.0', b: '2.0.0', a: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('all discovered constraints apply before a queued name is selected', () => {
+  const registry = {
+    a: { '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0' });
+});
+
+test('self cycles, mutual cycles, and repeated diamond discoveries terminate', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '1.0.0': { b: '*', c: '*' } },
+    b: { '1.0.0': { d: '*' } },
+    c: { '1.0.0': { d: '*' } },
+    d: { '1.0.0': { a: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0', d: '1.0.0' });
+});
+
+test('cycle conflicts backtrack to the most recent choice', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('long chains resolve and backtrack without a stack or iteration limit', () => {
+  const registry = {};
+  const length = 15000;
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': i + 1 < length ? { [`p${i + 1}`]: '*' } : {} };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length);
+  assert.equal(result[`p${length - 1}`], '1.0.0');
+  registry[`p${length - 1}`]['1.0.0'] = { missing: '*' };
+  registry.p0['0.0.0'] = {};
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '0.0.0' });
+});
+
+test('constraints are checked before exploring a Cartesian product', () => {
+  const dependencies = {};
+  const registry = { a: { '2.0.0': dependencies, '1.0.0': {} } };
+  for (let i = 0; i < 60; i += 1) {
+    dependencies[`p${i}`] = '*';
+    registry[`p${i}`] = { '2.0.0': {}, '1.0.0': {} };
+  }
+  dependencies.a = '1.0.0';
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0' });
+});
+
+test('missing packages and empty version maps are unsatisfiable, empty root is valid', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.deepEqual(resolve({ a: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('validation includes every unreachable version, range, and map', () => {
+  for (const malformed of [null, [], new Date(), 'map', 42]) {
+    assert.throws(() => resolve(malformed, {}), TypeError);
+    assert.throws(() => resolve({}, malformed), TypeError);
+    assert.throws(() => resolve({ unreachable: malformed }, {}), TypeError);
+    assert.throws(() => resolve({ unreachable: { '1.0.0': malformed } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unreachable: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unreachable: { '1.0.0': { missing: 'invalid' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+});
+
+test('only own enumerable string keys participate and special package names are safe', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    const versions = Object.create(null);
+    versions['1.0.0'] = Object.create(null);
+    registry[name] = Object.freeze(versions);
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'hidden', { value: null });
+  Object.defineProperty(root, 'hidden', { value: 'invalid' });
+  registry[Symbol('ignored')] = null;
+  root[Symbol('ignored')] = 'invalid';
+  const result = resolve(Object.freeze(registry), Object.freeze(root));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+});
+
+// An intentionally small, copying reference search provides independent rollback
+// coverage. Recursion is confined to this bounded test oracle, not the resolver.
+function referenceResolve(registry, root) {
+  function search(queue, cursor, selected, constraints) {
+    while (cursor < queue.length && selected.has(queue[cursor])) cursor += 1;
+    if (cursor === queue.length) return Object.fromEntries(selected);
+    const name = queue[cursor];
+    const candidates = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of candidates) {
+      if (!constraints.get(name).every(range => satisfies(version, range))) continue;
+      const nextSelected = new Map(selected).set(name, version);
+      const nextConstraints = new Map(Array.from(constraints, ([key, ranges]) => [key, ranges.slice()]));
+      const nextQueue = queue.slice();
+      let valid = true;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        if (!nextConstraints.has(dependency)) nextConstraints.set(dependency, []);
+        nextConstraints.get(dependency).push(range);
+        nextQueue.push(dependency);
+        if (nextSelected.has(dependency) && !satisfies(nextSelected.get(dependency), range)) valid = false;
+      }
+      if (!valid) continue;
+      const result = search(nextQueue, cursor + 1, nextSelected, nextConstraints);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(Object.keys(root), 0, new Map(), new Map(Object.entries(root).map(([name, range]) => [name, [range]])));
+}
+
+test('first-found results match an independent reference on generated cyclic graphs', () => {
+  let seed = 123456789;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=2.0.0', '<3.0.0'];
+  for (let sample = 0; sample < 300; sample += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        const deps = {};
+        for (const dependency of [...names, 'missing']) {
+          if (random(5) === 0) deps[dependency] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names) if (random(2) === 0) root[name] = ranges[random(ranges.length)];
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `sample ${sample}`);
+  }
+});
