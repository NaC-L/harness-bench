+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('../src');
+const { compare, satisfies } = require('../src/semver');
+
+// A small, independent copying search is an oracle for FIFO first-found behavior.
+// Recursion is only used here for tiny generated registries, never in the resolver.
+function reference(registry, root) {
+  function search(selected, pending, constraints) {
+    if (pending.length === 0) return selected;
+    const [name, ...rest] = pending;
+    if (Object.hasOwn(selected, name)) return search(selected, rest, constraints);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints[name].every(range => satisfies(version, range))) continue;
+      const next = { ...selected, [name]: version };
+      const nextConstraints = Object.fromEntries(Object.entries(constraints).map(([key, ranges]) => [key, [...ranges]]));
+      const nextPending = [...rest];
+      let conflict = false;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        (nextConstraints[dependency] ||= []).push(range);
+        nextPending.push(dependency);
+        if (Object.hasOwn(next, dependency) && !satisfies(next[dependency], range)) conflict = true;
+      }
+      if (conflict) continue;
+      const result = search(next, nextPending, nextConstraints);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search({}, Object.keys(root), Object.fromEntries(Object.entries(root).map(([name, range]) => [name, [range]])));
+}
+
+function freezeRegistry(registry) {
+  for (const versions of Object.values(registry)) {
+    for (const deps of Object.values(versions)) Object.freeze(deps);
+    Object.freeze(versions);
+  }
+  return Object.freeze(registry);
+}
+
+test('numeric ordering compares all three components', () => {
+  assert.deepEqual(resolve({ a: { '9.0.0': {}, '10.0.0': {}, '10.9.0': {}, '10.10.9': {}, '10.10.10': {} } }, { a: '*' }), { a: '10.10.10' });
+});
+
+test('backtracking removes failed-branch constraints and unreachable dependencies', () => {
+  const registry = freezeRegistry({
+    a: { '2.0.0': { b: '2.0.0', ghost: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  });
+  const root = Object.freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('partial discovery is undone after conflicting with an already selected package', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { ghost: '*', a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('dependency constraints are collected before their FIFO entries are processed', () => {
+  const registry = {
+    a: { '1.0.0': { c: '1.0.0' } },
+    b: { '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.equal(resolve(registry, { a: '*', b: '*' }), null);
+});
+
+test('FIFO discovery determines the first solution, rather than recursive dependency order', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '2.0.0', c: '1.0.0' });
+});
+
+test('root key order controls which package keeps its highest version', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+});
+
+test('cycles expand each selected package once and can backtrack to a satisfiable cycle', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('long cyclic chains and deep backtracking do not use the call stack or a cutoff', () => {
+  const count = 15000;
+  const registry = {};
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % count}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, count);
+  assert.equal(result[`p${count - 1}`], '1.0.0');
+  registry[`p${count - 1}`]['1.0.0'] = { missing: '*' };
+  registry.p0['0.0.0'] = {};
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '0.0.0' });
+});
+
+test('discovered conflicts prune choices rather than enumerating a Cartesian product', () => {
+  const registry = { guard: { '1.0.0': {} } };
+  const root = { guard: '*' };
+  const expected = { guard: '1.0.0' };
+  for (let i = 0; i < 60; i += 1) {
+    registry[`p${i}`] = { '2.0.0': { guard: '2.0.0' }, '1.0.0': {} };
+    root[`p${i}`] = '*';
+    expected[`p${i}`] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('missing packages and empty catalogs are unsatisfiable, but unreachable ones are irrelevant', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.deepEqual(resolve({ a: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('all registry entries are validated eagerly, even with an empty root', () => {
+  const badRecords = [null, [], 1, 'map', new Date(), Object.create({})];
+  for (const bad of badRecords) {
+    assert.throws(() => resolve(bad, {}), TypeError);
+    assert.throws(() => resolve({}, bad), TypeError);
+    assert.throws(() => resolve({ unreachable: bad }, {}), TypeError);
+    assert.throws(() => resolve({ unreachable: { '1.0.0': bad } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unreachable: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unreachable: { '1.0.0': { missing: '^0.1' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+});
+
+test('many references to a selected package do not repeatedly scan its constraints', () => {
+  const registry = { shared: { '1.0.0': {} } };
+  const root = { shared: '*' };
+  const count = 15000;
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { shared: '*' } };
+    root[`p${i}`] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.keys(result).length, count + 1);
+  assert.equal(result.shared, '1.0.0');
+});
+
+test('null-prototype maps, special names, and only own enumerable string keys', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'ignored', { value: null });
+  Object.defineProperty(root, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  root[Symbol('ignored')] = null;
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+});
+
+test('generated small cyclic registries agree with an independent first-found oracle', () => {
+  let seed = 0x12345678;
+  function random(max) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % max;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=1.0.0 <2.0.0'];
+  for (let iteration = 0; iteration < 500; iteration += 1) {
+    const registry = {};
+    for (const name of names) {
+      const versions = registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0']) {
+        const deps = versions[version] = {};
+        for (const dependency of [...names, 'missing']) {
+          if (random(5) === 0) deps[dependency] = ranges[random(ranges.length)];
+        }
+      }
+    }
+    const root = {};
+    for (const name of names) if (random(3) !== 0) root[name] = ranges[random(ranges.length)];
+    assert.deepEqual(resolve(registry, root), reference(registry, root), `generated case ${iteration}`);
+  }
+});
