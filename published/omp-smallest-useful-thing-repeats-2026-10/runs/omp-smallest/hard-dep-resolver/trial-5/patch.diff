+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parse, compare, satisfies, compileRange } = require('../src/semver');
+const { resolve } = require('../src');
+
+test('parse requires canonical safe integer triples', () => {
+  assert.deepEqual(parse('0.10.9007199254740991'), [0, 10, Number.MAX_SAFE_INTEGER]);
+  for (const invalid of [null, 1, {}, '', '1', '1.2', '1.2.3.4', '01.2.3', '1.02.3', '1.2.03', '-1.2.3', '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3 ', '1.2.3\n', '1.2.3\r', '1.2.3\u2028', '1.2.3\u2029', '9007199254740992.0.0']) {
+    assert.throws(() => parse(invalid), TypeError, String(invalid));
+  }
+});
+
+test('compare is numeric and returns only -1, 0, or 1', () => {
+  assert.equal(compare('1.9.0', '1.10.0'), -1);
+  assert.equal(compare('10.0.0', '9.99.99'), 1);
+  assert.equal(compare('1.0.10', '1.0.9'), 1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+  assert.throws(() => compare('1.0.0', '01.0.0'), TypeError);
+});
+
+test('each range operator, conjunctions, whitespace, and compiled predicates', () => {
+  const cases = [
+    ['1.2.3', '*', true], ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false],
+    ['1.2.3', '>=1.2.3', true], ['1.2.3', '>1.2.3', false], ['1.2.4', '>1.2.3', true],
+    ['1.2.3', '<=1.2.3', true], ['1.2.3', '<1.2.3', false], ['1.2.2', '<1.2.3', true],
+    ['1.2.3', ' \t>=1.0.0\n<2.0.0 * ', true], ['2.0.0', '>=1.0.0 <2.0.0', false],
+    ['1.2.3', '>2.0.0 <1.0.0', false],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected);
+  }
+});
+
+test('caret uses next major, minor, or patch according to the first nonzero component', () => {
+  const cases = [
+    ['1.2.3', '^1.2.3', true], ['1.2.2', '^1.2.3', false], ['1.99.99', '^1.2.3', true], ['2.0.0', '^1.2.3', false],
+    ['0.2.3', '^0.2.3', true], ['0.2.2', '^0.2.3', false], ['0.2.99', '^0.2.3', true], ['0.3.0', '^0.2.3', false],
+    ['0.0.3', '^0.0.3', true], ['0.0.2', '^0.0.3', false], ['0.0.4', '^0.0.3', false],
+    ['0.0.0', '^0.0.0', true], ['0.0.1', '^0.0.0', false],
+  ];
+  for (const [version, range, expected] of cases) assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+  const registry = { a: { '0.3.0': {}, '0.2.9': {}, '0.2.3': {} } };
+  assert.deepEqual(resolve(registry, { a: '^0.2.3' }), { a: '0.2.9' });
+});
+
+test('tilde always uses the next minor and ranges handle safe integer boundaries', () => {
+  assert.equal(satisfies('0.0.9', '~0.0.3'), true);
+  assert.equal(satisfies('0.1.0', '~0.0.3'), false);
+  assert.equal(satisfies('1.3.0', '~1.2.3'), false);
+  assert.equal(satisfies('1.2.2', '~1.2.3'), false);
+  assert.equal(satisfies('9007199254740991.99.99', '^9007199254740991.0.0'), true);
+  assert.equal(satisfies('0.9007199254740991.1', '^0.9007199254740991.0'), true);
+  assert.equal(satisfies('0.0.9007199254740991', '^0.0.9007199254740991'), true);
+  assert.equal(satisfies('1.9007199254740991.9', '~1.9007199254740991.0'), true);
+});
+
+test('invalid ranges fail eagerly in compileRange and satisfies', () => {
+  for (const range of [null, 1, {}, '', ' \n\t', '^', '~', '>=', '1.2', '01.2.3', 'v1.2.3', '=1.2.3', '!=1.2.3', '1.2.x', '1.2.3 || 2.0.0', '1.2.3 - 2.0.0', '> 1.2.3', '**', '* invalid']) {
+    assert.throws(() => compileRange(range), TypeError, String(range));
+    assert.throws(() => satisfies('1.2.3', range), TypeError, String(range));
+  }
+  assert.throws(() => satisfies('1.2.3\n', '*'), TypeError);
+});
