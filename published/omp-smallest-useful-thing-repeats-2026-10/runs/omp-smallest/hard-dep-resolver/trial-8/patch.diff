+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { compare, satisfies } = require('./semver');
+
+test('versions are ordered numerically in every component', () => {
+  const registry = { pkg: {
+    '9.99.99': {}, '10.9.99': {}, '10.10.9': {}, '10.10.10': {},
+  } };
+  assert.deepEqual(resolve(registry, { pkg: '*' }), { pkg: '10.10.10' });
+  assert.deepEqual(resolve(registry, { pkg: '<10.10.10' }), { pkg: '10.10.9' });
+});
+
+test('first-found selection uses FIFO discovery, not dependency-first traversal', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '2.0.0', c: '1.0.0',
+  });
+  assert.deepEqual(resolve(registry, { c: '*', a: '*' }), {
+    c: '2.0.0', a: '1.0.0', b: '1.0.0',
+  });
+});
+
+test('all discovered constraints apply before a queued package is selected', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*' } },
+    b: { '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('backtracking removes constraints, queued dependencies, and abandoned selections', () => {
+  const registry = {
+    a: { '2.0.0': { shared: '2.0.0', abandoned: '*' }, '1.0.0': { shared: '1.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+    abandoned: { '1.0.0': { missing: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', shared: '*' }), {
+    a: '1.0.0', shared: '1.0.0',
+  });
+});
+
+test('partial dependency discovery is undone after conflict with a selected package', () => {
+  const registry = {
+    anchor: { '1.0.0': {} },
+    a: {
+      '3.0.0': { temporary: '*', anchor: '2.0.0', missing: '*' },
+      '2.0.0': { anchor: '2.0.0' },
+      '1.0.0': { anchor: '1.0.0' },
+    },
+  };
+  assert.deepEqual(resolve(registry, { anchor: '*', a: '*' }), {
+    anchor: '1.0.0', a: '1.0.0',
+  });
+});
+
+test('cycles terminate, and conflicting cycles backtrack or return null', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve(registry, { a: '2.0.0' }), null);
+});
+
+test('long chains and backtracking do not depend on recursion or iteration limits', () => {
+  const registry = {};
+  const length = 20000;
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': i + 1 < length ? { [`p${i + 1}`]: '*' } : { p0: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length);
+  assert.equal(result[`p${length - 1}`], '1.0.0');
+  registry[`p${length - 1}`]['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('discovered conflicts prune branches before a Cartesian product is enumerated', () => {
+  const registry = { anchor: { '1.0.0': {} } };
+  const expected = { anchor: '1.0.0' };
+  for (let i = 0; i < 80; i += 1) {
+    const next = i < 79 ? { [`p${i + 1}`]: '*' } : {};
+    registry[`p${i}`] = {
+      '2.0.0': { ...next, anchor: '2.0.0' },
+      '1.0.0': { ...next, anchor: '1.0.0' },
+    };
+    expected[`p${i}`] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, { p0: '*', anchor: '*' }), expected);
+});
+
+test('empty roots and missing packages have distinct valid outcomes', () => {
+  assert.deepEqual(resolve({}, {}), {});
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ empty: {} }, { empty: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': { missing: '*' } } }, { a: '*' }), null);
+});
+
+test('unreachable malformed entries are validated eagerly, including with an empty root', () => {
+  const invalidRegistries = [
+    null, [], new Date(),
+    { unused: null }, { unused: [] },
+    { unused: { '01.0.0': {} } },
+    { unused: { '1.0.0\n': {} } },
+    { unused: { '1.0.0': null } },
+    { unused: { '1.0.0': [] } },
+    { unused: { '1.0.0': { missing: '^0.01.0' } } },
+    { unused: { '1.0.0': { missing: '' } } },
+    { unused: { '1.0.0': { missing: 1 } } },
+  ];
+  for (const registry of invalidRegistries) assert.throws(() => resolve(registry, {}), TypeError);
+  for (const root of [null, [], new Date(), { a: '' }, { a: 1 }]) {
+    assert.throws(() => resolve({}, root), TypeError);
+  }
+});
+
+test('only own enumerable string keys participate and special names remain ordinary keys', () => {
+  const deps = Object.create(null);
+  deps.constructor = '*';
+  const registry = Object.create(null);
+  registry.__proto__ = { '1.0.0': deps };
+  registry.constructor = { '1.0.0': {} };
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  const root = Object.create(null);
+  root.__proto__ = '*';
+  Object.defineProperty(root, 'ignored', { value: '' });
+  root[Symbol('ignored')] = '';
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor']);
+  assert.equal(result.__proto__, '1.0.0');
+  assert.equal(result.constructor, '1.0.0');
+  assert.deepEqual(resolve({}, { toString: '*' }), null);
+});
+
+test('frozen inputs remain unchanged across success and failure', () => {
+  const registry = Object.freeze({ a: Object.freeze({ '1.0.0': Object.freeze({}) }) });
+  const root = Object.freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0' });
+  assert.equal(resolve(registry, Object.freeze({ a: '2.0.0' })), null);
+  assert.deepEqual(registry, { a: { '1.0.0': {} } });
+  assert.deepEqual(root, { a: '*' });
+});
+
+// A small snapshot-based oracle keeps the first-found rule independent of the
+// production resolver's choice frames and reversible trails. Graphs stay tiny.
+function referenceResolve(registry, root) {
+  function visit(queue, cursor, selected) {
+    for (const [name, range] of queue) {
+      if (selected.has(name) && !satisfies(selected.get(name), range)) return null;
+    }
+    while (cursor < queue.length && selected.has(queue[cursor][0])) cursor += 1;
+    if (cursor === queue.length) return Object.fromEntries(selected);
+    const name = queue[cursor][0];
+    const ranges = queue.filter(item => item[0] === name).map(item => item[1]);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!ranges.every(range => satisfies(version, range))) continue;
+      const next = new Map(selected);
+      next.set(name, version);
+      const result = visit(queue.concat(Object.entries(registry[name][version])), cursor + 1, next);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return visit(Object.entries(root), 0, new Map());
+}
+
+test('first-found results match a snapshot oracle on deterministic cyclic graphs', () => {
+  let seed = 123456;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '3.0.0', '>=2.0.0', '<3.0.0'];
+  for (let trial = 0; trial < 400; trial += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        const deps = {};
+        for (const dependency of [...names, 'missing']) {
+          if (random(5) === 0) deps[dependency] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = { [names[random(names.length)]]: '*' };
+    root[names[random(names.length)]] = ranges[random(ranges.length)];
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `graph ${trial}`);
+  }
+});
