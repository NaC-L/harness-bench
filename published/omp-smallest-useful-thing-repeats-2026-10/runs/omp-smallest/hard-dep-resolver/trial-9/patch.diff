+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { compare, satisfies } = require('./src/semver');
+
+test('versions are ordered numerically at every component', () => {
+  for (const versions of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    const registry = { a: Object.fromEntries(versions.map(version => [version, {}])) };
+    assert.deepEqual(resolve(registry, { a: '*' }), { a: versions[1] });
+  }
+});
+
+test('first found uses FIFO discovery rather than recursive dependency order', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '2.0.0', c: '1.0.0',
+  });
+  assert.deepEqual(resolve(registry, { c: '*', a: '*', b: '*' }), {
+    c: '2.0.0', a: '2.0.0', b: '1.0.0',
+  });
+});
+
+test('rollback removes constraints, missing dependencies and descendant selections', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0', ghost: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': { old: '*' }, '1.0.0': { fresh: '*' } },
+    old: { '1.0.0': {} },
+    fresh: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), {
+    a: '1.0.0', b: '1.0.0', fresh: '1.0.0',
+  });
+});
+
+test('rollback removes a partially appended dependency list after an immediate conflict', () => {
+  const registry = {
+    a: { '1.0.0': {} },
+    b: {
+      '2.0.0': { c: '2.0.0', a: '2.0.0', ghost: '*' },
+      '1.0.0': { c: '1.0.0' },
+    },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('cycles expand each selected version only once and can backtrack', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '>1.0.0' } } }, { a: '*' }), null);
+});
+
+test('all discovered constraints are collected before selecting a package', () => {
+  const registry = {
+    a: { '1.0.0': { c: '<2.0.0' } },
+    b: { '1.0.0': { c: '>=1.5.0' } },
+    c: { '2.0.0': {}, '1.5.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*', c: '*' }), {
+    a: '1.0.0', b: '1.0.0', c: '1.5.0',
+  });
+  assert.equal(resolve(registry, { a: '*', b: '*', c: '<1.5.0' }), null);
+});
+
+test('zero-major caret ranges constrain resolver choices', () => {
+  const registry = { a: { '0.9.0': {}, '0.2.9': {}, '0.2.3': {}, '0.0.4': {}, '0.0.3': {} } };
+  assert.deepEqual(resolve(registry, { a: '^0.2.3' }), { a: '0.2.9' });
+  assert.deepEqual(resolve(registry, { a: '^0.0.3' }), { a: '0.0.3' });
+});
+
+test('long cyclic chains exceed both the old iteration limit and typical call-stack depth', () => {
+  const registry = {};
+  const length = 15000;
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % length}`]: '*', p0: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.notEqual(result, null);
+  assert.equal(Object.keys(result).length, length);
+  assert.ok(Object.values(result).every(version => version === '1.0.0'));
+  // Force iterative unwinding of the entire chain as well as iterative discovery.
+  registry[`p${length - 1}`]['1.0.0'].missing = '*';
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('conflicts are pruned at discovery, not after enumerating a Cartesian product', () => {
+  const registry = { anchor: { '2.0.0': {}, '1.0.0': {} } };
+  const root = { anchor: '*' };
+  for (let i = 0; i < 48; i += 1) {
+    registry[`p${i}`] = { '2.0.0': { anchor: '1.0.0' }, '1.0.0': { anchor: '2.0.0' } };
+    root[`p${i}`] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(result.anchor, '2.0.0');
+  assert.ok(Object.keys(root).slice(1).every(name => result[name] === '1.0.0'));
+});
+
+test('missing packages and empty catalogs are unsatisfiable; empty root selects nothing', () => {
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': { missing: '*' } } }, { a: '*' }), null);
+});
+
+test('validation is eager even for unreachable entries and empty roots', () => {
+  const invalidMaps = [null, undefined, [], 'map', 1, new Date(), Object.create({})];
+  for (const invalid of invalidMaps) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  for (const version of ['1.0', '01.0.0', '1.0.0-beta', '1.0.0\n', '9007199254740992.0.0']) {
+    assert.throws(() => resolve({ unused: { [version]: {} } }, {}), TypeError);
+  }
+  for (const range of ['', ' ', 'latest', '^', '>= 1.0.0', '1.0.0 || 2.0.0', null, 1]) {
+    assert.throws(() => resolve({ unused: { '1.0.0': { missing: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { missing: range }), TypeError);
+  }
+});
+
+test('only own enumerable string keys participate and prototype-like names are safe', () => {
+  const names = ['__proto__', 'constructor', 'toString'];
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of names) {
+    registry[name] = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+    root[name] = '*';
+  }
+  for (const record of [registry, root, ...Object.values(registry), ...Object.values(registry).map(map => map['1.0.0'])]) {
+    Object.defineProperty(record, 'ignored', { value: null });
+    record[Symbol('ignored')] = null;
+    Object.freeze(record);
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), names);
+  for (const name of names) assert.equal(result[name], '1.0.0');
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+});
+
+test('frozen inputs are never mutated', () => {
+  const deps = Object.freeze({ b: '*' });
+  const registry = Object.freeze({
+    a: Object.freeze({ '2.0.0': deps, '1.0.0': Object.freeze({}) }),
+    b: Object.freeze({ '1.0.0': Object.freeze({}) }),
+  });
+  const root = Object.freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(registry.a['2.0.0'], deps);
+});
+
+// A small immutable reference search checks exact first-found behavior without
+// sharing the production resolver's mutable queue, frames, or constraint trail.
+function referenceResolve(registry, root) {
+  function search(selected, pending, constraints) {
+    for (const [name, version] of Object.entries(selected)) {
+      if (!constraints.every(([target, range]) => target !== name || satisfies(version, range))) return null;
+    }
+    if (pending.length === 0) return selected;
+    const [name, ...rest] = pending;
+    if (Object.hasOwn(selected, name)) return search(selected, rest, constraints);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints.every(([target, range]) => target !== name || satisfies(version, range))) continue;
+      const deps = Object.entries(registry[name][version]);
+      const result = search({ ...selected, [name]: version }, [...rest, ...deps.map(([target]) => target)], [...constraints, ...deps]);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search({}, Object.keys(root), Object.entries(root));
+}
+
+test('seeded small dependency graphs match an independent first-found search', () => {
+  let seed = 20261001;
+  function random(max) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % max;
+  }
+  const ranges = ['*', '1.0.0', '2.0.0', '<2.0.0', '>=2.0.0'];
+  const names = ['a', 'b', 'c', 'd'];
+  for (let iteration = 0; iteration < 300; iteration += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0']) {
+        if (random(5) === 0) continue;
+        const deps = {};
+        for (const target of [...names, 'missing']) {
+          if (random(4) === 0) deps[target] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names) if (random(3) !== 0) root[name] = ranges[random(ranges.length)];
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `graph ${iteration}`);
+  }
+});
