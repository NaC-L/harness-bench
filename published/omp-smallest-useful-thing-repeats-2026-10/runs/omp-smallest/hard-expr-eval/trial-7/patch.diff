@@ -0,0 +1,170 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./index');
+
+function assertError(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('numeric literals, precedence, associativity, and unary signs', () => {
+  const cases = [
+    ['1.5 + .5 + 5. + 1.5e-3 + 2E+1', 27.0015],
+    ['2 + 3 * 4', 14],
+    ['(2 + 3) * 4', 20],
+    ['20 - 5 - 3', 12],
+    ['24 / 4 / 2', 3],
+    ['20 // 3 * 2 % 5', 2],
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['3 * -2 ** 2', -12],
+    ['--2 ** 2', 4],
+    ['2 ** +3', 8],
+    ['2 - -3', 5],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo signs, identity, and positive zeros', () => {
+  for (const a of [-13, -7, -1, 0, 1, 7, 13]) {
+    for (const b of [-5, -3, -2, 2, 3, 5]) {
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const source of ['-0 // 2', '0 // -2', '-6 % 3', '6 % -3', '0 % -2']) {
+    assert.equal(Object.is(evaluate(source), 0), true, source);
+  }
+  for (const operator of ['/', '//', '%']) {
+    for (const zero of ['0', '-0', '(1 > 2)']) {
+      const source = `  7   ${operator} ${zero}`;
+      assertError(source, source.indexOf(operator) + 1);
+    }
+  }
+});
+
+test('comparisons chain, short-circuit, and coerce booleans numerically', () => {
+  const cases = [
+    ['1 < 2 <= 3', true],
+    ['3 > 2 >= 2', true],
+    ['1 < 2 > 1', true],
+    ['1 < 2 == 2 != 3', true],
+    ['3 < 2 < 1', false],
+    ['1 == 2 == 0', false],
+    ['1 < 2 + 3 * 4', true],
+    ['(1 < 2) + (3 < 2)', 1],
+    ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true],
+    ['(1 < 2) ** 3', 1],
+    ['1 < (2 < 3)', false],
+    ['(1 < 2) < 3', true],
+    ['2 < 1 < missing', false],
+    ['2 < 1 < (1 / 0)', false],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('variables use own properties, read once per occurrence in evaluation order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 10 });
+  for (const [name, value] of Object.entries({ a: 1, b: 2, c: 3, d: 4 })) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c + d', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < d', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a + b, abs(-c), min(d, a))', variables), 3);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd', 'a']);
+  assertError('  inherited', 3, variables);
+  assertError('  toString', 3, {});
+  assert.equal(evaluate('_x1 + A2', { _x1: 2, A2: 3 }), 5);
+  let occurrences = 0;
+  assert.equal(evaluate('x + x * x', { get x() { return ++occurrences; } }), 7);
+  assert.equal(occurrences, 3);
+});
+
+test('built-ins validate arity and preserve Python selection semantics', () => {
+  assert.equal(evaluate('min(4, -1, 7, 2)'), -1);
+  assert.equal(evaluate('max(4, -1, 7, 2)'), 7);
+  assert.equal(evaluate('abs(-7)'), 7);
+  assert.equal(evaluate('min(2)'), 2);
+  assert.equal(evaluate('max(2)'), 2);
+  assert.equal(evaluate('min(1 > 2, 2)'), false);
+  assert.equal(evaluate('max(1 < 2, 0)'), true);
+  assert.equal(evaluate('abs(1 < 2)'), 1);
+  assert.equal(Object.is(evaluate('min(0, -0)'), 0), true);
+  assert.equal(Object.is(evaluate('max(-0, 0)'), -0), true);
+  assert.equal(evaluate('min(1, x)', { x: NaN }), 1);
+  assert.equal(evaluate('max(1, x)', { x: NaN }), 1);
+});
+
+test('syntax is checked in full before any getters or runtime errors', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  for (const source of [
+    'x + min()', 'x + max()', 'x + abs()', 'x + abs(1, 2)', 'x + other(1)',
+    'x + 2 < 1 < abs(1, 2)', 'x + 2 < 1 < other(1)',
+  ]) {
+    const name = /(?:min|max|abs|other)\(/.exec(source)[0].slice(0, -1);
+    assertError(source, source.indexOf(name) + 1, variables);
+  }
+  assertError('x + min(1,)', 11, variables);
+  assertError('x + 2 < 1 < (3 + )', 18, variables);
+  assertError('1 / 0 + abs()', 9, variables);
+  assert.equal(reads, 0);
+});
+
+test('syntax and lexical errors report actual UTF-16 token offsets', () => {
+  const cases = [
+    ['  missing', 3],
+    ['1 +   missing', 7],
+    ['  @', 3],
+    ['1 + \t @', 7],
+    ['1 +   )', 7],
+    ['  1  2', 6],
+    ['1 +   ', 7],
+    ['', 1],
+    [' \t\n', 4],
+    ['(1 + 2   ', 10],
+    ['2(3)', 2],
+    ['1 = 2', 3],
+    ['1 ! 2', 3],
+    ['1e+', 2],
+    ['min(1,   )', 10],
+    ['  unknown(1)', 3],
+    ['1 + \u{1F600}', 5],
+    ['1\u2003+\u2003)', 5],
+  ];
+  for (const [source, column] of cases) assertError(source, column);
+});
+
+test('100,001-operand arithmetic and comparison chains evaluate without recursion', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array.from({ length: count }, (_, index) => index).join('<')), true);
+  assert.equal(evaluate('2 < 1 < ' + Array(count).fill('missing').join('<')), false);
+});
