+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small independent oracle, used only for short exhaustive test inputs.
+function lcsLength(a, b) {
+  let previous = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const current = [0];
+    for (let j = 0; j < b.length; j++) {
+      current.push(line === b[j]
+        ? previous[j] + 1
+        : Math.max(previous[j + 1], current[j]));
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op === 'equal').length, lcsLength(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserting = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserting = false;
+    if (entry.op === 'insert') inserting = true;
+    if (entry.op === 'delete') assert.equal(inserting, false);
+  }
+}
+
+test('minimal deterministic scripts and roundtrips for exhaustive repeated lines', () => {
+  const arrays = [Object.freeze([])];
+  let level = arrays;
+  for (let length = 1; length <= 4; length++) {
+    const next = [];
+    for (const prefix of level) {
+      for (const line of ['', 'a', '+a']) next.push(Object.freeze([...prefix, line]));
+    }
+    arrays.push(...next);
+    level = next;
+  }
+  for (const a of arrays) {
+    for (const b of arrays) {
+      checkScript(a, b);
+      for (const context of [0, 1, 2, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+        if (a.length === b.length && a.every((line, i) => line === b[i])) {
+          assert.deepEqual(hunks, []);
+        }
+      }
+    }
+  }
+});
+
+test('longer randomized repetitive inputs remain minimal and roundtrip', () => {
+  let seed = 12345;
+  const random = () => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed;
+  };
+  const alphabet = ['', 'a', 'b', '-delete', '+insert', ' context'];
+  for (let trial = 0; trial < 200; trial++) {
+    const a = Array.from({ length: random() % 40 }, () => alphabet[random() % alphabet.length]);
+    const b = Array.from({ length: random() % 40 }, () => alphabet[random() % alphabet.length]);
+    checkScript(a, b);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context: trial % 5 })), b);
+  }
+});
+
+test('zero-length ranges use preceding coordinates and subsequent hunks use global coordinates', () => {
+  const a = ['a', 'b', 'c', 'd', 'e'];
+  const b = ['x', 'a', 'c', 'd', 'z', 'e', 'y'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 2, oldLines: 1, newStart: 2, newLines: 0, lines: ['-b'] },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+z'] },
+    { oldStart: 5, oldLines: 0, newStart: 7, newLines: 1, lines: ['+y'] },
+  ]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(unifiedHunks(['a'], [], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-a'] },
+  ]);
+});
+
+test('context merges at exactly twice the context and never duplicates lines', () => {
+  const a = Array.from({ length: 12 }, (_, i) => String(i));
+  const b = a.slice();
+  b[1] = 'first';
+  b[6] = 'second';
+  assert.deepEqual(unifiedHunks(a, b, { context: 2 }), [{
+    oldStart: 1, oldLines: 9, newStart: 1, newLines: 9,
+    lines: [' 0', '-1', '+first', ' 2', ' 3', ' 4', ' 5', '-6', '+second', ' 7', ' 8'],
+  }]);
+  b[6] = '6';
+  b[7] = 'second';
+  const hunks = unifiedHunks(a, b, { context: 2 });
+  assert.equal(hunks.length, 2);
+  assert.deepEqual(hunks.map(hunk => [hunk.oldStart, hunk.oldLines]), [[1, 4], [6, 5]]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  assert.equal(unifiedHunks(a, b)[0].oldLines, 11);
+});
+
+test('patches preserve literal prefixes and unmentioned lines, and return a new array', () => {
+  const a = Object.freeze(['', ' leading', '+literal', '-literal', 'tail']);
+  const b = ['', ' leading', '-replacement', '+literal', 'tail', ''];
+  assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(applyHunks(['a', 'b', 'c'], [{
+    oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'],
+  }]), ['a', 'B', 'c']);
+});
+
+test('malformed, mismatched, overlapping, and misordered patches identify the failing hunk', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {},
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: '2' },
+    { ...valid, oldStart: 4 }, { ...valid, newStart: 3 },
+    { ...valid, newStart: 0 }, { ...valid, oldLines: 2 },
+    { ...valid, oldLines: -1 }, { ...valid, newLines: 2 },
+    { ...valid, newLines: NaN }, { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] }, { ...valid, lines: ['?b', '+B'] },
+    { ...valid, lines: ['', '+B'] }, { ...valid, lines: [null] },
+    { ...valid, lines: 'not an array' },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 3, oldLines: 0, newStart: 3, newLines: 1, lines: ['+x'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+});
+
+test('small changes to 20,000 lines run in under one second', (t) => {
+  const a = Array.from({ length: 20000 }, (_, i) => `line ${i % 100}`);
+  const b = a.slice();
+  b[10] = 'first replacement';
+  b[10000] = 'middle replacement';
+  b[19990] = 'last replacement';
+  b.splice(12000, 0, 'inserted line');
+  b.splice(8000, 1);
+  const start = performance.now();
+  const script = diffLines(a, b);
+  const hunks = unifiedHunks(a, b);
+  const patched = applyHunks(a, hunks);
+  const elapsed = performance.now() - start;
+  assert.deepEqual(patched, b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length, 8);
+  assert.ok(elapsed < 1000, `took ${elapsed.toFixed(1)} ms`);
+  t.diagnostic(`20,000-line diff, hunk construction, and patch: ${elapsed.toFixed(1)} ms`);
+});
