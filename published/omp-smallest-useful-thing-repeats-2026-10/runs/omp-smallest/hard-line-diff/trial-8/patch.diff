@@ -0,0 +1,183 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const previous = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = previous;
+    }
+  }
+  return row[b.length];
+}
+
+function checkPair(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const { op } of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(op));
+    if (op === 'equal') inserted = false;
+    if (op === 'insert') inserted = true;
+    if (op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+  for (const context of [0, 1, 2, 3]) {
+    const hunks = unifiedHunks(a, b, { context });
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+}
+
+test('minimal deterministic scripts and roundtrips for exhaustive repetitive inputs', () => {
+  const alphabet = ['', 'x', '+'];
+  const inputs = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 3; length++) {
+    level = level.flatMap(prefix => alphabet.map(line => [...prefix, line]));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) checkPair(Object.freeze(a), Object.freeze(b));
+  }
+});
+
+test('seeded longer scripts remain minimal and roundtrip', () => {
+  let seed = 123456789;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  }
+  const alphabet = ['', 'a', 'b', 'c', '+insert', '-delete', ' context'];
+  for (let iteration = 0; iteration < 250; iteration++) {
+    const a = Array.from({ length: random(31) }, () => alphabet[random(alphabet.length)]);
+    const b = Array.from({ length: random(31) }, () => alphabet[random(alphabet.length)]);
+    checkPair(Object.freeze(a), Object.freeze(b));
+  }
+});
+
+test('zero-line ranges use preceding line numbers and complete-file coordinates', () => {
+  const a = ['a', 'b', 'c'];
+  const b = ['top', 'a', 'b', 'middle', 'c', 'bottom'];
+  const insertions = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 2, oldLines: 0, newStart: 4, newLines: 1, lines: ['+middle'] },
+    { oldStart: 3, oldLines: 0, newStart: 6, newLines: 1, lines: ['+bottom'] },
+  ];
+  assert.deepEqual(unifiedHunks(a, b, { context: 0 }), insertions);
+  assert.deepEqual(applyHunks(a, insertions), b);
+  const deletions = insertions.map(hunk => ({
+    oldStart: hunk.newStart,
+    oldLines: hunk.newLines,
+    newStart: hunk.oldStart,
+    newLines: hunk.oldLines,
+    lines: hunk.lines.map(line => '-' + line.slice(1)),
+  }));
+  assert.deepEqual(unifiedHunks(b, a, { context: 0 }), deletions);
+  assert.deepEqual(applyHunks(b, deletions), a);
+  assert.deepEqual(unifiedHunks([], []), []);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('context merges touching windows, splits larger gaps, and clips at boundaries', () => {
+  const a = Array.from({ length: 10 }, (_, i) => String(i));
+  const touching = a.slice();
+  touching[1] = 'first';
+  touching[6] = 'second';
+  assert.deepEqual(unifiedHunks(a, touching, { context: 2 }), [{
+    oldStart: 1, oldLines: 9, newStart: 1, newLines: 9,
+    lines: [' 0', '-1', '+first', ' 2', ' 3', ' 4', ' 5', '-6', '+second', ' 7', ' 8'],
+  }]);
+  const separated = a.slice();
+  separated[1] = 'first';
+  separated[7] = 'second';
+  assert.deepEqual(unifiedHunks(a, separated, { context: 2 }), [
+    { oldStart: 1, oldLines: 4, newStart: 1, newLines: 4,
+      lines: [' 0', '-1', '+first', ' 2', ' 3'] },
+    { oldStart: 6, oldLines: 5, newStart: 6, newLines: 5,
+      lines: [' 5', ' 6', '-7', '+second', ' 8', ' 9'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a'], ['b']), [{
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ['-a', '+b'],
+  }]);
+});
+
+test('applying retains unmentioned lines and preserves inputs and prefix characters', () => {
+  const a = Object.freeze(['keep', '+old', '-old', ' old', '', 'tail']);
+  const b = Object.freeze(['keep', '+new', '-old', ' new', '', 'tail']);
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(a, ['keep', '+old', '-old', ' old', '', 'tail']);
+});
+
+test('malformed and nonapplicable hunks identify their index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null,
+    { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 2.5 },
+    { ...valid, oldStart: '2' },
+    { ...valid, oldLines: -1 },
+    { ...valid, oldLines: NaN },
+    { ...valid, newLines: Infinity },
+    { ...valid, newStart: 0 },
+    { ...valid, newStart: 3 },
+    { ...valid, newLines: 2 },
+    { ...valid, oldLines: 2 },
+    { ...valid, oldStart: 5 },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] },
+    { ...valid, lines: [null] },
+    { ...valid, lines: '-b' },
+    { ...valid, lines: [] },
+    { oldStart: 3, oldLines: 2, newStart: 3, newLines: 0, lines: ['-c', '-missing'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'],
+  }, valid]), /hunk 1 does not apply/);
+  for (const context of [-1, 0.5, NaN, Infinity, '3']) {
+    assert.throws(() => unifiedHunks(a, a, { context }), /context/);
+  }
+});
+
+test('small changes in 20,000 lines run below one second', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? String(i % 3) : `line ${i}`);
+    const b = a.slice();
+    b.splice(10, 1, 'replacement');
+    b.splice(10000, 0, 'inserted', '');
+    b.splice(19000, 1);
+    const start = performance.now();
+    const hunks = unifiedHunks(a, b);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    const elapsed = performance.now() - start;
+    assert.ok(elapsed < 1000, `small-change roundtrip took ${elapsed.toFixed(1)} ms`);
+  }
+});
