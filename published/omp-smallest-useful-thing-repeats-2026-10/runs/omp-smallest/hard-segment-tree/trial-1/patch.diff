@@ -0,0 +1,151 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+function checkTree(tree, values) {
+  // Query before materialization so toArray cannot hide stale lazy children.
+  for (let l = 0; l <= values.length; l++) {
+    let sum = 0;
+    let max = -Infinity;
+    for (let r = l; r <= values.length; r++) {
+      if (r > l) {
+        sum += values[r - 1];
+        max = Math.max(max, values[r - 1]);
+      }
+      assert.equal(tree.sum(l, r), sum, `sum(${l}, ${r})`);
+      assert.equal(tree.max(l, r), max, `max(${l}, ${r})`);
+    }
+    for (const x of [-Infinity, -20, -1, 0, 1, 20, Infinity]) {
+      const expected = values.findIndex((v, i) => i >= l && v >= x);
+      assert.equal(tree.firstAtLeast(l, x), expected, `firstAtLeast(${l}, ${x})`);
+    }
+    if (l < values.length) assert.equal(tree.get(l), values[l]);
+  }
+  assert.deepEqual(tree.toArray(), values);
+}
+
+test('assignment discards earlier additions at parent and child nodes', () => {
+  for (const n of [1, 2, 5, 8]) {
+    const tree = new RangeTree(Array(n).fill(1));
+    tree.add(0, n, 7);
+    tree.assign(0, n, -4);
+    tree.add(0, n, 2);
+    assert.equal(tree.sum(0, 1), -2);
+    checkTree(tree, Array(n).fill(-2));
+
+    tree.add(0, Math.ceil(n / 2), 9);
+    tree.assign(0, n, 0);
+    tree.add(0, n, -3);
+    checkTree(tree, Array(n).fill(-3));
+  }
+});
+
+test('partial maxima use negative infinity as the identity', () => {
+  const tree = new RangeTree([-9, -7, -5, -3, -1]);
+  assert.equal(tree.max(1, 4), -3);
+  tree.assign(0, 5, -12);
+  tree.add(1, 4, 2);
+  checkTree(tree, [-12, -10, -10, -10, -12]);
+});
+
+test('threshold search pushes updates before inspecting children', () => {
+  const tree = new RangeTree([-10, -10, -10, -10, -10]);
+  tree.add(0, 5, 20);
+  assert.equal(tree.firstAtLeast(0, 5), 0);
+  assert.equal(tree.firstAtLeast(3, 5), 3);
+  tree.assign(0, 5, 30);
+  assert.equal(tree.firstAtLeast(1, 25), 1);
+
+  const descending = new RangeTree([10, -10, 10, -10, 10]);
+  descending.add(0, 5, -5);
+  assert.equal(descending.firstAtLeast(1, 0), 2);
+  descending.assign(0, 5, -20);
+  descending.assign(4, 5, 1);
+  assert.equal(descending.firstAtLeast(0, 0), 4);
+  assert.equal(descending.firstAtLeast(5, -Infinity), -1);
+  assert.equal(descending.firstAtLeast(0, Infinity), -1);
+});
+
+test('mixed lazy updates and queries agree with a plain array', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    const values = Array.from({ length: n }, () => (random(81) - 40) / 4);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 500; step++) {
+      const a = random(n + 1);
+      const b = random(n + 1);
+      // Regular whole-tree updates exercise tags at ancestors of stale children.
+      const l = step % 7 === 0 ? 0 : Math.min(a, b);
+      const r = step % 7 === 0 ? n : Math.max(a, b);
+      const v = (random(81) - 40) / 4;
+      const op = random(10);
+      if (op < 4) {
+        tree.assign(l, r, v);
+        values.fill(v, l, r);
+      } else if (op < 8) {
+        tree.add(l, r, v);
+        for (let i = l; i < r; i++) values[i] += v;
+      } else if (op === 8) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0));
+        assert.equal(tree.max(l, r), Math.max(-Infinity, ...values.slice(l, r)));
+      } else {
+        assert.equal(tree.firstAtLeast(l, v), values.findIndex((x, i) => i >= l && x >= v));
+      }
+      if (step % 73 === 72) checkTree(tree, values);
+    }
+    checkTree(tree, values);
+  }
+});
+
+test('validation, empty ranges, read-only length, and independent arrays', () => {
+  for (const input of [undefined, null, [], {}, [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, -2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  tree.add(0, 3, 2);
+  const expected = [3, 0, 5];
+  const invalidRanges = [[-1, 1], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]];
+  for (const [l, r] of invalidRanges) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const v of [NaN, Infinity, -Infinity, undefined, null, '2', {}, 2n]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, v), RangeError);
+      assert.throws(() => tree[method](1, 1, v), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, undefined, null, '0', {}, 0n]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 7), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  checkTree(tree, expected);
+  const output = tree.toArray();
+  output[0] = 100;
+  assert.deepEqual(tree.toArray(), expected);
+  assert.equal(tree.assign(0, 3, 1), undefined);
+  assert.equal(tree.add(0, 3, 2), undefined);
+  checkTree(tree, [3, 3, 3]);
+});
