@@ -0,0 +1,176 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./range-tree');
+
+function firstAtLeast(values, lo, x) {
+  for (let i = lo; i < values.length; i++) {
+    if (values[i] >= x) return i;
+  }
+  return -1;
+}
+
+function checkRange(tree, values, l, r) {
+  const slice = values.slice(l, r);
+  assert.equal(tree.sum(l, r), slice.reduce((sum, value) => sum + value, 0));
+  assert.equal(tree.max(l, r), Math.max(...slice));
+}
+
+test('assignment discards pending additions on both parent and child segments', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 9);
+  tree.add(3, 7, -4);
+  tree.add(0, 7, 5);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -2);
+  tree.assign(1, 6, -8);
+  const values = [-2, -8, -8, -8, -8, -8, -2];
+  for (let l = 0; l <= values.length; l++) {
+    for (let r = l; r <= values.length; r++) checkRange(tree, values, l, r);
+  }
+  assert.deepEqual(tree.toArray(), values);
+});
+
+test('partial maxima use a negative-infinity identity', () => {
+  const tree = new RangeTree([-5, -2, -9, -3, -7]);
+  assert.equal(tree.max(0, 2), -2);
+  assert.equal(tree.max(2, 5), -3);
+  assert.equal(tree.max(2, 3), -9);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 4), -7);
+  assert.equal(tree.max(4, 5), -10);
+});
+
+test('threshold search propagates lazy tags before inspecting children', () => {
+  const tree = new RangeTree([9, 1, 3, 7, 2]);
+  tree.assign(0, 5, -4);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 6), 0);
+  assert.equal(tree.firstAtLeast(2, 6), 2);
+  assert.equal(tree.firstAtLeast(0, 7), -1);
+  tree.assign(0, 5, -10);
+  tree.add(3, 5, 8);
+  assert.equal(tree.firstAtLeast(0, -2), 3);
+  assert.equal(tree.firstAtLeast(4, -2), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+});
+
+test('mixed updates and queries agree with an array across varied tree shapes', () => {
+  let seed = 0x12345678;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 31, 64]) {
+    const values = Array.from({ length: n }, () => random(101) - 50);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 500; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 7 === 0) [l, r] = [0, n];
+      const v = random(101) - 50;
+      if (random(2)) {
+        assert.equal(tree.assign(l, r, v), undefined);
+        values.fill(v, l, r);
+      } else {
+        assert.equal(tree.add(l, r, v), undefined);
+        for (let i = l; i < r; i++) values[i] += v;
+      }
+      // Search first: materialization or other queries could mask stale children.
+      const lo = random(n + 1);
+      const x = random(201) - 100;
+      assert.equal(tree.firstAtLeast(lo, x), firstAtLeast(values, lo, x));
+      checkRange(tree, values, 0, n);
+      l = random(n + 1);
+      r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      checkRange(tree, values, l, r);
+      const i = random(n);
+      assert.equal(tree.get(i), values[i]);
+      if (step % 37 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('API validation, empty ranges, read-only length and array independence', () => {
+  for (const values of [undefined, null, [], '123', new Float64Array([1]),
+    [NaN], [Infinity], [-Infinity], ['1'], [undefined], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1.5, -2.25, 3.75];
+  const tree = new RangeTree(input);
+  input[0] = 999;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 99; }, TypeError);
+  assert.equal(tree.length, 3);
+  tree.add(0, 3, 0.25);
+  const expected = [1.75, -2, 4];
+  for (const [l, r] of [[-1, 1], [0, 4], [2, 1], [0.5, 2], [0, NaN],
+    [0, Infinity], ['0', 1], [0, undefined]]) {
+    for (const method of ['sum', 'max', 'assign', 'add']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const v of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, v), RangeError);
+      assert.throws(() => tree[method](1, 1, v), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= 3; i++) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), expected);
+  const copy = tree.toArray();
+  copy[1] = 999;
+  assert.deepEqual(tree.toArray(), expected);
+});
+
+test('tree traversal stays logarithmic for updates and queries, linear for snapshots', () => {
+  const n = 4097;
+  const visits = Object.create(null);
+  class CountedTree extends RangeTree {}
+  for (const name of ['_build', '_update', '_sum', '_max', '_first', '_write']) {
+    CountedTree.prototype[name] = function (...args) {
+      visits[name] = (visits[name] || 0) + 1;
+      return RangeTree.prototype[name].apply(this, args);
+    };
+  }
+  const tree = new CountedTree(Array(n).fill(-10));
+  assert.equal(visits._build, 2 * n - 1);
+  const limit = 8 * Math.ceil(Math.log2(n));
+  const logarithmic = (name, operation) => {
+    visits[name] = 0;
+    operation();
+    assert.ok(visits[name] <= limit, `${name} visited ${visits[name]} nodes`);
+  };
+  logarithmic('_update', () => tree.assign(1, n - 1, -4));
+  logarithmic('_update', () => tree.add(2, n, 3));
+  logarithmic('_sum', () => assert.equal(tree.sum(1, n - 1), -(n - 2) - 3));
+  logarithmic('_max', () => assert.equal(tree.max(1, n - 1), -1));
+  logarithmic('_sum', () => assert.equal(tree.get(n - 1), -7));
+  logarithmic('_first', () => assert.equal(tree.firstAtLeast(n - 2, -1), n - 2));
+  logarithmic('_first', () => assert.equal(tree.firstAtLeast(0, 0), -1));
+  tree.assign(n - 1, n, 10);
+  logarithmic('_first', () => assert.equal(tree.firstAtLeast(0, 10), n - 1));
+  tree.toArray();
+  assert.equal(visits._write, 2 * n - 1);
+});
