+++ "{temp}\\hb-38fe464f-7shvjpkf/cache.regression.test.js"
@@ -0,0 +1,256 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./src/cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+function rejection(promise) {
+  return promise.then(() => assert.fail('expected rejection'), reason => reason);
+}
+
+const mutations = [
+  ['invalidate', cache => cache.invalidate('key')],
+  ['clear', cache => cache.clear()],
+  ['set', cache => cache.set('key', 'installed')]
+];
+
+for (const [name, mutate] of mutations) {
+  for (const oldFirst of [true, false]) {
+    for (const fails of [false, true]) {
+      test(`${name}: obsolete ${fails ? 'rejection' : 'success'}, ${oldFirst ? 'old' : 'new'} settles first`, async () => {
+        let time = 0;
+        let calls = 0;
+        const old = deferred();
+        const fresh = deferred();
+        const reason = { obsolete: true };
+        const cache = createCache({
+          now: () => time,
+          ttlMs: 10,
+          load() {
+            calls += 1;
+            assert.ok(calls <= 2, 'new flight must stay available for deduplication');
+            return calls === 1 ? old.promise : fresh.promise;
+          }
+        });
+        const oldReader = cache.get('key');
+        const oldWaiter = cache.get('key');
+        const oldResults = fails
+          ? [rejection(oldReader), rejection(oldWaiter)]
+          : [oldReader, oldWaiter];
+        await Promise.resolve();
+        assert.equal(calls, 1);
+        assert.equal(mutate(cache), undefined);
+        if (name === 'set') {
+          assert.equal(await cache.get('key'), 'installed');
+          time = 10;
+        }
+        const newReader = cache.get('key');
+        await Promise.resolve();
+        assert.equal(calls, 2);
+        const settleOld = () => fails ? old.reject(reason) : old.resolve('obsolete');
+        if (oldFirst) {
+          settleOld();
+          assert.deepEqual(await Promise.all(oldResults), [fails ? reason : 'obsolete', fails ? reason : 'obsolete']);
+          assert.equal(cache.size, 0);
+          const newWaiter = cache.get('key');
+          await Promise.resolve();
+          assert.equal(calls, 2);
+          fresh.resolve('fresh');
+          assert.deepEqual(await Promise.all([newReader, newWaiter]), ['fresh', 'fresh']);
+        } else {
+          fresh.resolve('fresh');
+          assert.equal(await newReader, 'fresh');
+          settleOld();
+          assert.deepEqual(await Promise.all(oldResults), [fails ? reason : 'obsolete', fails ? reason : 'obsolete']);
+        }
+        assert.equal(await cache.get('key'), 'fresh');
+        assert.equal(cache.size, 1);
+        assert.equal(calls, 2);
+      });
+    }
+  }
+
+  test(`${name}: barrier before loader invocation`, async () => {
+    let calls = 0;
+    const cache = createCache({
+      now: () => 0,
+      load: () => ++calls === 1 ? 'obsolete' : 'fresh'
+    });
+    const oldReader = cache.get('key');
+    mutate(cache);
+    const newReader = cache.get('key');
+    assert.equal(await oldReader, 'obsolete');
+    assert.equal(await newReader, name === 'set' ? 'installed' : 'fresh');
+    assert.equal(await cache.get('key'), name === 'set' ? 'installed' : 'fresh');
+    assert.equal(calls, name === 'set' ? 1 : 2);
+  });
+
+  test(`${name}: synchronous loader mutation is a barrier`, async () => {
+    let calls = 0;
+    const cache = createCache({
+      now: () => 0,
+      load() {
+        if (++calls === 1) {
+          mutate(cache);
+          return 'obsolete';
+        }
+        return 'fresh';
+      }
+    });
+    const oldReader = cache.get('key');
+    const oldWaiter = cache.get('key');
+    assert.deepEqual(await Promise.all([oldReader, oldWaiter]), ['obsolete', 'obsolete']);
+    assert.equal(await cache.get('key'), name === 'set' ? 'installed' : 'fresh');
+    assert.equal(calls, name === 'set' ? 1 : 2);
+  });
+}
+
+for (const mode of ['throw', 'promise', 'thenable']) {
+  test(`${mode}: failures reach all waiters and allow retry`, async () => {
+    const reason = mode === 'throw' ? undefined : { failed: mode };
+    let calls = 0;
+    const cache = createCache({
+      load() {
+        if (++calls > 1) return 'recovered';
+        if (mode === 'throw') throw reason;
+        if (mode === 'promise') return Promise.reject(reason);
+        return { then(resolve, reject) { reject(reason); } };
+      }
+    });
+    const readers = [rejection(cache.get('key')), rejection(cache.get('key'))];
+    for (const actual of await Promise.all(readers)) assert.equal(actual, reason);
+    assert.equal(calls, 1);
+    assert.equal(cache.size, 0);
+    assert.equal(await cache.get('key'), 'recovered');
+    assert.equal(await cache.get('key'), 'recovered');
+    assert.equal(calls, 2);
+  });
+}
+
+test('repeated invalidation separates every flight, even without stored values', async () => {
+  const gates = [deferred(), deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+  const first = cache.get('key');
+  cache.invalidate('key');
+  const second = cache.get('key');
+  cache.invalidate('key');
+  const third = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 3);
+  gates[1].resolve('second');
+  assert.equal(await second, 'second');
+  gates[0].resolve('first');
+  assert.equal(await first, 'first');
+  assert.equal(cache.size, 0);
+  const waiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 3);
+  gates[2].resolve('third');
+  assert.deepEqual(await Promise.all([third, waiter]), ['third', 'third']);
+  assert.equal(await cache.get('key'), 'third');
+});
+
+test('set TTL is not extended by an obsolete completion', async () => {
+  let time = 0;
+  let calls = 0;
+  const old = deferred();
+  const cache = createCache({ now: () => time, ttlMs: 10, load: () => ++calls === 1 ? old.promise : 'fresh' });
+  const reader = cache.get('key');
+  await Promise.resolve();
+  time = 2;
+  assert.equal(cache.set('key', undefined), undefined);
+  time = 11;
+  old.resolve('obsolete');
+  assert.equal(await reader, 'obsolete');
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(cache.size, 1);
+  time = 12;
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'fresh');
+  assert.equal(calls, 2);
+});
+
+test('TTL starts at commit; zero TTL still deduplicates pending loads', async () => {
+  for (const ttlMs of [0, 10]) {
+    let time = 0;
+    let calls = 0;
+    const gate = deferred();
+    const cache = createCache({ now: () => time, ttlMs, load: () => ++calls === 1 ? gate.promise : null });
+    const first = cache.get('key');
+    const second = cache.get('key');
+    await Promise.resolve();
+    time = 100;
+    gate.resolve(undefined);
+    assert.deepEqual(await Promise.all([first, second]), [undefined, undefined]);
+    assert.equal(calls, 1);
+    if (ttlMs > 0) {
+      time = 109;
+      assert.equal(await cache.get('key'), undefined);
+      assert.equal(cache.size, 1);
+    }
+    time = 100 + ttlMs;
+    assert.equal(cache.size, 0);
+    const next = cache.get('key');
+    const waiter = cache.get('key');
+    assert.equal(cache.size, 0);
+    assert.deepEqual(await Promise.all([next, waiter]), [null, null]);
+    assert.equal(calls, 2);
+  }
+});
+
+test('clear detaches flights and removes stored values across keys', async () => {
+  const gates = new Map([['a', deferred()], ['b', deferred()]]);
+  const calls = new Map();
+  const cache = createCache({
+    now: () => 0,
+    load(key) {
+      const count = (calls.get(key) || 0) + 1;
+      calls.set(key, count);
+      return count === 1 ? gates.get(key).promise : `fresh-${key}`;
+    }
+  });
+  cache.set('stored', 42);
+  const oldA = cache.get('a');
+  const oldB = cache.get('b');
+  await Promise.resolve();
+  cache.clear();
+  assert.equal(cache.size, 0);
+  assert.deepEqual(await Promise.all([cache.get('a'), cache.get('b')]), ['fresh-a', 'fresh-b']);
+  gates.get('a').resolve('old-a');
+  gates.get('b').resolve('old-b');
+  assert.deepEqual(await Promise.all([oldA, oldB]), ['old-a', 'old-b']);
+  assert.deepEqual(await Promise.all([cache.get('a'), cache.get('b')]), ['fresh-a', 'fresh-b']);
+  assert.equal(cache.size, 2);
+  assert.deepEqual([...calls], [['a', 2], ['b', 2]]);
+});
+
+test('reentrant loads join their own flight and can load another key', async () => {
+  const key = {};
+  const calls = [];
+  let ownReader;
+  const cache = createCache({
+    now: () => 0,
+    load(...args) {
+      calls.push(args);
+      if (args[0] === key) {
+        ownReader = cache.get(key);
+        return cache.get('other').then(value => `outer-${value}`);
+      }
+      return 'inner';
+    }
+  });
+  assert.equal(await cache.get(key), 'outer-inner');
+  assert.equal(await ownReader, 'outer-inner');
+  assert.deepEqual(calls, [[key], ['other']]);
+  assert.equal(cache.size, 2);
+});
