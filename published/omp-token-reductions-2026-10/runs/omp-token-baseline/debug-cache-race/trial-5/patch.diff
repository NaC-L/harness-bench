+++ "{temp}\\hb-73c7dc15-i4p3gjn2/src/cache.test.js"
@@ -0,0 +1,214 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+for (const mutation of ['invalidate', 'clear']) {
+  for (const oldFirst of [true, false]) {
+    for (const rejects of [false, true]) {
+      test(`${mutation}: obsolete ${rejects ? 'rejection' : 'success'}, ${oldFirst ? 'old' : 'new'} settles first`, async () => {
+        const old = deferred();
+        const fresh = deferred();
+        const reason = { obsolete: true };
+        let calls = 0;
+        const cache = createCache({
+          now: () => 0,
+          load: () => (++calls === 1 ? old.promise : fresh.promise)
+        });
+        const oldReader = cache.get('key');
+        const oldWaiter = cache.get('key');
+        const oldResults = Promise.allSettled([oldReader, oldWaiter]);
+        await Promise.resolve();
+        cache[mutation]('key');
+        const freshReader = cache.get('key');
+        await Promise.resolve();
+        const settleOld = async () => {
+          if (rejects) old.reject(reason);
+          else old.resolve('stale');
+          assert.deepEqual(await oldResults, [
+            rejects ? { status: 'rejected', reason } : { status: 'fulfilled', value: 'stale' },
+            rejects ? { status: 'rejected', reason } : { status: 'fulfilled', value: 'stale' }
+          ]);
+        };
+        if (oldFirst) {
+          await settleOld();
+          assert.equal(cache.size, 0);
+        } else {
+          fresh.resolve('fresh');
+          assert.equal(await freshReader, 'fresh');
+          await settleOld();
+          assert.equal(cache.size, 1);
+        }
+        const joinedReader = cache.get('key');
+        await Promise.resolve();
+        assert.equal(calls, 2);
+        fresh.resolve('fresh');
+        assert.deepEqual(await Promise.all([freshReader, joinedReader]), ['fresh', 'fresh']);
+        assert.equal(await cache.get('key'), 'fresh');
+      });
+    }
+  }
+}
+
+test('repeated barriers detach every generation, including loads not yet invoked', async () => {
+  const gates = [deferred(), deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+  const first = cache.get('key');
+  cache.invalidate('key');
+  const second = cache.get('key');
+  cache.invalidate('key');
+  const third = cache.get('key');
+  await Promise.resolve();
+  gates[1].resolve('second');
+  assert.equal(await second, 'second');
+  gates[0].resolve('first');
+  assert.equal(await first, 'first');
+  assert.equal(cache.size, 0);
+  const joined = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 3);
+  gates[2].resolve('third');
+  assert.deepEqual(await Promise.all([third, joined]), ['third', 'third']);
+  assert.equal(await cache.get('key'), 'third');
+});
+
+for (const settlesBeforeExpiry of [true, false]) {
+  test(`set wins without extending TTL; old load settles ${settlesBeforeExpiry ? 'before' : 'after'} expiry`, async () => {
+    let time = 0;
+    let calls = 0;
+    const old = deferred();
+    const fresh = deferred();
+    const cache = createCache({
+      ttlMs: 10,
+      now: () => time,
+      load: () => (++calls === 1 ? old.promise : fresh.promise)
+    });
+    const oldReader = cache.get('key');
+    await Promise.resolve();
+    assert.equal(cache.set('key', undefined), undefined);
+    time = 5;
+    if (settlesBeforeExpiry) {
+      old.resolve('stale');
+      assert.equal(await oldReader, 'stale');
+    }
+    assert.equal(await cache.get('key'), undefined);
+    assert.equal(cache.size, 1);
+    time = 10;
+    assert.equal(cache.size, 0);
+    const freshReader = cache.get('key');
+    await Promise.resolve();
+    if (!settlesBeforeExpiry) {
+      old.resolve('stale');
+      assert.equal(await oldReader, 'stale');
+    }
+    const joined = cache.get('key');
+    await Promise.resolve();
+    assert.equal(calls, 2);
+    time = 20;
+    fresh.resolve(null);
+    assert.deepEqual(await Promise.all([freshReader, joined]), [null, null]);
+    time = 29;
+    assert.equal(await cache.get('key'), null);
+    assert.equal(cache.size, 1);
+    time = 30;
+    assert.equal(cache.size, 0);
+  });
+}
+
+for (const kind of ['throw', 'promise', 'thenable', 'then getter']) {
+  test(`${kind} failures share their reason and permit retry`, async () => {
+    const reason = kind === 'promise' ? undefined : kind === 'thenable' ? null : { kind };
+    let calls = 0;
+    const cache = createCache({
+      now: () => 0,
+      load() {
+        if (++calls > 1) return 'retry';
+        if (kind === 'throw') throw reason;
+        if (kind === 'promise') return Promise.reject(reason);
+        if (kind === 'thenable') return { then(resolve, reject) { reject(reason); } };
+        return { get then() { throw reason; } };
+      }
+    });
+    const results = await Promise.allSettled([cache.get('key'), cache.get('key')]);
+    assert.equal(calls, 1);
+    for (const result of results) {
+      assert.equal(result.status, 'rejected');
+      assert.equal(result.reason, reason);
+    }
+    assert.equal(cache.size, 0);
+    assert.equal(await cache.get('key'), 'retry');
+    assert.equal(calls, 2);
+  });
+}
+
+test('a failed replacement permits retry while an obsolete success remains pending', async () => {
+  const gates = [deferred(), deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+  const old = cache.get('key');
+  cache.clear();
+  const failed = Promise.allSettled([cache.get('key')]);
+  await Promise.resolve();
+  gates[1].reject('failed replacement');
+  assert.deepEqual(await failed, [{ status: 'rejected', reason: 'failed replacement' }]);
+  const retry = cache.get('key');
+  await Promise.resolve();
+  gates[0].resolve('stale');
+  assert.equal(await old, 'stale');
+  const joined = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 3);
+  gates[2].resolve('retry');
+  assert.deepEqual(await Promise.all([retry, joined]), ['retry', 'retry']);
+});
+
+for (const mutation of ['invalidate', 'clear', 'set']) {
+  test(`synchronous ${mutation} inside load preserves self-read and mutation barrier`, async () => {
+    let calls = 0;
+    let selfReader;
+    let nextReader;
+    const cache = createCache({
+      now: () => 0,
+      load(key) {
+        if (++calls > 1) return 'fresh';
+        selfReader = cache.get(key);
+        cache[mutation](key, 'supplied');
+        nextReader = cache.get(key);
+        return 'old';
+      }
+    });
+    assert.equal(await cache.get('key'), 'old');
+    assert.equal(await selfReader, 'old');
+    const expected = mutation === 'set' ? 'supplied' : 'fresh';
+    assert.equal(await nextReader, expected);
+    assert.equal(await cache.get('key'), expected);
+    assert.equal(calls, mutation === 'set' ? 1 : 2);
+  });
+}
+
+test('zero TTL deduplicates only unsettled loads', async () => {
+  const gate = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 0, now: () => 0, load: () => (++calls === 1 ? gate.promise : 'next') });
+  const first = cache.get('key');
+  const second = cache.get('key');
+  await Promise.resolve();
+  assert.equal(cache.size, 0);
+  assert.equal(calls, 1);
+  gate.resolve('first');
+  assert.deepEqual(await Promise.all([first, second]), ['first', 'first']);
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'next');
+  assert.equal(calls, 2);
+});
