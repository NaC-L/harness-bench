diff --git "{temp}\\hb-06797e26-6nvx_qja/src/resolver.test.js" "{temp}\\hb-06797e26-6nvx_qja/src/resolver.test.js"
new file mode 100644
index 0000000..c74207c
--- /dev/null
+++ "{temp}\\hb-06797e26-6nvx_qja/src/resolver.test.js"
@@ -0,0 +1,172 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { parse, compare, satisfies, compileRange } = require('./semver');
+
+test('numeric ordering compares major and patch components', () => {
+  assert.deepEqual(resolve({ a: { '9.0.0': {}, '10.0.9': {}, '10.0.10': {} } }, { a: '*' }), { a: '10.0.10' });
+  assert.equal(compare('10.0.9', '9.0.0'), 1);
+  assert.equal(compare('10.0.9', '10.0.10'), -1);
+  assert.equal(compare('10.0.9', '10.0.9'), 0);
+});
+
+test('first-found selection follows FIFO discovery, not dependency-first traversal', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '2.0.0', c: '1.0.0' });
+});
+
+test('root and dependency key order determine the first complete assignment', () => {
+  const registry = {
+    a: { '2.0.0': { shared: '2.0.0' }, '1.0.0': { shared: '1.0.0' } },
+    b: { '2.0.0': { shared: '1.0.0' }, '1.0.0': { shared: '2.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+    entry: { '2.0.0': { a: '*', b: '*' }, '1.0.0': { b: '*', a: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0', shared: '2.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0', shared: '1.0.0' });
+  assert.deepEqual(resolve(registry, { entry: '2.0.0' }), { entry: '2.0.0', a: '2.0.0', b: '1.0.0', shared: '2.0.0' });
+  assert.deepEqual(resolve(registry, { entry: '1.0.0' }), { entry: '1.0.0', b: '2.0.0', a: '1.0.0', shared: '1.0.0' });
+});
+
+test('discovered constraints apply before a queued package is selected', () => {
+  const registry = {
+    a: { '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('backtracking removes rejected dependencies and constraints but retains root constraints', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0', missing: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '1.0.0' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('a partially appended conflict retries the most recent choice', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { missing: '*', a: '1.0.0' }, '1.0.0': { a: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('exhausted descendant choices are removed when an ancestor is retried', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*', c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { d: '*' }, '1.0.0': { d: '*' } },
+    c: { '1.0.0': {} },
+    d: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', c: '1.0.0' });
+});
+
+test('cycles constrain existing choices without expanding them again', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve({ a: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+});
+
+test('long dependency chains ending in a cycle do not depend on stack depth or an iteration cap', () => {
+  const registry = {};
+  const count = 12000;
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % count}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  const expected = {};
+  for (let i = 0; i < count; i += 1) expected[`p${i}`] = '1.0.0';
+  assert.deepEqual(result, expected);
+});
+
+test('discovered conflicts prune choices before a Cartesian product is enumerated', () => {
+  const registry = { guard: { '1.0.0': {} } };
+  const root = { guard: '1.0.0' };
+  const expected = { guard: '1.0.0' };
+  for (let i = 0; i < 40; i += 1) {
+    registry[`p${i}`] = { '2.0.0': { guard: '2.0.0' }, '1.0.0': {} };
+    root[`p${i}`] = '*';
+    expected[`p${i}`] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('missing packages and exhausted choices are unsatisfiable; unreachable packages are not selected', () => {
+  const registry = { a: { '2.0.0': { missing: '*' }, '1.0.0': { missing: '*' } }, unused: { '1.0.0': {} } };
+  assert.equal(resolve(registry, { a: '*' }), null);
+  assert.equal(resolve(registry, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.deepEqual(resolve(registry, {}), {});
+});
+
+test('all maps, versions and ranges are validated even when unreachable', () => {
+  for (const invalid of [null, [], 1, Object.create({ inherited: true })]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { missing: 'invalid' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+});
+
+test('null-prototype maps and special names work without mutating frozen inputs', () => {
+  const versions = Object.freeze(Object.assign(Object.create(null), { '1.0.0': Object.freeze({}) }));
+  const registry = Object.assign(Object.create(null), { ['__proto__']: versions, constructor: versions, toString: versions });
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  const root = Object.freeze({ ['__proto__']: '*', constructor: '*', toString: '*' });
+  const result = resolve(registry, root);
+  assert.deepEqual(result, { ['__proto__']: '1.0.0', constructor: '1.0.0', toString: '1.0.0' });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test('versions must be canonical safe integer triples, with no trailing newline', () => {
+  assert.deepEqual(parse('9007199254740991.0.1'), [Number.MAX_SAFE_INTEGER, 0, 1]);
+  for (const invalid of ['1.2.3\n', '1.2.3\r\n', '01.2.3', '1.2', '1.2.3-alpha', ' 1.2.3', '9007199254740992.0.0', 123, null]) {
+    assert.throws(() => parse(invalid), TypeError);
+  }
+  assert.throws(() => compare('1.2.3', '1.2.3\n'), TypeError);
+  assert.throws(() => satisfies('1.2.3\n', '*'), TypeError);
+  assert.throws(() => resolve({ a: { ['1.2.3\n']: {} } }, {}), TypeError);
+});
+
+test('caret ranges use the next nonzero component boundary', () => {
+  const cases = [
+    ['^1.2.3', '1.2.2', false], ['^1.2.3', '1.2.3', true], ['^1.2.3', '1.9.9', true], ['^1.2.3', '2.0.0', false],
+    ['^0.2.3', '0.2.2', false], ['^0.2.3', '0.2.3', true], ['^0.2.3', '0.2.9', true], ['^0.2.3', '0.3.0', false],
+    ['^0.0.3', '0.0.2', false], ['^0.0.3', '0.0.3', true], ['^0.0.3', '0.0.4', false],
+    ['^0.0.0', '0.0.0', true], ['^0.0.0', '0.0.1', false],
+    ['^0.0.9007199254740991', '0.0.9007199254740991', true], ['^0.0.9007199254740991', '0.1.0', false],
+  ];
+  for (const [range, version, expected] of cases) assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+  assert.deepEqual(resolve({ a: { '0.3.0': {}, '0.2.9': {} } }, { a: '^0.2.3' }), { a: '0.2.9' });
+});
+
+test('range helpers support AND terms, tilde, exact and all comparison operators', () => {
+  assert.equal(compileRange(' \t>=1.2.0 <2.0.0 *\n')(parse('1.9.0')), true);
+  assert.equal(satisfies('2.0.0', '>=1.2.0 <2.0.0'), false);
+  assert.equal(satisfies('1.2.9', '~1.2.3'), true);
+  assert.equal(satisfies('1.3.0', '~1.2.3'), false);
+  assert.equal(satisfies('1.2.3', '>1.2.3'), false);
+  assert.equal(satisfies('1.2.4', '>1.2.3'), true);
+  assert.equal(satisfies('1.2.3', '<=1.2.3'), true);
+  assert.equal(satisfies('1.2.4', '<=1.2.3'), false);
+  assert.equal(satisfies('1.2.3', '1.2.3'), true);
+  assert.equal(satisfies('1.2.4', '1.2.3'), false);
+  for (const invalid of ['', ' ', '^', '>= 1.2.3', '1.2.3 || 2.0.0', '=1.2.3', '1.x', 123, null]) {
+    assert.throws(() => compileRange(invalid), TypeError);
+  }
+});
