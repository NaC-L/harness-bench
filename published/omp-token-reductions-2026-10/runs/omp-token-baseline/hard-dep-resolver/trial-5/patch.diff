@@ -0,0 +1,183 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+
+test('versions are ordered numerically at every component', () => {
+  const versions = {
+    '9.99.99': {}, '10.9.99': {}, '10.10.9': {}, '10.10.10': {},
+  };
+  assert.deepEqual(resolve({ a: versions }, { a: '*' }), { a: '10.10.10' });
+  assert.equal(compare('10.10.10', '10.10.9'), 1);
+  assert.equal(compare('9.99.99', '10.0.0'), -1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+});
+
+test('FIFO discovery preserves the first complete assignment', () => {
+  const registry = {
+    a: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '2.0.0',
+  });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), {
+    b: '2.0.0', a: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('dependency key order determines the first complete assignment', () => {
+  const registry = {
+    entry: { '1.0.0': { a: '*', b: '*' } },
+    a: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { entry: '*' }), {
+    entry: '1.0.0', a: '2.0.0', b: '1.0.0', c: '2.0.0',
+  });
+  registry.entry['1.0.0'] = { b: '*', a: '*' };
+  assert.deepEqual(resolve(registry, { entry: '*' }), {
+    entry: '1.0.0', b: '2.0.0', a: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('all discovered constraints apply before a queued package is selected', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '2.0.0' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '1.0.0' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('partial dependency discovery is undone after a selected-name conflict', () => {
+  assert.deepEqual(resolve({
+    anchor: { '1.0.0': {} },
+    a: { '2.0.0': { stale: '*', anchor: '2.0.0' }, '1.0.0': { leaf: '*' } },
+    leaf: { '1.0.0': {} },
+  }, { anchor: '*', a: '*' }), {
+    anchor: '1.0.0', a: '1.0.0', leaf: '1.0.0',
+  });
+});
+
+test('exhausted nested choices remove selections, constraints, and reachability', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '*' }, '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { c: '2.0.0', missing: '*' }, '1.0.0': { missing: '*' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*' }), { a: '1.0.0', c: '1.0.0' });
+});
+
+test('cycles expand each selected package once and can backtrack', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '2.0.0' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '1.0.0' } },
+  }, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('long dependency chains do not depend on recursion or an iteration cap', () => {
+  const registry = {};
+  const expected = {};
+  for (let i = 0; i < 12000; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '1.0.0': i === 11999 ? {} : { [`p${i + 1}`]: '*' } };
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, { p0: '*' }), expected);
+  registry.p11999['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('discovered conflicts prune choices instead of enumerating a Cartesian product', () => {
+  const registry = { anchor: { '1.0.0': {} } };
+  const root = { anchor: '*' };
+  const expected = { anchor: '1.0.0' };
+  for (let i = 0; i < 32; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { anchor: '2.0.0' }, '1.0.0': { anchor: '1.0.0' } };
+    root[name] = '*';
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('missing packages and incompatible constraints are unsatisfiable', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '>1.0.0 <2.0.0' }), null);
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('plain and null-prototype maps support reserved names without mutation', () => {
+  const dependencies = Object.freeze(Object.assign(Object.create(null), { constructor: '*' }));
+  const versions = Object.freeze({ '1.0.0': dependencies });
+  const registry = Object.create(null);
+  registry.__proto__ = versions;
+  registry.constructor = Object.freeze({ '1.0.0': Object.freeze({}) });
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  const root = Object.freeze(Object.assign(Object.create(null), { ['__proto__']: '*' }));
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result, { ['__proto__']: '1.0.0', constructor: '1.0.0' });
+});
+
+test('all registry entries and root requirements are validated eagerly', () => {
+  for (const invalid of [null, [], 1, 'map', new Date()]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { dep: 'bad' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+});
+
+test('parse rejects noncanonical versions, including trailing line terminators', () => {
+  assert.deepEqual(parse('9007199254740991.0.1'), [Number.MAX_SAFE_INTEGER, 0, 1]);
+  for (const invalid of [null, 123, '', '1.2', '01.2.3', '1.02.3', '1.2.03',
+    '-1.2.3', '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3 ',
+    '1.2.3\n', '1.2.3\r', '1.2.3\r\n', '1.2.3\u2028', '9007199254740992.0.0']) {
+    assert.throws(() => parse(invalid), TypeError, String(invalid));
+  }
+});
+
+test('caret and tilde bounds follow major, zero-major minor, and patch rules', () => {
+  const cases = [
+    ['^1.2.3', '1.2.2', false], ['^1.2.3', '1.2.3', true],
+    ['^1.2.3', '1.99.99', true], ['^1.2.3', '2.0.0', false],
+    ['^0.2.3', '0.2.2', false], ['^0.2.3', '0.2.3', true],
+    ['^0.2.3', '0.2.99', true], ['^0.2.3', '0.3.0', false],
+    ['^0.0.3', '0.0.2', false], ['^0.0.3', '0.0.3', true],
+    ['^0.0.3', '0.0.4', false], ['^0.0.0', '0.0.0', true], ['^0.0.0', '0.0.1', false],
+    ['~1.2.3', '1.2.2', false], ['~1.2.3', '1.2.3', true],
+    ['~1.2.3', '1.2.99', true], ['~1.2.3', '1.3.0', false],
+    ['~0.0.3', '0.0.99', true], ['~0.0.3', '0.1.0', false],
+    ['^9007199254740991.0.0', '9007199254740991.9.9', true],
+    ['^0.0.9007199254740991', '0.0.9007199254740991', true],
+    ['~0.9007199254740991.0', '0.9007199254740991.9', true],
+  ];
+  for (const [range, version, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected, `${version} compiled ${range}`);
+  }
+  assert.deepEqual(resolve({ a: { '0.3.0': {}, '0.2.9': {} } }, { a: '^0.2.3' }), { a: '0.2.9' });
+});
+
+test('ranges support exact, wildcard, comparisons, whitespace, and conjunctions', () => {
+  for (const [range, expected] of [
+    ['1.2.3', true], ['1.2.4', false], ['*', true],
+    ['>=1.2.3', true], ['>1.2.3', false], ['<=1.2.3', true], ['<1.2.3', false],
+    [' \t >=1.0.0\n<2.0.0 *  ', true], ['>=2.0.0 <1.0.0', false],
+  ]) assert.equal(satisfies('1.2.3', range), expected, range);
+  for (const range of [null, 1, '', ' \t\n', '1.2', '||', '>= 1.2.3',
+    '=1.2.3', '1.x', '^01.2.3', '* garbage']) {
+    assert.throws(() => compileRange(range), TypeError, String(range));
+  }
+});
