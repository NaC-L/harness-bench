--- /dev/null
+++ "{temp}\\hb-d162574e-xbyyegke/contract.test.js"
@@ -0,0 +1,132 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error =>
+    error instanceof ExprError && error.column === column);
+}
+
+test('power binds above a left unary sign and associates right', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['2 * -3 ** 2', -18],
+    ['--2 ** 2', 4],
+    ['10 - 3 - 2', 5],
+    ['24 / 3 * 2', 16],
+    ['20 // 3 % 4', 2],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo preserve signs, zero and integer identity', () => {
+  for (let a = -12; a <= 12; a += 1) {
+    for (let b = -5; b <= 5; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (remainder === 0) assert.equal(Object.is(remainder, -0), false);
+      if (quotient === 0) assert.equal(Object.is(quotient, -0), false);
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  assert.equal(Object.is(evaluate('-0 // 2'), -0), false);
+  assert.equal(Object.is(evaluate('-0 % 2'), -0), false);
+});
+
+test('comparisons chain and booleans coerce numerically', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 == 2 != 3 > 2 >= 2', true],
+    ['1 + 2 < 2 * 2 < 3 ** 2', true],
+    ['(3 < 2) < 1', true],
+    ['(1 < 2) + (2 < 1)', 1],
+    ['(1 < 2) == 1', true],
+    ['(2 < 1) != 0', false],
+    ['(1 < 2) ** 2', 1],
+    ['abs(2 < 1)', 0],
+    ['max(2 < 1, 1 < 2)', 1],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('shared operands are read once and false comparisons short-circuit', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < 1 / 0'), false);
+  assert.equal(evaluate('1 < 2 > 3 < missing'), false);
+  reads.length = 0;
+  assert.equal(evaluate('max(a + b, abs(-c), a)', variables), 3);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'a']);
+});
+
+test('the whole source is parsed before any variable is evaluated', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['a +   unknown(1)', 7],
+    ['a +   abs(1, 2)', 7],
+    ['a +   min()', 7],
+    ['a +   max()', 7],
+    ['a +   abs()', 7],
+    ['a > 2 < abs(1, 2)', 9],
+    ['a > 2 < (1 + )', 14],
+    ['a > 2 < 1 @', 11],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('errors identify tokens after whitespace and the actual end of source', () => {
+  for (const [source, column] of [
+    ['1 +   missing', 7],
+    ['1   / 0', 5],
+    ['1   // -0', 5],
+    ['1   % (2 < 1)', 5],
+    ['1 +   @', 7],
+    ['1 + 😀', 5],
+    ['1\t\u2003@', 4],
+    ['1   2', 5],
+    ['min(1,   )', 10],
+    ['1 **    ', 9],
+    ['  (1 + 2', 9],
+    ['   ', 4],
+    ['', 1],
+  ]) errorAt(source, column);
+  errorAt('  inherited', 3, Object.create({ inherited: 4 }));
+});
+
+test('numeric literals and built-ins retain arithmetic behavior', () => {
+  assert.equal(evaluate('min(5., .5 + 1.5e-3, 2E+1)'), 0.5015);
+  assert.equal(evaluate('max(-2 ** 2, abs(-3), min(7, 8))'), 7);
+  assert.equal(evaluate('__proto__ + _value2',
+    Object.assign(Object.create(null), { ['__proto__']: 9, _value2: 4 })), 13);
+});
+
+test('100,001-operand flat arithmetic and comparisons avoid stack recursion', () => {
+  const count = 100000;
+  assert.equal(evaluate('1' + '+1'.repeat(count)), count + 1);
+  assert.equal(evaluate(String(count) + '-1'.repeat(count)), 0);
+  assert.equal(evaluate('1' + '<=1'.repeat(count)), true);
+});
