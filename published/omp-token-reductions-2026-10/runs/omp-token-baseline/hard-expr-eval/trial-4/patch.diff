index 0000000..27e4fcc
--- /dev/null
+++ "{temp}\\hb-e53136f9-nayr24z6/src/contract.test.js"
@@ -0,0 +1,133 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column);
+    return true;
+  });
+}
+
+test('powers associate right and bind asymmetrically with unary signs', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['--2 ** 2', 4],
+    ['-2 ** 2 * 3 + 1', -11],
+    ['8 / 2 * 3', 12],
+    ['10 - 3 + 2', 9],
+    ['16 // 3 % 2', 1],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo obey signed integer identities', () => {
+  for (const a of [-7, -6, -1, 0, 1, 6, 7]) {
+    for (const b of [-3, -2, 2, 3]) {
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+      else assert.ok(Object.is(remainder, 0));
+      if (quotient === 0) assert.ok(Object.is(quotient, 0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  assert.ok(Object.is(evaluate('-0 // 2'), 0));
+  assert.ok(Object.is(evaluate('-0 % -2'), 0));
+});
+
+test('comparison chains compare adjacent numbers, not intermediate booleans', () => {
+  assert.equal(evaluate('3 < 2 < 1'), false);
+  assert.equal(evaluate('3 > 2 > 1'), true);
+  assert.equal(evaluate('1 < 2 <= 2 != 3 == 3 >= 2 > 0'), true);
+  assert.equal(evaluate('1 + 2 < 2 * 2 <= 2 ** 2'), true);
+  assert.equal(evaluate('(3 > 2) > 0'), true);
+  assert.equal(evaluate('(1 < 2) == 1'), true);
+  assert.equal(evaluate('(1 > 2) == 0'), true);
+  assert.equal(evaluate('(1 < 2) + (3 < 2) * 5'), 1);
+});
+
+test('comparison operands are read once in order and short-circuit', () => {
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return 1; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 3; },
+    get d() { throw new Error('Unreachable operand'); },
+  };
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('a > b < d', variables), false);
+  assert.deepEqual(reads, ['a', 'b']);
+  assert.equal(evaluate('1 > 2 < missing'), false);
+  assert.equal(evaluate('1 > 2 < 1 / 0'), false);
+  errorAt('1 < 2 < missing', 9);
+});
+
+test('the complete source is parsed before reading any variables', () => {
+  const variables = { get x() { throw new Error('Evaluation must not start'); } };
+  for (const [source, column] of [
+    ['x + bogus(1)', 5],
+    ['x + min()', 5],
+    ['x + max()', 5],
+    ['x + abs()', 5],
+    ['x + abs(1, 2)', 5],
+    ['x + min(1,)', 11],
+    ['x + 1 2', 7],
+    ['x + (1', 7],
+    ['x + 1 @', 7],
+    ['x > 2 < abs(1, 2)', 9],
+    ['1 > 2 < missing +   ', 21],
+  ]) errorAt(source, column, variables);
+});
+
+test('calls and repeated variable occurrences evaluate left to right', () => {
+  let reads = 0;
+  const variables = { get x() { return ++reads; } };
+  assert.equal(evaluate('max(x + x, min(x, x), abs(-x))', variables), 5);
+  assert.equal(reads, 5);
+  assert.equal(evaluate('min(1 < 2, 2) + abs(1 > 2)'), 1);
+  errorAt('  inherited', 3, Object.create({ inherited: 4 }));
+  assert.equal(evaluate('own', Object.assign(Object.create(null), { own: 7 })), 7);
+});
+
+test('error columns follow whitespace and count UTF-16 offsets', () => {
+  for (const [source, column] of [
+    ['   missing', 4],
+    ['1   / 0', 5],
+    ['1\t // -0', 4],
+    ['1\n  % (2 - 2)', 5],
+    ['  bogus(1)', 3],
+    ['  abs(1, 2)', 3],
+    ['1   2', 5],
+    ['1 +   )', 7],
+    ['1 +   ', 7],
+    [' \t\n', 4],
+    ['1\u2003+\u2003@', 5],
+    ['1 +   \u{1F600}', 7],
+  ]) errorAt(source, column);
+});
+
+test('100,001-operand arithmetic chains remain iterative and left-associative', () => {
+  assert.equal(evaluate('1' + ' + 1'.repeat(100000)), 100001);
+  assert.equal(evaluate('100001' + ' - 1'.repeat(100000)), 1);
+  assert.equal(evaluate('1' + ' * 1'.repeat(100000)), 1);
+});
+
+test('100,001-operand comparison chains reuse operands without recursion', () => {
+  let reads = 0;
+  const variables = { get x() { return reads++; } };
+  assert.equal(evaluate('x' + ' < x'.repeat(100000), variables), true);
+  assert.equal(reads, 100001);
+});
