+++ "{temp}\\hb-5b5e9a19-c64zi0ub/evaluator.contract.test.js"
@@ -0,0 +1,149 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column);
+    return true;
+  });
+}
+
+test('power is right associative and binds above a unary sign on its left', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['--2 ** 2', 4],
+    ['-2 ** 2 * 3 + 1', -11],
+    ['2 * -3 ** 2', -18],
+    ['8 / 2 * 3', 12],
+    ['10 - 3 - 2', 5],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo use the divisor sign and positive zero', () => {
+  for (const [source, expected] of [
+    ['-7 // 2', -4], ['7 // -2', -4], ['-7 // -2', 3],
+    ['-7 % 3', 2], ['7 % -3', -2], ['-7 % -3', -1],
+    ['-5.5 // 2', -3], ['-5.5 % 2', 0.5], ['5.5 % -2', -0.5],
+    ['0 // -2', 0], ['0 % -2', 0], ['-6 % 3', 0],
+  ]) assert.equal(evaluate(source), expected, source);
+  for (let a = -12; a <= 12; a++) {
+    for (let b = -5; b <= 5; b++) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+    }
+  }
+});
+
+test('comparisons chain shared numeric operands rather than intermediate booleans', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 == 2 != 3 > 2 >= 2', true],
+    ['2 > 1 > 0', true],
+    ['1 + 2 < 2 * 2', true],
+    ['(3 < 2) < 1', true],
+    ['(1 < 2) + (3 < 2)', 1],
+    ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true],
+    ['(1 < 2) ** 3', 1],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('comparison operands are read once, left to right, and short circuit', () => {
+  const reads = [];
+  let next = 0;
+  const variables = {
+    get x() { reads.push('x'); return ++next; },
+    get stop() { reads.push('stop'); return 0; },
+    get skipped() { throw new Error('Must short circuit'); },
+  };
+  assert.equal(evaluate('x < x <= x < stop < skipped', variables), false);
+  assert.deepEqual(reads, ['x', 'x', 'x', 'stop']);
+  assert.equal(evaluate('3 < 2 < unknown'), false);
+  assert.equal(evaluate('3 < 2 < 1 / 0'), false);
+});
+
+test('variables and built-in arguments evaluate left to right without mutation', () => {
+  const reads = [];
+  const variables = Object.freeze({
+    get a() { reads.push('a'); return -2; },
+    get b() { reads.push('b'); return 5; },
+    get c() { reads.push('c'); return 3; },
+  });
+  assert.equal(evaluate('a + max(abs(a), min(b, c)) * b', variables), 13);
+  assert.deepEqual(reads, ['a', 'a', 'b', 'c', 'b']);
+  assert.equal(evaluate('abs(1 > 2) + max(1 < 2, 0)', variables), 1);
+  const ownOnly = Object.create({ inherited: 3 });
+  ownOnly.constructor = 7;
+  assert.equal(evaluate('constructor', ownOnly), 7);
+  errorAt(' inherited', 2, ownOnly);
+});
+
+test('the whole formula is parsed before evaluation or short circuit', () => {
+  const reads = [];
+  const variables = { get x() { reads.push('x'); return 1; } };
+  for (const [source, column] of [
+    ['x + mystery(1)', 5],
+    ['x + abs(1, 2)', 5],
+    ['x + min()', 5],
+    ['x + max()', 5],
+    ['x + abs()', 5],
+    ['x + min(1,)', 11],
+    ['3 < 2 < mystery(1)', 9],
+    ['3 < 2 < abs(1, 2)', 9],
+    ['3 < 2 < (1 + )', 14],
+    ['x + 1 @', 7],
+  ]) errorAt(source, column, variables);
+  assert.deepEqual(reads, []);
+});
+
+test('errors identify the actual token after whitespace and UTF-16 code units', () => {
+  for (const [source, column] of [
+    ['  missing', 3],
+    ['1  /  0', 4],
+    ['1  //  -0', 4],
+    ['1  %  (2 > 3)', 4],
+    ['  abs(1, 2)', 3],
+    [' \tunknown(1)', 3],
+    ['1 +  \n @', 8],
+    ['1 +  \n 😀', 8],
+    ['1  2', 4],
+    ['1 + )', 5],
+    ['(1 + 2   ', 10],
+    ['1 +   ', 7],
+    [' \t\n', 4],
+  ]) errorAt(source, column);
+  errorAt('1 < 2 < 1 / 0', 11);
+});
+
+test('literal forms, grouping, and built-in arities retain their contract', () => {
+  assert.equal(evaluate('1.5e-3 + .5 + 5. + 2E+1'), 25.5015);
+  assert.equal(evaluate('min(4, max(2, 3), abs(-1))'), 1);
+  assert.equal(evaluate('max(4)'), 4);
+  assert.equal(evaluate('min(4)'), 4);
+  for (const [source, column] of [
+    ['2(3)', 2], ['2 **', 5], ['1 = 2', 3], ['1 ! 2', 3],
+    ['min(,1)', 5], ['min(1 2)', 7], ['"1"', 1],
+  ]) errorAt(source, column);
+});
+
+test('100,001-operand arithmetic and comparison chains do not exhaust the stack', () => {
+  const count = 100001;
+  assert.equal(evaluate('1+'.repeat(count - 1) + '1'), count);
+  assert.equal(evaluate('1*'.repeat(count - 1) + '2'), 2);
+  let reads = 0;
+  const variables = { get x() { return ++reads; } };
+  assert.equal(evaluate('x<'.repeat(count - 1) + 'x', variables), true);
+  assert.equal(reads, count);
+  assert.equal(evaluate('2<1' + '<1'.repeat(count - 2)), false);
+});
