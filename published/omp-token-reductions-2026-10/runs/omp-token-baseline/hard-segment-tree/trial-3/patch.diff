@@ -0,0 +1,125 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards pending additions at both parent and child nodes', () => {
+  const tree = new RangeTree([0, 1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 4, 9);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, -7);
+  tree.add(2, 6, 2);
+  assert.equal(tree.sum(1, 7), -34);
+  assert.deepEqual(tree.toArray(), [-7, -7, -5, -5, -5, -5, -7, -7]);
+});
+
+test('partial maximum queries preserve negative values', () => {
+  const tree = new RangeTree([-9, -8, -7, -6, -5]);
+  assert.equal(tree.max(1, 4), -6);
+  assert.equal(tree.max(0, 1), -9);
+  tree.assign(0, 5, -12);
+  tree.add(1, 4, -2);
+  assert.equal(tree.max(1, 4), -14);
+  assert.equal(tree.max(0, 5), -12);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold search propagates updates before descending', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0]);
+  tree.assign(0, 5, 4);
+  assert.equal(tree.firstAtLeast(2, 4), 2);
+  tree.add(0, 5, -7);
+  assert.equal(tree.firstAtLeast(0, -2), -1);
+  tree.assign(1, 4, 8);
+  tree.add(0, 5, 2);
+  assert.equal(tree.firstAtLeast(0, 10), 1);
+  assert.equal(tree.firstAtLeast(2, 10), 2);
+  assert.equal(tree.firstAtLeast(4, 10), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(4, -Infinity), 4);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('batched mixed updates match an array oracle for every query range', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 8) % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 31]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let batch = 0; batch < 30; batch++) {
+      for (let step = 0; step < 8; step++) {
+        let l = random(n + 1);
+        let r = random(n + 1);
+        if (l > r) [l, r] = [r, l];
+        if (step % 3 === 0) { l = 0; r = n; }
+        const v = random(41) - 20;
+        const assigning = random(2) === 0;
+        assert.equal(assigning ? tree.assign(l, r, v) : tree.add(l, r, v), undefined);
+        for (let i = l; i < r; i++) values[i] = assigning ? v : values[i] + v;
+      }
+      // Search first, while the batched updates can still have pending tags.
+      for (let lo = 0; lo <= n; lo++) {
+        for (const x of [-Infinity, -21, -1, 0, 7, 21, Infinity]) {
+          const expected = values.findIndex((value, i) => i >= lo && value >= x);
+          assert.equal(tree.firstAtLeast(lo, x), expected, `search n=${n} batch=${batch} lo=${lo} x=${x}`);
+        }
+      }
+      for (let l = 0; l <= n; l++) {
+        let sum = 0;
+        let maximum = -Infinity;
+        for (let r = l; r <= n; r++) {
+          if (r > l) {
+            sum += values[r - 1];
+            maximum = Math.max(maximum, values[r - 1]);
+          }
+          assert.equal(tree.sum(l, r), sum, `sum n=${n} batch=${batch} [${l},${r})`);
+          assert.equal(tree.max(l, r), maximum, `max n=${n} batch=${batch} [${l},${r})`);
+        }
+      }
+      for (let i = 0; i < n; i++) assert.equal(tree.get(i), values[i]);
+      assert.deepEqual(tree.toArray(), values);
+    }
+  }
+});
+
+test('validation and empty operations leave lazy state unchanged; arrays do not alias', () => {
+  for (const values of [[], null, '12', [NaN], [Infinity], [1, undefined], ['1']]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.add(0, 3, 4);
+  for (const [l, r] of [[-1, 2], [2, 1], [0, 4], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 9), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const v of [NaN, Infinity, -Infinity, '1', undefined]) {
+      assert.throws(() => tree[method](0, 3, v), RangeError);
+      assert.throws(() => tree[method](1, 1, v), RangeError);
+    }
+    assert.equal(tree[method](1, 1, 99), undefined);
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) assert.throws(() => tree.get(i), RangeError);
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 99; }, TypeError);
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(3, 3), -Infinity);
+  assert.equal(tree.firstAtLeast(1, 6), 1);
+  const output = tree.toArray();
+  assert.deepEqual(output, [5, 6, 7]);
+  output[1] = 99;
+  assert.deepEqual(tree.toArray(), [5, 6, 7]);
+});
