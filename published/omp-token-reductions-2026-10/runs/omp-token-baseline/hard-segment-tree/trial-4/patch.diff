@@ -0,0 +1,127 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards earlier additions at the node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, -2);
+  assert.equal(tree.sum(1, 3), -4);
+  assert.deepEqual(tree.toArray(), Array(8).fill(-2));
+  tree.assign(2, 6, 5);
+  tree.add(3, 7, 2);
+  assert.deepEqual(tree.toArray(), [-2, -2, 5, 7, 7, 7, 0, -2]);
+});
+
+test('partial maxima retain negative values', () => {
+  const tree = new RangeTree([-8, -3, -6, -4, -9]);
+  assert.equal(tree.max(1, 4), -3);
+  tree.assign(0, 5, -10);
+  tree.add(2, 5, 4);
+  assert.equal(tree.max(0, 2), -10);
+  assert.equal(tree.max(1, 4), -6);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold search observes pending assignments and additions before descent', () => {
+  const tree = new RangeTree([9, 0, 0, 0, 0, 0, 0]);
+  tree.assign(0, 7, -4);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.add(0, 7, 10);
+  assert.equal(tree.firstAtLeast(2, 6), 2);
+  tree.assign(0, 3, -8);
+  tree.add(3, 7, 2);
+  assert.equal(tree.firstAtLeast(0, 7), 3);
+  assert.equal(tree.firstAtLeast(5, 8), 5);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('mixed range updates match an array model for every query boundary', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 7, 8, 17, 31]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let batch = 0; batch < 80; batch++) {
+      for (let update = 0; update < 5; update++) {
+        const a = random(length + 1);
+        const b = random(length + 1);
+        const l = update === 0 ? 0 : Math.min(a, b);
+        const r = update === 0 ? length : Math.max(a, b);
+        const value = random(41) - 20;
+        const assigning = random(3) === 0;
+        tree[assigning ? 'assign' : 'add'](l, r, value);
+        for (let i = l; i < r; i++) {
+          values[i] = assigning ? value : values[i] + value;
+        }
+      }
+      // Search first: materializing the tree must not hide stale-child bugs.
+      for (let lo = 0; lo <= length; lo++) {
+        for (const threshold of [-Infinity, -25, 0, 25, Infinity, values[lo]]) {
+          if (threshold === undefined) continue;
+          const expected = values.findIndex((value, i) => i >= lo && value >= threshold);
+          assert.equal(tree.firstAtLeast(lo, threshold), expected);
+        }
+      }
+      for (let l = 0; l <= length; l++) {
+        let sum = 0;
+        let maximum = -Infinity;
+        for (let r = l; r <= length; r++) {
+          assert.equal(tree.sum(l, r), sum);
+          assert.equal(tree.max(l, r), maximum);
+          if (r < length) {
+            sum += values[r];
+            maximum = Math.max(maximum, values[r]);
+          }
+        }
+        if (l < length) assert.equal(tree.get(l), values[l]);
+      }
+      assert.deepEqual(tree.toArray(), values);
+    }
+  }
+});
+
+test('empty ranges and rejected updates preserve pending state and array isolation', () => {
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  tree.assign(0, 3, -5);
+  tree.add(0, 3, 2);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  for (const endpoint of [0, 1, 3]) {
+    assert.equal(tree.assign(endpoint, endpoint, 9), undefined);
+    assert.equal(tree.add(endpoint, endpoint, 4), undefined);
+    assert.equal(tree.sum(endpoint, endpoint), 0);
+    assert.equal(tree.max(endpoint, endpoint), -Infinity);
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined]) {
+      assert.throws(() => tree.assign(endpoint, endpoint, value), RangeError);
+      assert.throws(() => tree.add(endpoint, endpoint, value), RangeError);
+    }
+  }
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 7), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const [lo, x] of [[-1, 0], [4, 0], [0.5, 0], [NaN, 0], [0, NaN], [0, '1']]) {
+    assert.throws(() => tree.firstAtLeast(lo, x), RangeError);
+  }
+  assert.equal(tree.sum(0, 3), -9);
+  assert.equal(tree.firstAtLeast(1, -3), 1);
+  const output = tree.toArray();
+  assert.deepEqual(output, [-3, -3, -3]);
+  output[1] = 100;
+  assert.equal(tree.get(1), -3);
+});
