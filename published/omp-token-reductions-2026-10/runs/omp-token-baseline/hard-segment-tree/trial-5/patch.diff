+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard additions on both the node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, -10);
+  tree.add(0, 8, 2);
+  tree.assign(2, 6, 0);
+  tree.add(3, 7, -4);
+  assert.equal(tree.sum(0, 8), -48);
+  assert.equal(tree.sum(1, 7), -32);
+  assert.equal(tree.max(0, 2), -8);
+  assert.deepEqual(tree.toArray(), [-8, -8, 0, -4, -4, -4, -12, -8]);
+});
+
+test('partial maxima preserve negative values and the empty-range identity', () => {
+  const tree = new RangeTree([-5, -2, -7, -9, -3]);
+  assert.equal(tree.max(0, 2), -2);
+  assert.equal(tree.max(2, 5), -3);
+  assert.equal(tree.max(3, 4), -9);
+  assert.equal(tree.max(2, 2), -Infinity);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 3), -7);
+  assert.equal(tree.max(4, 5), -10);
+});
+
+test('threshold search propagates lazy assignments and additions before descent', () => {
+  const assigned = new RangeTree([0, 0, 0, 0, 0]);
+  assigned.assign(0, 5, 10);
+  assert.equal(assigned.firstAtLeast(0, 5), 0);
+  assert.equal(assigned.firstAtLeast(3, 10), 3);
+  assigned.assign(0, 3, -10);
+  assert.equal(assigned.firstAtLeast(0, 5), 3);
+
+  const increased = new RangeTree([-10, -10, -10, -10]);
+  increased.add(0, 4, 15);
+  assert.equal(increased.firstAtLeast(1, 5), 1);
+
+  const decreased = new RangeTree([5, 10, 0, 0]);
+  decreased.add(0, 4, -6);
+  assert.equal(decreased.firstAtLeast(0, 0), 1);
+  assert.equal(decreased.firstAtLeast(2, 0), -1);
+  assert.equal(decreased.firstAtLeast(0, Infinity), -1);
+  assert.equal(decreased.firstAtLeast(2, -Infinity), 2);
+  assert.equal(decreased.firstAtLeast(4, -Infinity), -1);
+});
+
+test('mixed overlapping updates match an array model across all query APIs', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 8) % limit;
+  };
+  for (const length of [1, 2, 3, 5, 8, 13, 32]) {
+    const values = Array.from({ length }, () => random(31) - 15);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 100; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 5 === 0) { l = 0; r = length; }
+      const value = random(31) - 15;
+      const assigning = random(2) === 0;
+      assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      if (step % 5 !== 4) continue;
+
+      // Search first, before range queries or materialization can push lazy tags.
+      for (let lo = 0; lo <= length; lo++) {
+        for (const threshold of [-Infinity, -20, -1, 0, 1, 20, Infinity]) {
+          const expected = values.findIndex((v, i) => i >= lo && v >= threshold);
+          assert.equal(tree.firstAtLeast(lo, threshold), expected);
+        }
+      }
+      for (let start = 0; start <= length; start++) {
+        let sum = 0;
+        let max = -Infinity;
+        for (let end = start; end <= length; end++) {
+          assert.equal(tree.sum(start, end), sum);
+          assert.equal(tree.max(start, end), max);
+          if (end < length) {
+            sum += values[end];
+            max = Math.max(max, values[end]);
+          }
+        }
+      }
+      for (let i = 0; i < length; i++) assert.equal(tree.get(i), values[i]);
+      assert.deepEqual(tree.toArray(), values);
+    }
+  }
+});
+
+test('validation is atomic, empty updates are inert, and arrays do not alias', () => {
+  for (const input of [null, {}, [], [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.assign(0, 3, -4);
+  tree.add(0, 3, 2);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    assert.equal(tree[method](0, 0, 10), undefined);
+    assert.equal(tree[method](3, 3, 10), undefined);
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 4; }, TypeError);
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(3, 3), -Infinity);
+  assert.deepEqual(tree.toArray(), [-2, -2, -2]);
+  const output = tree.toArray();
+  output[0] = 99;
+  assert.equal(tree.get(0), -2);
+});
