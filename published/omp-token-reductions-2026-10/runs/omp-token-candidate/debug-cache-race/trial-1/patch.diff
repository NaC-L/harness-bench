--- /dev/null
+++ "{temp}\\hb-c61039ce-kua6vken/src/cache.test.js"
@@ -0,0 +1,255 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+function outcome(promise) {
+  return promise.then(
+    value => ({ value }),
+    reason => ({ reason })
+  );
+}
+
+for (const mutation of ['invalidate', 'clear', 'set']) {
+  for (const order of ['obsolete first', 'current first']) {
+    for (const rejected of [false, true]) {
+      test(`${mutation}: ${order}, obsolete ${rejected ? 'rejects' : 'fulfills'}`, async () => {
+        const old = deferred();
+        const fresh = deferred();
+        const reason = { obsolete: true };
+        let time = 0;
+        let calls = 0;
+        const cache = createCache({
+          ttlMs: 10,
+          now: () => time,
+          load() {
+            calls += 1;
+            assert.ok(calls <= 2, 'obsolete settlement must not detach the fresh flight');
+            return calls === 1 ? old.promise : fresh.promise;
+          }
+        });
+        const oldReaders = [outcome(cache.get('key')), outcome(cache.get('key'))];
+        await Promise.resolve();
+        assert.equal(calls, 1);
+        assert.equal(cache.size, 0);
+        if (mutation === 'set') {
+          assert.equal(cache.set('key', 'manual'), undefined);
+          assert.equal(await cache.get('key'), 'manual');
+          time = 10;
+          assert.equal(cache.size, 0);
+        } else {
+          assert.equal(cache[mutation]('key'), undefined);
+        }
+        const currentReader = cache.get('key');
+        await Promise.resolve();
+        assert.equal(calls, 2);
+
+        async function settleOld() {
+          if (rejected) old.reject(reason);
+          else old.resolve('obsolete');
+          const expected = rejected ? { reason } : { value: 'obsolete' };
+          for (const reader of oldReaders) assert.deepEqual(await reader, expected);
+        }
+
+        if (order === 'obsolete first') {
+          await settleOld();
+          assert.equal(cache.size, 0);
+          const joinedReader = cache.get('key');
+          fresh.resolve('fresh');
+          assert.equal(await joinedReader, 'fresh');
+        } else {
+          fresh.resolve('fresh');
+          assert.equal(await currentReader, 'fresh');
+          await settleOld();
+        }
+        assert.equal(await currentReader, 'fresh');
+        assert.equal(await cache.get('key'), 'fresh');
+        assert.equal(calls, 2);
+        assert.equal(cache.size, 1);
+      });
+    }
+  }
+}
+
+test('repeated invalidations detach each generation even without a stored value', async () => {
+  const gates = [deferred(), deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+  const readers = [];
+  for (let i = 0; i < gates.length; i += 1) {
+    readers.push(cache.get('key'));
+    await Promise.resolve();
+    if (i < gates.length - 1) cache.invalidate('key');
+  }
+  gates[1].resolve('second');
+  assert.equal(await readers[1], 'second');
+  gates[0].resolve('first');
+  assert.equal(await readers[0], 'first');
+  assert.equal(cache.size, 0);
+  const joined = cache.get('key');
+  gates[2].resolve('third');
+  assert.equal(await readers[2], 'third');
+  assert.equal(await joined, 'third');
+  assert.equal(await cache.get('key'), 'third');
+  assert.equal(calls, 3);
+});
+
+test('clear detaches all keys and removes stored values', async () => {
+  const gates = new Map([['a', deferred()], ['b', deferred()]]);
+  const calls = [];
+  const cache = createCache({
+    now: () => 0,
+    load(key) {
+      calls.push(key);
+      return calls.length <= 2 ? gates.get(key).promise : `fresh-${key}`;
+    }
+  });
+  cache.set('stored', undefined);
+  const a = cache.get('a');
+  const b = cache.get('b');
+  await Promise.resolve();
+  cache.clear();
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('a'), 'fresh-a');
+  gates.get('a').resolve('old-a');
+  gates.get('b').resolve('old-b');
+  assert.equal(await a, 'old-a');
+  assert.equal(await b, 'old-b');
+  assert.equal(await cache.get('b'), 'fresh-b');
+  assert.equal(await cache.get('stored'), 'fresh-stored');
+  assert.deepEqual(calls, ['a', 'b', 'a', 'b', 'stored']);
+});
+
+for (const failure of ['throw', 'promise', 'thenable', 'then getter']) {
+  test(`${failure} rejection is shared, uncached, and retryable`, async () => {
+    const reason = { failure };
+    let calls = 0;
+    const cache = createCache({
+      now: () => 0,
+      load() {
+        calls += 1;
+        if (calls > 1) return 'recovered';
+        if (failure === 'throw') throw reason;
+        if (failure === 'promise') return Promise.reject(reason);
+        if (failure === 'thenable') return { then(resolve, reject) { reject(reason); } };
+        return { get then() { throw reason; } };
+      }
+    });
+    const readers = [outcome(cache.get('key')), outcome(cache.get('key'))];
+    for (const reader of readers) assert.equal((await reader).reason, reason);
+    assert.equal(calls, 1);
+    assert.equal(cache.size, 0);
+    assert.equal(await cache.get('key'), 'recovered');
+    assert.equal(await cache.get('key'), 'recovered');
+    assert.equal(calls, 2);
+  });
+}
+
+for (const mutation of ['invalidate', 'clear', 'set']) {
+  test(`synchronous load ${mutation} is a barrier before settlement`, async () => {
+    let calls = 0;
+    let joined;
+    let fresh;
+    let cache;
+    cache = createCache({
+      now: () => 0,
+      load(key) {
+        assert.equal(arguments.length, 1);
+        assert.equal(key, 'key');
+        calls += 1;
+        if (calls > 1) return 'fresh';
+        joined = cache.get(key);
+        if (mutation === 'set') cache.set(key, 'manual');
+        else cache[mutation](key);
+        fresh = cache.get(key);
+        return 'obsolete';
+      }
+    });
+    assert.equal(await cache.get('key'), 'obsolete');
+    assert.equal(await joined, 'obsolete');
+    const expected = mutation === 'set' ? 'manual' : 'fresh';
+    assert.equal(await fresh, expected);
+    assert.equal(await cache.get('key'), expected);
+    assert.equal(calls, mutation === 'set' ? 1 : 2);
+  });
+}
+
+test('set wins over a pending load without its completion restarting TTL', async () => {
+  const old = deferred();
+  let time = 0;
+  let calls = 0;
+  const cache = createCache({
+    ttlMs: 10,
+    now: () => time,
+    load: () => ++calls === 1 ? old.promise : 'fresh'
+  });
+  const reader = cache.get('key');
+  await Promise.resolve();
+  time = 5;
+  cache.set('key', null);
+  time = 14;
+  old.resolve('obsolete');
+  assert.equal(await reader, 'obsolete');
+  assert.equal(await cache.get('key'), null);
+  assert.equal(cache.size, 1);
+  time = 15;
+  assert.equal(await cache.get('key'), 'fresh');
+  assert.equal(calls, 2);
+});
+
+test('TTL begins at commit and size expiration does not detach active flights', async () => {
+  const gate = deferred();
+  let time = 0;
+  let calls = 0;
+  const cache = createCache({
+    ttlMs: 10,
+    now: () => time,
+    load: () => ++calls === 1 ? gate.promise : 'next'
+  });
+  const reader = cache.get('key');
+  await Promise.resolve();
+  time = 20;
+  assert.equal(cache.size, 0);
+  const joined = cache.get('key');
+  gate.resolve(undefined);
+  assert.equal(await reader, undefined);
+  assert.equal(await joined, undefined);
+  time = 29;
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(calls, 1);
+  time = 30;
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'next');
+  assert.equal(calls, 2);
+});
+
+test('zero TTL deduplicates unsettled loads but never reuses settled values', async () => {
+  const gate = deferred();
+  let calls = 0;
+  const cache = createCache({
+    ttlMs: 0,
+    now: () => 0,
+    load: () => ++calls === 1 ? gate.promise : 'next'
+  });
+  const first = cache.get('key');
+  const joined = cache.get('key');
+  await Promise.resolve();
+  assert.equal(cache.size, 0);
+  gate.resolve('first');
+  assert.equal(await first, 'first');
+  assert.equal(await joined, 'first');
+  assert.equal(calls, 1);
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'next');
+  assert.equal(calls, 2);
+});
