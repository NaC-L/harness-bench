@@ -0,0 +1,277 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./src/cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+function rejectsWith(promise, reason) {
+  return assert.rejects(promise, actual => {
+    assert.strictEqual(actual, reason);
+    return true;
+  });
+}
+
+test('obsolete success cannot commit or detach a pending replacement', async () => {
+  const old = deferred();
+  const fresh = deferred();
+  let calls = 0;
+  const cache = createCache({
+    now: () => 0,
+    load: () => (++calls === 1 ? old.promise : fresh.promise)
+  });
+  const oldReader = cache.get('key');
+  const oldWaiter = cache.get('key');
+  await Promise.resolve();
+  cache.invalidate('key');
+  const freshReader = cache.get('key');
+  old.resolve('old');
+  assert.equal(await oldReader, 'old');
+  assert.equal(await oldWaiter, 'old');
+  assert.equal(cache.size, 0);
+  const freshWaiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 2);
+  fresh.resolve('fresh');
+  assert.equal(await freshReader, 'fresh');
+  assert.equal(await freshWaiter, 'fresh');
+  assert.equal(await cache.get('key'), 'fresh');
+});
+
+test('late obsolete success cannot overwrite a value or restart its TTL', async () => {
+  const old = deferred();
+  const fresh = deferred();
+  let time = 0;
+  let calls = 0;
+  const cache = createCache({
+    now: () => time,
+    ttlMs: 10,
+    load: () => [old.promise, fresh.promise, 'next'][calls++]
+  });
+  const oldReader = cache.get('key');
+  await Promise.resolve();
+  cache.invalidate('key');
+  const freshReader = cache.get('key');
+  time = 3;
+  fresh.resolve('fresh');
+  assert.equal(await freshReader, 'fresh');
+  time = 8;
+  old.resolve('old');
+  assert.equal(await oldReader, 'old');
+  assert.equal(await cache.get('key'), 'fresh');
+  time = 13;
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'next');
+  assert.equal(calls, 3);
+});
+
+for (const mutation of ['invalidate', 'clear']) {
+  test(`repeated ${mutation} calls are separate barriers without stored values`, async () => {
+    const gates = [deferred(), deferred(), deferred()];
+    let calls = 0;
+    const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+    const first = cache.get('key');
+    await Promise.resolve();
+    cache[mutation]('key');
+    const second = cache.get('key');
+    await Promise.resolve();
+    cache[mutation]('key');
+    const third = cache.get('key');
+    gates[1].resolve('second');
+    assert.equal(await second, 'second');
+    gates[0].resolve('first');
+    assert.equal(await first, 'first');
+    assert.equal(cache.size, 0);
+    const waiter = cache.get('key');
+    await Promise.resolve();
+    assert.equal(calls, 3);
+    gates[2].resolve('third');
+    assert.equal(await third, 'third');
+    assert.equal(await waiter, 'third');
+    assert.equal(await cache.get('key'), 'third');
+  });
+}
+
+test('clear detaches every key through both successful and rejected old loads', async () => {
+  const gates = [deferred(), deferred(), deferred(), deferred()];
+  const keys = [];
+  const cache = createCache({
+    now: () => 0,
+    load: key => {
+      keys.push(key);
+      return gates[keys.length - 1].promise;
+    }
+  });
+  cache.set('stored', 'value');
+  const oldA = cache.get('a');
+  const oldB = cache.get('b');
+  const reason = { failure: 'old b' };
+  const rejected = rejectsWith(oldB, reason);
+  await Promise.resolve();
+  assert.equal(cache.clear(), undefined);
+  assert.equal(cache.size, 0);
+  const freshA = cache.get('a');
+  const freshB = cache.get('b');
+  gates[0].resolve('old a');
+  gates[1].reject(reason);
+  assert.equal(await oldA, 'old a');
+  await rejected;
+  assert.equal(cache.size, 0);
+  const waiterA = cache.get('a');
+  const waiterB = cache.get('b');
+  await Promise.resolve();
+  assert.deepEqual(keys, ['a', 'b', 'a', 'b']);
+  gates[2].resolve('fresh a');
+  gates[3].resolve('fresh b');
+  assert.equal(await freshA, 'fresh a');
+  assert.equal(await waiterA, 'fresh a');
+  assert.equal(await freshB, 'fresh b');
+  assert.equal(await waiterB, 'fresh b');
+  assert.equal(cache.size, 2);
+});
+
+test('set wins over an earlier load without letting it extend the supplied TTL', async () => {
+  const old = deferred();
+  let time = 0;
+  let calls = 0;
+  const cache = createCache({
+    now: () => time,
+    ttlMs: 10,
+    load: () => (++calls === 1 ? old.promise : 'fresh')
+  });
+  const reader = cache.get('key');
+  await Promise.resolve();
+  time = 2;
+  assert.equal(cache.set('key', undefined), undefined);
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(cache.size, 1);
+  time = 9;
+  old.resolve('old');
+  assert.equal(await reader, 'old');
+  assert.equal(await cache.get('key'), undefined);
+  time = 12;
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'fresh');
+  assert.equal(calls, 2);
+});
+
+test('expired set starts a fresh load that an obsolete rejection cannot detach', async () => {
+  const old = deferred();
+  const fresh = deferred();
+  const reason = 'obsolete failure';
+  let time = 0;
+  let calls = 0;
+  const cache = createCache({
+    now: () => time,
+    ttlMs: 10,
+    load: () => (++calls === 1 ? old.promise : fresh.promise)
+  });
+  const rejected = rejectsWith(cache.get('key'), reason);
+  await Promise.resolve();
+  cache.set('key', null);
+  assert.equal(await cache.get('key'), null);
+  time = 10;
+  const reader = cache.get('key');
+  old.reject(reason);
+  await rejected;
+  const waiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 2);
+  fresh.resolve('fresh');
+  assert.equal(await reader, 'fresh');
+  assert.equal(await waiter, 'fresh');
+  assert.equal(await cache.get('key'), 'fresh');
+});
+
+for (const [kind, reason, fail] of [
+  ['synchronous throw', { failure: 'throw' }, reason => { throw reason; }],
+  ['Promise rejection', undefined, reason => Promise.reject(reason)],
+  ['thenable rejection', new Error('thenable failure'), reason => ({ then(resolve, reject) { reject(reason); } })]
+]) {
+  test(`${kind} releases the flight and preserves all waiters' rejection reason`, async () => {
+    let calls = 0;
+    const cache = createCache({
+      now: () => 0,
+      load: () => (++calls === 1 ? fail(reason) : 'retry')
+    });
+    const first = rejectsWith(cache.get('key'), reason);
+    const second = rejectsWith(cache.get('key'), reason);
+    await Promise.all([first, second]);
+    assert.equal(calls, 1);
+    assert.equal(cache.size, 0);
+    assert.equal(await cache.get('key'), 'retry');
+    assert.equal(await cache.get('key'), 'retry');
+    assert.equal(calls, 2);
+  });
+}
+
+for (const mutation of ['invalidate', 'clear', 'set']) {
+  test(`synchronous loader ${mutation} detaches its own flight before starting another`, async () => {
+    const fresh = deferred();
+    let cache;
+    let time = 0;
+    let calls = 0;
+    let ownReader;
+    let suppliedReader;
+    let freshReader;
+    cache = createCache({
+      now: () => time,
+      ttlMs: 10,
+      load(key) {
+        assert.equal(arguments.length, 1);
+        assert.equal(key, 'key');
+        calls += 1;
+        if (calls !== 1) return fresh.promise;
+        ownReader = cache.get(key);
+        assert.equal(cache[mutation](key, 'supplied'), undefined);
+        if (mutation === 'set') {
+          suppliedReader = cache.get(key);
+          time = 10;
+        }
+        freshReader = cache.get(key);
+        return 'old';
+      }
+    });
+    assert.equal(await cache.get('key'), 'old');
+    assert.equal(await ownReader, 'old');
+    if (mutation === 'set') assert.equal(await suppliedReader, 'supplied');
+    assert.equal(cache.size, 0);
+    const waiter = cache.get('key');
+    await Promise.resolve();
+    assert.equal(calls, 2);
+    fresh.resolve('fresh');
+    assert.equal(await freshReader, 'fresh');
+    assert.equal(await waiter, 'fresh');
+    assert.equal(await cache.get('key'), 'fresh');
+  });
+}
+
+test('zero TTL shares unsettled loads but retries immediately after settlement', async () => {
+  const gates = [deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ ttlMs: 0, now: () => 0, load: () => gates[calls++].promise });
+  const first = cache.get('key');
+  const waiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(cache.size, 0);
+  assert.equal(calls, 1);
+  gates[0].resolve('first');
+  assert.equal(await first, 'first');
+  assert.equal(await waiter, 'first');
+  assert.equal(cache.size, 0);
+  const next = cache.get('key');
+  const nextWaiter = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 2);
+  gates[1].resolve('next');
+  assert.equal(await next, 'next');
+  assert.equal(await nextWaiter, 'next');
+});
