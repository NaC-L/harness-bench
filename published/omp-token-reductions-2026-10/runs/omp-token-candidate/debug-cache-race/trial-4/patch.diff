+++ "{temp}\\hb-43fc2013-nptq5af0/cache-races.test.js"
@@ -0,0 +1,260 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./src/cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((res, rej) => { resolve = res; reject = rej; });
+  return { promise, resolve, reject };
+}
+
+function outcome(promise) {
+  return promise.then(value => ({ value }), reason => ({ reason }));
+}
+
+for (const obsoleteRejects of [false, true]) {
+  for (const oldFirst of [false, true]) {
+    test(`detached ${obsoleteRejects ? 'rejection' : 'success'}, ${oldFirst ? 'old' : 'new'} flight settles first`, async () => {
+      const old = deferred();
+      const fresh = deferred();
+      const reason = { obsolete: true };
+      let calls = 0;
+      const cache = createCache({
+        now: () => 0,
+        load: () => ++calls === 1 ? old.promise : fresh.promise
+      });
+      const oldReaders = [outcome(cache.get('key')), outcome(cache.get('key'))];
+      await Promise.resolve();
+      cache.invalidate('key');
+      const freshReaders = [cache.get('key'), cache.get('key')];
+      await Promise.resolve();
+      assert.equal(calls, 2);
+
+      async function settleOld() {
+        if (obsoleteRejects) old.reject(reason);
+        else old.resolve('stale');
+        for (const reader of oldReaders) {
+          const result = await reader;
+          assert.deepEqual(result, obsoleteRejects ? { reason } : { value: 'stale' });
+          if (obsoleteRejects) assert.equal(result.reason, reason);
+        }
+      }
+      async function settleFresh() {
+        fresh.resolve('fresh');
+        assert.deepEqual(await Promise.all(freshReaders), ['fresh', 'fresh']);
+      }
+      if (oldFirst) {
+        await settleOld();
+        assert.equal(cache.size, 0);
+        freshReaders.push(cache.get('key'));
+        await Promise.resolve();
+        assert.equal(calls, 2);
+        fresh.resolve('fresh');
+        assert.deepEqual(await Promise.all(freshReaders), ['fresh', 'fresh', 'fresh']);
+      } else {
+        await settleFresh();
+        await settleOld();
+      }
+      assert.equal(await cache.get('key'), 'fresh');
+      assert.equal(cache.size, 1);
+      assert.equal(calls, 2);
+    });
+  }
+}
+
+test('each invalidation is a barrier even without a stored value', async () => {
+  const gates = [deferred(), deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+  const readers = [cache.get(NaN)];
+  cache.invalidate(NaN);
+  readers.push(cache.get(NaN));
+  cache.invalidate(NaN);
+  readers.push(cache.get(NaN));
+  await Promise.resolve();
+  assert.equal(calls, 3);
+  gates[2].resolve('newest');
+  assert.equal(await readers[2], 'newest');
+  gates[1].resolve('middle');
+  assert.equal(await readers[1], 'middle');
+  gates[0].resolve('oldest');
+  assert.equal(await readers[0], 'oldest');
+  assert.equal(await cache.get(NaN), 'newest');
+  assert.equal(calls, 3);
+});
+
+test('clear detaches every key without affecting another cache instance', async () => {
+  const gates = new Map([['a', deferred()], ['b', deferred()]]);
+  const calls = new Map();
+  const cache = createCache({
+    now: () => 0,
+    load(key) {
+      const count = (calls.get(key) || 0) + 1;
+      calls.set(key, count);
+      return count === 1 ? gates.get(key).promise : `fresh-${key}`;
+    }
+  });
+  const other = createCache({ now: () => 0, load: () => 'other' });
+  other.set('a', 'independent');
+  cache.set('stored', 'removed');
+  const a = cache.get('a');
+  const b = outcome(cache.get('b'));
+  assert.equal(cache.clear(), undefined);
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('a'), 'fresh-a');
+  assert.equal(await cache.get('b'), 'fresh-b');
+  gates.get('a').resolve('stale-a');
+  gates.get('b').reject(null);
+  assert.equal(await a, 'stale-a');
+  assert.deepEqual(await b, { reason: null });
+  assert.equal(await cache.get('a'), 'fresh-a');
+  assert.equal(await cache.get('b'), 'fresh-b');
+  assert.equal(await other.get('a'), 'independent');
+  assert.equal(cache.size, 2);
+});
+
+for (const oldBeforeExpiry of [false, true]) {
+  test(`set wins without extending TTL; obsolete load settles ${oldBeforeExpiry ? 'before' : 'after'} expiry`, async () => {
+    let time = 0;
+    let calls = 0;
+    const old = deferred();
+    const fresh = deferred();
+    const cache = createCache({
+      ttlMs: 10,
+      now: () => time,
+      load: () => ++calls === 1 ? old.promise : fresh.promise
+    });
+    const original = cache.get('key');
+    assert.equal(cache.set('key', undefined), undefined);
+    time = 5;
+    if (oldBeforeExpiry) {
+      old.resolve('stale');
+      assert.equal(await original, 'stale');
+    }
+    assert.equal(await cache.get('key'), undefined);
+    assert.equal(cache.size, 1);
+    time = 10;
+    assert.equal(cache.size, 0);
+    const replacement = cache.get('key');
+    await Promise.resolve();
+    assert.equal(calls, 2);
+    if (!oldBeforeExpiry) {
+      old.resolve('stale');
+      assert.equal(await original, 'stale');
+      assert.equal(cache.size, 0);
+    }
+    const joined = cache.get('key');
+    time = 20;
+    fresh.resolve(null);
+    assert.deepEqual(await Promise.all([replacement, joined]), [null, null]);
+    assert.equal(calls, 2);
+    time = 29;
+    assert.equal(await cache.get('key'), null);
+    assert.equal(cache.size, 1);
+    time = 30;
+    assert.equal(cache.size, 0);
+  });
+}
+
+for (const failure of ['throw', 'promise', 'thenable']) {
+  test(`${failure} rejection releases the flight and preserves the reason for every waiter`, async () => {
+    const reason = failure === 'throw' ? undefined : { failure };
+    let calls = 0;
+    const cache = createCache({
+      now: () => 0,
+      load() {
+        if (++calls > 1) return 'retried';
+        if (failure === 'throw') throw reason;
+        if (failure === 'promise') return Promise.reject(reason);
+        return { then(resolve, reject) { reject(reason); } };
+      }
+    });
+    const readers = [outcome(cache.get('key')), outcome(cache.get('key'))];
+    for (const reader of readers) {
+      const result = await reader;
+      assert.deepEqual(result, { reason });
+      assert.equal(result.reason, reason);
+    }
+    assert.equal(calls, 1);
+    assert.equal(cache.size, 0);
+    assert.equal(await cache.get('key'), 'retried');
+    assert.equal(calls, 2);
+  });
+}
+
+for (const mutation of ['invalidate', 'set', 'clear']) {
+  for (const rejects of [false, true]) {
+    test(`synchronous load ${mutation} then ${rejects ? 'throws' : 'returns'} is a barrier`, async () => {
+      const fresh = deferred();
+      const reason = { mutation };
+      let cache;
+      let calls = 0;
+      let next;
+      cache = createCache({
+        now: () => 0,
+        load(key) {
+          if (++calls > 1) return fresh.promise;
+          assert.equal(cache[mutation](key, 'set-value'), undefined);
+          next = cache.get(key);
+          if (rejects) throw reason;
+          return 'stale';
+        }
+      });
+      const original = await outcome(cache.get('key'));
+      assert.deepEqual(original, rejects ? { reason } : { value: 'stale' });
+      if (rejects) assert.equal(original.reason, reason);
+      assert.equal(cache.size, mutation === 'set' ? 1 : 0);
+      const joined = cache.get('key');
+      fresh.resolve('fresh');
+      const expected = mutation === 'set' ? 'set-value' : 'fresh';
+      assert.deepEqual(await Promise.all([next, joined]), [expected, expected]);
+      assert.equal(await cache.get('key'), expected);
+      assert.equal(calls, mutation === 'set' ? 1 : 2);
+    });
+  }
+}
+
+test('reentrant reads join their own flight and other keys load independently', async () => {
+  const key = {};
+  const otherKey = {};
+  const calls = [];
+  let self;
+  let other;
+  let cache;
+  cache = createCache({
+    now: () => 0,
+    load(...args) {
+      assert.equal(args.length, 1);
+      calls.push(args[0]);
+      if (args[0] === key) {
+        self = cache.get(key);
+        other = cache.get(otherKey);
+        return 'self';
+      }
+      return { then(resolve) { resolve('other'); } };
+    }
+  });
+  assert.equal(await cache.get(key), 'self');
+  assert.equal(await self, 'self');
+  assert.equal(await other, 'other');
+  assert.deepEqual(calls, [key, otherKey]);
+  assert.equal(cache.size, 2);
+});
+
+test('zero TTL deduplicates pending work but never reuses settled values', async () => {
+  const first = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 0, now: () => 0, load: () => ++calls === 1 ? first.promise : 'next' });
+  const a = cache.get('key');
+  const b = cache.get('key');
+  assert.equal(cache.size, 0);
+  first.resolve('first');
+  assert.deepEqual(await Promise.all([a, b]), ['first', 'first']);
+  assert.equal(calls, 1);
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'next');
+  assert.equal(calls, 2);
+  assert.equal(cache.size, 0);
+});
