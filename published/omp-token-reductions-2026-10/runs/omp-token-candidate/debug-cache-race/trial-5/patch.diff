+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createCache } = require('./cache');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((done, fail) => { resolve = done; reject = fail; });
+  return { promise, resolve, reject };
+}
+
+test('obsolete success cannot commit or detach a newer pending flight', async () => {
+  const old = deferred();
+  const fresh = deferred();
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => ++calls === 1 ? old.promise : fresh.promise });
+  const oldReader = cache.get('key');
+  await Promise.resolve();
+  cache.invalidate('key');
+  const freshReader = cache.get('key');
+  await Promise.resolve();
+  old.resolve('stale');
+  assert.equal(await oldReader, 'stale');
+  assert.equal(cache.size, 0);
+  const joinedReader = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 2);
+  fresh.resolve('fresh');
+  assert.deepEqual(await Promise.all([freshReader, joinedReader]), ['fresh', 'fresh']);
+  assert.equal(await cache.get('key'), 'fresh');
+});
+
+test('repeated invalidations are barriers even without a stored value', async () => {
+  const gates = [deferred(), deferred(), deferred()];
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => gates[calls++].promise });
+  const first = cache.get('key');
+  await Promise.resolve();
+  cache.invalidate('key');
+  const second = cache.get('key');
+  await Promise.resolve();
+  cache.invalidate('key');
+  const third = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 3);
+  gates[2].resolve('latest');
+  assert.equal(await third, 'latest');
+  gates[0].resolve('first');
+  gates[1].resolve('second');
+  assert.deepEqual(await Promise.all([first, second]), ['first', 'second']);
+  assert.equal(await cache.get('key'), 'latest');
+});
+
+test('clear removes stored values and detaches flights for all key identities', async () => {
+  const keys = [{}, NaN];
+  const oldGates = keys.map(() => deferred());
+  const newGates = keys.map(() => deferred());
+  const calls = new Map();
+  const cache = createCache({ now: () => 0, load(key) {
+    const count = (calls.get(key) || 0) + 1;
+    calls.set(key, count);
+    const index = keys.indexOf(key);
+    return (count === 1 ? oldGates : newGates)[index === -1 ? 1 : index].promise;
+  } });
+  cache.set('stored', null);
+  const oldReaders = keys.map(key => cache.get(key));
+  await Promise.resolve();
+  assert.equal(cache.clear(), undefined);
+  assert.equal(cache.size, 0);
+  const newReaders = keys.map(key => cache.get(key));
+  await Promise.resolve();
+  oldGates.forEach((gate, index) => gate.resolve(`old-${index}`));
+  assert.deepEqual(await Promise.all(oldReaders), ['old-0', 'old-1']);
+  assert.equal(cache.size, 0);
+  const joinedReaders = keys.map(key => cache.get(key));
+  await Promise.resolve();
+  keys.forEach(key => assert.equal(calls.get(key), 2));
+  newGates.forEach((gate, index) => gate.resolve(`new-${index}`));
+  assert.deepEqual(await Promise.all(newReaders), ['new-0', 'new-1']);
+  assert.deepEqual(await Promise.all(joinedReaders), ['new-0', 'new-1']);
+  assert.equal(cache.size, 2);
+});
+
+test('set wins over earlier loads without restarting its TTL', async () => {
+  let time = 0;
+  const old = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 10, now: () => time,
+    load: () => ++calls === 1 ? old.promise : 'fresh' });
+  const reader = cache.get('key');
+  await Promise.resolve();
+  time = 5;
+  assert.equal(cache.set('key', undefined), undefined);
+  time = 12;
+  old.resolve('stale');
+  assert.equal(await reader, 'stale');
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(cache.size, 1);
+  time = 15;
+  assert.equal(cache.size, 0);
+  assert.equal(await cache.get('key'), 'fresh');
+  assert.equal(calls, 2);
+});
+
+test('expired set values and size cleanup cannot reattach an old load', async () => {
+  let time = 0;
+  const old = deferred();
+  const fresh = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 10, now: () => time,
+    load: () => ++calls === 1 ? old.promise : fresh.promise });
+  const oldReader = cache.get('key');
+  await Promise.resolve();
+  cache.set('key', null);
+  time = 10;
+  assert.equal(cache.size, 0);
+  const freshReader = cache.get('key');
+  await Promise.resolve();
+  old.resolve('stale');
+  assert.equal(await oldReader, 'stale');
+  assert.equal(cache.size, 0);
+  const joinedReader = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 2);
+  fresh.resolve('fresh');
+  assert.deepEqual(await Promise.all([freshReader, joinedReader]), ['fresh', 'fresh']);
+});
+
+test('active failures reach all waiters unchanged and allow retry', async t => {
+  const error = new Error('failed');
+  const cases = [
+    ['synchronous throw', 'reason', () => { throw 'reason'; }],
+    ['rejected promise', error, () => Promise.reject(error)],
+    ['rejecting thenable', null, () => ({ then(resolve, reject) { reject(null); } })],
+    ['undefined rejection', undefined, () => Promise.reject(undefined)]
+  ];
+  for (const [name, reason, fail] of cases) {
+    await t.test(name, async () => {
+      let calls = 0;
+      const cache = createCache({ now: () => 0, load: () => ++calls === 1 ? fail() : 'retry' });
+      const results = await Promise.allSettled([cache.get('key'), cache.get('key')]);
+      assert.equal(calls, 1);
+      for (const result of results) {
+        assert.equal(result.status, 'rejected');
+        assert.equal(result.reason, reason);
+      }
+      assert.equal(cache.size, 0);
+      assert.equal(await cache.get('key'), 'retry');
+      assert.equal(calls, 2);
+    });
+  }
+});
+
+test('obsolete rejection cannot detach a newer flight', async () => {
+  const old = deferred();
+  const fresh = deferred();
+  const reason = {};
+  let calls = 0;
+  const cache = createCache({ now: () => 0, load: () => ++calls === 1 ? old.promise : fresh.promise });
+  const oldResults = Promise.allSettled([cache.get('key'), cache.get('key')]);
+  await Promise.resolve();
+  cache.invalidate('key');
+  const freshReader = cache.get('key');
+  await Promise.resolve();
+  old.reject(reason);
+  assert.deepEqual(await oldResults, [
+    { status: 'rejected', reason }, { status: 'rejected', reason }
+  ]);
+  const joinedReader = cache.get('key');
+  await Promise.resolve();
+  assert.equal(calls, 2);
+  fresh.resolve('fresh');
+  assert.deepEqual(await Promise.all([freshReader, joinedReader]), ['fresh', 'fresh']);
+});
+
+test('synchronous loader mutations preserve barriers and reentrant reads', async t => {
+  for (const mutation of ['invalidate', 'set', 'clear']) {
+    await t.test(mutation, async () => {
+      const key = {};
+      let calls = 0;
+      let ownReader;
+      let nextReader;
+      let otherReader;
+      const cache = createCache({ now: () => 0, load(...args) {
+        assert.equal(args.length, 1);
+        if (args[0] === 'other') return 'other-value';
+        assert.equal(args[0], key);
+        calls += 1;
+        if (calls > 1) return 'fresh';
+        ownReader = cache.get(key);
+        assert.equal(cache[mutation](key, 'set-value'), undefined);
+        nextReader = cache.get(key);
+        otherReader = cache.get('other');
+        return 'stale';
+      } });
+      assert.equal(await cache.get(key), 'stale');
+      assert.equal(await ownReader, 'stale');
+      const expected = mutation === 'set' ? 'set-value' : 'fresh';
+      assert.equal(await nextReader, expected);
+      assert.equal(await cache.get(key), expected);
+      assert.equal(await otherReader, 'other-value');
+      assert.equal(calls, mutation === 'set' ? 1 : 2);
+    });
+  }
+});
+
+test('successful thenable TTL begins at commit and expires at the boundary', async () => {
+  let time = 0;
+  let calls = 0;
+  const gate = deferred();
+  const cache = createCache({ ttlMs: 10, now: () => time, load: () => {
+    calls += 1;
+    return { then(resolve, reject) { gate.promise.then(resolve, reject); } };
+  } });
+  const reader = cache.get('key');
+  await Promise.resolve();
+  time = 20;
+  gate.resolve(undefined);
+  assert.equal(await reader, undefined);
+  time = 29;
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(calls, 1);
+  time = 30;
+  assert.equal(await cache.get('key'), undefined);
+  assert.equal(calls, 2);
+});
+
+test('zero TTL deduplicates unsettled loads but never reuses settled values', async () => {
+  const gate = deferred();
+  let calls = 0;
+  const cache = createCache({ ttlMs: 0, now: () => 0,
+    load: () => ++calls === 1 ? gate.promise : 'next' });
+  const first = cache.get('key');
+  const joined = cache.get('key');
+  await Promise.resolve();
+  assert.equal(cache.size, 0);
+  gate.resolve('first');
+  assert.deepEqual(await Promise.all([first, joined]), ['first', 'first']);
+  assert.equal(calls, 1);
+  assert.equal(await cache.get('key'), 'next');
+  assert.equal(calls, 2);
+  assert.equal(cache.size, 0);
+});
