@@ -0,0 +1,163 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+
+const version = '1.0.0';
+
+function freeze(value) {
+  for (const child of Object.values(value)) {
+    if (child !== null && typeof child === 'object') freeze(child);
+  }
+  return Object.freeze(value);
+}
+
+test('numeric ordering compares major and patch components', () => {
+  assert.deepEqual(resolve({
+    major: { '9.0.0': {}, '10.0.0': {} },
+    patch: { '1.0.9': {}, '1.0.10': {} },
+  }, { major: '*', patch: '*' }), {
+    major: '10.0.0', patch: '1.0.10',
+  });
+});
+
+test('first-found selection uses FIFO discovery and immediately collected constraints', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': {} },
+    c: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '2.0.0', c: '1.0.0',
+  });
+});
+
+test('root and dependency key order determine the first-found assignment', () => {
+  const registry = {
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': {} },
+    c: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { b: '*', c: '*' }), { b: '2.0.0', c: '1.0.0' });
+  assert.deepEqual(resolve(registry, { c: '*', b: '*' }), { c: '2.0.0', b: '1.0.0' });
+  registry.a = { '1.0.0': { b: '*', c: '*' } };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0', c: '1.0.0' });
+  registry.a = { '1.0.0': { c: '*', b: '*' } };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', c: '2.0.0', b: '1.0.0' });
+});
+
+test('a conflict retries the latest choice, preserving earlier choices', () => {
+  const registry = {
+    a: { '2.0.0': { c: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('rollback removes a partially appended dependency list and its constraints', () => {
+  const registry = {
+    z: { '1.0.0': {} },
+    a: {
+      '2.0.0': { ghost: '*', z: '2.0.0', unseen: '*' },
+      '1.0.0': { z: '1.0.0' },
+    },
+  };
+  assert.deepEqual(resolve(registry, { z: '1.0.0', a: '*' }), {
+    z: '1.0.0', a: '1.0.0',
+  });
+});
+
+test('rollback removes selected descendants and unreachable requirements', () => {
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '*' }, '1.0.0': { c: '*' } },
+    c: { '1.0.0': { missing: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0' });
+});
+
+test('cycles expand once and incompatible cycles backtrack', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0' }, '1.0.0': { a: '*', b: '1.0.0' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve(registry, { a: '2.0.0' }), null);
+});
+
+test('missing packages and incompatible root ranges are unsatisfiable', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '>1.0.0' }), null);
+});
+
+test('all maps, versions, and ranges are validated even when unreachable', () => {
+  for (const invalid of [null, [], new Date(), 1, 'map', Object.create({})]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0\n': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { dependency: 'invalid' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('null-prototype maps, special names, and own enumerable string keys are supported', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'hidden', { value: null });
+  Object.defineProperty(root, 'hidden', { value: 'invalid' });
+  Object.defineProperty(registry.__proto__, 'hidden', { value: null });
+  Object.defineProperty(registry.__proto__[version], 'hidden', { value: 'invalid' });
+  registry[Symbol('ignored')] = null;
+  root[Symbol('ignored')] = 'invalid';
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result, { ['__proto__']: version, constructor: version, toString: version });
+});
+
+test('resolution does not mutate inputs or leak state between calls', () => {
+  const registry = freeze({ a: { '2.0.0': { b: '*' }, '1.0.0': {} }, b: { '1.0.0': {} } });
+  const root = freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { a: '1.0.0' }), { a: '1.0.0' });
+});
+
+test('long dependency chains ending in a cycle do not use the call stack', () => {
+  const count = 15000;
+  const registry = {};
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { [version]: { [`p${(i + 1) % count}`]: '*' } };
+  }
+  const expected = Object.fromEntries(Object.keys(registry).map(name => [name, version]));
+  assert.deepEqual(resolve(registry, { p0: '*' }), expected);
+});
+
+test('backtracking has no arbitrary iteration limit', () => {
+  const versions = { '0.0.0': {} };
+  for (let i = 1; i <= 5000; i += 1) versions[`${i}.0.0`] = { missing: '*' };
+  assert.deepEqual(resolve({ a: versions }, { a: '*' }), { a: '0.0.0' });
+});
+
+test('selected-version conflicts prune choices before expanding a Cartesian product', () => {
+  const registry = { gate: { '1.0.0': {} } };
+  const root = { gate: '1.0.0' };
+  const expected = { gate: '1.0.0' };
+  for (let i = 0; i < 40; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { gate: '2.0.0' }, '1.0.0': { gate: '1.0.0' } };
+    root[name] = '*';
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
