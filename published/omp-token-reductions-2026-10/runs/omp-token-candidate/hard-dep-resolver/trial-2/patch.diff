--- /dev/null
+++ "{temp}\\hb-32dc2fb8-4e1w0prm/semver.test.js"
@@ -0,0 +1,89 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+const { resolve } = require('./src');
+
+const max = Number.MAX_SAFE_INTEGER;
+
+test('parse accepts canonical safe integer triples and compare is numeric', () => {
+  assert.deepEqual(parse(`0.1.${max}`), [0, 1, max]);
+  assert.equal(compare('1.10.0', '1.9.99'), 1);
+  assert.equal(compare('2.0.0', '10.0.0'), -1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+});
+
+test('versions reject noncanonical syntax and unsafe components', () => {
+  for (const invalid of [
+    null, 1, '1.2', '1.2.3.4', '01.2.3', '1.02.3', '1.2.03', '-1.2.3',
+    '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3 ', '1.2.3\n', '1.2.3\r',
+    '1.2.3\u2028', '1.2.3\u2029', `${max + 1}.0.0`, `0.${max + 1}.0`, `0.0.${max + 1}`,
+  ]) {
+    assert.throws(() => parse(invalid), TypeError);
+  }
+  assert.throws(() => compare('1.0.0', 'bad'), TypeError);
+  assert.throws(() => satisfies('bad', '*'), TypeError);
+});
+
+test('range operators and whitespace-separated conjunctions honor boundaries', () => {
+  const cases = [
+    ['*', '0.0.0', true],
+    ['1.2.3', '1.2.3', true], ['1.2.3', '1.2.4', false],
+    ['>=1.2.3', '1.2.3', true], ['>=1.2.3', '1.2.2', false],
+    ['>1.2.3', '1.2.4', true], ['>1.2.3', '1.2.3', false],
+    ['<=1.2.3', '1.2.3', true], ['<=1.2.3', '1.2.4', false],
+    ['<1.2.3', '1.2.2', true], ['<1.2.3', '1.2.3', false],
+    [' \t>=1.2.3\n<2.0.0 * ', '1.9.0', true],
+    ['>=1.2.3 <2.0.0', '2.0.0', false],
+    ['>2.0.0 <1.0.0', '1.5.0', false],
+  ];
+  for (const [range, version, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} in ${range}`);
+  }
+  const accepts = compileRange('>=1.0.0 <2.0.0');
+  assert.equal(accepts([1, 9, 0]), true);
+  assert.equal(accepts([2, 0, 0]), false);
+});
+
+test('caret uses the first nonzero component for its exclusive upper bound', () => {
+  const cases = [
+    ['^1.2.3', '1.2.2', false], ['^1.2.3', '1.2.3', true],
+    ['^1.2.3', '1.9.9', true], ['^1.2.3', '2.0.0', false],
+    ['^0.2.3', '0.2.2', false], ['^0.2.3', '0.2.3', true],
+    ['^0.2.3', '0.2.99', true], ['^0.2.3', '0.3.0', false],
+    ['^0.0.3', '0.0.2', false], ['^0.0.3', '0.0.3', true], ['^0.0.3', '0.0.4', false],
+    ['^0.0.0', '0.0.0', true], ['^0.0.0', '0.0.1', false],
+  ];
+  for (const [range, version, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} in ${range}`);
+  }
+  assert.deepEqual(resolve({ a: { '0.3.0': {}, '0.2.9': {} } }, { a: '^0.2.3' }), { a: '0.2.9' });
+});
+
+test('tilde limits the minor version, including zero major', () => {
+  assert.equal(satisfies('1.2.2', '~1.2.3'), false);
+  assert.equal(satisfies('1.2.3', '~1.2.3'), true);
+  assert.equal(satisfies('1.2.99', '~1.2.3'), true);
+  assert.equal(satisfies('1.3.0', '~1.2.3'), false);
+  assert.equal(satisfies('0.0.9', '~0.0.3'), true);
+  assert.equal(satisfies('0.1.0', '~0.0.3'), false);
+});
+
+test('range upper bounds beyond safe component maxima remain ordered', () => {
+  assert.equal(satisfies(`${max}.${max}.${max}`, `^${max}.0.0`), true);
+  assert.equal(satisfies(`0.${max}.${max}`, `^0.${max}.0`), true);
+  assert.equal(satisfies(`0.0.${max}`, `^0.0.${max}`), true);
+  assert.equal(satisfies(`1.${max}.${max}`, `~1.${max}.0`), true);
+  assert.equal(satisfies('2.0.0', `~1.${max}.0`), false);
+});
+
+test('invalid range syntax is rejected eagerly, including later AND terms', () => {
+  for (const invalid of [
+    null, 1, '', ' \t\n ', '1', '1.2', '1.x', '||', '1.0.0 || 2.0.0',
+    '>= 1.0.0', '==1.0.0', '^', '~', '* invalid', '<=01.0.0', '1.0.0 - 2.0.0',
+  ]) {
+    assert.throws(() => compileRange(invalid), TypeError);
+  }
+  assert.throws(() => satisfies('1.0.0', ''), TypeError);
+});
