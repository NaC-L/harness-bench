+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+
+test('orders all version components numerically', () => {
+  assert.deepEqual(resolve({
+    major: { '9.99.99': {}, '10.0.0': {} },
+    patch: { '1.0.9': {}, '1.0.10': {} },
+  }, { major: '*', patch: '*' }), { major: '10.0.0', patch: '1.0.10' });
+});
+
+test('collects pending root constraints before choosing a dependency', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '2.0.0' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '1.0.0' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('removes failed dependencies and constraints before trying another version', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '2.0.0', missing: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '1.0.0': {} },
+  }, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('undoes partially appended constraints after an immediate conflict', () => {
+  assert.deepEqual(resolve({
+    a: { '1.0.0': {} },
+    b: { '2.0.0': { c: '2.0.0', a: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0' });
+});
+
+test('returns the first FIFO depth-first assignment, not a globally newest set', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' }, '1.0.0': { c: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+    c: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '1.0.0',
+  });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), {
+    b: '2.0.0', a: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('uses dependency key order when discovering later choices', () => {
+  const versions = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve({ entry: { '1.0.0': { a: '*', b: '*' } }, ...versions }, { entry: '*' }), {
+    entry: '1.0.0', a: '2.0.0', b: '1.0.0',
+  });
+  assert.deepEqual(resolve({ entry: { '1.0.0': { b: '*', a: '*' } }, ...versions }, { entry: '*' }), {
+    entry: '1.0.0', b: '2.0.0', a: '1.0.0',
+  });
+});
+
+test('resolves cycles and self-dependencies without expanding selected names again', () => {
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '*', b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  }, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { b: '*' } }, b: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('checks discovered conflicts before enumerating independent choices', () => {
+  const registry = { anchor: { '1.0.0': {} } };
+  const root = { anchor: '*' };
+  const expected = { anchor: '1.0.0' };
+  for (let i = 0; i < 40; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { anchor: '2.0.0' }, '1.0.0': {} };
+    root[name] = '*';
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('resolves and unwinds chains beyond the recursive call-stack depth', () => {
+  const registry = {};
+  const expected = {};
+  const count = 16000;
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': i + 1 === count ? {} : { [`p${i + 1}`]: '*' } };
+    expected[`p${i}`] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, { p0: '*' }), expected);
+  registry[`p${count - 1}`]['1.0.0'] = { absent: '*' };
+  registry.p0['0.0.0'] = {};
+  assert.deepEqual(resolve(registry, { p0: '*' }), { p0: '0.0.0' });
+});
+
+test('treats missing packages as unsatisfiable and ignores unselected reachability', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': { missing: '*' } } }, { a: '*' }), null);
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('validates malformed maps, versions and ranges even when unreachable', () => {
+  for (const value of [null, [], 1, 'map', new Date()]) {
+    assert.throws(() => resolve(value, {}), TypeError);
+    assert.throws(() => resolve({}, value), TypeError);
+    assert.throws(() => resolve({ unused: value }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': value } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  for (const range of ['', 'invalid', '^1.0', '!=1.0.0', 1, null]) {
+    assert.throws(() => resolve({ unused: { '1.0.0': { dependency: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { unused: range }), TypeError);
+  }
+});
+
+test('supports null-prototype maps and special names without mutating inputs', () => {
+  const deps = Object.freeze(Object.assign(Object.create(null), { constructor: '*' }));
+  const versions = Object.freeze(Object.assign(Object.create(null), { '1.0.0': deps }));
+  const registry = Object.freeze(Object.assign(Object.create(null), {
+    ['__proto__']: versions,
+    constructor: Object.freeze({ '1.0.0': Object.freeze({}) }),
+  }));
+  const root = Object.assign(Object.create(null), { ['__proto__']: '*' });
+  Object.defineProperty(root, 'ignored', { value: 'invalid', enumerable: false });
+  root[Symbol('ignored')] = 'invalid';
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.deepEqual(result, { ['__proto__']: '1.0.0', constructor: '1.0.0' });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
