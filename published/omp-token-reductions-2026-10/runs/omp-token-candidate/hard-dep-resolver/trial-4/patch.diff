+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+
+test('numeric candidate order covers every component and safe integer boundaries', () => {
+  for (const [older, newer] of [
+    ['9.0.0', '10.0.0'],
+    ['1.9.0', '1.10.0'],
+    ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    assert.deepEqual(resolve({ a: { [older]: {}, [newer]: {} } }, { a: '*' }), { a: newer });
+  }
+});
+
+test('backtracking removes abandoned dependencies, selections, and constraints', () => {
+  const registry = {
+    a: {
+      '2.0.0': { ghost: '*', b: '2.0.0', missing: '*' },
+      '1.0.0': { b: '1.0.0' },
+    },
+    ghost: { '1.0.0': { a: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('FIFO discovery collects constraints before choosing later packages', () => {
+  const registry = {
+    a: { '2.0.0': { c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '2.0.0', c: '1.0.0',
+  });
+});
+
+test('root constraints are collected before dependencies and survive backtracking', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '1.0.0' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('a newly discovered conflict retries the most recent choice first', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+});
+
+test('dependency key order determines the first complete assignment', () => {
+  const registry = {
+    root: { '1.0.0': { a: '*', b: '*' } },
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { root: '*' }), {
+    root: '1.0.0', a: '2.0.0', b: '1.0.0',
+  });
+  registry.root['1.0.0'] = { b: '*', a: '*' };
+  assert.deepEqual(resolve(registry, { root: '*' }), {
+    root: '1.0.0', b: '2.0.0', a: '1.0.0',
+  });
+});
+
+test('cycles terminate and self-constraints can reject a candidate', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  assert.deepEqual(resolve({ a: {
+    '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '1.0.0' },
+  } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '*', c: '*' } },
+    c: { '1.0.0': { b: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0' });
+  registry.b['1.0.0'].a = '2.0.0';
+  assert.equal(resolve(registry, { a: '*' }), null);
+});
+
+test('missing packages, empty catalogs, and contradictory ranges are unsatisfiable', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '>1.0.0 <1.0.0' }), null);
+  assert.deepEqual(resolve({ a: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('all maps, versions, and ranges are validated even when unreachable', () => {
+  for (const invalid of [null, [], 1, 'map', new Date(), Object.create({ inherited: true })]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { other: '^bad' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+});
+
+test('null-prototype maps and special names work without mutating inputs', () => {
+  const deps = Object.freeze(Object.assign(Object.create(null), { constructor: '*' }));
+  const registry = Object.create(null);
+  registry.__proto__ = Object.freeze({ '1.0.0': deps });
+  registry.constructor = Object.freeze({ '1.0.0': Object.freeze({}) });
+  Object.defineProperty(registry, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  const root = Object.freeze(Object.assign(Object.create(null), { ['__proto__']: '*' }));
+  const result = resolve(registry, root);
+  assert.deepEqual(result, { ['__proto__']: '1.0.0', constructor: '1.0.0' });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(registry), ['__proto__', 'constructor']);
+  assert.deepEqual(deps, Object.assign(Object.create(null), { constructor: '*' }));
+});
+
+test('long branching chains prune constraints without recursive stack depth', () => {
+  const registry = {};
+  const expected = {};
+  const count = 12000;
+  for (let i = 0; i < count; i += 1) {
+    const name = `p${i}`;
+    const deps = i + 1 < count ? { [`p${i + 1}`]: '1.0.0' } : {};
+    registry[name] = { '2.0.0': deps, '1.0.0': deps };
+    expected[name] = i === 0 ? '2.0.0' : '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, { p0: '*' }), expected);
+});
+
+test('backtracking unwinds a long chain iteratively', () => {
+  const registry = { root: { '2.0.0': { p0: '*' }, '1.0.0': {} } };
+  const count = 12000;
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [i + 1 < count ? `p${i + 1}` : 'missing']: '*' } };
+  }
+  assert.deepEqual(resolve(registry, { root: '*' }), { root: '1.0.0' });
+});
