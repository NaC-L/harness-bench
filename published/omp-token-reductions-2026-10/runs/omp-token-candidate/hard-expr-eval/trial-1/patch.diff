@@ -0,0 +1,129 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src');
+
+function expectError(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('power is right associative and binds asymmetrically around unary signs', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 1 / 16],
+    ['-2 ** -2', -1 / 4],
+    ['2 * -3 ** 2 + 5', -13],
+    ['--2 ** 2', 4],
+    ['+2 ** +3', 8],
+    ['16 / 4 / 2 - 3 - 1', -2],
+  ]) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('comparisons chain numeric operands rather than intermediate booleans', () => {
+  assert.equal(evaluate('3 < 2 < 1'), false);
+  assert.equal(evaluate('1 < 2 <= 2 == 2 != 3 > 2 >= 2'), true);
+  assert.equal(evaluate('1 < 2 > 3'), false);
+  assert.equal(evaluate('(3 < 2) < 1'), true);
+  assert.equal(evaluate('(1 < 2) + (2 < 1)'), 1);
+  assert.equal(evaluate('(1 < 2) == 1'), true);
+  assert.equal(evaluate('2 ** (1 < 2) * (2 > 1)'), 2);
+  assert.equal(evaluate('abs((1 > 2) - 2)'), 2);
+});
+
+test('comparison operands and call arguments read getters once in order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 7 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 0]]) {
+    Object.defineProperty(variables, name, {
+      get() {
+        reads.push(name);
+        return value;
+      },
+    });
+  }
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < d', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a + a, b, min(c, d))', variables), 2);
+  assert.deepEqual(reads, ['a', 'a', 'b', 'c', 'd']);
+  expectError('inherited', 1, variables);
+});
+
+test('false chains skip runtime errors but do not skip parsing', () => {
+  assert.equal(evaluate('2 < 1 < missing'), false);
+  assert.equal(evaluate('2 < 1 < 1 / 0'), false);
+  expectError('1 < 2 < 1 / 0', 11);
+  const variables = {
+    get a() {
+      assert.fail('Syntax errors must be detected before reading variables');
+    },
+  };
+  expectError('a < 0 <   abs(1, 2)', 11, variables);
+  expectError('a < 0 <   unknown(1)', 11, variables);
+  expectError('a < 0 < min(1,)', 15, variables);
+});
+
+test('floor division and modulo preserve integer identity and normalize zeros', () => {
+  for (const a of [-8, -1, 0, 1, 8]) {
+    for (const b of [-3, 3]) {
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      const expectedQuotient = Math.floor(a / b);
+      assert.equal(quotient, expectedQuotient === 0 ? 0 : expectedQuotient);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+    }
+  }
+  for (const source of ['0 // -2', '-0 // 2', '-6 % 3', '6 % -3']) {
+    assert.ok(Object.is(evaluate(source), 0), source);
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  expectError('1 / (2 < 1)', 3);
+  expectError('1 // -0', 3);
+  expectError('1 % 0', 3);
+});
+
+test('errors point to token starts after whitespace and to the full source end', () => {
+  for (const [source, column] of [
+    ['  missing', 3],
+    ['1 +   missing', 7],
+    ['  9 /   0', 5],
+    ['9  //  0', 4],
+    ['9\t % 0', 4],
+    ['   min()', 4],
+    ['   max()', 4],
+    ['   abs()', 4],
+    [' \n unknown(1)', 4],
+    ['1 +   )', 7],
+    ['1  2', 4],
+    ['1 +   @', 7],
+    ['1 +   😀', 7],
+    ['2 **   / 3', 8],
+  ]) {
+    expectError(source, column);
+  }
+  for (const source of ['', ' \t\n', '1 +  \t', '(1 + 2   ', 'min(1,  ']) {
+    expectError(source, source.length + 1);
+  }
+});
+
+test('long flat arithmetic and comparison chains do not consume the call stack', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array(count).fill('1').join(' <= ')), true);
+});
