@@ -0,0 +1,132 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error =>
+    error instanceof ExprError && error.column === column);
+}
+
+test('power binds above a left unary sign and associates right', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625],
+    ['--2 ** 2', 4],
+    ['3 * -2 ** 2 + 5', -7],
+    ['20 / 2 * 3', 30],
+    ['10 - 3 - 2', 5],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo honor signs, fractions, and positive zero', () => {
+  for (const [source, expected] of [
+    ['7 // -3', -3],
+    ['-7 // -3', 2],
+    ['-7.5 // 2', -4],
+    ['-7.5 % 2', 0.5],
+    ['7.5 % -2', -0.5],
+    ['-7 % -3', -1],
+    ['-6 % 3', 0],
+    ['6 % -3', 0],
+    ['-0 // 3', 0],
+    ['0 // -3', 0],
+    ['-0 % 3', 0],
+  ]) assert.equal(evaluate(source), expected, source);
+
+  for (const a of [-13, -7, 0, 7, 13]) {
+    for (const b of [-5, -2, 2, 5]) {
+      const variables = { a, b };
+      const quotient = evaluate('a // b', variables);
+      const remainder = evaluate('a % b', variables);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+    }
+  }
+});
+
+test('comparisons chain, coerce booleans numerically, and respect parentheses', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 != 3 > 0', true],
+    ['2 == 2 >= 1', true],
+    ['1 < 2 > 3', false],
+    ['(3 < 2) < 1', true],
+    ['(1 < 2) + (3 < 2)', 1],
+    ['(1 < 2) == 1', true],
+    ['(3 < 2) == 0', true],
+    ['(1 < 2) ** 3', 1],
+    ['1 + 2 * 3 < 8', true],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('shared comparison operands are read once and false chains short-circuit', () => {
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return 1; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 3; },
+  };
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('a > b < c', variables), false);
+  assert.deepEqual(reads, ['a', 'b']);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+  assert.equal(evaluate('1 < 2 < 3 < 0 < missing'), false);
+});
+
+test('the entire formula is parsed before getters or short-circuit evaluation', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 1; } };
+  errorAt('a + abs(1, 2)', 5, variables);
+  errorAt('a + unknown(1)', 5, variables);
+  errorAt('a > 2 < abs()', 9, variables);
+  errorAt('a > 2 < max(1,)', 15, variables);
+  errorAt('a > 2 < (1 + )', 14, variables);
+  errorAt('a + 1 @', 7, variables);
+  assert.equal(reads, 0);
+});
+
+test('errors identify tokens after whitespace and EOF includes trailing whitespace', () => {
+  errorAt('1 +   missing', 7);
+  errorAt('1 /   0', 3);
+  errorAt('1  // -0', 4);
+  errorAt('1 \t% (2 - 2)', 4);
+  errorAt('  nope(1)', 3);
+  errorAt('  abs()', 3);
+  errorAt('1 +   )', 7);
+  errorAt('1 + \t@', 6);
+  errorAt('1 + \t😀', 6);
+  errorAt('1 +   ', 7);
+  errorAt('   ', 4);
+  errorAt('(1  ', 5);
+  errorAt('1   2', 5);
+});
+
+test('literals, built-ins, and own getter-backed variables retain evaluation order', () => {
+  assert.equal(evaluate('.5 + 5. + 1.5e-3 + 2E+1'), 25.5015);
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return -3; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 4; },
+  };
+  assert.equal(evaluate('max(abs(a), min(b, c), a + c)', variables), 3);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'a', 'c']);
+  errorAt('  inherited', 3, Object.create({ inherited: 1 }));
+  assert.equal(evaluate('min(1 < 2, 5) + max(3 < 2, -1)'), 1);
+});
+
+test('100,001-operand arithmetic and comparison chains do not consume the call stack', () => {
+  const count = 100001;
+  assert.equal(evaluate('1+'.repeat(count - 1) + '1'), count);
+  assert.equal(evaluate('1<='.repeat(count - 1) + '1'), true);
+});
