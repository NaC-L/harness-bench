+++ "{temp}\\hb-1f1534e4-bn4f_mog/evaluate-contract.test.js"
@@ -0,0 +1,123 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function expectError(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('powers associate right and bind above unary signs on the left', () => {
+  const cases = [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['3 * -2 ** 2 + 1', -11],
+    ['--2 ** +2', 4],
+  ];
+  for (const [source, expected] of cases) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('floor division and modulo handle fractional operands and positive zero', () => {
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  assert.equal(evaluate('-7.5 % -2'), -1.5);
+  assert.equal(evaluate('1 // -2'), -1);
+  assert.equal(evaluate('-0 // 2'), 0);
+  assert.equal(evaluate('1 // 2'), 0);
+  assert.equal(evaluate('-4 % 2'), 0);
+  assert.equal(evaluate('4 % -2'), 0);
+});
+
+test('comparison chains evaluate shared operands once in left-to-right order', () => {
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return 2; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 3; },
+    get d() { reads.push('d'); return 4; },
+    get e() { reads.push('e'); return 4; },
+    get f() { reads.push('f'); return 2; },
+    get g() { reads.push('g'); return 1; },
+  };
+  assert.equal(evaluate('a == b < c <= d >= e != f > g', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd', 'e', 'f', 'g']);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('1 == 2 < 1 / 0'), false);
+  assert.equal(evaluate('3 > 2 > 1'), true);
+  assert.equal(evaluate('1 < 2 > 3'), false);
+});
+
+test('parentheses isolate chains and comparison booleans become numeric operands', () => {
+  assert.equal(evaluate('(3 < 2) < 1'), true);
+  assert.equal(evaluate('(1 < 2) + (3 < 2)'), 1);
+  assert.equal(evaluate('(1 < 2) == 1'), true);
+  assert.equal(evaluate('(3 < 2) == 0'), true);
+  assert.equal(evaluate('2 ** (1 < 2)'), 2);
+  assert.equal(evaluate('abs(-(1 < 2))'), 1);
+});
+
+test('errors point at tokens after whitespace and at the complete source end', () => {
+  const cases = [
+    ['1 +   missing', 7],
+    ['1 + \n\t@', 7],
+    ['1   2', 5],
+    ['1 +   * 2', 7],
+    ['1   / 0', 5],
+    ['1   // -0', 5],
+    ['1   % (2 - 2)', 5],
+    ['1 < 2 <   unknown', 11],
+    ['  min(1,)', 9],
+    ['2 (3)', 3],
+    ['1 +  \n', 7],
+    ['(1  ', 5],
+    [' \t\n', 4],
+  ];
+  for (const [source, column] of cases) expectError(source, column);
+});
+
+test('the complete formula and call arities are validated before any evaluation', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  expectError('x +   nope(1)', 7, variables);
+  expectError('x +   abs(1, 2)', 7, variables);
+  expectError('x +   min()', 7, variables);
+  expectError('x +   max()', 7, variables);
+  expectError('x + 1 < 0 < abs()', 13, variables);
+  expectError('x + 1 < 0 < (2 + )', 18, variables);
+  assert.equal(reads, 0);
+});
+
+test('nested calls and arithmetic preserve getter order without mutating variables', () => {
+  const reads = [];
+  const variables = Object.freeze({
+    get x() { reads.push('x'); return 2; },
+    get y() { reads.push('y'); return 3; },
+    get z() { reads.push('z'); return -4; },
+  });
+  assert.equal(evaluate('max(x ** y, abs(z), min(y, x)) + x', variables), 10);
+  assert.deepEqual(reads, ['x', 'y', 'z', 'y', 'x', 'x']);
+  expectError('   inherited', 4, Object.create({ inherited: 1 }));
+});
+
+test('100,001-operand arithmetic stays stack-safe', () => {
+  assert.equal(evaluate(Array(100001).fill('1').join(' + ')), 100001);
+});
+
+test('100,001-operand comparison chains read every shared operand exactly once', () => {
+  let reads = 0;
+  const variables = { get x() { return reads++; } };
+  assert.equal(evaluate(Array(100001).fill('x').join(' < '), variables), true);
+  assert.equal(reads, 100001);
+});
