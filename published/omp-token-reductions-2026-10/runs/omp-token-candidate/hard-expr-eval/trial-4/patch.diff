--- /dev/null
+++ "{temp}\\hb-09c6b499-f5uekblf/evaluator.contract.test.js"
@@ -0,0 +1,136 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error =>
+    error instanceof ExprError && error.column === column);
+}
+
+test('arithmetic follows the documented precedence and associativity', () => {
+  const cases = [
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['-(1 + 2) ** 2', -9],
+    ['--2 ** 2', 4],
+    ['1 + -2 * 3', -5],
+    ['10 - 3 - 2', 5],
+    ['16 / 4 / 2', 2],
+    ['9 // 2 * 3 % 5', 2],
+    ['1.5e-3 + .5 + 5. + 2E+1', 25.5015],
+    ['abs(-3) + min(5, 2, 4) * max(1, 3)', 9],
+    ['max(min(4, 2), abs(-3))', 3],
+  ];
+  for (const [source, expected] of cases) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('division and modulo obey sign, reconstruction and positive-zero rules', () => {
+  for (const a of [-9, -7, -1, -0, 0, 1, 7, 9]) {
+    for (const b of [-3, -2, 2, 3]) {
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.ok(a === quotient * b + remainder);
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+      else assert.equal(Object.is(remainder, -0), false);
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`8   ${operator} -0`, 5);
+  }
+});
+
+test('comparison chains retain operands and coerce booleans numerically', () => {
+  const cases = [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 != 3 == 3 >= 2 > 1', true],
+    ['1 == 1 == 1', true],
+    ['3 > 2 > 1', true],
+    ['1 + 2 < 2 * 2', true],
+    ['(3 > 2) == 1', true],
+    ['(3 < 2) == 0', true],
+    ['(3 > 2) + (3 < 2)', 1],
+    ['-(1 < 2) ** 2', -1],
+    ['abs(1 > 2)', 0],
+    ['min(1 < 2, 2)', 1],
+    ['(1 < 2) < 2', true],
+  ];
+  for (const [source, expected] of cases) {
+    assert.equal(evaluate(source), expected, source);
+  }
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+});
+
+test('getters are read once per occurrence in left-to-right evaluation order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 10 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b <= c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('d < c < b < a', variables), false);
+  assert.deepEqual(reads.splice(0), ['d', 'c']);
+  assert.equal(evaluate('max(a + b, abs(-c), d) + a', variables), 5);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd', 'a']);
+  errorAt('inherited', 1, variables);
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('own', Object.assign(Object.create(null), { own: 7 })), 7);
+});
+
+test('the complete formula is parsed before any variables are read', () => {
+  let reads = 0;
+  const variables = { get first() { reads += 1; return 1; } };
+  for (const source of ['first + mystery(1)', 'first + abs()', 'first + abs(1, 2)']) {
+    errorAt(source, 9, variables);
+  }
+  errorAt('3 < 2 < abs(1, 2)', 9, variables);
+  errorAt('first + min(1,)', 15, variables);
+  errorAt('first + 2 3', 11, variables);
+  assert.equal(reads, 0);
+});
+
+test('errors identify tokens after whitespace and the full UTF-16 end offset', () => {
+  for (const [source, column] of [
+    [' \tmissing', 3],
+    [' \n@', 3],
+    ['1 + \t😀', 6],
+    ['1 +   )', 7],
+    ['1  2', 4],
+    ['min(1,)', 7],
+    ['abs(1 2)', 7],
+    ['1 +   ', 7],
+    ['(1   ', 6],
+    [' \t\n', 4],
+    ['', 1],
+    ['2(3)', 2],
+    ['1 = 1', 3],
+  ]) {
+    errorAt(source, column);
+  }
+});
+
+for (const [name, separator, expected] of [
+  ['addition', ' + ', 100001],
+  ['multiplication', ' * ', 1],
+  ['comparison', ' <= ', true],
+]) {
+  test(`100,001-operand flat ${name} evaluates without recursive traversal`, () => {
+    assert.equal(evaluate('1' + `${separator}1`.repeat(100000)), expected);
+  });
+}
