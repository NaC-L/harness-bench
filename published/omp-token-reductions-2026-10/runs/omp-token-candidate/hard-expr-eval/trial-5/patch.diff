@@ -0,0 +1,116 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column);
+    return true;
+  });
+}
+
+test('power is right associative and binds asymmetrically to unary signs', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['2 ** -2 ** 2', 0.0625],
+    ['--2 ** 2', 4], ['3 * -2 ** 2', -12],
+    ['20 / 2 * 3 // 4 % 5', 2], ['10 - 3 + 1', 8],
+  ]) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('comparisons chain with numeric boolean coercion and arithmetic precedence', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false], ['1 < 2 <= 2', true],
+    ['3 > 2 >= 2 != 1 == 1', true], ['1 == 2 == 0', false],
+    ['1 + 2 < 2 * 2', true], ['(1 < 2) + (2 < 1)', 1],
+    ['(1 < 2) == 1', true], ['(2 < 1) == 0', true],
+    ['(3 < 2) < 1', true], ['abs(2 < 1)', 0],
+  ]) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('comparison operands are read once and stop after the first false link', () => {
+  const reads = [];
+  const variables = {
+    get a() { reads.push('a'); return 1; },
+    get b() { reads.push('b'); return 2; },
+    get c() { reads.push('c'); return 3; },
+  };
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  assert.equal(evaluate('2 < 1 < missing'), false);
+  assert.equal(evaluate('2 < 1 < (1 / 0)'), false);
+});
+
+test('the whole formula is parsed before reading variables or short circuiting', () => {
+  const variables = { get x() { assert.fail('Getter ran before parsing finished'); } };
+  errorAt('x + unknown(1)', 5, variables);
+  errorAt('x + abs(1, 2)', 5, variables);
+  errorAt('x + min()', 5, variables);
+  errorAt('x + max()', 5, variables);
+  errorAt('2 < 1 < abs(1, 2)', 9);
+  errorAt('2 < 1 < (3 + )', 14);
+});
+
+test('floor division and modulo handle fractional operands and normalize zero', () => {
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('7.5 // -2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const source of ['0 // -3', '-0 // 3', '-6 % 3', '6 % -3', '-0 % -3']) {
+    assert.ok(Object.is(evaluate(source), 0), source);
+  }
+  assert.equal(evaluate('8 % 3'), 2);
+  assert.equal(evaluate('-8 % -3'), -2);
+});
+
+test('zero divisors report the actual operator column, including whitespace', () => {
+  errorAt('  1   / 0', 7);
+  errorAt('  1   // -0', 7);
+  errorAt('  1   % (2 - 2)', 7);
+});
+
+test('syntax and variable errors use UTF-16 token offsets and full-source EOF', () => {
+  errorAt('   missing', 4);
+  errorAt('1 +   @', 7);
+  errorAt('1 +   \u{1f600}', 7);
+  errorAt('1 \t 2', 5);
+  errorAt('  abs(1, 2)', 3);
+  errorAt('  mystery(1)', 3);
+  errorAt('1 + \t ', 7);
+  errorAt('   ', 4);
+  errorAt('', 1);
+  errorAt('(1 + 2   ', 10);
+  errorAt('min(1,   )', 10);
+  errorAt('2(3)', 2);
+  errorAt('1 = 2', 3);
+  errorAt('1e+', 2);
+});
+
+test('literals, built-ins and variables preserve left-to-right evaluation', () => {
+  assert.equal(evaluate('.5 + 5. + 1.5e-3 + 2E+1'), 25.5015);
+  const reads = [];
+  const variables = Object.create({ inherited: 10 });
+  Object.defineProperty(variables, 'x', {
+    get() { reads.push('x'); return reads.length; },
+  });
+  assert.equal(evaluate('max(x, min(x, x), abs(-x)) + x', variables), 9);
+  assert.deepEqual(reads, ['x', 'x', 'x', 'x', 'x']);
+  errorAt('inherited', 1, variables);
+  assert.equal(evaluate('constructor', { constructor: 4 }), 4);
+});
+
+test('long flat arithmetic and comparison chains do not exhaust the stack', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join(' + ')), count);
+  assert.equal(evaluate(Array.from({ length: count }, (_, i) => i).join(' < ')), true);
+});
