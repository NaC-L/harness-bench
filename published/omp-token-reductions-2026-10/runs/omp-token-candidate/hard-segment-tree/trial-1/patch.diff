+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions pending on both ancestors and descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(0, 7, 5);
+  tree.assign(0, 7, -4);
+  tree.add(0, 7, 2);
+  tree.assign(2, 5, 0);
+  assert.equal(tree.sum(0, 3), -4);
+  assert.equal(tree.sum(3, 7), -4);
+  assert.equal(tree.max(0, 2), -2);
+  assert.deepEqual(tree.toArray(), [-2, -2, 0, 0, 0, -2, -2]);
+});
+
+test('partial maxima use the negative-infinity identity', () => {
+  const tree = new RangeTree([-8, -3, -12, -5, -9]);
+  assert.equal(tree.max(0, 2), -3);
+  assert.equal(tree.max(2, 5), -5);
+  assert.equal(tree.max(2, 3), -12);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, -2);
+  assert.equal(tree.max(1, 4), -12);
+  assert.equal(tree.max(3, 5), -10);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold search propagates assignments and additions before descending', () => {
+  const tree = new RangeTree([9, 1, 8, 2, 7]);
+  tree.assign(0, 5, 3);
+  assert.equal(tree.firstAtLeast(0, 4), -1);
+  assert.equal(tree.firstAtLeast(1, 3), 1);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(2, 12), 2);
+  tree.add(0, 5, -20);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.assign(0, 5, 20);
+  tree.assign(0, 3, -5);
+  assert.equal(tree.firstAtLeast(0, 10), 3);
+  assert.equal(tree.firstAtLeast(4, 20), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+});
+
+test('mixed updates and interleaved queries match an independent array model', () => {
+  let state = 0x12345678;
+  const random = (limit) => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  };
+  for (const length of [1, 2, 3, 7, 8, 17, 32, 65]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 400; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      // Leave several updates pending, including nested and whole-tree tags.
+      if (step % 7 === 0) { l = 0; r = length; }
+      const value = random(41) - 20;
+      if (random(2) === 0) {
+        assert.equal(tree.assign(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] = value;
+      } else {
+        assert.equal(tree.add(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] += value;
+      }
+      if (step % 5 !== 0) continue;
+      const lo = random(length + 1);
+      const threshold = random(81) - 40;
+      assert.equal(tree.firstAtLeast(lo, threshold),
+        values.findIndex((value, i) => i >= lo && value >= threshold));
+      const ql = random(length + 1);
+      const qr = ql + random(length - ql + 1);
+      const slice = values.slice(ql, qr);
+      assert.equal(tree.sum(ql, qr), slice.reduce((sum, value) => sum + value, 0));
+      assert.equal(tree.max(ql, qr), Math.max(...slice));
+      const index = random(length);
+      assert.equal(tree.get(index), values[index]);
+      if (step % 25 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+    for (let l = 0; l <= length; l++) {
+      for (let r = l; r <= length; r++) {
+        const slice = values.slice(l, r);
+        assert.equal(tree.sum(l, r), slice.reduce((sum, value) => sum + value, 0));
+        assert.equal(tree.max(l, r), Math.max(...slice));
+      }
+      for (const threshold of [-Infinity, -30, 0, 30, Infinity]) {
+        assert.equal(tree.firstAtLeast(l, threshold),
+          values.findIndex((value, i) => i >= l && value >= threshold));
+      }
+    }
+  }
+});
+
+test('validation, empty ranges, and array independence preserve the API', () => {
+  for (const values of [[], null, '123', [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1.5, -2.25, 3.75];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  const output = tree.toArray();
+  output[1] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  tree.add(0, 3, 0.5);
+  tree.assign(1, 2, -1.5);
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '2', undefined]) {
+    assert.throws(() => tree.assign(0, 3, value), RangeError);
+    assert.throws(() => tree.add(0, 3, value), RangeError);
+    assert.throws(() => tree.assign(1, 1, value), RangeError);
+    assert.throws(() => tree.add(1, 1, value), RangeError);
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (const i of [0, 1, 3]) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.equal(tree.sum(0, 3), 4.75);
+  assert.equal(tree.max(0, 3), 4.25);
+  assert.deepEqual(tree.toArray(), [2, -1.5, 4.25]);
+});
