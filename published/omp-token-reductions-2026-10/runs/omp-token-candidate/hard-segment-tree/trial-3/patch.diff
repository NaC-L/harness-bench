+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard older additions at parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 8, 5);
+  tree.assign(0, 4, -3);
+  tree.add(0, 8, 2);
+  tree.assign(2, 8, -7);
+  tree.add(1, 7, 4);
+  assert.equal(tree.sum(1, 6), -9);
+  assert.deepEqual(tree.toArray(), [-1, 3, -3, -3, -3, -3, -3, -7]);
+
+  tree.add(0, 4, 20);
+  tree.assign(0, 8, 5);
+  tree.add(0, 8, -2);
+  assert.equal(tree.get(1), 3);
+  assert.deepEqual(tree.toArray(), Array(8).fill(3));
+});
+
+test('partial maxima use the correct identity for negative values', () => {
+  const tree = new RangeTree([-9, -4, -7, -12, -6]);
+  assert.equal(tree.max(0, 2), -4);
+  assert.equal(tree.max(2, 5), -6);
+  assert.equal(tree.max(3, 4), -12);
+  tree.assign(0, 5, -8);
+  tree.add(1, 4, -3);
+  assert.equal(tree.max(1, 4), -11);
+  assert.equal(tree.max(2, 5), -8);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold search propagates updates before examining descendants', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0]);
+  tree.assign(0, 5, 8);
+  assert.equal(tree.firstAtLeast(2, 8), 2);
+  tree.add(0, 5, -6);
+  assert.equal(tree.firstAtLeast(1, 3), -1);
+  assert.equal(tree.firstAtLeast(3, 2), 3);
+  tree.assign(0, 3, -9);
+  tree.add(0, 5, 4);
+  assert.equal(tree.firstAtLeast(0, 6), 3);
+  assert.equal(tree.firstAtLeast(4, 6), 4);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('mixed pending updates and queries agree with an array oracle', () => {
+  let state = 0x5eed1234;
+  const random = (bound) => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % bound;
+  };
+
+  for (const length of [1, 2, 3, 7, 8, 19, 32]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    const checkSearch = (lo, threshold) => {
+      assert.equal(tree.firstAtLeast(lo, threshold),
+        values.findIndex((value, index) => index >= lo && value >= threshold));
+    };
+    const checkRange = (l, r) => {
+      const range = values.slice(l, r);
+      assert.equal(tree.sum(l, r), range.reduce((sum, value) => sum + value, 0));
+      assert.equal(tree.max(l, r), Math.max(...range));
+    };
+    const checkAll = () => {
+      // Search first: materializing the tree must not hide stale search tags.
+      for (let lo = 0; lo <= length; lo++) {
+        for (const threshold of [-Infinity, -25, 0, 25, Infinity]) {
+          checkSearch(lo, threshold);
+        }
+      }
+      for (let l = 0; l <= length; l++) {
+        for (let r = l; r <= length; r++) checkRange(l, r);
+      }
+      for (let i = 0; i < length; i++) assert.equal(tree.get(i), values[i]);
+      assert.deepEqual(tree.toArray(), values);
+    };
+
+    for (let step = 0; step < 400; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      const value = random(61) - 30;
+      const operation = random(10);
+      if (operation < 7) {
+        const assigning = operation < 3;
+        assert.equal(assigning ? tree.assign(l, r, value) : tree.add(l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      } else if (operation === 7) {
+        checkRange(l, r);
+      } else if (operation === 8) {
+        checkSearch(l, value);
+      } else {
+        const index = random(length);
+        assert.equal(tree.get(index), values[index]);
+      }
+      if (step % 37 === 36) checkAll();
+    }
+    checkAll();
+  }
+});
+
+test('invalid and empty updates preserve pending values and arrays remain independent', () => {
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.get(0), 1);
+  tree.add(0, 3, 4);
+  for (const method of ['assign', 'add']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN]]) {
+      assert.throws(() => tree[method](l, r, 7), RangeError);
+    }
+    for (const value of [NaN, Infinity, -Infinity, '7', undefined]) {
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+    }
+    assert.equal(tree[method](0, 0, 7), undefined);
+    assert.equal(tree[method](3, 3, 7), undefined);
+  }
+  assert.equal(tree.sum(3, 3), 0);
+  assert.equal(tree.max(0, 0), -Infinity);
+  assert.deepEqual(tree.toArray(), [5, 6, 7]);
+  const output = tree.toArray();
+  output[1] = 99;
+  assert.equal(tree.get(1), 6);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 9; }, TypeError);
+});
