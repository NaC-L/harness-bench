@@ -0,0 +1,24 @@
+'use strict';
+
+// Deep copy of JSON-compatible data. Uses defineProperty so keys such as
+// '__proto__' stay ordinary own data properties.
+function cloneJson(value) {
+  if (value === null || typeof value !== 'object') return value;
+  if (Array.isArray(value)) return value.map(cloneJson);
+  const out = {};
+  for (const key of Object.keys(value)) {
+    Object.defineProperty(out, key, {
+      value: cloneJson(value[key]),
+      writable: true,
+      enumerable: true,
+      configurable: true,
+    });
+  }
+  return out;
+}
+
+function cloneEntry(entry) {
+  return { lsn: entry.lsn, key: entry.key, value: cloneJson(entry.value) };
+}
+
+module.exports = { cloneJson, cloneEntry };
