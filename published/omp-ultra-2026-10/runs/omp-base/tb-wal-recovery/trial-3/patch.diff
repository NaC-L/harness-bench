+'use strict';
+
+// Deep copy of JSON-compatible data. Own keys (including '__proto__') are
+// defined as ordinary data properties, never prototype operations.
+function deepClone(value) {
+  if (Array.isArray(value)) return value.map(deepClone);
+  if (value !== null && typeof value === 'object') {
+    const out = {};
+    for (const key of Object.keys(value)) defineData(out, key, deepClone(value[key]));
+    return out;
+  }
+  return value;
+}
+
+function defineData(target, key, value) {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function cloneEntry(entry) {
+  return { lsn: entry.lsn, key: entry.key, value: deepClone(entry.value) };
+}
+
+module.exports = { deepClone, defineData, cloneEntry };
