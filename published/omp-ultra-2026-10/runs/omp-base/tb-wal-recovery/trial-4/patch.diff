@@ -0,0 +1,24 @@
+'use strict';
+
+// Deep copy of JSON-compatible data. Object keys (including '__proto__') are
+// defined as own data properties, never treated as prototype operations.
+function cloneValue(value) {
+  if (value === null || typeof value !== 'object') return value;
+  if (Array.isArray(value)) return value.map(cloneValue);
+  const out = {};
+  for (const key of Object.keys(value)) {
+    Object.defineProperty(out, key, {
+      value: cloneValue(value[key]),
+      writable: true,
+      enumerable: true,
+      configurable: true,
+    });
+  }
+  return out;
+}
+
+function cloneEntry(entry) {
+  return { lsn: entry.lsn, key: entry.key, value: cloneValue(entry.value) };
+}
+
+module.exports = { cloneValue, cloneEntry };
