+'use strict';
+
+// Sets an own enumerable data property; '__proto__' stays an ordinary key.
+function defineData(target, key, value) {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+// Deep copy of JSON-compatible data (null, booleans, numbers, strings, arrays, plain objects).
+function cloneValue(value) {
+  if (value === null || typeof value !== 'object') return value;
+  if (Array.isArray(value)) return value.map(cloneValue);
+  const out = {};
+  for (const key of Object.keys(value)) defineData(out, key, cloneValue(value[key]));
+  return out;
+}
+
+function cloneEntry(entry) {
+  return { lsn: entry.lsn, key: entry.key, value: cloneValue(entry.value) };
+}
+
+module.exports = { cloneValue, cloneEntry, defineData };
