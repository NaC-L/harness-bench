@@ -0,0 +1,24 @@
+'use strict';
+
+// Deep copy of JSON-compatible data. Own keys (including '__proto__') are
+// copied as ordinary data properties onto fresh plain objects.
+function deepClone(value) {
+  if (value === null || typeof value !== 'object') return value;
+  if (Array.isArray(value)) return value.map(deepClone);
+  const out = {};
+  for (const key of Object.keys(value)) {
+    Object.defineProperty(out, key, {
+      value: deepClone(value[key]),
+      enumerable: true,
+      writable: true,
+      configurable: true,
+    });
+  }
+  return out;
+}
+
+function cloneEntry(entry) {
+  return { lsn: entry.lsn, key: entry.key, value: deepClone(entry.value) };
+}
+
+module.exports = { deepClone, cloneEntry };
