+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('../src');
+const { compare, satisfies } = require('../src/semver');
+
+test('versions are ordered numerically across all three components', () => {
+  for (const [older, newer] of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    assert.deepEqual(resolve({ pkg: { [older]: {}, [newer]: {} } }, { pkg: '*' }), { pkg: newer });
+  }
+});
+
+test('FIFO first-found selection collects root and dependency constraints immediately', () => {
+  const registry = {
+    app: { '2.0.0': { shared: '1.0.0' }, '1.0.0': { shared: '2.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { app: '*', shared: '*' }), { app: '2.0.0', shared: '1.0.0' });
+  assert.deepEqual(resolve(registry, { shared: '*', app: '*' }), { shared: '2.0.0', app: '1.0.0' });
+  assert.deepEqual(resolve(registry, { app: '*', shared: '2.0.0' }), { app: '1.0.0', shared: '2.0.0' });
+
+  const pending = {
+    app: { '2.0.0': { left: '*', right: '1.0.0' } },
+    left: { '2.0.0': { right: '2.0.0' }, '1.0.0': {} },
+    right: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(pending, { app: '*' }), { app: '2.0.0', left: '1.0.0', right: '1.0.0' });
+});
+
+test('dependency key order, not catalog order, determines the first solution', () => {
+  const registry = {
+    shared: { '2.0.0': {}, '1.0.0': {} },
+    right: { '2.0.0': { shared: '2.0.0' }, '1.0.0': { shared: '1.0.0' } },
+    left: { '2.0.0': { shared: '1.0.0' }, '1.0.0': { shared: '2.0.0' } },
+    app: { '1.0.0': { left: '*', right: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { app: '*' }), {
+    app: '1.0.0', left: '2.0.0', right: '1.0.0', shared: '1.0.0',
+  });
+  registry.app['1.0.0'] = { right: '*', left: '*' };
+  assert.deepEqual(resolve(registry, { app: '*' }), {
+    app: '1.0.0', right: '2.0.0', left: '1.0.0', shared: '2.0.0',
+  });
+});
+
+test('backtracking removes abandoned dependencies, constraints, and descendant selections', () => {
+  const registry = {
+    app: { '2.0.0': { leaf: '2.0.0', missing: '*' }, '1.0.0': { leaf: '1.0.0' } },
+    leaf: { '2.0.0': { abandoned: '*' }, '1.0.0': {} },
+    abandoned: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { app: '*' }), { app: '1.0.0', leaf: '1.0.0' });
+});
+
+test('an immediate conflict undoes even partially appended dependencies and retries the latest choice', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { orphan: '*', a: '1.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*', c: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('cycles and duplicate discoveries select and expand each package only once', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  assert.deepEqual(resolve({ a: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '1.0.0' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('missing packages, empty catalogs, and conflicting requirements are unsatisfiable', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ empty: {} }, { empty: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '2.0.0' }), null);
+  assert.equal(resolve({ a: { '1.0.0': { b: '1.0.0' } }, b: { '2.0.0': {} } }, { a: '*' }), null);
+  assert.deepEqual(resolve({ a: { '2.0.0': { missing: '*' }, '1.0.0': {} } }, { a: '*' }), { a: '1.0.0' });
+  assert.deepEqual(resolve({ unreachable: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('all maps, versions, and ranges are validated, even for unreachable entries and empty roots', () => {
+  for (const bad of [null, [], 1, 'map', new Date(), Object.create({ inherited: true })]) {
+    assert.throws(() => resolve(bad, {}), TypeError);
+    assert.throws(() => resolve({}, bad), TypeError);
+    assert.throws(() => resolve({ unused: bad }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': bad } }, {}), TypeError);
+  }
+  for (const version of ['01.0.0', '1.0', '1.0.0\n', '1.0.0-beta', '9007199254740992.0.0']) {
+    assert.throws(() => resolve({ unused: { [version]: {} } }, {}), TypeError);
+  }
+  for (const range of ['', null, '^', '>= 1.0.0', '1.0.0 || 2.0.0', '1.x']) {
+    assert.throws(() => resolve({ unused: { '1.0.0': { missing: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { missing: range }), TypeError);
+  }
+});
+
+test('null-prototype maps and special names are safe, and inputs are not mutated', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.freeze({ '1.0.0': Object.freeze({}) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'hidden', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(root, 'hidden', { value: null });
+  root[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+  assert.equal(root.__proto__, '*');
+  assert.deepEqual(Object.keys(registry.__proto__), ['1.0.0']);
+});
+
+test('long cyclic chains use neither recursive stack depth nor an arbitrary iteration limit', () => {
+  const count = 16000;
+  const registry = {};
+  for (let i = 0; i < count; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % count}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, count);
+  assert.equal(result[`p${count - 1}`], '1.0.0');
+  registry[`p${count - 1}`]['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('discovered conflicts are checked before exploring the remaining Cartesian product', { timeout: 3000 }, () => {
+  const registry = {};
+  const root = {};
+  for (let i = 0; i < 80; i += 1) {
+    registry[`p${i}`] = { '2.0.0': { [`p${i}`]: '1.0.0' }, '1.0.0': {} };
+    root[`p${i}`] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.keys(result).length, 80);
+  assert.ok(Object.values(result).every(version => version === '1.0.0'));
+});
+
+// Independent, copying reference search for small registries. Production search
+// must use a reversible trail; this oracle intentionally does not share it.
+function referenceResolve(registry, root) {
+  function search(selected, constraints, queue, cursor) {
+    if (cursor === queue.length) return Object.fromEntries(selected);
+    const name = queue[cursor];
+    if (selected.has(name)) return search(selected, constraints, queue, cursor + 1);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints.get(name).every(range => satisfies(version, range))) continue;
+      const nextSelected = new Map(selected).set(name, version);
+      const nextConstraints = new Map([...constraints].map(([key, ranges]) => [key, ranges.slice()]));
+      const nextQueue = queue.slice();
+      let conflict = false;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        if (!nextConstraints.has(dependency)) nextConstraints.set(dependency, []);
+        nextConstraints.get(dependency).push(range);
+        nextQueue.push(dependency);
+        if (nextSelected.has(dependency) && !satisfies(nextSelected.get(dependency), range)) {
+          conflict = true;
+          break;
+        }
+      }
+      if (conflict) continue;
+      const result = search(nextSelected, nextConstraints, nextQueue, cursor + 1);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(new Map(), new Map(Object.entries(root).map(([name, range]) => [name, [range]])), Object.keys(root), 0);
+}
+
+test('seeded small cyclic registries match the independent first-found reference search', () => {
+  let seed = 0x12345678;
+  function pick(count) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 8) % count;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=1.0.0 <2.0.0'];
+  for (let run = 0; run < 400; run += 1) {
+    const registry = {};
+    const root = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0']) {
+        const deps = {};
+        for (const dependency of [...names, 'missing']) {
+          if (pick(5) === 0) deps[dependency] = ranges[pick(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+      if (pick(2) === 0) root[name] = ranges[pick(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `registry ${run}`);
+  }
+});
