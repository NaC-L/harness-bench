+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+
+test('semver uses numeric components and canonical, safe versions', () => {
+  assert.deepEqual(parse('12.34.56'), [12, 34, 56]);
+  assert.equal(compare('1.10.0', '1.9.99'), 1);
+  assert.equal(compare('10.0.0', '9.99.99'), 1);
+  assert.equal(compare('1.2.10', '1.2.9'), 1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+  assert.equal(compare('0.0.0', '0.0.1'), -1);
+  assert.deepEqual(parse('9007199254740991.0.0'), [Number.MAX_SAFE_INTEGER, 0, 0]);
+  for (const version of [null, 123, '', '1.2', '01.2.3', '1.02.3', '1.2.03',
+    '-1.2.3', '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3\n', '1.2.3\r',
+    '1.2.3\u2028', '9007199254740992.0.0']) {
+    assert.throws(() => parse(version), TypeError, String(version));
+    assert.throws(() => compare('1.0.0', version), TypeError);
+    assert.throws(() => satisfies(version, '*'), TypeError);
+  }
+});
+
+test('all range operators, AND terms, and zero-major caret boundaries', () => {
+  const cases = [
+    ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false],
+    ['0.0.0', '*', true], ['1.2.3', '>=1.2.3', true],
+    ['1.2.3', '>1.2.3', false], ['1.2.4', '>1.2.3', true],
+    ['1.2.3', '<=1.2.3', true], ['1.2.4', '<=1.2.3', false],
+    ['1.2.2', '<1.2.3', true], ['1.2.3', '<1.2.3', false],
+    ['1.2.3', '^1.2.3', true], ['1.9.0', '^1.2.3', true],
+    ['1.2.2', '^1.2.3', false], ['2.0.0', '^1.2.3', false],
+    ['0.2.3', '^0.2.3', true], ['0.2.9', '^0.2.3', true],
+    ['0.2.2', '^0.2.3', false], ['0.3.0', '^0.2.3', false],
+    ['0.0.3', '^0.0.3', true], ['0.0.2', '^0.0.3', false],
+    ['0.0.4', '^0.0.3', false], ['0.0.0', '^0.0.0', true],
+    ['0.0.1', '^0.0.0', false], ['1.2.9', '~1.2.3', true],
+    ['1.3.0', '~1.2.3', false], ['0.0.9', '~0.0.3', true],
+    ['0.1.0', '~0.0.3', false],
+    ['1.5.0', ' \t>=1.0.0\n<2.0.0 * ', true],
+    ['2.0.0', '>=1.0.0 <2.0.0', false],
+    ['1.0.0', '>2.0.0 <1.0.0', false],
+    ['9007199254740991.0.0', '^9007199254740991.0.0', true],
+    ['0.9007199254740991.0', '^0.9007199254740991.0', true],
+    ['0.0.9007199254740991', '^0.0.9007199254740991', true],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected);
+  }
+  for (const range of [null, 1, '', ' \n ', '^', '~', '>=', '1.2', '=1.2.3',
+    '>= 1.2.3', '1.2.3 || 2.0.0', '1.x', '^01.2.3', '* nonsense']) {
+    assert.throws(() => compileRange(range), TypeError, String(range));
+    assert.throws(() => satisfies('1.2.3', range), TypeError);
+  }
+});
+
+test('resolver orders every version component numerically', () => {
+  const registry = { a: { '9.99.99': {}, '10.0.0': {} },
+    b: { '1.9.99': {}, '1.10.0': {} }, c: { '1.2.9': {}, '1.2.10': {} } };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*', c: '*' }),
+    { a: '10.0.0', b: '1.10.0', c: '1.2.10' });
+  assert.deepEqual(resolve({ a: { '0.2.3': {}, '0.3.0': {} } }, { a: '^0.2.3' }),
+    { a: '0.2.3' });
+});
+
+test('FIFO discovery and first-found selection follow root and dependency key order', () => {
+  const registry = {
+    x: { '2.0.0': { y: '1.0.0' }, '1.0.0': { y: '2.0.0' } },
+    y: { '2.0.0': { x: '1.0.0' }, '1.0.0': { x: '2.0.0' } },
+    parent: { '1.0.0': { y: '*', x: '*' } },
+  };
+  assert.deepEqual(resolve(registry, { x: '*', y: '*' }), { x: '2.0.0', y: '1.0.0' });
+  assert.deepEqual(resolve(registry, { y: '*', x: '*' }), { y: '2.0.0', x: '1.0.0' });
+  assert.deepEqual(resolve(registry, { parent: '*' }),
+    { parent: '1.0.0', y: '2.0.0', x: '1.0.0' });
+});
+
+test('discovery collects constraints before processing later queued requirements', () => {
+  const registry = {
+    a: { '1.0.0': { b: '*', c: '1.0.0' } },
+    b: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }),
+    { a: '1.0.0', b: '1.0.0', c: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', c: '1.0.0' }),
+    { b: '1.0.0', c: '1.0.0' });
+});
+
+test('backtracking removes failed dependencies, constraints, and downstream selections', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0', abandoned: '*' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': { leaf: '*' } },
+    leaf: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '2.0.0' });
+  assert.deepEqual(resolve({ a: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} } },
+    { a: '*' }), { a: '1.0.0' });
+});
+
+test('a discovered selected-package conflict retries the most recent choice', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('cycles terminate, and missing or contradictory reachable packages are unsatisfiable', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  assert.deepEqual(resolve({ a: { '1.0.0': { b: '*' } }, b: { '1.0.0': { a: '*' } } },
+    { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': { a: '>1.0.0' } } }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': { b: '*' } } }, { a: '*' }), null);
+});
+
+test('validation is eager even for empty roots and unreachable entries', () => {
+  const badRegistries = [null, [], new Date(), Object.create({}),
+    { unused: null }, { unused: [] }, { unused: { bad: {} } },
+    { unused: { '1.0.0': null } }, { unused: { '1.0.0': [] } },
+    { unused: { '1.0.0': { bad: '^' } } }];
+  for (const registry of badRegistries) assert.throws(() => resolve(registry, {}), TypeError);
+  for (const root of [null, [], new Date(), Object.create({}), { a: '' }, { a: 1 }]) {
+    assert.throws(() => resolve({}, root), TypeError);
+  }
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('only own enumerable string keys participate; special names are safe and inputs untouched', () => {
+  const deps = Object.create(null);
+  deps.constructor = '*';
+  const registry = Object.create(null);
+  registry.__proto__ = Object.freeze({ '1.0.0': Object.freeze(deps) });
+  registry.constructor = Object.freeze({ '1.0.0': Object.freeze({}) });
+  Object.defineProperty(registry, 'hidden', { value: null });
+  registry[Symbol('ignored')] = null;
+  const root = Object.create(null);
+  root.__proto__ = '*';
+  Object.defineProperty(root, 'hidden', { value: 'invalid' });
+  root[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.deepEqual(result, JSON.parse('{"__proto__":"1.0.0","constructor":"1.0.0"}'));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(registry.__proto__['1.0.0'], deps);
+  assert.equal(root.__proto__, '*');
+});
+
+test('long chains and cyclic tails do not depend on call-stack depth or an iteration limit', () => {
+  const length = 20000;
+  const registry = {};
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % length}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length);
+  assert.equal(result[`p${length - 1}`], '1.0.0');
+  registry[`p${length - 1}`]['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('already discovered conflicts prune choices before enumerating a Cartesian product', () => {
+  const registry = {};
+  const root = {};
+  const expected = {};
+  for (let i = 0; i < 60; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { [name]: '1.0.0' }, '1.0.0': {} };
+    root[name] = '*';
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+// A small, deliberately copy-based reference search checks ordering as well as
+// satisfiability. Its recursion is bounded by the tiny generated registries.
+function referenceResolve(registry, root) {
+  function search(selected, constraints, pending) {
+    for (const [name, version] of selected) {
+      if (!constraints.get(name).every(range => satisfies(version, range))) return null;
+    }
+    if (pending.length === 0) return Object.fromEntries(selected);
+    const [name, ...rest] = pending;
+    if (selected.has(name)) return search(selected, constraints, rest);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints.get(name).every(range => satisfies(version, range))) continue;
+      const nextSelected = new Map(selected).set(name, version);
+      const nextConstraints = new Map([...constraints].map(([key, ranges]) => [key, [...ranges]]));
+      const nextPending = [...rest];
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        if (!nextConstraints.has(dependency)) nextConstraints.set(dependency, []);
+        nextConstraints.get(dependency).push(range);
+        nextPending.push(dependency);
+      }
+      const result = search(nextSelected, nextConstraints, nextPending);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(new Map(), new Map(Object.entries(root).map(([name, range]) => [name, [range]])),
+    Object.keys(root));
+}
+
+test('generated cyclic registries match an independent first-found reference search', () => {
+  let seed = 1732;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=1.0.0 <2.0.0', '>2.0.0'];
+  for (let sample = 0; sample < 300; sample += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        const deps = {};
+        for (let i = 0, count = random(4); i < count; i += 1) {
+          const dependency = [...names, 'missing'][random(5)];
+          deps[dependency] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = { [names[random(names.length)]]: '*' };
+    if (random(2)) root[names[random(names.length)]] = ranges[random(ranges.length)];
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root),
+      `sample ${sample}: ${JSON.stringify({ registry, root })}`);
+  }
+});
