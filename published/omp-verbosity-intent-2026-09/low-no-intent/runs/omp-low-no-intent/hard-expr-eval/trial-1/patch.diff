+++ "{temp}\\hb-f3f06992-9v41k80_/regression.test.js"
@@ -0,0 +1,130 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function expectError(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('literal syntax, arithmetic precedence and associativity', () => {
+  const cases = [
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+    ['20 - 6 - 4', 10],
+    ['24 / 3 * 2 // 3 % 4', 1],
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['3 * -2 ** 2 + +4', -8],
+    ['--2 ** 2', 4],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division, divisor-signed modulo and positive zero', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -8; b <= 8; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate(`${a} // ${b}`);
+      const remainder = evaluate(`${a} % ${b}`);
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+      else assert.equal(Object.is(remainder, -0), false);
+    }
+  }
+  assert.equal(evaluate('-5.5 // 2'), -3);
+  assert.equal(evaluate('-5.5 % 2'), 0.5);
+  assert.equal(evaluate('5.5 % -2'), -0.5);
+  assert.equal(Object.is(evaluate('0 // -3'), -0), false);
+  assert.equal(Object.is(evaluate('-6 % 3'), -0), false);
+});
+
+test('comparisons chain and boolean operands act as numbers', () => {
+  const cases = [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 == 2 != 3 < 4', true],
+    ['3 > 2 >= 2', true],
+    ['1 + 2 < 2 * 2', true],
+    ['(1 < 2) + (2 < 1)', 1],
+    ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true],
+    ['1 == (2 < 3) == 1', true],
+    ['(2 < 1) ** (1 < 2)', 0],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('getters run once per occurrence, left to right, with short-circuiting', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 4 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, { get() { reads.push(name); return value; } });
+  }
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  assert.equal(evaluate('c < b < a + missing', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('c < b < 1 / 0', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('a + a * b', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'a', 'b']);
+  assert.equal(evaluate('max(a, min(b, c), abs(-a))', variables), 2);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'a']);
+  expectError('inherited', 1, variables);
+  assert.deepEqual(reads, []);
+});
+
+test('errors point to tokens after whitespace and EOF includes trailing whitespace', () => {
+  for (const operator of ['/', '//', '%']) {
+    const source = `  1   ${operator} -0`;
+    expectError(source, source.indexOf(operator) + 1);
+  }
+  expectError(' \t missing', 4);
+  expectError('  1 + \t @', 9);
+  expectError('  1 + \t 💰', 9);
+  expectError('  1  2', 6);
+  expectError('  1 +   ', 9);
+  expectError(' \t ', 4);
+  expectError('  (1 + 2   ', 12);
+  expectError('min(1,  )', 9);
+  expectError('abs(1, 2)', 1);
+  expectError('  min()', 3);
+  expectError('  max()', 3);
+  expectError('  abs()', 3);
+  expectError('  nope(1)', 3);
+  expectError('1 = 1', 3);
+  expectError('1 ! 1', 3);
+});
+
+test('parse the whole formula and validate calls before reading any variables', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['a + abs(1, 2)', 5],
+    ['a + nope(1)', 5],
+    ['a > 2 < min()', 9],
+    ['a > 2 < (3 + )', 14],
+    ['a + 1 @', 7],
+    ['a + 1 2', 7],
+  ]) expectError(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('long flat arithmetic, comparison and call argument chains avoid recursion', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join(' + ')), count);
+  assert.equal(evaluate(Array(count).fill('1').join(' * ')), 1);
+  assert.equal(evaluate(Array.from({ length: count }, (_, i) => i).join(' < ')), true);
+  assert.equal(evaluate(`min(${Array(count).fill('1').join(',')})`), 1);
+  const source = `2 < 1 < ${Array(count).fill('missing').join(' < ')}`;
+  assert.equal(evaluate(source), false);
+});
