@@ -0,0 +1,188 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+const { splitLines, joinLines } = require('./lines');
+
+// A small independent oracle, used only for tiny test inputs.
+function editDistance(a, b) {
+  let previous = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 1; i <= a.length; i++) {
+    const current = [i];
+    for (let j = 1; j <= b.length; j++) {
+      current[j] = a[i - 1] === b[j - 1]
+        ? previous[j - 1]
+        : Math.min(previous[j], current[j - 1]) + 1;
+    }
+    previous = current;
+  }
+  return previous[b.length];
+}
+
+function checkPair(a, b) {
+  Object.freeze(a);
+  Object.freeze(b);
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, editDistance(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  for (const context of [0, 1, 2, 3, 20]) {
+    const hunks = unifiedHunks(a, b, { context });
+    for (const hunk of hunks) {
+      assert.equal(hunk.oldLines, hunk.lines.filter(l => l[0] !== '+').length);
+      assert.equal(hunk.newLines, hunk.lines.filter(l => l[0] !== '-').length);
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+    }
+    Object.freeze(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+}
+
+test('exhaustive minimal scripts and roundtrips for repeated/empty lines', () => {
+  const inputs = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'x'].map(line => [...lines, line]));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) checkPair([...a], [...b]);
+  }
+});
+
+test('seeded minimal scripts and patch roundtrips with literal prefixes', () => {
+  let seed = 123456789;
+  const random = max => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % max;
+  };
+  const alphabet = ['', 'same', 'other', '+literal', '-literal', ' literal', '\r'];
+  for (let i = 0; i < 300; i++) {
+    const a = Array.from({ length: random(13) }, () => alphabet[random(alphabet.length)]);
+    const b = Array.from({ length: random(13) }, () => alphabet[random(alphabet.length)]);
+    checkPair(a, b);
+  }
+  const a = splitLines('header\r\n-old\n');
+  const b = splitLines('header\r\n+new\n\n');
+  assert.equal(joinLines(applyHunks(a, unifiedHunks(a, b))), joinLines(b));
+});
+
+test('zero-line ranges use preceding line coordinates at top and bottom', () => {
+  const cases = [
+    [[], ['x'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['x'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a'], ['x', 'a'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a'], ['a', 'x'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['x', 'a'], ['a'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x'], ['a'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, expected] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [expected]);
+    assert.deepEqual(applyHunks(a, [expected]), b);
+  }
+});
+
+test('context touching merges, while larger gaps produce separate hunks', () => {
+  const a = ['before', 'old1', 'gap1', 'gap2', 'old2', 'after'];
+  const b = ['before', 'new1', 'gap1', 'gap2', 'new2', 'after'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' before', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' after'],
+  }]);
+  a.splice(4, 0, 'gap3');
+  b.splice(4, 0, 'gap3');
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+      lines: [' before', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+      lines: [' gap3', '-old2', '+new2', ' after'] },
+  ]);
+  assert.equal(unifiedHunks(a, b, { context: 0 }).length, 2);
+});
+
+test('multiple hunks use complete-file coordinates and preserve unmentioned lines', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd', 'e', 'f']);
+  const b = ['top', 'a', 'b', 'new1', 'new2', 'd', 'e', 'last'];
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 3, oldLines: 1, newStart: 4, newLines: 2, lines: ['-c', '+new1', '+new2'] },
+    { oldStart: 6, oldLines: 1, newStart: 8, newLines: 1, lines: ['-f', '+last'] },
+  ];
+  assert.deepEqual(unifiedHunks(a, b, { context: 0 }), hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(unifiedHunks(a, a), []);
+});
+
+test('malformed, mismatching, overlapping and unordered hunks are rejected', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {},
+    { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 5 },
+    { ...valid, oldStart: 1.5 },
+    { ...valid, oldLines: -1 },
+    { ...valid, oldLines: 4 },
+    { ...valid, oldLines: 0 },
+    { ...valid, newStart: 0 },
+    { ...valid, newStart: 1 },
+    { ...valid, newStart: NaN },
+    { ...valid, newLines: -1 },
+    { ...valid, newLines: 2 },
+    { ...valid, newLines: Infinity },
+    { ...valid, lines: null },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] },
+    { ...valid, lines: [2] },
+    { ...valid, lines: ['+B'] },
+    { ...valid, lines: ['-b'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const earlier = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] };
+  assert.throws(() => applyHunks(a, [valid, earlier]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+  assert.deepEqual(a, ['a', 'b', 'c']);
+});
+
+test('invalid context is rejected', () => {
+  for (const context of [-1, 0.5, NaN, Infinity, '1', null]) {
+    assert.throws(() => unifiedHunks([], [], { context }), RangeError);
+  }
+});
+
+test('small edits on 20,000 unique and repetitive lines stay below a second', () => {
+  for (const repeated of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repeated ? 'same' : `line ${i}`);
+    const b = [...a];
+    b.splice(19990, 1, 'replacement');
+    b.splice(10000, 0, 'insertion');
+    b.splice(5, 1);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const patched = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+    assert.deepEqual(patched, b);
+    assert.ok(elapsed < 1000, `small-edit diff and roundtrip took ${elapsed.toFixed(1)}ms`);
+  }
+});
