+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small quadratic oracle belongs only in tests, never in the implementation.
+function lcsLength(a, b) {
+  const row = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const previous = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = previous;
+    }
+  }
+  return row[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('minimal deterministic scripts and patch roundtrips for all short repetitive inputs', () => {
+  const inputs = [Object.freeze([])];
+  for (let length = 1; length <= 4; length++) {
+    for (let bits = 0; bits < 2 ** length; bits++) {
+      inputs.push(Object.freeze(Array.from({ length }, (_, i) => bits & (1 << i) ? 'x' : '')));
+    }
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      checkScript(a, b);
+      for (let context = 0; context <= 3; context++) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+      }
+    }
+  }
+});
+
+test('seeded larger repetitive inputs match the minimality oracle and roundtrip', () => {
+  let seed = 123456;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  const alphabet = ['', 'same', '+plus', '-minus', ' space'];
+  for (let trial = 0; trial < 250; trial++) {
+    const a = Object.freeze(Array.from({ length: random(40) }, () => alphabet[random(alphabet.length)]));
+    const b = Object.freeze(Array.from({ length: random(40) }, () => alphabet[random(alphabet.length)]));
+    checkScript(a, b);
+    for (const context of [0, 1, 3, 10]) {
+      assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context })), b);
+    }
+  }
+});
+
+test('zero-length ranges use preceding line coordinates at top, middle and end', () => {
+  const a = ['a', 'b'];
+  for (let position = 0; position <= a.length; position++) {
+    const b = a.slice();
+    b.splice(position, 0, 'added');
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [{
+      oldStart: position, oldLines: 0, newStart: position + 1, newLines: 1,
+      lines: ['+added'],
+    }]);
+    assert.deepEqual(unifiedHunks(b, a, { context: 0 }), [{
+      oldStart: position + 1, oldLines: 1, newStart: position, newLines: 0,
+      lines: ['-added'],
+    }]);
+  }
+  assert.deepEqual(unifiedHunks([], [''], { context: 0 }), [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+'],
+  }]);
+});
+
+test('touching context merges, larger gaps split, and coordinates remain global', () => {
+  for (const gap of [3, 4, 5]) {
+    const a = ['head', 'old1', ...Array.from({ length: gap }, (_, i) => `gap${i}`), 'old2', 'tail'];
+    const b = a.map(line => line.replace('old', 'new'));
+    const hunks = unifiedHunks(a, b, { context: 2 });
+    assert.equal(hunks.length, gap <= 4 ? 1 : 2);
+    if (gap <= 4) {
+      assert.deepEqual(hunks[0], {
+        oldStart: 1, oldLines: a.length, newStart: 1, newLines: b.length,
+        lines: [' head', '-old1', '+new1',
+          ...a.slice(2, -2).map(line => ` ${line}`), '-old2', '+new2', ' tail'],
+      });
+    } else {
+      assert.equal(hunks[1].oldStart, 6);
+      assert.equal(hunks[1].newStart, 6);
+    }
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+  const a = ['a', 'b', 'c', 'd', 'e'];
+  const b = ['top', 'a', 'b', 'c', 'e', 'bottom'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks.map(h => [h.oldStart, h.newStart]), [[0, 1], [4, 4], [5, 6]]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+});
+
+test('prefix characters, empty strings and retained original lines apply exactly', () => {
+  const a = Object.freeze(['', ' leading', '-minus', '+plus', 'last']);
+  const b = Object.freeze(['', '+replacement', '-minus', ' leading', 'last', '']);
+  const hunks = unifiedHunks(a, b);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  assert.deepEqual(applyHunks(a, [{
+    oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['- leading', '++changed'],
+  }]), ['', '+changed', '-minus', '+plus', 'last']);
+});
+
+test('malformed, mismatched, overlapping and out-of-order hunks identify their index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const malformed = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: [null] }, { ...valid, lines: [''] },
+    { ...valid, lines: ['-wrong', '+B'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: Infinity }, { ...valid, oldLines: '1' },
+    { ...valid, oldLines: 0 }, { ...valid, oldLines: 2 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: 2 },
+    { ...valid, newStart: 3 }, { ...valid, oldStart: 4, newStart: 4 },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of malformed) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 3, oldLines: 1, newStart: 4, newLines: 1, lines: [' c'],
+  }]), /hunk 1 does not apply/);
+});
+
+test('small edits to 20,000-line files stay fast and roundtrip', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? `line${i % 5}` : `line${i}`);
+    const b = a.slice();
+    b.splice(19000, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(20, 0, 'insertion');
+    const start = performance.now();
+    const hunks = unifiedHunks(a, b);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    const identical = diffLines(a, a);
+    assert.equal(identical.length, a.length);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'unique'} 20,000-line roundtrip and identical diff: ${(performance.now() - start).toFixed(1)} ms`);
+  }
+});
