@@ -0,0 +1,158 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard additions at both the node and its descendants', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 9);
+  tree.add(4, 8, -3);
+  tree.assign(0, 8, 0);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, -10);
+  tree.add(0, 8, 2);
+  assert.equal(tree.sum(2, 6), -32);
+  assert.equal(tree.sum(0, 8), -64);
+  assert.equal(tree.max(1, 7), -8);
+  assert.deepEqual(tree.toArray(), Array(8).fill(-8));
+});
+
+test('partial maxima use the identity for negative values', () => {
+  const tree = new RangeTree([-9, -4, -7, -2, -8]);
+  assert.equal(tree.max(0, 4), -2);
+  assert.equal(tree.max(2, 3), -7);
+  tree.assign(0, 5, -12);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 2), -9);
+  assert.equal(tree.max(4, 5), -12);
+});
+
+test('threshold searches push pending tags before descending', () => {
+  const tree = new RangeTree([0, 0, 0, 0, 0]);
+  tree.assign(0, 5, 8);
+  assert.equal(tree.firstAtLeast(0, 8), 0);
+  tree.add(0, 5, 2);
+  assert.equal(tree.firstAtLeast(3, 10), 3);
+  tree.assign(0, 5, -4);
+  tree.assign(4, 5, 7);
+  assert.equal(tree.firstAtLeast(0, 0), 4);
+  tree.add(0, 5, -9);
+  assert.equal(tree.firstAtLeast(0, -3), 4);
+  assert.equal(tree.firstAtLeast(0, -1), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('mixed range updates and queries agree with an array model', () => {
+  let seed = 0x12345678;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 5, 8, 17, 33]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 300; step++) {
+      const a = random(length + 1);
+      const b = random(length + 1);
+      const l = step % 7 === 0 ? 0 : Math.min(a, b);
+      const r = step % 7 === 0 ? length : Math.max(a, b);
+      const v = (random(81) - 40) / 4;
+      const assigning = random(2) === 0;
+      assert.equal(assigning ? tree.assign(l, r, v) : tree.add(l, r, v), undefined);
+      for (let i = l; i < r; i++) values[i] = assigning ? v : values[i] + v;
+
+      // Search first, before other queries can incidentally flush lazy tags.
+      for (let probe = 0; probe < 5; probe++) {
+        const lo = random(length + 1);
+        const x = probe === 0 ? -Infinity : probe === 1 ? Infinity : random(101) - 50;
+        const expected = values.findIndex((value, i) => i >= lo && value >= x);
+        assert.equal(tree.firstAtLeast(lo, x), expected);
+        const c = random(length + 1);
+        const d = random(length + 1);
+        const start = Math.min(c, d);
+        const end = Math.max(c, d);
+        const slice = values.slice(start, end);
+        assert.equal(tree.sum(start, end), slice.reduce((sum, value) => sum + value, 0));
+        assert.equal(tree.max(start, end), Math.max(-Infinity, ...slice));
+        const i = random(length);
+        assert.equal(tree.get(i), values[i]);
+      }
+      if (step % 37 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, read-only length, and array independence', () => {
+  for (const values of [undefined, null, 3, '123', [], [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, -2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 7; }, TypeError);
+  tree.add(0, 3, 4);
+  const expected = [5, 2, 7];
+  for (const [l, r] of [[-1, 1], [2, 1], [0, 4], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]]) {
+    for (const name of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[name](l, r, 8), RangeError);
+    }
+  }
+  for (const v of [NaN, Infinity, -Infinity, undefined, null, '2']) {
+    for (const name of ['assign', 'add']) {
+      assert.throws(() => tree[name](0, 3, v), RangeError);
+      assert.throws(() => tree[name](1, 1, v), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, undefined, null, '2']) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 10), undefined);
+    assert.equal(tree.add(i, i, -10), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  const output = tree.toArray();
+  assert.deepEqual(output, expected);
+  output[0] = 99;
+  assert.deepEqual(tree.toArray(), expected);
+});
+
+test('range operations and threshold searches visit logarithmically many nodes', () => {
+  const length = 8193;
+  const tree = new RangeTree(Array(length).fill(-1));
+  const counts = {};
+  for (const name of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[name];
+    counts[name] = 0;
+    tree[name] = function (...args) {
+      counts[name]++;
+      return original.apply(this, args);
+    };
+  }
+  const bound = 8 * Math.ceil(Math.log2(length));
+  const check = (name, operation) => {
+    counts[name] = 0;
+    operation();
+    assert.ok(counts[name] <= bound, `${name} visited ${counts[name]} nodes`);
+  };
+  check('_update', () => tree.add(1, length - 1, 3));
+  check('_update', () => tree.assign(2, length - 2, -7));
+  check('_sum', () => assert.equal(tree.sum(1, length - 1), 4 - 7 * (length - 4)));
+  check('_max', () => assert.equal(tree.max(2, length - 2), -7));
+  check('_sum', () => assert.equal(tree.get(length - 3), -7));
+  check('_first', () => assert.equal(tree.firstAtLeast(2, 0), length - 2));
+  assert.equal(tree.toArray().length, length);
+  assert.equal(counts._write, 2 * length - 1);
+});
