+++ "{temp}\\hb-26c55d52-dbqm1xnw/regression.test.js"
@@ -0,0 +1,164 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('literal syntax, arithmetic precedence, and associativity', () => {
+  const cases = [
+    ['1.5 + .5 + 5. + 1.5e-3 + 2E+1', 27.0015],
+    ['10 - 3 - 2', 5],
+    ['24 / 4 / 2', 3],
+    ['17 % 5 * 3 // 2', 3],
+    ['2 + 3 * 4', 14],
+    ['-2 ** 2', -4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['3 * -2 ** 2', -12],
+    ['--2 ** 2', 4],
+    ['2 ** +3', 8],
+    ['abs(-2 ** 2) + min(3, 1, 2) + max(1, 4)', 9],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo use divisor signs and positive zeros', () => {
+  for (let a = -12; a <= 12; a += 1) {
+    for (let b = -5; b <= 5; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+      else assert.equal(Object.is(remainder, -0), false);
+      if (quotient === 0) assert.equal(Object.is(quotient, -0), false);
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`10   ${operator} -0`, 6);
+    errorAt(`10   ${operator} (1 == 2)`, 6);
+  }
+});
+
+test('comparisons chain, short circuit, and coerce booleans in numeric contexts', () => {
+  const cases = [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 != 3 > 0 >= 0 == 0', true],
+    ['1 + 2 < 2 * 2', true],
+    ['(3 < 2) < 1', true],
+    ['(1 < 2) + (2 < 3)', 2],
+    ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true],
+    ['(1 < 2) ** 3', 1],
+    ['-(1 < 2)', -1],
+    ['min(1 < 2, 2 < 1)', 0],
+    ['abs(2 < 1)', 0],
+    ['3 < 2 < unknown', false],
+    ['3 < 2 < (1 / 0)', false],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('variables and call arguments are read once in left-to-right order', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, {
+      get() {
+        reads.push(name);
+        return value;
+      },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b < c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('a > b < c < d', variables), false);
+  assert.deepEqual(reads.splice(0), ['a', 'b']);
+  assert.equal(evaluate('max(a + b, abs(-c), min(d, a))', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd', 'a']);
+  assert.equal(evaluate('a ** b ** c + d', variables), 5);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+
+  let count = 0;
+  const changing = { get x() { return ++count; } };
+  assert.equal(evaluate('x < x < x', changing), true);
+  assert.equal(count, 3);
+  const inherited = Object.create({ x: 5 });
+  errorAt('  x', 3, inherited);
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('_value2', Object.assign(Object.create(null), { _value2: 7 })), 7);
+});
+
+test('all syntax is parsed before evaluation, including skipped comparisons', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['x + mystery(1)', 5],
+    ['x + abs(1, 2)', 5],
+    ['x + min()', 5],
+    ['x + max()', 5],
+    ['x + abs()', 5],
+    ['x + 1 trailing', 7],
+    ['x > 2 < mystery(1)', 9],
+    ['x > 2 < abs(1, 2)', 9],
+    ['x > 2 < min(1,)', 15],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('errors use actual token UTF-16 columns, including whitespace and EOF', () => {
+  const cases = [
+    ['', 1],
+    [' \t\n', 4],
+    ['1 +   ', 7],
+    ['(1 + 2  ', 9],
+    ['1   2', 5],
+    ['1 +   )', 7],
+    ['1 +   @', 7],
+    ['1 +   😀', 7],
+    ['\u20031 +\t@', 6],
+    ['  missing', 3],
+    ['  nope(1)', 3],
+    ['  abs(1, 2)', 3],
+    ['min(1,  )', 9],
+    ['2(3)', 2],
+    ['1 = 2', 3],
+    ['1 ! 2', 3],
+    ['1e+', 2],
+    ['.', 1],
+  ];
+  for (const [source, column] of cases) errorAt(source, column);
+});
+
+test('100,001-operand arithmetic and comparison chains remain linear and stack safe', () => {
+  const size = 100001;
+  const cases = [
+    [Array(size).fill('1').join(' + '), size],
+    [Array(size).fill('1').join(' * '), 1],
+    [Array(size).fill('1').join(' <= '), true],
+    [`min(${Array(size).fill('1').join(',')})`, 1],
+  ];
+  for (const [source, expected] of cases) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected);
+    assert.ok(performance.now() - start < 1000, 'each long formula must evaluate in under a second');
+  }
+});
