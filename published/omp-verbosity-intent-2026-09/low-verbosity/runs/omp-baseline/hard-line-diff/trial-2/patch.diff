@@ -0,0 +1,160 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+// A deliberately small quadratic oracle, used only for exhaustive test cases.
+function editDistance(a, b) {
+  let row = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 0; i < a.length; i++) {
+    const next = [i + 1];
+    for (let j = 0; j < b.length; j++) {
+      next.push(a[i] === b[j] ? row[j] : Math.min(row[j + 1], next[j]) + 1);
+    }
+    row = next;
+  }
+  return row[b.length];
+}
+
+function arraysUpTo(length, alphabet) {
+  const arrays = [Object.freeze([])];
+  let level = arrays;
+  for (let i = 0; i < length; i++) {
+    const next = [];
+    for (const prefix of level) {
+      for (const line of alphabet) next.push(Object.freeze([...prefix, line]));
+    }
+    arrays.push(...next);
+    level = next;
+  }
+  return arrays;
+}
+
+test('exhaustive minimal scripts and patch roundtrips with repeated and empty lines', () => {
+  const inputs = arraysUpTo(4, ['', '+line', '-line']);
+  for (const a of inputs) {
+    for (const b of inputs) {
+      const script = diffLines(a, b);
+      assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+      assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+      assert.equal(script.filter(entry => entry.op !== 'equal').length, editDistance(a, b));
+      assert.deepEqual(diffLines(a, b), script);
+      let inserted = false;
+      for (const entry of script) {
+        if (entry.op === 'equal') inserted = false;
+        else if (entry.op === 'insert') inserted = true;
+        else {
+          assert.equal(entry.op, 'delete');
+          assert.equal(inserted, false);
+        }
+      }
+      for (const context of [0, 1, 2, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+      }
+    }
+  }
+});
+
+test('zero-length coordinates use the preceding line at top, middle and end', () => {
+  const a = ['a', 'b'];
+  for (const position of [0, 1, 2]) {
+    const b = [...a.slice(0, position), '+added', ...a.slice(position)];
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [{
+      oldStart: position, oldLines: 0,
+      newStart: position + 1, newLines: 1, lines: ['++added'],
+    }]);
+    assert.deepEqual(unifiedHunks(b, a, { context: 0 }), [{
+      oldStart: position + 1, oldLines: 1,
+      newStart: position, newLines: 0, lines: ['-+added'],
+    }]);
+  }
+  assert.deepEqual(unifiedHunks([], [''], { context: 0 }), [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+'],
+  }]);
+  assert.deepEqual(unifiedHunks([''], [], { context: 0 }), [{
+    oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-'],
+  }]);
+});
+
+test('touching context merges; larger gaps produce globally positioned hunks', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];
+  const touching = ['a', 'B', 'c', 'd', 'E', 'f', 'g'];
+  assert.deepEqual(unifiedHunks(a, touching, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' a', '-b', '+B', ' c', ' d', '-e', '+E', ' f'],
+  }]);
+  const separated = ['a', 'B', 'c', 'd', 'e', 'F', 'g'];
+  assert.deepEqual(unifiedHunks(a, separated, { context: 1 }), [{
+    oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+    lines: [' a', '-b', '+B', ' c'],
+  }, {
+    oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+    lines: [' e', '-f', '+F', ' g'],
+  }]);
+  assert.deepEqual(unifiedHunks(a, a), []);
+  for (const context of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => unifiedHunks(a, a, { context }), RangeError);
+  }
+});
+
+test('application retains gaps and respects offsets from earlier changes', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd', 'e']);
+  const hunks = [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'],
+  }, {
+    oldStart: 3, oldLines: 1, newStart: 4, newLines: 0, lines: ['-c'],
+  }, {
+    oldStart: 5, oldLines: 0, newStart: 7, newLines: 1, lines: ['+z'],
+  }];
+  assert.deepEqual(applyHunks(a, hunks), ['x', 'y', 'a', 'b', 'd', 'e', 'z']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('malformed or nonapplicable hunks identify the offending index', () => {
+  const a = Object.freeze(['a', 'b']);
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] };
+  const invalid = [
+    null, {},
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: Infinity },
+    { ...valid, oldStart: Number.MAX_SAFE_INTEGER + 1 },
+    { ...valid, oldLines: -1 }, { ...valid, newLines: -1 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 2 },
+    { ...valid, lines: null }, { ...valid, lines: [''] },
+    { ...valid, lines: [42] }, { ...valid, lines: ['?a'] },
+    { ...valid, lines: [' wrong'] }, { ...valid, lines: ['-wrong', '+a'] },
+    { ...valid, oldLines: 2 }, { ...valid, newLines: 2 },
+    { ...valid, lines: [' a', ' b'] },
+    { oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' c'] },
+    { oldStart: 3, oldLines: 0, newStart: 4, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 2, oldLines: 1, newStart: 3, newLines: 1, lines: [' b'],
+  }]), /hunk 1 does not apply/);
+});
+
+test('small changes in 20,000-line files, including repetitive lines', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(100, 1, 'replacement');
+    b.splice(10000, 0, 'inserted');
+    b.splice(19000, 1);
+    const script = diffLines(a, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+  }
+});
