+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard additions pending at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(3, 7, -10);
+  tree.assign(0, 7, -4);
+  tree.add(0, 7, 6);
+  tree.assign(0, 7, -8);
+  tree.add(0, 7, 3);
+  assert.equal(tree.sum(1, 6), -25);
+  assert.equal(tree.max(2, 5), -5);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-5));
+  tree.add(1, 6, 9);
+  tree.assign(2, 5, -2);
+  assert.deepEqual(tree.toArray(), [-5, 4, -2, -2, -2, 4, -5]);
+  assert.equal(tree.sum(0, 7), -8);
+});
+
+test('partial maxima use negative infinity as the identity', () => {
+  const tree = new RangeTree([-9, -4, -7, -2, -8]);
+  assert.equal(tree.max(0, 1), -9);
+  assert.equal(tree.max(1, 3), -4);
+  assert.equal(tree.max(2, 5), -2);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 4), -17);
+  assert.equal(tree.max(3, 3), -Infinity);
+});
+
+test('threshold searches propagate lazy assignment and addition before descending', () => {
+  for (const update of ['assign', 'add']) {
+    const tree = new RangeTree([0, 0, 0, 0, 0]);
+    tree[update](0, 5, 10);
+    assert.equal(tree.firstAtLeast(0, 10), 0);
+    assert.equal(tree.firstAtLeast(3, 10), 3);
+    assert.equal(tree.firstAtLeast(5, 10), -1);
+    assert.equal(tree.firstAtLeast(0, 11), -1);
+  }
+  const tree = new RangeTree([20, 20, 20, 20, 20]);
+  tree.assign(0, 2, -10);
+  assert.equal(tree.firstAtLeast(0, 10), 2);
+  tree.add(2, 5, -15);
+  assert.equal(tree.firstAtLeast(0, 10), -1);
+  tree.assign(0, 5, -8);
+  tree.add(0, 5, 3);
+  assert.equal(tree.firstAtLeast(1, -5), 1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(4, -Infinity), 4);
+});
+
+test('validation, empty ranges, read-only length, and independent arrays', () => {
+  for (const values of [[], null, undefined, {}, new Float64Array([1]),
+    [NaN], [Infinity], [-Infinity], ['1'], [1, , 3]]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [3, -2, 7];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 8; }, TypeError);
+  const invalidRanges = [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, 1.5],
+    [NaN, 2], [0, Infinity], ['0', 2], [0, undefined]];
+  for (const [l, r] of invalidRanges) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, Infinity, '1', undefined]) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '1', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), [3, -2, 7]);
+  const output = tree.toArray();
+  output[1] = 99;
+  assert.equal(tree.get(1), -2);
+  tree.assign(0, 3, 4);
+  assert.deepEqual(output, [3, 99, 7]);
+  assert.equal(tree.firstAtLeast(3, -Infinity), -1);
+});
+
+test('deterministic mixed updates agree with an array model for every query', () => {
+  let seed = 0x6a09e667;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 8) % limit;
+  };
+  for (const length of [1, 2, 3, 7, 8, 17]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    const check = () => {
+      // Search first so materializing the leaves cannot hide propagation bugs.
+      for (let lo = 0; lo <= length; lo++) {
+        for (const x of [-Infinity, -30, -10, 0, 10, 30, Infinity, ...values]) {
+          const expected = values.findIndex((value, i) => i >= lo && value >= x);
+          assert.equal(tree.firstAtLeast(lo, x), expected);
+        }
+      }
+      for (let l = 0; l <= length; l++) {
+        let sum = 0;
+        let max = -Infinity;
+        for (let r = l; r <= length; r++) {
+          assert.equal(tree.sum(l, r), sum);
+          assert.equal(tree.max(l, r), max);
+          if (r < length) {
+            sum += values[r];
+            max = Math.max(max, values[r]);
+          }
+        }
+      }
+      for (let i = 0; i < length; i++) assert.equal(tree.get(i), values[i]);
+      assert.deepEqual(tree.toArray(), values);
+    };
+    check();
+    for (let step = 0; step < 260; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 4 === 0) [l, r] = [0, length];
+      const value = random(41) - 20;
+      const assigning = random(2) === 0;
+      assert.equal(tree[assigning ? 'assign' : 'add'](l, r, value), undefined);
+      for (let i = l; i < r; i++) {
+        values[i] = assigning ? value : values[i] + value;
+      }
+      // Let overlapping lazy tags accumulate between exhaustive checks.
+      if (step % 13 === 12) check();
+    }
+    check();
+  }
+});
