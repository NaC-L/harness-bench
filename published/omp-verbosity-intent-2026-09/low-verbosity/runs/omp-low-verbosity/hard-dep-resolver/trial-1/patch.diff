+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+
+test('versions are canonical safe numeric triples', () => {
+  assert.deepEqual(parse('0.10.9007199254740991'), [0, 10, Number.MAX_SAFE_INTEGER]);
+  for (const value of [null, 1, {}, '1.2', '01.2.3', '1.02.3', '1.2.03', '-1.2.3',
+    '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3 ', '1.2.3\n', '1.2.3\r\n',
+    '1.2.3\u2028', '9007199254740992.0.0']) {
+    assert.throws(() => parse(value), TypeError);
+  }
+  assert.equal(compare('1.10.0', '1.9.99'), 1);
+  assert.equal(compare('10.0.0', '9.99.99'), 1);
+  assert.equal(compare('0.0.9', '0.0.10'), -1);
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+});
+
+test('caret and tilde ranges use the specified exclusive bounds', () => {
+  const cases = [
+    ['^1.2.3', '1.2.2', false], ['^1.2.3', '1.2.3', true],
+    ['^1.2.3', '1.99.99', true], ['^1.2.3', '2.0.0', false],
+    ['^0.2.3', '0.2.2', false], ['^0.2.3', '0.2.3', true],
+    ['^0.2.3', '0.2.99', true], ['^0.2.3', '0.3.0', false],
+    ['^0.0.3', '0.0.2', false], ['^0.0.3', '0.0.3', true],
+    ['^0.0.3', '0.0.4', false], ['^0.0.0', '0.0.0', true],
+    ['^0.0.0', '0.0.1', false], ['~1.2.3', '1.2.2', false],
+    ['~1.2.3', '1.2.99', true], ['~1.2.3', '1.3.0', false],
+    ['~0.0.3', '0.0.99', true], ['~0.0.3', '0.1.0', false],
+    ['^9007199254740991.0.0', '9007199254740991.99.99', true],
+    ['^0.9007199254740991.0', '0.9007199254740991.99', true],
+    ['^0.0.9007199254740991', '0.0.9007199254740991', true],
+    ['^0.0.9007199254740991', '0.1.0', false],
+    ['~1.9007199254740991.0', '1.9007199254740991.99', true],
+    ['~1.9007199254740991.0', '2.0.0', false],
+  ];
+  for (const [range, version, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected);
+  }
+});
+
+test('ranges are eagerly validated AND terms with whitespace and all operators', () => {
+  for (const [range, version, expected] of [
+    ['*', '0.0.0', true], ['1.2.3', '1.2.3', true], ['1.2.3', '1.2.4', false],
+    ['>=1.2.3', '1.2.3', true], ['>1.2.3', '1.2.3', false],
+    ['<=1.2.3', '1.2.3', true], ['<1.2.3', '1.2.3', false],
+    [' \t>=1.2.3\n<2.0.0 * ', '1.10.0', true],
+    ['>=1.2.3 <2.0.0', '2.0.0', false], ['>2.0.0 <1.0.0', '1.2.3', false],
+  ]) assert.equal(satisfies(version, range), expected, `${version} ${range}`);
+  for (const range of [null, {}, 1, '', ' \n ', '1', '1.2', '1.x.3', '=1.2.3',
+    '>= 1.2.3', '^^1.2.3', '1.2.3 || 2.0.0', '* garbage', '>2.0.0 invalid']) {
+    assert.throws(() => compileRange(range), TypeError);
+    assert.throws(() => satisfies('1.0.0', range), TypeError);
+  }
+});
