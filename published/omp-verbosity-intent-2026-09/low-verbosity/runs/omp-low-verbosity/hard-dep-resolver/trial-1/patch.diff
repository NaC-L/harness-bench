+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { parse, compare, compileRange } = require('./src/semver');
+
+test('numeric ordering compares major, minor, and patch components', () => {
+  for (const [versions, expected] of [
+    [['9.0.0', '10.0.0'], '10.0.0'],
+    [['1.9.0', '1.10.0'], '1.10.0'],
+    [['1.0.9', '1.0.10'], '1.0.10'],
+  ]) {
+    assert.deepEqual(resolve({ a: Object.fromEntries(versions.map(v => [v, {}])) }, { a: '*' }), { a: expected });
+  }
+});
+
+test('backtracking removes descendant selections, constraints, and queued requirements', () => {
+  const registry = {
+    a: { '2.0.0': { b: '2.0.0', missing: '*' }, '1.0.0': { b: '1.0.0' } },
+    b: { '2.0.0': { abandoned: '*' }, '1.0.0': {} },
+    abandoned: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { abandoned: '*', a: '1.0.0' }, '1.0.0': { b: '*' } },
+    b: { '1.0.0': {} },
+  }, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+});
+
+test('the first solution uses FIFO discoveries, not dependency-first or global maximization', () => {
+  const registry = {
+    a: { '1.0.0': { b: '*' } },
+    z: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { z: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', z: '*' }), { a: '1.0.0', z: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '2.0.0', z: '1.0.0' });
+  assert.deepEqual(resolve({
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  }, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('all discovered constraints apply before a queued name is selected', () => {
+  assert.deepEqual(resolve({
+    a: { '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  }, { a: '*', b: '*' }), { a: '1.0.0', b: '1.0.0', c: '1.0.0' });
+  assert.deepEqual(resolve({
+    a: { '1.0.0': { b: '^0.2.0' } },
+    b: { '0.3.0': {}, '0.2.9': {} },
+  }, { a: '*', b: '*' }), { a: '1.0.0', b: '0.2.9' });
+});
+
+test('cycles expand selected packages only once and still enforce constraints', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  }, { a: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+  assert.equal(resolve({
+    a: { '1.0.0': { b: '*' } }, b: { '1.0.0': { a: '2.0.0' } },
+  }, { a: '*' }), null);
+});
+
+test('only selected versions determine reachability; missing packages are unsatisfiable', () => {
+  assert.deepEqual(resolve({ unrelated: { '1.0.0': { missing: '*' } } }, {}), {});
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '>1.0.0' }), null);
+  assert.deepEqual(resolve({
+    a: { '2.0.0': { missing: '*' }, '1.0.0': {} }, unused: { '1.0.0': {} },
+  }, { a: '*' }), { a: '1.0.0' });
+});
+
+test('all maps, versions, and ranges are eagerly validated, even when unreachable', () => {
+  for (const value of [null, [], 'map', 1, new Date(), Object.create({})]) {
+    assert.throws(() => resolve(value, {}), TypeError);
+    assert.throws(() => resolve({}, value), TypeError);
+    assert.throws(() => resolve({ unused: value }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': value } }, {}), TypeError);
+  }
+  for (const version of ['01.0.0', '1.0.0\n', '1.0.0-beta', '1.0', '9007199254740992.0.0']) {
+    assert.throws(() => resolve({ unused: { [version]: {} } }, {}), TypeError);
+  }
+  for (const range of ['', 'invalid', '* invalid', null]) {
+    assert.throws(() => resolve({ unused: { '1.0.0': { missing: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { missing: range }), TypeError);
+  }
+});
+
+test('plain and null-prototype maps use only own enumerable string keys without mutation', () => {
+  const names = ['__proto__', 'constructor', 'toString'];
+  const deps = Object.create(null);
+  const root = Object.create(null);
+  const registry = Object.create(null);
+  for (const name of names) {
+    root[name] = '*';
+    registry[name] = Object.freeze(Object.assign(Object.create(null), { '1.0.0': deps }));
+  }
+  Object.defineProperty(registry, 'hidden', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(root, 'hidden', { value: null });
+  root[Symbol('ignored')] = null;
+  Object.defineProperty(deps, 'hidden', { value: null });
+  deps[Symbol('ignored')] = null;
+  Object.freeze(deps);
+  Object.freeze(root);
+  Object.freeze(registry);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result, Object.fromEntries(names.map(name => [name, '1.0.0'])));
+  assert.deepEqual(Object.keys(result), names);
+});
+
+test('long chains and deep failed branches use no recursion or arbitrary step limit', () => {
+  const registry = {};
+  const length = 12000;
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % length}`]: '*' } };
+  }
+  const solution = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(solution).length, length);
+  assert.equal(solution[`p${length - 1}`], '1.0.0');
+  registry[`p${length - 1}`]['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+  registry.entry = { '2.0.0': { p0: '*' }, '1.0.0': {} };
+  assert.deepEqual(resolve(registry, { entry: '*' }), { entry: '1.0.0' });
+});
+
+test('conflicts are checked during search, before any full Cartesian product', { timeout: 5000 }, () => {
+  const registry = {};
+  const root = {};
+  for (let i = 0; i < 80; i += 1) {
+    const name = `p${i}`;
+    root[name] = '*';
+    registry[name] = { '2.0.0': { [name]: '1.0.0' }, '1.0.0': {} };
+  }
+  assert.deepEqual(resolve(registry, root), Object.fromEntries(Object.keys(root).map(name => [name, '1.0.0'])));
+});
+
+// Small, independently implemented snapshot DFS is an oracle for ordering and
+// rollback. It is intentionally recursive only for these bounded tiny fixtures.
+function referenceResolve(registry, root) {
+  function search(selected, pending, constraints) {
+    if (pending.length === 0) return Object.fromEntries(selected);
+    const [name, ...remaining] = pending;
+    if (selected.has(name)) return search(selected, remaining, constraints);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!constraints.get(name).every(accepts => accepts(parse(version)))) continue;
+      const nextSelected = new Map(selected).set(name, version);
+      const nextConstraints = new Map([...constraints].map(([key, list]) => [key, [...list]]));
+      const nextPending = [...remaining];
+      let valid = true;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        const accepts = compileRange(range);
+        if (!nextConstraints.has(dependency)) nextConstraints.set(dependency, []);
+        nextConstraints.get(dependency).push(accepts);
+        nextPending.push(dependency);
+        if (nextSelected.has(dependency) && !accepts(parse(nextSelected.get(dependency)))) valid = false;
+      }
+      if (valid) {
+        const result = search(nextSelected, nextPending, nextConstraints);
+        if (result !== null) return result;
+      }
+    }
+    return null;
+  }
+  return search(new Map(), Object.keys(root), new Map(Object.entries(root).map(([name, range]) => [name, [compileRange(range)]])));
+}
+
+test('first-found assignments match a snapshot DFS across generated cyclic graphs', () => {
+  let seed = 123456789;
+  function random(max) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % max;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=1.0.0', '<2.0.0', '>2.0.0'];
+  for (let sample = 0; sample < 300; sample += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0']) {
+        const deps = {};
+        for (let i = 0, count = random(4); i < count; i += 1) {
+          deps[[...names, 'missing'][random(5)]] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (let i = 0, count = random(4); i <= count; i += 1) root[names[random(names.length)]] = ranges[random(ranges.length)];
+    const expected = referenceResolve(registry, root);
+    const actual = resolve(registry, root);
+    assert.deepEqual(actual, expected, `sample ${sample}: ${JSON.stringify({ registry, root })}`);
+    if (actual) assert.deepEqual(Object.keys(actual), Object.keys(expected));
+  }
+});
