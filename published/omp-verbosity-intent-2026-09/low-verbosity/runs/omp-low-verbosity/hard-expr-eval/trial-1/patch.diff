index 0000000..2484ac0
--- /dev/null
+++ "{temp}\\hb-93497f93-pv15rnic/evaluator.contract.test.js"
@@ -0,0 +1,107 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('Python power precedence and arithmetic associativity', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25], ['2 ** -2 ** 2', 1 / 16],
+    ['--2 ** 2', 4], ['2 * -3 ** 2', -18], ['2 ** +3', 8],
+    ['20 - 5 - 3', 12], ['24 / 3 * 2', 16], ['20 // 3 % 4', 2],
+    ['1.5e-3 + .5 + 5. + 2E+1', 25.5015],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo signs, identities and positive zero', () => {
+  for (let a = -15; a <= 15; a += 1) {
+    for (let b = -5; b <= 5; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(!Object.is(remainder, -0));
+      assert.ok(!Object.is(quotient, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+});
+
+test('comparison chains share operands, short-circuit, and coerce booleans numerically', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false], ['1 < 2 <= 2 != 3 > 0', true],
+    ['3 > 2 > 1', true], ['1 == 1 == 1', true], ['2 < 1 < missing', false],
+    ['2 < 1 < (1 / 0)', false], ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true], ['(1 < 2) + (2 < 1)', 1],
+    ['1 < 2 < (3 < 4)', false], ['(1 < 2) < 3', true],
+  ]) assert.equal(evaluate(source), expected, source);
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, { get() { reads.push(name); return value; } });
+  }
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+});
+
+test('variables are own properties and occurrences read left to right without mutation', () => {
+  let reads = 0;
+  const variables = Object.freeze({ get x() { reads += 1; return reads; } });
+  assert.equal(evaluate('x + x * x', variables), 7);
+  assert.equal(reads, 3);
+  errorAt(' inherited', 2, Object.create({ inherited: 2 }));
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('_a1', Object.assign(Object.create(null), { _a1: 3 })), 3);
+});
+
+test('built-in calls evaluate every argument once and left to right', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return reads; } };
+  assert.equal(evaluate('min(x, max(x, x), abs(-x))', variables), 1);
+  assert.equal(reads, 4);
+  assert.equal(evaluate('max(1 < 2, 2 < 1)'), 1);
+  assert.equal(evaluate('abs(-2 ** 2)'), 4);
+  assert.equal(evaluate('min(3)'), 3);
+});
+
+test('the entire source is parsed before any evaluation', () => {
+  const variables = { get x() { assert.fail('must not evaluate invalid source'); } };
+  for (const [source, column] of [
+    ['x + nope(1)', 5], ['x + min()', 5], ['x + max()', 5],
+    ['x + abs()', 5], ['x + abs(1, 2)', 5], ['x + min(1,)', 11],
+    ['x + 2 3', 7], ['x + (2', 7], ['2 < 1 < abs(1, 2)', 9],
+  ]) errorAt(source, column, variables);
+});
+
+test('errors use actual UTF-16 token offsets, including whitespace and EOF', () => {
+  for (const [source, column] of [
+    ['  missing', 3], ['1   / 0', 5], ['1\t // -0', 4], ['1  % 0', 4],
+    ['  @', 3], ['1 +  😀', 6], ['1 +   ', 7], ['  ', 3], ['', 1],
+    ['1  2', 4], ['(1  ', 5], ['abs(1, 2)  ', 1], ['  nope(1)', 3],
+    ['2(3)', 2], ['1e+', 2], ['min(1,)', 7],
+  ]) errorAt(source, column);
+});
+
+test('100,001-operand flat arithmetic and comparison chains are stack safe', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array(count).fill('1').join('==')), true);
+  assert.equal(evaluate('min(' + Array(count).fill('1').join(',') + ')'), 1);
+});
