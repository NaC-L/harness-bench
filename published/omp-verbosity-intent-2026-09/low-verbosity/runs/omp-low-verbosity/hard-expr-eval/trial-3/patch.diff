+++ "{temp}\\hb-fba0f5b5-jalomjvw/contract.test.js"
@@ -0,0 +1,152 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('literal formats, precedence and left-associative arithmetic', () => {
+  for (const [source, expected] of [
+    ['1.5 + .5 + 5. + 1.5e-3 + 2E+1', 27.0015],
+    ['2 + 3 * 4', 14],
+    ['(2 + 3) * 4', 20],
+    ['10 - 3 - 2', 5],
+    ['24 / 3 / 2', 4],
+    ['20 // 3 * 2 % 5', 2],
+    ['3 * -2 + +4', -2],
+    ['_amount + value2', 7],
+  ]) {
+    assert.equal(evaluate(source, { _amount: 3, value2: 4 }), expected, source);
+  }
+});
+
+test('power is right-associative and binds above a sign on its left', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4],
+    ['+2 ** 2', 4],
+    ['(-2) ** 2', 4],
+    ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512],
+    ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25],
+    ['3 * -2 ** 2', -12],
+    ['--2 ** 2', 4],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and remainder follow divisor signs and normalize zero', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -7; b <= 7; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+      else assert.ok(!Object.is(remainder, -0));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+});
+
+test('comparisons chain shared operands, not intermediate booleans', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false],
+    ['1 < 2 <= 2 == 2 != 3 > 1 >= 1', true],
+    ['3 > 2 > 1', true],
+    ['1 + 2 < 2 * 2', true],
+    ['(3 < 2) < 1', true],
+    ['(1 < 2) + (2 < 1)', 1],
+    ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true],
+    ['(1 < 2) ** 2', 1],
+    ['abs(2 < 1)', 0],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('variables and arguments are read once per occurrence in evaluation order', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a + b, abs(-c), min(d, a))', variables), 3);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd', 'a']);
+  reads.length = 0;
+  assert.equal(evaluate('a ** b + c / d', variables), 1.75);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+  let occurrences = 0;
+  assert.equal(evaluate('x < x < x', { get x() { return ++occurrences; } }), true);
+  assert.equal(occurrences, 3);
+  errorAt(' inherited', 2, Object.create({ inherited: 1 }));
+});
+
+test('false chains short-circuit evaluation but not parsing', () => {
+  const variables = { get untouched() { throw new Error('must not be read'); } };
+  assert.equal(evaluate('3 < 2 < untouched', variables), false);
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < 1 / 0'), false);
+  errorAt('3 < 2 < bogus(1)', 9);
+  errorAt('3 < 2 < abs(1, 2)', 9);
+  errorAt('3 < 2 < (1 + )', 14);
+});
+
+test('calls enforce names and arity before any evaluation', () => {
+  assert.equal(evaluate('min(3)'), 3);
+  assert.equal(evaluate('max(1, 3, 2)'), 3);
+  assert.equal(evaluate('abs(-3)'), 3);
+  const variables = { get x() { throw new Error('must not be read'); } };
+  for (const source of ['x + bogus(1)', 'x + abs()', 'x + abs(1, 2)', 'x + min()', 'x + max()']) {
+    errorAt(source, 5, variables);
+  }
+  errorAt('min(1,)', 7);
+});
+
+test('error columns identify tokens after whitespace and use UTF-16 offsets', () => {
+  for (const [source, column] of [
+    ['   missing', 4],
+    ['1 +   missing', 7],
+    ['1 /   0', 3],
+    ['1   // 0', 5],
+    ['1\t % -0', 4],
+    ['1 +\n\t @', 7],
+    ['1 +   )', 7],
+    ['1   2', 5],
+    ['  abs()', 3],
+    ['1  = 2', 4],
+    ['1 +  😀', 6],
+    ['', 1],
+    [' \t\n', 4],
+    ['1 +   ', 7],
+    ['(1   ', 6],
+    ['min(1,   ', 10],
+  ]) errorAt(source, column);
+});
+
+test('long flat formulas evaluate without recursive traversal or quadratic work', t => {
+  const count = 100001;
+  const start = performance.now();
+  assert.equal(evaluate('1+'.repeat(count - 1) + '1'), count);
+  assert.equal(evaluate('1*'.repeat(count - 1) + '1'), 1);
+  assert.equal(evaluate('1<='.repeat(count - 1) + '1'), true);
+  assert.equal(evaluate('max(' + '1,'.repeat(count - 1) + '2)'), 2);
+  t.diagnostic(`Four ${count}-operand formulas: ${(performance.now() - start).toFixed(1)} ms`);
+});
