+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 0; j < b.length; j++) {
+      const above = row[j + 1];
+      row[j + 1] = line === b[j] ? diagonal + 1 : Math.max(above, row[j]);
+      diagonal = above;
+    }
+  }
+  return row[b.length];
+}
+
+function checkPair(a, b) {
+  Object.freeze(a);
+  Object.freeze(b);
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  for (const context of [0, 1, 2, 3, 100]) {
+    const hunks = unifiedHunks(a, b, { context });
+    for (const hunk of hunks) {
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+    }
+    Object.freeze(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+}
+
+test('exhaustive short repetitive inputs produce minimal, ordered roundtrips', () => {
+  const inputs = [[]];
+  let level = [[]];
+  for (let size = 1; size <= 4; size++) {
+    level = level.flatMap(lines => [['', ...lines], ['x', ...lines]]);
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) checkPair(a, b);
+  }
+});
+
+test('seeded repetitive inputs preserve empty lines and literal prefixes', () => {
+  let seed = 12345;
+  const next = () => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed;
+  };
+  const alphabet = ['', '+', '-', ' ', 'same', 'same', 'end'];
+  for (let trial = 0; trial < 300; trial++) {
+    const a = Array.from({ length: next() % 30 }, () => alphabet[next() % alphabet.length]);
+    const b = Array.from({ length: next() % 30 }, () => alphabet[next() % alphabet.length]);
+    checkPair(a, b);
+  }
+});
+
+test('zero-length ranges use preceding-line coordinates', () => {
+  assert.deepEqual(unifiedHunks([], ['x'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['x'], [], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a'], ['a', 'x'], { context: 0 }), [
+    { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a', 'x'], ['a'], { context: 0 }), [
+    { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a'], ['a']), []);
+});
+
+test('touching context merges, separated hunks keep full-file coordinates', () => {
+  const a = ['0', 'old', '2', '3', 'old2', '5', '6'];
+  const b = ['0', 'new', '2', '3', 'new2', '5', '6'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' 0', '-old', '+new', ' 2', ' 3', '-old2', '+new2', ' 5'],
+  }]);
+  const original = ['a', 'b', 'c', 'd', 'e', 'f'];
+  const changed = ['x', 'y', 'a', 'b', 'c', 'e', 'f', 'z'];
+  assert.deepEqual(unifiedHunks(original, changed, { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 4, oldLines: 1, newStart: 5, newLines: 0, lines: ['-d'] },
+    { oldStart: 6, oldLines: 0, newStart: 8, newLines: 1, lines: ['+z'] },
+  ]);
+  const separated = unifiedHunks(['0', 'old', '2', '3', '4', 'old2', '6'],
+    ['0', 'new', '2', '3', '4', 'new2', '6'], { context: 1 });
+  assert.equal(separated.length, 2);
+  assert.equal(separated[1].oldStart, 5);
+  assert.deepEqual(separated[0].lines, [' 0', '-old', '+new', ' 2']);
+  assert.deepEqual(separated[1].lines, [' 4', '-old2', '+new2', ' 6']);
+});
+
+test('application rejects malformed counts, coordinates, content and ordering', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {},
+    { ...valid, oldStart: 0 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: 4 }, { ...valid, newStart: 1 },
+    { ...valid, oldLines: -1 }, { ...valid, oldLines: 2 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: NaN },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] }, { ...valid, lines: [null] },
+    { ...valid, lines: ' b' },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, { ...valid, oldStart: 1 }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, { ...valid, oldStart: 3, newStart: 4 }]), /hunk 1 does not apply/);
+  assert.deepEqual(applyHunks(a, [valid]), ['a', 'B', 'c']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(applyHunks(['+x', '-x', ' x', ''], [{
+    oldStart: 1, oldLines: 4, newStart: 1, newLines: 4,
+    lines: [' +x', ' -x', '  x', ' '],
+  }]), ['+x', '-x', ' x', '']);
+});
+
+test('small edits to 20,000 lines remain minimal and applicable', () => {
+  const a = Array.from({ length: 20000 }, (_, i) => `line ${i}`);
+  const b = a.slice();
+  b.splice(19000, 1);
+  b.splice(10000, 1, 'replacement');
+  b.splice(500, 0, 'inserted');
+  const script = diffLines(a, b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+  assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+  const repeated = new Array(20000).fill('same');
+  const changed = repeated.slice();
+  changed[10000] = 'different';
+  assert.equal(diffLines(repeated, changed).filter(e => e.op !== 'equal').length, 2);
+  assert.deepEqual(applyHunks(repeated, unifiedHunks(repeated, changed)), changed);
+});
