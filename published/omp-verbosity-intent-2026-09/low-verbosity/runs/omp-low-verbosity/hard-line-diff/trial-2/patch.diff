@@ -0,0 +1,139 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const above = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = above;
+    }
+  }
+  return row[b.length];
+}
+
+function verifyScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  assert.deepEqual(diffLines(a, b), script);
+}
+
+test('exhaustive minimal scripts and patch roundtrips with repeated and empty lines', () => {
+  const arrays = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'x', '-x'].map(line => Object.freeze([...lines, line])));
+    arrays.push(...level);
+  }
+  for (const a of arrays) {
+    for (const b of arrays) {
+      verifyScript(a, b);
+      for (const context of [0, 1, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+        if (a.length === b.length && a.every((line, i) => line === b[i])) {
+          assert.deepEqual(hunks, []);
+        }
+      }
+    }
+  }
+});
+
+test('zero-line ranges use preceding line numbers at both ends', () => {
+  const a = ['a', 'b'];
+  const b = ['top', 'a', 'b', 'bottom'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 2, oldLines: 0, newStart: 4, newLines: 1, lines: ['+bottom'] },
+  ]);
+  assert.deepEqual(unifiedHunks(b, a, { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-top'] },
+    { oldStart: 4, oldLines: 1, newStart: 2, newLines: 0, lines: ['-bottom'] },
+  ]);
+  assert.deepEqual(unifiedHunks([], [''], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+'] },
+  ]);
+});
+
+test('touching contexts merge and separated contexts do not duplicate lines', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
+  assert.deepEqual(unifiedHunks(a, ['A', 'b', 'c', 'D', 'e', 'f', 'g', 'h'], { context: 1 }), [
+    { oldStart: 1, oldLines: 5, newStart: 1, newLines: 5,
+      lines: ['-a', '+A', ' b', ' c', '-d', '+D', ' e'] },
+  ]);
+  assert.deepEqual(unifiedHunks(a, ['A', 'b', 'c', 'd', 'E', 'f', 'g', 'h'], { context: 1 }), [
+    { oldStart: 1, oldLines: 2, newStart: 1, newLines: 2, lines: ['-a', '+A', ' b'] },
+    { oldStart: 4, oldLines: 3, newStart: 4, newLines: 3, lines: [' d', '-e', '+E', ' f'] },
+  ]);
+});
+
+test('patches preserve prefix characters and unmentioned lines with cumulative offsets', () => {
+  const a = Object.freeze([' a', '-b', '+c', '', 'tail']);
+  const hunks = Object.freeze([
+    Object.freeze({ oldStart: 0, oldLines: 0, newStart: 1, newLines: 2,
+      lines: Object.freeze(['++top', '+']) }),
+    Object.freeze({ oldStart: 2, oldLines: 2, newStart: 4, newLines: 1,
+      lines: Object.freeze(['--b', '-+c', '++replacement']) }),
+  ]);
+  assert.deepEqual(applyHunks(a, hunks), ['+top', '', ' a', '+replacement', '', 'tail']);
+  assert.deepEqual(applyHunks(a, []), a);
+  assert.notEqual(applyHunks(a, []), a);
+});
+
+test('malformed, mismatching, overlapping and unordered hunks report their index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+B'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, oldStart: 5 },
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldLines: 2 }, { ...valid, oldLines: -1 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 3 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: NaN },
+    { ...valid, newLines: Infinity }, { ...valid, oldLines: Number.MAX_SAFE_INTEGER + 1 },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' wrong'],
+  }]), /hunk 1 does not apply/);
+});
+
+test('large sparse edits and repeated lines roundtrip', () => {
+  for (const repeated of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repeated ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(18000, 1);
+    b.splice(10000, 0, '+inserted', '');
+    b[200] = '-replacement';
+    assert.equal(diffLines(a, b).filter(entry => entry.op !== 'equal').length, 5);
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b)), b);
+  }
+});
