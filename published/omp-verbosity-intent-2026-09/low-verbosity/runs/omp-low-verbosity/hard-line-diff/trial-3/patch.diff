+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small quadratic oracle is appropriate for exhaustive short inputs only.
+function lcsLength(a, b) {
+  let previous = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const row = [0];
+    for (let j = 0; j < b.length; j++) {
+      row.push(line === b[j] ? previous[j] + 1 : Math.max(previous[j + 1], row[j]));
+    }
+    previous = row;
+  }
+  return previous[b.length];
+}
+
+function shortInputs() {
+  const inputs = [Object.freeze([])];
+  let level = inputs;
+  for (let length = 1; length <= 4; length++) {
+    const next = [];
+    for (const prefix of level) {
+      for (const line of ['', '-', '+']) next.push(Object.freeze([...prefix, line]));
+    }
+    inputs.push(...next);
+    level = next;
+  }
+  return inputs;
+}
+
+test('exhaustive repeated/empty lines: minimal, ordered, deterministic, and roundtrippable', () => {
+  const inputs = shortInputs();
+  for (const a of inputs) {
+    for (const b of inputs) {
+      const script = diffLines(a, b);
+      assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+      assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+      assert.equal(script.filter(entry => entry.op !== 'equal').length,
+        a.length + b.length - 2 * lcsLength(a, b));
+      assert.deepEqual(diffLines(a, b), script);
+      let inserted = false;
+      for (const entry of script) {
+        assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+        if (entry.op === 'equal') inserted = false;
+        if (entry.op === 'insert') inserted = true;
+        if (entry.op === 'delete') assert.equal(inserted, false);
+      }
+      for (const context of [0, 1, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        Object.freeze(hunks);
+        assert.deepEqual(applyHunks(a, hunks), b);
+        if (a.length === b.length && a.every((line, i) => line === b[i])) {
+          assert.deepEqual(hunks, []);
+        }
+      }
+    }
+  }
+});
+
+test('zero-line coordinates at the beginning, middle, and end', () => {
+  const a = ['a', 'b'];
+  for (let i = 0; i <= a.length; i++) {
+    const b = [...a.slice(0, i), 'added', ...a.slice(i)];
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [{
+      oldStart: i, oldLines: 0, newStart: i + 1, newLines: 1, lines: ['+added'],
+    }]);
+    assert.deepEqual(unifiedHunks(b, a, { context: 0 }), [{
+      oldStart: i + 1, oldLines: 1, newStart: i, newLines: 0, lines: ['-added'],
+    }]);
+  }
+  assert.deepEqual(unifiedHunks([], ['']), [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+'],
+  }]);
+  assert.deepEqual(unifiedHunks([''], []), [{
+    oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-'],
+  }]);
+});
+
+test('touching context merges, separated context retains complete-file coordinates', () => {
+  const a = ['before', 'old', 'gap1', 'gap2', 'old2', 'after'];
+  const b = ['before', 'new', 'gap1', 'gap2', 'new2', 'after'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' before', '-old', '+new', ' gap1', ' gap2', '-old2', '+new2', ' after'],
+  }]);
+  a.splice(4, 0, 'gap3');
+  b.splice(4, 0, 'gap3');
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+    lines: [' before', '-old', '+new', ' gap1'],
+  }, {
+    oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+    lines: [' gap3', '-old2', '+new2', ' after'],
+  }]);
+  assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context: 1 })), b);
+});
+
+test('application tracks offsets without modifying original coordinates', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd']);
+  const hunks = [{ oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 3, oldLines: 1, newStart: 4, newLines: 0, lines: ['-c'] },
+    { oldStart: 4, oldLines: 0, newStart: 6, newLines: 1, lines: ['+z'] }];
+  assert.deepEqual(applyHunks(a, hunks), ['x', 'y', 'a', 'b', 'd', 'z']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  assert.deepEqual(applyHunks([], [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+a'] },
+    { oldStart: 0, oldLines: 0, newStart: 2, newLines: 1, lines: ['+b'] },
+  ]), ['a', 'b']);
+});
+
+test('malformed or inapplicable hunks identify their index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+x'] };
+  const invalid = [null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+x'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: Infinity },
+    { ...valid, oldStart: '2' }, { ...valid, oldLines: -1 },
+    { ...valid, oldLines: 2 }, { ...valid, oldLines: 0 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: 2 },
+    { ...valid, newStart: 1 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: 5, newStart: 5 },
+    { ...valid, oldStart: 3, newStart: 3, oldLines: 2 }];
+  for (const hunk of invalid) assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [{
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a', ' b'],
+  }]), /hunk 0 does not apply/);
+});
+
+test('small edits to 20,000-line files remain fast, including repetitive lines', () => {
+  for (const repeated of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repeated ? `line ${i % 5}` : `line ${i}`);
+    const b = a.slice();
+    b.splice(100, 1, 'replacement');
+    b.splice(10000, 0, 'inserted');
+    b.splice(18000, 1);
+    const started = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const result = applyHunks(a, hunks);
+    const elapsed = performance.now() - started;
+    assert.deepEqual(result, b);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `small-edit roundtrip took ${elapsed.toFixed(1)}ms`);
+  }
+});
