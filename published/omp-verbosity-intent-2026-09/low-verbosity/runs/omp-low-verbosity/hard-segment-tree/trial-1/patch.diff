@@ -0,0 +1,147 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards older additions on both parent and child tags', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 9);
+  tree.add(0, 7, 4);
+  tree.assign(0, 7, -6);
+  tree.add(0, 7, 2);
+  tree.assign(1, 6, 0);
+  tree.add(2, 5, -3);
+  assert.equal(tree.sum(0, 7), -17);
+  assert.deepEqual(tree.toArray(), [-4, 0, -3, -3, -3, 0, -4]);
+  tree.assign(0, 7, 5);
+  tree.add(0, 7, 3);
+  tree.assign(0, 7, 1);
+  tree.add(0, 7, 2);
+  assert.equal(tree.sum(1, 6), 15);
+  assert.equal(tree.get(6), 3);
+});
+
+test('partial maxima use the identity for negative values', () => {
+  const tree = new RangeTree([-7, -2, -9, -4, -8]);
+  assert.equal(tree.max(0, 1), -7);
+  assert.equal(tree.max(1, 4), -2);
+  assert.equal(tree.max(3, 5), -4);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(2, 5), -7);
+  assert.equal(tree.max(5, 5), -Infinity);
+});
+
+test('threshold search propagates updates before examining children', () => {
+  const tree = new RangeTree([1, 9, 2, 8, 3, 7, 4]);
+  tree.assign(0, 7, 5);
+  assert.equal(tree.firstAtLeast(0, 5), 0);
+  assert.equal(tree.firstAtLeast(3, 5), 3);
+  assert.equal(tree.firstAtLeast(0, 6), -1);
+  tree.add(0, 7, 10);
+  assert.equal(tree.firstAtLeast(2, 15), 2);
+  tree.assign(0, 7, -20);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.add(0, 7, 21);
+  tree.assign(0, 3, -2);
+  assert.equal(tree.firstAtLeast(0, 1), 3);
+  assert.equal(tree.firstAtLeast(6, 1), 6);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(2, -Infinity), 2);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('API validation, empty ranges, and array independence are preserved', () => {
+  for (const input of [[], null, {}, '123', [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  tree.add(0, 3, 1);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, 1.5], [NaN, 2], [0, Infinity], ['0', 2]]) {
+      assert.throws(() => tree[method](l, r, 7), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined, null]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+    for (let i = 0; i <= 3; i++) assert.equal(tree[method](i, i, 9), undefined);
+  }
+  for (let i = 0; i <= 3; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  for (const index of [-1, 3, 0.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, undefined, null, '1']) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), [3, -2, 5]);
+  const output = tree.toArray();
+  output[0] = 99;
+  assert.equal(tree.get(0), 3);
+  assert.equal(tree.assign(0, 1, 4), undefined);
+  assert.equal(tree.add(0, 1, 2), undefined);
+  assert.deepEqual(tree.toArray(), [6, -2, 5]);
+});
+
+test('mixed updates and queries agree with a seeded array oracle', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 7, 8, 17, 31]) {
+    const values = Array.from({ length }, () => (random(81) - 40) / 2);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 1600; step++) {
+      let l = random(length + 1);
+      let r = random(length + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 7 === 0) [l, r] = [0, length];
+      const operation = random(10);
+      const value = (random(81) - 40) / 2;
+      const context = `length=${length}, step=${step}, range=[${l}, ${r})`;
+      if (operation < 3) {
+        tree.assign(l, r, value);
+        for (let i = l; i < r; i++) values[i] = value;
+      } else if (operation < 6) {
+        tree.add(l, r, value);
+        for (let i = l; i < r; i++) values[i] += value;
+      } else if (operation === 6) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0), context);
+      } else if (operation === 7) {
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)), context);
+      } else if (operation === 8) {
+        const threshold = step % 11 === 0 ? Infinity : step % 13 === 0 ? -Infinity : value;
+        assert.equal(tree.firstAtLeast(l, threshold), values.findIndex((v, i) => i >= l && v >= threshold), context);
+      } else {
+        const i = random(length);
+        assert.equal(tree.get(i), values[i], context);
+      }
+      // Avoid materializing after each update: pending tags must compose repeatedly.
+      if (step % 113 === 0) assert.deepEqual(tree.toArray(), values, context);
+    }
+    assert.deepEqual(tree.toArray(), values);
+    for (let l = 0; l <= length; l++) {
+      for (let r = l; r <= length; r++) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0));
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+      }
+      for (const threshold of [-Infinity, -10, 0, 10, Infinity]) {
+        assert.equal(tree.firstAtLeast(l, threshold), values.findIndex((v, i) => i >= l && v >= threshold));
+      }
+    }
+  }
+});
