@@ -0,0 +1,160 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard additions on both parent and child lazy tags', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(0, 7, 10);
+  tree.assign(0, 7, -8);
+  tree.add(0, 7, 2);
+  assert.equal(tree.sum(1, 6), -30);
+  assert.equal(tree.max(1, 6), -6);
+  tree.add(2, 5, 4);
+  tree.assign(3, 6, 0);
+  assert.deepEqual(tree.toArray(), [-6, -6, -2, 0, 0, 0, -6]);
+  assert.equal(tree.sum(0, 7), -20);
+});
+
+test('partial maxima preserve negative values', () => {
+  const tree = new RangeTree([-9, -3, -8, -5, -7]);
+  assert.equal(tree.max(0, 1), -9);
+  assert.equal(tree.max(1, 4), -3);
+  tree.assign(0, 5, -12);
+  tree.add(2, 4, 3);
+  assert.equal(tree.max(1, 5), -9);
+  assert.equal(tree.max(5, 5), -Infinity);
+});
+
+test('threshold searches see pending assignments and additions before other queries', () => {
+  const tree = new RangeTree([0, 1, 2, 3, 4, 5, 6]);
+  tree.add(0, 7, 10);
+  assert.equal(tree.firstAtLeast(2, 14), 4);
+  tree.assign(0, 7, -20);
+  assert.equal(tree.firstAtLeast(0, -10), -1);
+  tree.add(3, 7, 30);
+  assert.equal(tree.firstAtLeast(1, 5), 3);
+  tree.assign(0, 7, 0);
+  assert.equal(tree.firstAtLeast(4, 0), 4);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), 5);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+});
+
+test('validation, empty ranges, return values and array independence retain the API', () => {
+  for (const values of [null, {}, [], [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [2, -4, 6];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 10; }, TypeError);
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const v of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](1, 1, v), RangeError);
+      assert.throws(() => tree[method](0, 3, v), RangeError);
+    }
+  }
+  for (const i of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(i), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= 3; i++) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), [2, -4, 6]);
+  const copy = tree.toArray();
+  copy[1] = 100;
+  assert.equal(tree.get(1), -4);
+  assert.equal(tree.assign(0, 3, 5), undefined);
+  assert.equal(tree.add(0, 3, -2), undefined);
+  assert.deepEqual(tree.toArray(), [3, 3, 3]);
+  assert.deepEqual(copy, [2, 100, 6]);
+});
+
+test('mixed lazy updates agree with a seeded array oracle', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const n of [1, 2, 3, 7, 8, 17, 32, 65]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let batch = 0; batch < 150; batch++) {
+      // Accumulate tags before any query can push them to the leaves.
+      for (let step = 0; step < 8; step++) {
+        let l = random(n + 1);
+        let r = random(n + 1);
+        if (l > r) [l, r] = [r, l];
+        if (step % 3 === 0) [l, r] = [0, n];
+        const v = random(41) - 20;
+        const assigning = random(2) === 0;
+        tree[assigning ? 'assign' : 'add'](l, r, v);
+        for (let i = l; i < r; i++) values[i] = assigning ? v : values[i] + v;
+      }
+      for (let q = 0; q < 8; q++) {
+        const lo = random(n + 1);
+        const x = q === 0 ? -Infinity : q === 1 ? Infinity : random(101) - 50;
+        assert.equal(tree.firstAtLeast(lo, x), values.findIndex((v, i) => i >= lo && v >= x));
+        let l = random(n + 1);
+        let r = random(n + 1);
+        if (l > r) [l, r] = [r, l];
+        const slice = values.slice(l, r);
+        assert.equal(tree.sum(l, r), slice.reduce((a, b) => a + b, 0));
+        assert.equal(tree.max(l, r), Math.max(...slice));
+        const i = random(n);
+        assert.equal(tree.get(i), values[i]);
+      }
+      if (batch % 10 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('tree traversal remains logarithmic for operations and linear for materialization', () => {
+  const n = 4097;
+  const tree = new RangeTree(Array(n).fill(-1));
+  const counts = {};
+  for (const method of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[method];
+    counts[method] = 0;
+    tree[method] = function (...args) {
+      counts[method]++;
+      return original.apply(this, args);
+    };
+  }
+  const limit = 8 * Math.ceil(Math.log2(n));
+  tree.assign(1, n - 1, 3);
+  assert.ok(counts._update <= limit);
+  counts._update = 0;
+  tree.add(2, n - 2, 4);
+  assert.ok(counts._update <= limit);
+  assert.equal(tree.sum(1, n - 1), (n - 4) * 7 + 6);
+  assert.ok(counts._sum <= limit);
+  assert.equal(tree.max(1, n - 1), 7);
+  assert.ok(counts._max <= limit);
+  assert.equal(tree.firstAtLeast(1, 7), 2);
+  assert.ok(counts._first <= limit);
+  counts._first = 0;
+  assert.equal(tree.firstAtLeast(n - 2, 7), -1);
+  assert.ok(counts._first <= limit);
+  assert.equal(tree.toArray().length, n);
+  assert.equal(counts._write, 2 * n - 1);
+});
