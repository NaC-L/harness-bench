@@ -0,0 +1,167 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('../src/range-tree');
+
+test('assignment discards additions on both the assigned node and its descendants', () => {
+  for (const inspect of [
+    tree => assert.equal(tree.sum(1, 5), -12),
+    tree => assert.equal(tree.max(1, 5), -3),
+    tree => assert.equal(tree.get(3), -3),
+    tree => assert.equal(tree.firstAtLeast(0, -2), -1),
+    tree => assert.deepEqual(tree.toArray(), Array(7).fill(-3)),
+  ]) {
+    const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+    tree.add(0, 3, 11);
+    tree.add(3, 7, 13);
+    tree.add(0, 7, 17);
+    tree.assign(0, 7, 0);
+    tree.add(0, 7, 5);
+    tree.assign(0, 7, -7);
+    tree.add(0, 7, 4);
+    inspect(tree);
+  }
+});
+
+test('partial maxima use negative infinity as the identity', () => {
+  const tree = new RangeTree([-8, -3, -9, -2, -7]);
+  assert.equal(tree.max(0, 1), -8);
+  assert.equal(tree.max(1, 4), -2);
+  assert.equal(tree.max(4, 5), -7);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 3), -7);
+});
+
+test('threshold search pushes assignments and additions before inspecting children', () => {
+  const tree = new RangeTree([9, -5, -4, -3, -2]);
+  tree.assign(0, 5, -10);
+  tree.add(0, 5, 12);
+  assert.equal(tree.firstAtLeast(1, 2), 1);
+  assert.equal(tree.firstAtLeast(0, 3), -1);
+  tree.add(0, 5, -4);
+  assert.equal(tree.firstAtLeast(2, -2), 2);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.assign(0, 5, 20);
+  tree.assign(0, 3, -20);
+  assert.equal(tree.firstAtLeast(0, 20), 3);
+  assert.equal(tree.firstAtLeast(4, 20), 4);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+});
+
+test('validation, empty ranges, read-only length, and independent arrays', () => {
+  for (const values of [[], null, {}, [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  tree.add(0, 3, 2);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 4; }, TypeError);
+  for (const [l, r] of [[-1, 2], [2, 1], [0, 4], [0.5, 2], [0, NaN], ['0', 2]]) {
+    for (const method of ['sum', 'max', 'assign', 'add']) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '2', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '2', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), [3, 4, 5]);
+  const output = tree.toArray();
+  output[0] = 99;
+  assert.equal(tree.get(0), 3);
+  assert.equal(tree.assign(0, 1, 3), undefined);
+  assert.equal(tree.add(0, 1, 0), undefined);
+});
+
+test('mixed lazy workloads agree with an array oracle across uneven tree sizes', () => {
+  let seed = 0x12345678;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 31, 64]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 400; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 4 === 0) [l, r] = [0, n];
+      const value = random(41) - 20;
+      const assigning = random(2) === 0;
+      tree[assigning ? 'assign' : 'add'](l, r, value);
+      for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      // Search first: other queries must not flush the lazy tags on its behalf.
+      const lo = random(n + 1);
+      const threshold = random(61) - 30;
+      assert.equal(tree.firstAtLeast(lo, threshold),
+        values.findIndex((v, i) => i >= lo && v >= threshold));
+      let a = random(n + 1);
+      let b = random(n + 1);
+      if (a > b) [a, b] = [b, a];
+      const slice = values.slice(a, b);
+      assert.equal(tree.sum(a, b), slice.reduce((sum, v) => sum + v, 0));
+      assert.equal(tree.max(a, b), Math.max(-Infinity, ...slice));
+      const index = random(n);
+      assert.equal(tree.get(index), values[index]);
+      if (step % 37 === 0) {
+        assert.deepEqual(tree.toArray(), values);
+        for (let start = 0; start <= n; start++) {
+          for (let end = start; end <= n; end++) {
+            const range = values.slice(start, end);
+            assert.equal(tree.sum(start, end), range.reduce((sum, v) => sum + v, 0));
+            assert.equal(tree.max(start, end), Math.max(-Infinity, ...range));
+          }
+        }
+      }
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('updates and queries visit logarithmically many nodes; materialization is linear', () => {
+  const n = 8193;
+  const tree = new RangeTree(Array(n).fill(-1));
+  for (const [internal, operation] of [
+    ['_update', () => tree.assign(1, n - 1, 2)],
+    ['_update', () => tree.add(2, n - 2, 3)],
+    ['_sum', () => assert.equal(tree.sum(1, n - 1), 5 * (n - 4) + 4)],
+    ['_max', () => assert.equal(tree.max(1, n - 1), 5)],
+    ['_sum', () => assert.equal(tree.get(n - 3), 5)],
+    ['_first', () => assert.equal(tree.firstAtLeast(n - 4, 5), n - 4)],
+    ['_write', () => assert.equal(tree.toArray().length, n)],
+  ]) {
+    const original = tree[internal];
+    let visits = 0;
+    tree[internal] = function (...args) {
+      visits++;
+      return original.apply(this, args);
+    };
+    operation();
+    tree[internal] = original;
+    if (internal === '_write') assert.equal(visits, 2 * n - 1);
+    else assert.ok(visits <= 8 * Math.ceil(Math.log2(n)), `${internal}: ${visits} visits`);
+  }
+});
