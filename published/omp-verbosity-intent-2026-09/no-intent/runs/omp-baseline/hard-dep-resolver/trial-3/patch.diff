@@ -0,0 +1,95 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parse, compare, satisfies, compileRange } = require('./semver');
+
+test('parse accepts exactly three canonical safe integer components', () => {
+  assert.deepEqual(parse('0.0.0'), [0, 0, 0]);
+  assert.deepEqual(parse('10.20.30'), [10, 20, 30]);
+  assert.deepEqual(parse('9007199254740991.0.0'), [Number.MAX_SAFE_INTEGER, 0, 0]);
+  for (const version of [
+    null, undefined, 1, {}, [], '', '1', '1.2', '1.2.3.4', '01.2.3', '1.02.3',
+    '1.2.03', '-1.2.3', '+1.2.3', '1.2.3-beta', '1.2.3+build', ' 1.2.3',
+    '1.2.3 ', '1.2.3\n', '1.2.3\r', '1.2.3\u2028', '1.2.3\u2029',
+    '9007199254740992.0.0', '0.9007199254740992.0', '0.0.9007199254740992',
+  ]) assert.throws(() => parse(version), TypeError, String(version));
+});
+
+test('compare uses numeric major, minor, and patch order and validates both inputs', () => {
+  for (const [left, right] of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.2.9', '1.2.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    assert.equal(compare(left, right), -1);
+    assert.equal(compare(right, left), 1);
+  }
+  assert.equal(compare('1.2.3', '1.2.3'), 0);
+  assert.throws(() => compare('bad', '1.2.3'), TypeError);
+  assert.throws(() => compare('1.2.3', 'bad'), TypeError);
+});
+
+test('caret follows the first nonzero component and excludes its upper bound', () => {
+  for (const [range, below, base, within, upper] of [
+    ['^1.2.3', '1.2.2', '1.2.3', '1.99.99', '2.0.0'],
+    ['^0.2.3', '0.2.2', '0.2.3', '0.2.99', '0.3.0'],
+    ['^0.0.3', '0.0.2', '0.0.3', '0.0.3', '0.0.4'],
+    ['^0.0.0', null, '0.0.0', '0.0.0', '0.0.1'],
+  ]) {
+    if (below !== null) assert.equal(satisfies(below, range), false);
+    assert.equal(satisfies(base, range), true);
+    assert.equal(satisfies(within, range), true);
+    assert.equal(satisfies(upper, range), false);
+    assert.equal(satisfies('9.0.0', range), false);
+  }
+});
+
+test('tilde admits patch updates but excludes the next minor', () => {
+  for (const range of ['~1.2.3', '~0.2.3']) {
+    const major = range[1];
+    assert.equal(satisfies(`${major}.2.2`, range), false);
+    assert.equal(satisfies(`${major}.2.3`, range), true);
+    assert.equal(satisfies(`${major}.2.99`, range), true);
+    assert.equal(satisfies(`${major}.3.0`, range), false);
+  }
+});
+
+test('safe integer boundary versions work in caret and tilde ranges', () => {
+  const max = Number.MAX_SAFE_INTEGER;
+  for (const version of [`${max}.0.0`, `0.${max}.0`, `0.0.${max}`]) {
+    assert.equal(satisfies(version, `^${version}`), true);
+    assert.equal(satisfies(version, `~${version}`), true);
+  }
+  assert.equal(satisfies(`0.${max}.${max}`, `^0.${max}.0`), true);
+  assert.equal(satisfies('1.0.0', `^0.${max}.0`), false);
+  assert.equal(satisfies('0.1.0', `^0.0.${max}`), false);
+});
+
+test('exact, wildcard, and comparison terms are combined with AND', () => {
+  const cases = [
+    ['1.2.3', '1.2.3', true], ['1.2.4', '1.2.3', false], ['0.0.0', '*', true],
+    ['1.2.3', '>=1.2.3', true], ['1.2.2', '>=1.2.3', false],
+    ['1.2.3', '>1.2.3', false], ['1.2.4', '>1.2.3', true],
+    ['1.2.3', '<=1.2.3', true], ['1.2.4', '<=1.2.3', false],
+    ['1.2.3', '<1.2.3', false], ['1.2.2', '<1.2.3', true],
+    ['1.5.0', ' \t>=1.0.0\n<2.0.0 * \r', true],
+    ['2.0.0', '>=1.0.0 <2.0.0', false],
+    ['1.2.3', '>1.2.3 <1.2.3', false],
+  ];
+  for (const [version, range, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} / ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected);
+  }
+});
+
+test('malformed ranges are rejected eagerly, including terms after a wildcard', () => {
+  for (const range of [
+    null, 1, {}, [], '', ' \t\n', '^', '~', '>=', '1.2', '^01.2.3',
+    '=>1.2.3', '==1.2.3', '1.2.3 || 2.0.0', '1.2.3 - 2.0.0',
+    '>= 1.2.3', '* invalid', '<9007199254740992.0.0',
+  ]) {
+    assert.throws(() => compileRange(range), TypeError, String(range));
+    assert.throws(() => satisfies('1.2.3', range), TypeError, String(range));
+  }
+  assert.throws(() => satisfies('1.2.3\n', '*'), TypeError);
+});
