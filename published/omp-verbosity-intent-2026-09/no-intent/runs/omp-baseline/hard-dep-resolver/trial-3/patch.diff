+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { compare, satisfies } = require('./semver');
+
+test('orders every version component numerically', () => {
+  for (const [older, newer] of [
+    ['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10'],
+    ['9007199254740990.0.0', '9007199254740991.0.0'],
+  ]) {
+    assert.deepEqual(resolve({ a: { [older]: {}, [newer]: {} } }, { a: '*' }), { a: newer });
+  }
+});
+
+test('backtracking removes rejected dependencies and restores shared constraints', () => {
+  const registry = {
+    a: { '2.0.0': { x: '>=2.0.0', missing: '*' }, '1.0.0': { x: '<2.0.0' } },
+    x: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', x: '*' }), { a: '1.0.0', x: '1.0.0' });
+});
+
+test('undoes partially discovered dependencies on an immediate selected conflict', () => {
+  const registry = {
+    a: { '2.0.0': {} },
+    b: { '2.0.0': { missing: '*', a: '<2.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('FIFO root processing precedes dependency choices, rather than maximizing every version', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '2.0.0', c: '1.0.0',
+  });
+});
+
+test('dependency discovery collects sibling constraints before processing the next name', () => {
+  const registry = {
+    a: { '1.0.0': { b: '*', c: '*' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+    c: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', c: '*' }), {
+    a: '1.0.0', c: '2.0.0', b: '1.0.0',
+  });
+});
+
+test('backtracks to the most recent choice before changing an earlier version', () => {
+  const registry = {
+    a: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    b: { '2.0.0': { c: '1.0.0' }, '1.0.0': { c: '2.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '2.0.0',
+  });
+});
+
+test('cycles expand each selected version once and can backtrack', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '2.0.0' } } }, { a: '*' }), null);
+});
+
+test('handles long cyclic chains without recursion or an iteration cutoff', () => {
+  const size = 12000;
+  const registry = {};
+  for (let i = 0; i < size; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % size}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, size);
+  for (let i = 0; i < size; i += 1) assert.equal(result[`p${i}`], '1.0.0');
+});
+
+test('unwinds a long failed branch without retaining unreachable selections', () => {
+  const registry = { a: { '2.0.0': { p0: '*' }, '1.0.0': {} } };
+  const size = 12000;
+  for (let i = 0; i < size; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [i + 1 === size ? 'missing' : `p${i + 1}`]: '*' } };
+  }
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0' });
+});
+
+test('checks discovered constraints before exploring a Cartesian product', { timeout: 5000 }, () => {
+  const registry = {};
+  const root = {};
+  for (let i = 0; i < 80; i += 1) {
+    root[`p${i}`] = '*';
+    registry[`p${i}`] = { '2.0.0': { [`p${i}`]: '1.0.0' }, '1.0.0': {} };
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.keys(result).length, 80);
+  assert.ok(Object.values(result).every(version => version === '1.0.0'));
+});
+
+test('missing packages and contradictory constraints are unsatisfiable', () => {
+  assert.equal(resolve({}, { absent: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.equal(resolve({ a: { '1.0.0': {} } }, { a: '>1.0.0 <1.0.0' }), null);
+  assert.deepEqual(resolve({ a: { '1.0.0': { absent: '*' } } }, {}), {});
+});
+
+test('eagerly validates maps, versions, and ranges even when unreachable', () => {
+  for (const invalid of [null, [], 1, 'map', new Date(), Object.create({ inherited: true })]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0\n': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { missing: 'bad' } } }, {}), TypeError);
+  assert.throws(() => resolve({ a: { '2.0.0': {}, '1.0.0': { missing: 'bad' } } }, { a: '*' }), TypeError);
+  assert.throws(() => resolve({}, { missing: 'bad' }), TypeError);
+});
+
+test('only own enumerable string keys participate at every map level', () => {
+  const ignored = record => {
+    Object.defineProperty(record, 'ignored', { value: null });
+    record[Symbol('ignored')] = null;
+    return record;
+  };
+  const registry = ignored({ a: ignored({ '1.0.0': ignored({}) }) });
+  assert.deepEqual(resolve(registry, ignored({ a: '*' })), { a: '1.0.0' });
+});
+
+test('accepts null-prototype maps and preserves special names as own result properties', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+    root[name] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), Object.keys(root));
+  for (const name of Object.keys(root)) {
+    assert.ok(Object.hasOwn(result, name));
+    assert.equal(result[name], '1.0.0');
+  }
+});
+
+test('does not mutate frozen inputs', () => {
+  const registry = Object.freeze({
+    a: Object.freeze({ '1.0.0': Object.freeze({ b: '^0.2.0' }) }),
+    b: Object.freeze({ '0.3.0': Object.freeze({}), '0.2.9': Object.freeze({}) }),
+  });
+  const root = Object.freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0', b: '0.2.9' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0', b: '0.2.9' });
+});
+
+// An intentionally small immutable reference search checks exact first-found
+// results, independently of the production solver's mutable trail and frames.
+function referenceResolve(registry, root) {
+  const requirements = record => Object.entries(record).map(([name, range]) => ({ name, range }));
+  function search(queue, cursor, selected) {
+    for (const { name, range } of queue) {
+      if (selected.has(name) && !satisfies(selected.get(name), range)) return null;
+    }
+    if (cursor === queue.length) return Object.fromEntries(selected);
+    const { name } = queue[cursor];
+    if (selected.has(name)) return search(queue, cursor + 1, selected);
+    const versions = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of versions) {
+      if (!queue.every(item => item.name !== name || satisfies(version, item.range))) continue;
+      const next = new Map(selected);
+      next.set(name, version);
+      const result = search(queue.concat(requirements(registry[name][version])), cursor + 1, next);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(requirements(root), 0, new Map());
+}
+
+test('matches first-found reference search on seeded branching and cyclic registries', () => {
+  let seed = 123456789;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return Math.floor((seed / 0x100000000) * limit);
+  };
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=1.0.0', '<2.0.0'];
+  for (let iteration = 0; iteration < 300; iteration += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0']) {
+        const deps = {};
+        for (const dependency of [...names, 'missing']) {
+          if (random(5) === 0) deps[dependency] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names) {
+      if (random(2) === 0) root[name] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `case ${iteration}`);
+  }
+});
