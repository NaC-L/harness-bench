@@ -0,0 +1,126 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('arithmetic follows the documented precedence and associativity', () => {
+  const cases = [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25], ['--2 ** 2', 4], ['2 * -3 ** 2', -18],
+    ['2 ** +3 * 4', 32], ['10 - 3 - 2', 5], ['16 / 4 / 2', 2],
+    ['20 // 3 * 2 % 5', 2], ['1 + 2 * 3 ** 2', 19],
+    ['.5 + 5. + 1.5e-3 + 2E+1', 25.5015],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and remainder follow Python, including floating-point rounding', () => {
+  for (let a = -15; a <= 15; a++) {
+    for (let b = -7; b <= 7; b++) {
+      if (!b) continue;
+      const variables = { a, b };
+      const quotient = evaluate('a // b', variables);
+      const remainder = evaluate('a % b', variables);
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (quotient === 0) assert.equal(Object.is(quotient, -0), false);
+      if (remainder === 0) assert.equal(Object.is(remainder, -0), false);
+    }
+  }
+  const cases = [
+    ['1 // 0.1', 9], ['-1 // 0.1', -10], ['1 // -0.1', -10],
+    ['-1 // -0.1', 9], ['5.5 // 2', 2], ['-5.5 // 2', -3],
+    ['-5.5 % 2', 0.5], ['5.5 % -2', -0.5],
+    ['-0 // 2', 0], ['-0 % -2', 0], ['4 % -2', 0],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('comparisons chain and coerce parenthesized booleans in numeric contexts', () => {
+  const cases = [
+    ['3 < 2 < 1', false], ['3 > 2 > 1', true], ['1 < 2 <= 2 != 3', true],
+    ['1 == 1 >= 1 > 0', true], ['1 > 2 == 0', false],
+    ['(1 < 2) + (3 < 2)', 1], ['(1 < 2) == 1', true],
+    ['(1 > 2) == 0', true], ['(1 < 2) ** 3', 1],
+    ['1 < 2 + 3 * 4', true], ['abs(-(2 < 3))', 1],
+    ['min(3, 1 < 2, 2)', 1], ['max(0, 1 < 2)', 1],
+    ['3 < 2 < missing', false], ['3 < 2 < 1 / 0', false],
+    ['(3 < 2) < 1', true],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('variables and arguments are read once per occurrence, in evaluation order', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('d < c < b < a', variables), false);
+  assert.deepEqual(reads.splice(0), ['d', 'c']);
+  assert.equal(evaluate('max(a + b, c * d, abs(-a))', variables), 12);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd', 'a']);
+  assert.equal(evaluate('a + a', variables), 2);
+  assert.deepEqual(reads, ['a', 'a']);
+  errorAt('inherited', 1, Object.create({ inherited: 7 }));
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('_x1', { _x1: 9 }), 9);
+});
+
+test('invalid syntax is rejected before evaluating any part of the formula', () => {
+  let reads = 0;
+  const variables = { get a() { reads++; return 1; } };
+  for (const [source, column] of [
+    ['a + nope(1)', 5], ['a + abs()', 5], ['a + abs(1, 2)', 5],
+    ['a + min()', 5], ['a + max()', 5], ['a < 0 < abs()', 9],
+    ['a + abs(1,)', 11], ['a + 2 3', 7], ['a + (2', 7],
+    ['a + 2)', 6], ['a + 2(3)', 6], ['a = 2', 3],
+    ['a + "2"', 5], ['a + .', 5], ['a + 1e', 6],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('error columns point to tokens after whitespace and use UTF-16 offsets', () => {
+  for (const [source, column] of [
+    ['  missing', 3], ['1 +   missing', 7], ['1 +   @', 7],
+    ['1 +\t😀', 5], ['1 +   * 2', 7], ['1  2', 4],
+    ['  nope(1)', 3], ['  abs(1, 2)', 3], ['abs(1,  )', 9],
+    ['', 1], ['   ', 4], ['1 +  ', 6], ['(1  ', 5],
+    ['1 +\n\t', 6],
+    ['1   / 0', 5], ['1   // -0', 5], ['1   % (2 - 2)', 5],
+  ]) errorAt(source, column);
+});
+
+test('long flat arithmetic, comparisons, and calls remain linear and stack-safe', () => {
+  const count = 100001;
+  const formulas = [
+    [Array(count).fill('1').join('+'), count],
+    [Array(count).fill('1').join('*'), 1],
+    [Array(count).fill('1').join('=='), true],
+    [`min(${Array(count).fill('1').join(',')})`, 1],
+  ];
+  for (const [source, expected] of formulas) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected);
+    const elapsed = performance.now() - start;
+    assert.ok(elapsed < 1000, `100,001 operands took ${elapsed.toFixed(1)}ms`);
+  }
+});
