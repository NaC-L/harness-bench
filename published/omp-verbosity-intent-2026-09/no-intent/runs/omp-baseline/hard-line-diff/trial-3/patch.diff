@@ -0,0 +1,162 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+// A small, independent oracle; the production algorithm must not use this table.
+function lcsLength(a, b) {
+  const lengths = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0));
+  for (let i = 1; i <= a.length; i++) {
+    for (let j = 1; j <= b.length; j++) {
+      lengths[i][j] = a[i - 1] === b[j - 1]
+        ? lengths[i - 1][j - 1] + 1
+        : Math.max(lengths[i - 1][j], lengths[i][j - 1]);
+    }
+  }
+  return lengths[a.length][b.length];
+}
+
+function verifyScript(a, b, script) {
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let sawInsert = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') sawInsert = false;
+    if (entry.op === 'insert') sawInsert = true;
+    if (entry.op === 'delete') assert.equal(sawInsert, false);
+  }
+}
+
+function freezeHunks(hunks) {
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  return Object.freeze(hunks);
+}
+
+test('exhaustive short repetitive inputs have minimal ordered scripts and patch roundtrips', () => {
+  const inputs = [Object.freeze([])];
+  let layer = inputs.slice();
+  for (let length = 1; length <= 4; length++) {
+    layer = layer.flatMap(lines => ['', 'x', '-x'].map(line => Object.freeze([...lines, line])));
+    inputs.push(...layer);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      const script = diffLines(a, b);
+      verifyScript(a, b, script);
+      assert.deepEqual(diffLines(a, b), script);
+      for (const context of [0, 1, 3]) {
+        const hunks = freezeHunks(unifiedHunks(a, b, { context }));
+        assert.deepEqual(applyHunks(a, hunks), b);
+        if (a.length === b.length && a.every((line, i) => line === b[i])) {
+          assert.deepEqual(hunks, []);
+        }
+      }
+    }
+  }
+});
+
+test('zero-line ranges use preceding line coordinates at every boundary', () => {
+  const cases = [
+    [[], ['+value'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['++value'] }],
+    [['-value'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['--value'] }],
+    [['a', 'b'], ['x', 'a', 'b'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a', 'b'], ['a', 'x', 'b'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['a', 'b'], ['a', 'b', 'x'], { oldStart: 2, oldLines: 0, newStart: 3, newLines: 1, lines: ['+x'] }],
+    [['x', 'a', 'b'], ['a', 'b'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x', 'b'], ['a', 'b'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+    [['a', 'b', 'x'], ['a', 'b'], { oldStart: 3, oldLines: 1, newStart: 2, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, hunk] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [hunk]);
+    assert.deepEqual(applyHunks(a, [hunk]), b);
+  }
+});
+
+test('context windows merge exactly when they touch, without duplicated context', () => {
+  for (const gap of [0, 1, 4, 5, 9]) {
+    const middle = Array.from({ length: gap }, (_, i) => `middle ${i}`);
+    const a = ['head', 'old first', ...middle, 'old last', 'tail'];
+    const b = ['head', 'new first', ...middle, 'new last', 'tail'];
+    const hunks = unifiedHunks(a, b, { context: 2 });
+    assert.equal(hunks.length, gap <= 4 ? 1 : 2);
+    const contextLines = hunks.flatMap(hunk => hunk.lines.filter(line => line[0] === ' '));
+    assert.equal(new Set(contextLines).size, contextLines.length);
+    if (gap <= 4) {
+      assert.equal(hunks[0].oldStart, 1);
+      assert.equal(hunks[0].newStart, 1);
+      assert.equal(hunks[0].oldLines, a.length);
+      assert.equal(hunks[0].newLines, b.length);
+    }
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+});
+
+test('separate hunks retain original coordinates and cumulative new offsets', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd', 'e']);
+  const b = ['x', 'a', 'b', 'd', 'e', 'y'];
+  const hunks = freezeHunks(unifiedHunks(a, b, { context: 0 }));
+  assert.deepEqual(hunks, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 3, oldLines: 1, newStart: 3, newLines: 0, lines: ['-c'] },
+    { oldStart: 5, oldLines: 0, newStart: 6, newLines: 1, lines: ['+y'] },
+  ]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('malformed or nonapplicable hunks identify the failing index', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const malformed = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+B'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: 4 }, { ...valid, oldLines: 2 },
+    { ...valid, newLines: 2 }, { ...valid, newStart: 3 },
+    { ...valid, newLines: Infinity }, { ...valid, oldLines: NaN },
+    { ...valid, lines: ['-b', '+B', '+extra'] },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of malformed) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const earlier = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ['-a', '+A'] };
+  assert.throws(() => applyHunks(a, [valid, earlier]), /hunk 1 does not apply/);
+  const insert = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] };
+  assert.throws(() => applyHunks(a, [insert, valid]), /hunk 1 does not apply/);
+  const afterInsert = { ...valid, newStart: 3 };
+  assert.deepEqual(applyHunks(a, [insert, afterInsert]), ['x', 'a', 'B', 'c']);
+});
+
+test('small changes in 20,000 unique or repetitive lines are fast and roundtrip', () => {
+  for (const repetitive of [false, true]) {
+    const a = Object.freeze(Array.from({ length: 20000 }, (_, i) => repetitive ? `line ${i % 3}` : `line ${i}`));
+    const b = a.slice();
+    b.splice(100, 1, 'replacement');
+    b.splice(10000, 0, 'inserted');
+    b.splice(19000, 1);
+    Object.freeze(b);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = freezeHunks(unifiedHunks(a, b));
+    const patched = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 4);
+    assert.deepEqual(patched, b);
+    assert.ok(elapsed < 1000, `small diff took ${elapsed.toFixed(1)} ms`);
+    assert.deepEqual(unifiedHunks(a, a), []);
+  }
+});
