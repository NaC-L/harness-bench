+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./range-tree');
+
+test('assignment discards older additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(3, 7, -10);
+  tree.assign(0, 7, 0);
+  tree.add(0, 7, -4);
+  assert.equal(tree.sum(1, 6), -20);
+  assert.deepEqual(tree.toArray(), Array(7).fill(-4));
+  tree.add(0, 7, 12);
+  tree.assign(0, 7, -6);
+  tree.assign(2, 5, 3);
+  assert.deepEqual(tree.toArray(), [-6, -6, 3, 3, 3, -6, -6]);
+});
+
+test('partial maxima use the identity for negative values', () => {
+  const tree = new RangeTree([-9, -2, -7, -5, -3]);
+  assert.equal(tree.max(0, 1), -9);
+  assert.equal(tree.max(2, 5), -3);
+  tree.assign(0, 5, -12);
+  tree.add(1, 4, 2);
+  assert.equal(tree.max(0, 4), -10);
+  assert.equal(tree.max(4, 5), -12);
+});
+
+test('threshold search pushes assignments and additions before descending', () => {
+  const raised = new RangeTree([-8, -7, -6, -5, -4]);
+  raised.add(0, 5, 10);
+  assert.equal(raised.firstAtLeast(0, 4), 2);
+  assert.equal(raised.firstAtLeast(3, 4), 3);
+  assert.equal(raised.firstAtLeast(0, 7), -1);
+
+  const lowered = new RangeTree([9, 8, 7, 6, 5]);
+  lowered.assign(0, 5, -3);
+  assert.equal(lowered.firstAtLeast(0, -2), -1);
+  lowered.add(0, 5, 5);
+  assert.equal(lowered.firstAtLeast(2, 2), 2);
+  lowered.add(0, 5, -10);
+  lowered.assign(0, 5, 0);
+  assert.equal(lowered.firstAtLeast(1, 0), 1);
+  assert.equal(lowered.firstAtLeast(0, Infinity), -1);
+  assert.equal(lowered.firstAtLeast(4, -Infinity), 4);
+  assert.equal(lowered.firstAtLeast(5, -Infinity), -1);
+});
+
+test('empty ranges, singleton trees, copying, and read-only length retain their API', () => {
+  const input = [2];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.get(0), 2);
+  assert.equal(tree.length, 1);
+  assert.throws(() => { tree.length = 4; }, TypeError);
+  assert.equal(tree.assign(0, 1, -4), undefined);
+  assert.equal(tree.add(0, 1, 1), undefined);
+  for (const endpoint of [0, 1]) {
+    assert.equal(tree.assign(endpoint, endpoint, 7), undefined);
+    assert.equal(tree.add(endpoint, endpoint, 8), undefined);
+    assert.equal(tree.sum(endpoint, endpoint), 0);
+    assert.equal(tree.max(endpoint, endpoint), -Infinity);
+  }
+  assert.equal(tree.get(0), -3);
+  assert.equal(tree.firstAtLeast(0, -3), 0);
+  assert.equal(tree.firstAtLeast(0, -2), -1);
+  const output = tree.toArray();
+  output[0] = 100;
+  assert.deepEqual(tree.toArray(), [-3]);
+});
+
+test('invalid arguments throw RangeError without changing stored values', () => {
+  for (const input of [undefined, null, {}, '12', new Float64Array([1]), [],
+    [NaN], [Infinity], [-Infinity], ['1'], [null], Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const tree = new RangeTree([1, 2, 3]);
+  tree.add(0, 3, 4);
+  for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, 1.5],
+    [NaN, 2], [0, Infinity], ['0', 2], [0, undefined]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 8), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const threshold of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), [5, 6, 7]);
+});
+
+test('mixed updates and queries agree with a seeded array oracle', () => {
+  let seed = 0x7a39b621;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 5, 7, 8, 9, 16, 17, 31, 32, 33, 65]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 600; step++) {
+      const a = random(length + 1);
+      const b = random(length + 1);
+      const l = step % 7 === 0 ? 0 : Math.min(a, b);
+      const r = step % 7 === 0 ? length : Math.max(a, b);
+      const value = random(41) - 20;
+      const operation = random(8);
+      const context = `length=${length}, step=${step}, operation=${operation}`;
+      if (operation < 3) {
+        const assigning = operation === 0;
+        assert.equal(tree[assigning ? 'assign' : 'add'](l, r, value), undefined);
+        for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+      } else if (operation === 3) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0), context);
+      } else if (operation === 4) {
+        assert.equal(tree.max(l, r), Math.max(-Infinity, ...values.slice(l, r)), context);
+      } else if (operation === 5) {
+        const x = step % 11 === 0 ? Infinity : step % 13 === 0 ? -Infinity : value;
+        assert.equal(tree.firstAtLeast(l, x), values.findIndex((v, i) => i >= l && v >= x), context);
+      } else if (operation === 6) {
+        const index = random(length);
+        assert.equal(tree.get(index), values[index], context);
+      } else {
+        assert.deepEqual(tree.toArray(), values, context);
+      }
+    }
+    // Search before materialization, so lazy search defects cannot be masked by toArray().
+    for (let lo = 0; lo <= length; lo++) {
+      for (const x of [-Infinity, -20, 0, 20, Infinity]) {
+        assert.equal(tree.firstAtLeast(lo, x), values.findIndex((v, i) => i >= lo && v >= x));
+      }
+    }
+    for (let l = 0; l <= length; l++) {
+      for (let r = l; r <= length; r++) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0));
+        assert.equal(tree.max(l, r), Math.max(-Infinity, ...values.slice(l, r)));
+      }
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
