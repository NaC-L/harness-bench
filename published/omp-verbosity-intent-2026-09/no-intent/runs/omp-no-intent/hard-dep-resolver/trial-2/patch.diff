+++ "{temp}\\hb-071472a9-ny3ph0of/resolver-contract.test.js"
@@ -0,0 +1,265 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+const { parse, compare, satisfies, compileRange } = require('./src/semver');
+
+function record(entries) {
+  return Object.fromEntries(entries);
+}
+
+// A small, deliberately independent oracle: copy each branch's complete queue
+// and assignment. Recursion is confined to these tiny test registries.
+function firstFound(registry, root) {
+  function search(queue, cursor, selected) {
+    if (cursor === queue.length) return record(selected);
+    const [name] = queue[cursor];
+    if (selected.has(name)) return search(queue, cursor + 1, selected);
+    const candidates = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of candidates) {
+      if (!queue.every(([dependency, range]) => dependency !== name || satisfies(version, range))) continue;
+      const nextSelected = new Map(selected).set(name, version);
+      const nextQueue = queue.concat(Object.entries(registry[name][version]));
+      if (!nextQueue.every(([dependency, range]) => !nextSelected.has(dependency)
+        || satisfies(nextSelected.get(dependency), range))) continue;
+      const result = search(nextQueue, cursor + 1, nextSelected);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(Object.entries(root), 0, new Map());
+}
+
+test('numeric candidate ordering covers every version component', () => {
+  for (const [older, newer] of [['9.0.0', '10.0.0'], ['1.9.0', '1.10.0'], ['1.0.9', '1.0.10']]) {
+    const registry = { pkg: record([[older, {}], [newer, {}]]) };
+    assert.deepEqual(resolve(registry, { pkg: '*' }), { pkg: newer });
+    assert.equal(compare(older, newer), -1);
+    assert.equal(compare(newer, older), 1);
+    assert.equal(compare(newer, newer), 0);
+  }
+});
+
+test('caret and tilde ranges use the specified exclusive upper bounds', () => {
+  const cases = [
+    ['^1.2.3', '1.2.2', false], ['^1.2.3', '1.2.3', true],
+    ['^1.2.3', '1.99.99', true], ['^1.2.3', '2.0.0', false],
+    ['^0.2.3', '0.2.2', false], ['^0.2.3', '0.2.3', true],
+    ['^0.2.3', '0.2.99', true], ['^0.2.3', '0.3.0', false],
+    ['^0.0.3', '0.0.2', false], ['^0.0.3', '0.0.3', true],
+    ['^0.0.3', '0.0.4', false], ['^0.0.3', '0.1.0', false],
+    ['^0.0.0', '0.0.0', true], ['^0.0.0', '0.0.1', false],
+    ['~0.0.3', '0.0.99', true], ['~0.0.3', '0.1.0', false],
+    ['~1.2.3', '1.2.2', false], ['~1.2.3', '1.2.99', true],
+    ['~1.2.3', '1.3.0', false],
+    ['  >=1.2.3\t<2.0.0 *  ', '1.9.0', true],
+    ['>=1.2.3 <2.0.0', '2.0.0', false],
+    ['>1.2.3 <=1.2.5', '1.2.3', false],
+    ['>1.2.3 <=1.2.5', '1.2.5', true],
+    ['1.2.3', '1.2.3', true], ['1.2.3', '1.2.4', false],
+  ];
+  for (const [range, version, expected] of cases) {
+    assert.equal(satisfies(version, range), expected, `${version} in ${range}`);
+    assert.equal(compileRange(range)(parse(version)), expected);
+  }
+  const max = Number.MAX_SAFE_INTEGER;
+  for (const range of [`^${max}.0.0`, `~0.${max}.0`, `^0.0.${max}`]) {
+    assert.equal(satisfies(range.slice(1), range), true);
+  }
+  assert.deepEqual(resolve({ pkg: { '0.2.9': {}, '0.3.0': {} } }, { pkg: '^0.2.3' }), { pkg: '0.2.9' });
+});
+
+test('invalid versions and ranges throw eagerly', () => {
+  const versions = [null, 1, '', '1.2', '01.2.3', '1.02.3', '1.2.03', '-1.2.3',
+    '1.2.3-beta', '1.2.3+build', ' 1.2.3', '1.2.3 ', '1.2.3\n', '1.2.3\r',
+    '1.2.3\r\n', '9007199254740992.0.0'];
+  for (const version of versions) {
+    assert.throws(() => parse(version), TypeError);
+    assert.throws(() => compare('1.0.0', version), TypeError);
+    assert.throws(() => satisfies(version, '*'), TypeError);
+    if (typeof version === 'string') {
+      assert.throws(() => resolve({ unreachable: record([[version, {}]]) }, {}), TypeError);
+    }
+  }
+  const ranges = [null, 1, '', ' \t\n', '1', '1.2', '1.x', '>= 1.2.3',
+    '=>1.2.3', '==1.2.3', '^', '~', '1.2.3 || 2.0.0', '* invalid', '^01.2.3'];
+  for (const range of ranges) {
+    assert.throws(() => compileRange(range), TypeError);
+    assert.throws(() => satisfies('1.2.3', range), TypeError);
+    assert.throws(() => resolve({ unreachable: { '1.0.0': { missing: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { missing: range }), TypeError);
+  }
+});
+
+test('maps must be plain records, including unreachable version maps and dependencies', () => {
+  for (const invalid of [null, [], 1, 'map', new Map(), new Date(), Object.create({ inherited: true })]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unreachable: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unreachable: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.deepEqual(resolve({}, {}), {});
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ empty: {} }, { empty: '*' }), null);
+});
+
+test('only own enumerable string keys participate; special names remain plain own properties', () => {
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = Object.assign(Object.create(null), { '1.0.0': Object.create(null) });
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'hidden', { value: null });
+  registry[Symbol('ignored')] = null;
+  Object.defineProperty(root, 'hidden', { value: null });
+  root[Symbol('ignored')] = null;
+  Object.defineProperty(registry.__proto__, 'invalid', { value: null });
+  registry.__proto__[Symbol('ignored')] = null;
+  Object.defineProperty(registry.__proto__['1.0.0'], 'hidden', { value: null });
+  registry.__proto__['1.0.0'][Symbol('ignored')] = null;
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) {
+    assert.equal(Object.hasOwn(result, name), true);
+    assert.equal(result[name], '1.0.0');
+    assert.deepEqual(Object.getOwnPropertyDescriptor(result, name), {
+      value: '1.0.0', enumerable: true, writable: true, configurable: true,
+    });
+  }
+});
+
+test('discovery collects all constraints before FIFO processing', () => {
+  const registry = {
+    a: { '1.0.0': { shared: '*' } },
+    b: { '1.0.0': { shared: '1.0.0' } },
+    shared: { '1.0.0': {}, '2.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '1.0.0', shared: '1.0.0',
+  });
+});
+
+test('root order, dependency order and immediate conflicts determine the first solution', () => {
+  const registry = {
+    a: { '2.0.0': { shared: '2.0.0' }, '1.0.0': { shared: '1.0.0' } },
+    b: { '2.0.0': { shared: '1.0.0' }, '1.0.0': { shared: '2.0.0' } },
+    shared: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0', shared: '2.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0', shared: '1.0.0' });
+  registry.app = { '1.0.0': { a: '*', b: '*' } };
+  assert.deepEqual(resolve(registry, { app: '*' }), { app: '1.0.0', a: '2.0.0', b: '1.0.0', shared: '2.0.0' });
+  registry.app['1.0.0'] = { b: '*', a: '*' };
+  assert.deepEqual(resolve(registry, { app: '*' }), { app: '1.0.0', b: '2.0.0', a: '1.0.0', shared: '1.0.0' });
+
+  const immediate = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(immediate, { a: '*', b: '*', c: '*' }), { a: '2.0.0', b: '1.0.0', c: '1.0.0' });
+});
+
+test('backtracking removes abandoned constraints, queued dependencies and descendant choices', () => {
+  const registry = {
+    a: {
+      '2.0.0': { b: '1.0.0', missing: '*' },
+      '1.0.0': { b: '2.0.0' },
+    },
+    b: { '1.0.0': { abandoned: '*' }, '2.0.0': {} },
+    abandoned: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '1.0.0', b: '2.0.0' });
+
+  const partial = {
+    a: {
+      '3.0.0': { ghost: '*', a: '1.0.0', never: '*' },
+      '2.0.0': { a: '1.0.0' },
+      '1.0.0': {},
+    },
+  };
+  assert.deepEqual(resolve(partial, { a: '*' }), { a: '1.0.0' });
+  assert.equal(resolve(partial, { a: '>=2.0.0' }), null);
+});
+
+test('cycles are expanded once and conflicting cycles backtrack', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': { b: '*' } },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve(registry, { a: '2.0.0', b: '2.0.0' }), null);
+});
+
+test('inputs are not mutated, even during backtracking', () => {
+  const low = Object.freeze({});
+  const high = Object.freeze({ missing: '*' });
+  const versions = Object.freeze({ '2.0.0': high, '1.0.0': low });
+  const registry = Object.freeze({ a: versions });
+  const root = Object.freeze({ a: '*' });
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0' });
+  assert.deepEqual(registry, { a: { '2.0.0': { missing: '*' }, '1.0.0': {} } });
+  assert.deepEqual(root, { a: '*' });
+});
+
+test('long chains and long cycles do not depend on recursion or an iteration cap', () => {
+  const size = 12000;
+  const registry = {};
+  for (let i = 0; i < size; i += 1) {
+    registry[`p${i}`] = { '1.0.0': i + 1 < size ? { [`p${i + 1}`]: '*' } : {} };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, size);
+  assert.equal(result[`p${size - 1}`], '1.0.0');
+  registry[`p${size - 1}`]['1.0.0'] = { p0: '*' };
+  assert.deepEqual(resolve(registry, { p0: '*' }), result);
+  registry[`p${size - 1}`]['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('known conflicts prune choices without enumerating a Cartesian product', () => {
+  const registry = { guard: { '2.0.0': {}, '1.0.0': {} } };
+  const root = { guard: '*' };
+  const expected = { guard: '2.0.0' };
+  for (let i = 0; i < 40; i += 1) {
+    const name = `p${i}`;
+    registry[name] = { '2.0.0': { guard: '1.0.0' }, '1.0.0': { guard: '2.0.0' } };
+    root[name] = '*';
+    expected[name] = '1.0.0';
+  }
+  assert.deepEqual(resolve(registry, root), expected);
+});
+
+test('first-found results match an independent oracle on seeded small cyclic registries', () => {
+  let seed = 0x51a7;
+  function random(limit) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return Math.floor((seed / 0x100000000) * limit);
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '>=2.0.0', '<2.0.0', '^1.0.0'];
+  for (let iteration = 0; iteration < 300; iteration += 1) {
+    const registry = {};
+    for (const name of names) {
+      const versions = {};
+      for (const version of ['1.0.0', '2.0.0', '10.0.0']) {
+        const deps = {};
+        for (let edge = 0, count = random(4); edge < count; edge += 1) {
+          deps[random(8) === 0 ? 'missing' : names[random(names.length)]] = ranges[random(ranges.length)];
+        }
+        versions[version] = deps;
+      }
+      registry[name] = versions;
+    }
+    const root = {};
+    for (let i = 0, count = 1 + random(3); i < count; i += 1) {
+      root[names[random(names.length)]] = ranges[random(ranges.length)];
+    }
+    assert.deepEqual(resolve(registry, root), firstFound(registry, root), `fixture ${iteration}`);
+  }
+});
