+  deps.b = { '2.0.0': { d: '1.0.0' }, '1.0.0': { d: '2.0.0' } };
+  deps.c = { '2.0.0': { d: '2.0.0' }, '1.0.0': { d: '1.0.0' } };
+  assert.deepEqual(resolve(deps, { a: '*' }), { a: '1.0.0', b: '2.0.0', c: '1.0.0', d: '1.0.0' });
+});
