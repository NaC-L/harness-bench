+  assert.deepEqual(resolve({ p: { '0.2.3': {}, '0.3.0': {}, '0.2.10': {} } }, { p: '^0.2.3' }), { p: '0.2.10' });
+  assert.deepEqual(resolve({ p: { '0.0.3': {}, '0.0.4': {} } }, { p: '^0.0.3' }), { p: '0.0.3' });
+});
