+
+// A small immutable reference search checks selection order as well as existence.
+function referenceResolve(registry, root) {
+  function search(selected, constraints, queue, cursor) {
+    while (cursor < queue.length && Object.hasOwn(selected, queue[cursor])) cursor += 1;
+    if (cursor === queue.length) return selected;
+    const name = queue[cursor];
+    const candidates = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of candidates) {
+      if (!constraints[name].every(range => satisfies(version, range))) continue;
+      const nextSelected = { ...selected, [name]: version };
+      const nextConstraints = Object.fromEntries(Object.entries(constraints).map(([key, ranges]) => [key, [...ranges]]));
+      const nextQueue = [...queue];
+      let valid = true;
+      for (const [dependency, range] of Object.entries(registry[name][version])) {
+        (nextConstraints[dependency] ||= []).push(range);
+        nextQueue.push(dependency);
+        if (Object.hasOwn(nextSelected, dependency) && !satisfies(nextSelected[dependency], range)) valid = false;
+      }
+      if (valid) {
+        const result = search(nextSelected, nextConstraints, nextQueue, cursor + 1);
+        if (result !== null) return result;
+      }
+    }
+    return null;
+  }
+  return search({}, Object.fromEntries(Object.entries(root).map(([name, range]) => [name, [range]])), Object.keys(root), 0);
+}
+
+test('first-found results agree with an independent small-graph reference search', () => {
+  let state = 314159;
+  function random(limit) {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % limit;
+  }
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '3.0.0', '<3.0.0', '>=2.0.0'];
+  for (let trial = 0; trial < 300; trial += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ['1.0.0', '2.0.0', '3.0.0']) {
+        const deps = {};
+        for (const dependency of [...names, 'missing']) {
+          if (random(5) === 0) deps[dependency] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (const name of names) if (random(3) !== 0) root[name] = ranges[random(ranges.length)];
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `trial ${trial}`);
+  }
+});
