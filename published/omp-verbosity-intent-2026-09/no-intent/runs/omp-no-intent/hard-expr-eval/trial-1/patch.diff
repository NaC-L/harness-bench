@@ -0,0 +1,136 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('power follows Python precedence and right associativity', () => {
+  for (const [source, expected] of [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625], ['2 ** --2', 4],
+    ['3 * -2 ** 2', -12], ['--2 ** 2', 4], ['+2 ** 3', 8],
+    ['20 / 2 * 3', 30], ['20 // 3 % 4', 2], ['10 - 3 - 2', 5],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and remainder agree for all integer sign combinations', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -9; b <= 9; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      assert.equal(Object.is(quotient, -0), false);
+      assert.equal(Object.is(remainder, -0), false);
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`  7  ${operator} -0`, 6);
+    errorAt(`1 ${operator} (2 < 1)`, 3);
+  }
+});
+
+test('comparisons chain, short-circuit, and coerce booleans numerically', () => {
+  for (const [source, expected] of [
+    ['3 < 2 < 1', false], ['1 < 2 <= 2 == 2 != 3 > 0 >= 0', true],
+    ['3 > 2 > 1', true], ['1 + 2 < 2 * 2', true],
+    ['1 < 2 > 3', false], ['2 != 2 < missing', false],
+    ['3 < 2 < (1 / 0)', false], ['(3 < 2) < 1', true],
+    ['(1 < 2) + (2 < 1)', 1], ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true], ['(1 < 2) != 1', false],
+    ['-(1 < 2)', -1], ['2 ** (1 < 2)', 2],
+  ]) assert.equal(evaluate(source), expected, source);
+});
+
+test('getters are read once per occurrence in left-to-right order', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 9 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b < c < d', variables), true);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd']);
+  reads.length = 0;
+  assert.equal(evaluate('c < b < d', variables), false);
+  assert.deepEqual(reads, ['c', 'b']);
+  reads.length = 0;
+  assert.equal(evaluate('max(a + b, abs(-c), min(d, b))', variables), 3);
+  assert.deepEqual(reads, ['a', 'b', 'c', 'd', 'b']);
+  let occurrence = 0;
+  const changing = { get x() { return ++occurrence; } };
+  assert.equal(evaluate('x < x < x', changing), true);
+  assert.equal(occurrence, 3);
+  errorAt('  inherited', 3, variables);
+  errorAt('toString', 1);
+  assert.equal(evaluate('x', Object.assign(Object.create(null), { x: 7 })), 7);
+});
+
+test('the complete formula is parsed before evaluating any variable', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['x + nope(1)', 5], ['x + abs()', 5], ['x + abs(1, 2)', 5],
+    ['x + min()', 5], ['x + max()', 5], ['x + min(1,)', 11],
+    ['x > 2 < abs(1, 2)', 9], ['x > 2 < (1 + )', 14],
+    ['x + 1 2', 7], ['x + 1 @', 7],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('error columns refer to tokens after whitespace and to the full source at EOF', () => {
+  for (const [source, column] of [
+    ['  missing', 3], ['1 +   missing', 7], ['1  2', 4],
+    ['  @', 3], ['1 + \t\n@', 7], ['1 +  \ud83d\ude00', 6],
+    ['\u2003\t?', 3], ['  nope(1)', 3], ['  abs(1, 2)', 3],
+    ['1 +   )', 7], ['min(1,  )', 9], ['  ', 3],
+    ['1 +   ', 7], ['(1   ', 6], ['min(1,   ', 10],
+    ['1 = 2', 3], ['2(3)', 2], ['1;2', 2], ['1e+', 2],
+  ]) errorAt(source, column);
+});
+
+test('numbers, identifiers, and built-in calls retain their contract', () => {
+  assert.equal(evaluate('1.5 + .5 + 5. + 1.5e-3 + 2E+2'), 207.0015);
+  assert.equal(evaluate(' _x2 + A0 ', { _x2: 2, A0: 3 }), 5);
+  assert.equal(evaluate('min(3, 2, -1)'), -1);
+  assert.equal(evaluate('max(-3, -2, -1)'), -1);
+  assert.equal(evaluate('abs(-7)'), 7);
+  assert.equal(evaluate('min(4)'), 4);
+  assert.equal(evaluate('max(4)'), 4);
+  assert.equal(evaluate('min + abs + max', { min: 1, abs: 2, max: 3 }), 6);
+  assert.equal(evaluate('min((1 < 2) + 3, 9)'), 4);
+});
+
+test('100,001-operand flat arithmetic and comparison chains are stack-safe', t => {
+  const count = 100001;
+  for (const [source, expected, label] of [
+    [Array(count).fill('1').join(' + '), count, 'addition'],
+    [Array(count).fill('1').join(' * '), 1, 'multiplication'],
+    [Array(count).fill('1').join(' <= '), true, 'comparison'],
+    [`2 < ${Array(count).fill('1').join(' < ')}`, false, 'short-circuit comparison'],
+    [`max(${Array(count).fill('1').join(',')})`, 1, 'call arguments'],
+  ]) {
+    const start = performance.now();
+    assert.equal(evaluate(source), expected);
+    t.diagnostic(`${label}: ${(performance.now() - start).toFixed(1)} ms`);
+  }
+});
