@@ -0,0 +1,114 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column);
+    return true;
+  });
+}
+
+test('arithmetic follows the documented precedence and associativity', () => {
+  const cases = [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25], ['2 ** -2 ** 2', 0.0625],
+    ['2 * -3 ** 2', -18], ['--2 ** 2', 4], ['2 ** +3', 8],
+    ['10 - 3 - 2', 5], ['24 / 3 * 2', 16], ['20 // 3 % 4', 2],
+    ['1.5 + .5 + 5. + 1.5e-3 + 2E+1', 27.0015],
+    ['max(1, min(3, 2), abs(-4))', 4],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo have Python signs and positive zeros', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -7; b <= 7; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(a, quotient * b + remainder);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      assert.ok(!Object.is(quotient, -0));
+      assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-5.5 // 2'), -3);
+  assert.equal(evaluate('-5.5 % 2'), 0.5);
+  assert.equal(evaluate('5.5 % -2'), -0.5);
+  assert.equal(evaluate('a // b', { a: -0, b: 2 }), 0);
+  assert.equal(evaluate('a % b', { a: -0, b: 2 }), 0);
+  for (const operator of ['/', '//', '%']) {
+    errorAt(`  1  ${operator}  -0`, 6);
+    errorAt(`1 ${operator} (2 < 1)`, 3);
+  }
+});
+
+test('comparisons chain, short-circuit, and coerce booleans numerically', () => {
+  const cases = [
+    ['1 < 2 <= 2 != 3', true], ['3 < 2 < 1', false],
+    ['2 == 2 == 2', true], ['2 != 3 != 3', false],
+    ['3 > 2 >= 2', true], ['1 + 2 < 2 * 2', true],
+    ['(1 < 2) + (2 < 1)', 1], ['(1 < 2) == 1', true],
+    ['(2 < 1) == 0', true], ['(1 < 2) < 2', true],
+    ['(3 < 2) < 1', true], ['min(1 < 2, 2 < 1)', 0],
+    ['1 > 2 < unknown', false], ['1 > 2 < 1 / 0', false],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('each variable occurrence and argument is read once, left to right', () => {
+  const reads = [];
+  const variables = Object.create({ inherited: 42 });
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3], ['d', 4]]) {
+    Object.defineProperty(variables, name, { get() { reads.push(name); return value; } });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b <= c < d', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd']);
+  assert.equal(evaluate('c < b < a < d', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('max(a + b, abs(-c), min(d, a))', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'd', 'a']);
+  assert.equal(evaluate('a + a * b', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'a', 'b']);
+  errorAt('  inherited', 3, variables);
+  errorAt('toString', 1);
+  assert.equal(evaluate('_amount2', Object.assign(Object.create(null), { _amount2: 7 })), 7);
+});
+
+test('syntax is validated before variables or runtime errors are evaluated', () => {
+  let reads = 0;
+  const variables = { get a() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['a + nope(1)', 5], ['a + abs(1, 2)', 5], ['a + min()', 5],
+    ['a + max()', 5], ['a + abs()', 5], ['1 / 0 + nope(1)', 9],
+    ['1 > 2 < abs(1, 2)', 9], ['a + min(1,)', 11], ['a + 2 3', 7],
+  ]) errorAt(source, column, variables);
+  assert.equal(reads, 0);
+});
+
+test('error columns are UTF-16 token offsets, including whitespace at EOF', () => {
+  for (const [source, column] of [
+    ['', 1], [' \t\r\n', 5], ['1 +   ', 7], ['(1 + 2  ', 9],
+    [' \tmissing', 3], ['1 +\n  missing', 7], ['1   @', 5],
+    [' \u2003🙂', 3], ['1 \t +   )', 9], ['  unknown(1)', 3],
+    ['  abs(1,2)', 3], ['2 (3)', 3], ['1 = 2', 3],
+    ['1 ! 2', 3], ['1,2', 2], ['1e+', 2], ['.', 1],
+    ['min(1,)', 7], ['abs(1) 2', 8],
+  ]) errorAt(source, column);
+});
+
+test('long flat formulas evaluate without per-operand recursion', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array.from({ length: count }, (_, i) => i).join('<')), true);
+  assert.equal(evaluate(`max(${Array(count).fill('1').join(',')})`), 1);
+});
