+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+
+// A small independent oracle is intentionally quadratic; production is Myers.
+function editDistance(a, b) {
+  let previous = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 1; i <= a.length; i++) {
+    const row = [i];
+    for (let j = 1; j <= b.length; j++) {
+      row[j] = a[i - 1] === b[j - 1]
+        ? previous[j - 1]
+        : Math.min(previous[j], row[j - 1]) + 1;
+    }
+    previous = row;
+  }
+  return previous[b.length];
+}
+
+function verify(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, editDistance(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+  for (const context of [0, 1, 2, 3, 10]) {
+    const hunks = unifiedHunks(a, b, { context });
+    assert.deepEqual(applyHunks(a, hunks), b);
+    if (a.length === b.length && a.every((line, i) => line === b[i])) {
+      assert.deepEqual(hunks, []);
+    }
+  }
+}
+
+test('minimal deterministic scripts and patch roundtrips for exhaustive repeated lines', () => {
+  const inputs = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'repeat'].map(line => [...lines, line]));
+    inputs.push(...level.map(lines => Object.freeze(lines)));
+  }
+  for (const a of inputs) {
+    for (const b of inputs) verify(a, b);
+  }
+});
+
+test('mixed prefixes, empty lines, and seeded larger repetitive inputs', () => {
+  let seed = 12345;
+  const random = n => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  };
+  const alphabet = ['', 'repeat', ' repeat', '+insert', '-delete'];
+  for (let sample = 0; sample < 250; sample++) {
+    const a = Object.freeze(Array.from({ length: random(25) }, () => alphabet[random(5)]));
+    const b = Object.freeze(Array.from({ length: random(25) }, () => alphabet[random(5)]));
+    verify(a, b);
+  }
+});
+
+test('zero-length ranges name preceding lines in complete-file coordinates', () => {
+  assert.deepEqual(unifiedHunks(['a', 'b'], ['x', 'a', 'b', 'y'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+    { oldStart: 2, oldLines: 0, newStart: 4, newLines: 1, lines: ['+y'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['x', 'a', 'b', 'y'], ['a', 'b'], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] },
+    { oldStart: 4, oldLines: 1, newStart: 2, newLines: 0, lines: ['-y'] },
+  ]);
+});
+
+test('context windows merge at exactly twice context, without duplication', () => {
+  const a = ['before', 'old1', 'gap1', 'gap2', 'old2', 'after'];
+  const b = ['before', 'new1', 'gap1', 'gap2', 'new2', 'after'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' before', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' after'],
+  }]);
+  a.splice(4, 0, 'gap3');
+  b.splice(4, 0, 'gap3');
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+      lines: [' before', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+      lines: [' gap3', '-old2', '+new2', ' after'] },
+  ]);
+});
+
+test('application retains omitted lines and does not mutate inputs or hunks', () => {
+  const a = Object.freeze(['a', '+b', '-c', ' d', 'e']);
+  const b = ['x', 'a', '+b', ' d', 'e', 'y'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+});
+
+test('malformed, mismatched, overlapping, and misordered hunks are rejected', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1,
+    lines: ['-b', '+x'] };
+  const invalid = [
+    null, {}, { ...valid, oldStart: 0 }, { ...valid, oldStart: 5 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldLines: -1 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 3 },
+    { ...valid, newLines: 2 }, { ...valid, lines: ['-wrong', '+x'] },
+    { ...valid, lines: [' b', '+x'] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: [''] }, { ...valid, lines: [null] },
+    { ...valid, lines: '-b' }, { ...valid, lines: ['+x'] },
+    { ...valid, oldLines: 0 }, { ...valid, newLines: 0 },
+    { ...valid, lines: ['-b', '-c', '+x'] },
+    { ...valid, oldStart: Infinity }, { ...valid, newLines: NaN },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, {
+    oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'],
+  }]), /hunk 1 does not apply/);
+});
+
+test('small changes to 20,000-line files remain fast', t => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(15000, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(5000, 0, 'inserted');
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const result = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+    assert.deepEqual(result, b);
+    assert.ok(elapsed < 1000, `small-edit diff took ${elapsed.toFixed(1)}ms`);
+    t.diagnostic(`${repetitive ? 'repetitive' : 'distinct'} lines: ${elapsed.toFixed(1)}ms`);
+  }
+});
