@@ -0,0 +1,185 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+// An intentionally small quadratic oracle, used only to check minimality in tests.
+function editDistance(a, b) {
+  let row = Array(b.length + 1).fill(0);
+  for (const line of a) {
+    const next = [0];
+    for (let j = 0; j < b.length; j++) {
+      next.push(line === b[j] ? row[j] + 1 : Math.max(row[j + 1], next[j]));
+    }
+    row = next;
+  }
+  return a.length + b.length - 2 * row[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, editDistance(a, b));
+  let inserted = false;
+  for (const edit of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(edit.op));
+    if (edit.op === 'equal') inserted = false;
+    if (edit.op === 'insert') inserted = true;
+    if (edit.op === 'delete') assert.equal(inserted, false, 'deletes precede inserts');
+  }
+  assert.deepEqual(diffLines(a, b), script, 'deterministic script');
+  return script;
+}
+
+function checkHunks(a, b, context, script) {
+  const hunks = unifiedHunks(a, b, { context });
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(unifiedHunks(a, b, { context }), hunks);
+  assert.equal(hunks.flatMap(h => h.lines).filter(l => l[0] !== ' ').length,
+    script.filter(e => e.op !== 'equal').length);
+  let oldEnd = 0;
+  let newEnd = 0;
+  for (const hunk of hunks) {
+    assert.equal(hunk.oldLines, hunk.lines.filter(l => l[0] !== '+').length);
+    assert.equal(hunk.newLines, hunk.lines.filter(l => l[0] !== '-').length);
+    const oldIndex = hunk.oldStart - (hunk.oldLines > 0 ? 1 : 0);
+    const newIndex = hunk.newStart - (hunk.newLines > 0 ? 1 : 0);
+    assert.ok(oldIndex >= oldEnd);
+    assert.ok(newIndex >= newEnd);
+    assert.equal(oldIndex - oldEnd, newIndex - newEnd);
+    const oldText = hunk.lines.filter(l => l[0] !== '+').map(l => l.slice(1));
+    const newText = hunk.lines.filter(l => l[0] !== '-').map(l => l.slice(1));
+    assert.deepEqual(oldText, a.slice(oldIndex, oldIndex + hunk.oldLines));
+    assert.deepEqual(newText, b.slice(newIndex, newIndex + hunk.newLines));
+    oldEnd = oldIndex + hunk.oldLines;
+    newEnd = newIndex + hunk.newLines;
+  }
+}
+
+test('exhaustive minimal scripts and hunk roundtrips with repeated and empty lines', () => {
+  const inputs = [Object.freeze([])];
+  for (let length = 1; length <= 4; length++) {
+    for (let mask = 0; mask < 2 ** length; mask++) {
+      inputs.push(Object.freeze(Array.from({ length }, (_, i) => (mask >> i) & 1 ? 'x' : '')));
+    }
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      const script = checkScript(a, b);
+      for (const context of [0, 1, 2, 3]) checkHunks(a, b, context, script);
+    }
+  }
+});
+
+test('seeded mixed-line roundtrips preserve prefix characters and longer edit paths', () => {
+  let seed = 123456;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  const alphabet = ['', 'same', '+plus', '-minus', ' space', '\r', 'λ'];
+  for (let run = 0; run < 400; run++) {
+    const a = Object.freeze(Array.from({ length: random(16) }, () => alphabet[random(alphabet.length)]));
+    const b = Object.freeze(Array.from({ length: random(16) }, () => alphabet[random(alphabet.length)]));
+    const script = checkScript(a, b);
+    checkHunks(a, b, random(6), script);
+  }
+});
+
+test('zero-length coordinates at the top, middle, and end', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd']);
+  const b = Object.freeze(['top', 'a', 'c', 'd', 'end']);
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks, [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] },
+    { oldStart: 2, oldLines: 1, newStart: 2, newLines: 0, lines: ['-b'] },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+end'] },
+  ]);
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  assert.deepEqual(unifiedHunks(['a'], [], { context: 0 }), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-a'] },
+  ]);
+  assert.deepEqual(unifiedHunks([], ['a'], { context: 0 }), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+a'] },
+  ]);
+});
+
+test('context touching and overlapping merges without duplicated equal lines', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i'];
+  const b = ['a', 'B', 'c', 'd', 'e', 'f', 'G', 'h', 'i'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 2 }), [{
+    oldStart: 1, oldLines: 9, newStart: 1, newLines: 9,
+    lines: [' a', '-b', '+B', ' c', ' d', ' e', ' f', '-g', '+G', ' h', ' i'],
+  }]);
+  const separated = ['a', 'B', 'c', 'd', 'e', 'f', 'g', 'H', 'i'];
+  assert.deepEqual(unifiedHunks(a, separated, { context: 2 }), [
+    { oldStart: 1, oldLines: 4, newStart: 1, newLines: 4, lines: [' a', '-b', '+B', ' c', ' d'] },
+    { oldStart: 6, oldLines: 4, newStart: 6, newLines: 4, lines: [' f', ' g', '-h', '+H', ' i'] },
+  ]);
+  assert.equal(unifiedHunks(a, separated).length, 1, 'default context is three');
+  assert.deepEqual(unifiedHunks(a, a), []);
+});
+
+test('application retains unmentioned lines, checks new offsets, and returns a copy', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const copied = applyHunks(a, []);
+  assert.deepEqual(copied, a);
+  assert.notEqual(copied, a);
+  assert.deepEqual(applyHunks(a, [
+    { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] },
+    { oldStart: 1, oldLines: 0, newStart: 3, newLines: 1, lines: ['+y'] },
+  ]), ['a', 'x', 'y', 'b', 'c']);
+});
+
+test('malformed or nonapplicable hunks identify the failing hunk', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+B'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: -1 }, { ...valid, newStart: -1 },
+    { ...valid, oldStart: 4 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: '2' }, { ...valid, oldStart: NaN },
+    { ...valid, oldLines: Infinity }, { ...valid, newLines: -1 },
+    { ...valid, oldLines: 0 }, { ...valid, newLines: 0 },
+    { ...valid, oldLines: 2 }, { ...valid, newLines: 2 },
+    { ...valid, newStart: 3 },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const insert = { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+top'] };
+  assert.throws(() => applyHunks(a, [insert, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, insert]), /hunk 1 does not apply/);
+  assert.deepEqual(a, ['a', 'b', 'c']);
+});
+
+test('20,000-line small edits, including repetitive inputs, complete under a second', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`);
+    const b = a.slice();
+    b.splice(19998, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(1, 0, '+inserted');
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const result = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.deepEqual(result, b);
+    assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `small edits took ${elapsed.toFixed(1)}ms`);
+  }
+});
