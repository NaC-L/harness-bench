+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./src/diff');
+const { splitLines, joinLines } = require('./src/lines');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (const line of a) {
+    let diagonal = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const above = row[j];
+      row[j] = line === b[j - 1] ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+      diagonal = above;
+    }
+  }
+  return row[b.length];
+}
+
+function checkScript(a, b, script) {
+  assert.deepEqual(script.filter(({ op }) => op !== 'insert').map(({ line }) => line), a);
+  assert.deepEqual(script.filter(({ op }) => op !== 'delete').map(({ line }) => line), b);
+  assert.equal(script.filter(({ op }) => op !== 'equal').length,
+    a.length + b.length - 2 * lcsLength(a, b));
+  let inserted = false;
+  for (const { op } of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(op));
+    if (op === 'equal') inserted = false;
+    if (op === 'insert') inserted = true;
+    if (op === 'delete') assert.equal(inserted, false);
+  }
+}
+
+test('exhaustive repetitive inputs have minimal, deterministic, ordered scripts and roundtrip', () => {
+  const inputs = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'a', '-a'].map(line => [...lines, line]));
+    inputs.push(...level.map(lines => Object.freeze(lines)));
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      const script = diffLines(a, b);
+      checkScript(a, b, script);
+      assert.deepEqual(diffLines(a, b), script);
+      for (const context of [0, 1, 2, 3]) {
+        const hunks = unifiedHunks(a, b, { context });
+        for (const hunk of hunks) {
+          Object.freeze(hunk.lines);
+          Object.freeze(hunk);
+        }
+        assert.deepEqual(applyHunks(a, Object.freeze(hunks)), b);
+      }
+    }
+  }
+});
+
+test('larger seeded repetitive examples agree with an independent LCS oracle', () => {
+  let seed = 123456;
+  const random = n => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  };
+  const alphabet = ['', 'same', 'other', '+plus', '-minus', ' space'];
+  for (let iteration = 0; iteration < 500; iteration++) {
+    const a = Array.from({ length: random(30) }, () => alphabet[random(alphabet.length)]);
+    const b = Array.from({ length: random(30) }, () => alphabet[random(alphabet.length)]);
+    checkScript(a, b, diffLines(a, b));
+    assert.deepEqual(applyHunks(a, unifiedHunks(a, b, { context: random(6) })), b);
+  }
+});
+
+test('zero-line ranges name the preceding line at top, middle, and end', () => {
+  for (const position of [0, 1, 3]) {
+    const original = ['a', 'b', 'c'];
+    const inserted = [...original.slice(0, position), 'new', ...original.slice(position)];
+    assert.deepEqual(unifiedHunks(original, inserted, { context: 0 }), [{
+      oldStart: position, oldLines: 0, newStart: position + 1, newLines: 1,
+      lines: ['+new'],
+    }]);
+    assert.deepEqual(unifiedHunks(inserted, original, { context: 0 }), [{
+      oldStart: position + 1, oldLines: 1, newStart: position, newLines: 0,
+      lines: ['-new'],
+    }]);
+  }
+  assert.deepEqual(unifiedHunks([], ['']), [{
+    oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+'],
+  }]);
+  assert.deepEqual(unifiedHunks([''], []), [{
+    oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-'],
+  }]);
+});
+
+test('context touching at twice the context merges without duplicate lines', () => {
+  const a = ['top', 'old1', 'gap1', 'gap2', 'old2', 'bottom'];
+  const b = ['top', 'new1', 'gap1', 'gap2', 'new2', 'bottom'];
+  assert.deepEqual(unifiedHunks(a, b, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' top', '-old1', '+new1', ' gap1', ' gap2', '-old2', '+new2', ' bottom'],
+  }]);
+  const c = ['top', 'old1', 'gap1', 'gap2', 'gap3', 'old2', 'bottom'];
+  const d = ['top', 'new1', 'gap1', 'gap2', 'gap3', 'new2', 'bottom'];
+  assert.deepEqual(unifiedHunks(c, d, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+      lines: [' top', '-old1', '+new1', ' gap1'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+      lines: [' gap3', '-old2', '+new2', ' bottom'] },
+  ]);
+  assert.deepEqual(unifiedHunks(c, c), []);
+  assert.deepEqual(unifiedHunks(['a'], ['b']), unifiedHunks(['a'], ['b'], { context: 3 }));
+});
+
+test('application uses original old coordinates and complete result new coordinates', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd', 'e']);
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 2, oldLines: 2, newStart: 3, newLines: 0, lines: ['-b', '-c'] },
+    { oldStart: 5, oldLines: 1, newStart: 5, newLines: 2, lines: ['-e', '+z', '+w'] },
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['x', 'y', 'a', 'd', 'z', 'w']);
+  const copy = applyHunks(a, []);
+  assert.deepEqual(copy, a);
+  assert.notEqual(copy, a);
+  const samePosition = [
+    { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] },
+    { oldStart: 1, oldLines: 0, newStart: 3, newLines: 1, lines: ['+y'] },
+  ];
+  assert.deepEqual(applyHunks(['a', 'b'], samePosition), ['a', 'x', 'y', 'b']);
+});
+
+test('text roundtrips preserve empty lines, trailing LF, CR, and prefix characters', () => {
+  const a = splitLines(' heading\n-delete\n+insert\n\ncarriage\r\n');
+  const text = ' heading\n+new\n-delete\n\ncarriage\r\n\n';
+  const b = splitLines(text);
+  for (const context of [0, 1, 3, 100]) {
+    assert.equal(joinLines(applyHunks(a, unifiedHunks(a, b, { context }))), text);
+  }
+});
+
+test('malformed or nonapplicable hunks identify their zero-based index', () => {
+  const a = ['a', 'b', 'c'];
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {}, { ...valid, lines: null }, { ...valid, lines: [null] },
+    { ...valid, lines: [''] }, { ...valid, lines: ['?b'] },
+    { ...valid, lines: ['-wrong', '+B'] }, { ...valid, lines: [' wrong'] },
+    { ...valid, lines: [' b', ' c'] }, { ...valid, lines: ['-b'] },
+    { ...valid, oldStart: 0 }, { ...valid, newStart: 0 },
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 1.5 },
+    { ...valid, oldStart: '2' }, { ...valid, oldStart: Infinity },
+    { ...valid, oldStart: 5 }, { ...valid, oldLines: 3 },
+    { ...valid, oldLines: -1 }, { ...valid, newLines: 0 },
+    { ...valid, newLines: NaN }, { ...valid, newStart: 3 },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  const earlier = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] };
+  assert.throws(() => applyHunks(a, [valid, earlier]), /hunk 1 does not apply/);
+  const wrongNew = { oldStart: 3, oldLines: 1, newStart: 4, newLines: 1, lines: [' c'] };
+  assert.throws(() => applyHunks(a, [valid, wrongNew]), /hunk 1 does not apply/);
+});
+
+test('small edits to 20,000-line unique and repetitive files finish under one second', () => {
+  for (const repetitive of [false, true]) {
+    const a = Array.from({ length: 20000 }, (_, i) => repetitive ? `line ${i % 3}` : `line ${i}`);
+    const b = a.slice();
+    b.splice(19000, 1);
+    b.splice(10000, 1, 'replacement');
+    b.splice(100, 0, 'inserted');
+    const start = performance.now();
+    const hunks = unifiedHunks(a, b);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    assert.ok(performance.now() - start < 1000);
+  }
+});
