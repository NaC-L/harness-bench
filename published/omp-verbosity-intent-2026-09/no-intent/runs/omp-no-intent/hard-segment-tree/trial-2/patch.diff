@@ -0,0 +1,137 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions pending at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7, 8]);
+  tree.add(0, 4, 7);
+  tree.add(0, 8, 3);
+  tree.assign(0, 8, -10);
+  tree.add(0, 8, 2);
+  assert.equal(tree.sum(2, 6), -32);
+  assert.equal(tree.max(1, 7), -8);
+  assert.deepEqual(tree.toArray(), Array(8).fill(-8));
+});
+
+test('partial maxima use the identity for negative values', () => {
+  const tree = new RangeTree([-9, -4, -7, -2, -6]);
+  assert.equal(tree.max(0, 3), -4);
+  assert.equal(tree.max(2, 3), -7);
+  assert.equal(tree.max(3, 5), -2);
+  assert.equal(tree.max(2, 2), -Infinity);
+});
+
+test('threshold searches push lazy tags before inspecting children', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 13), 2);
+  tree.assign(0, 5, -7);
+  assert.equal(tree.firstAtLeast(0, -6), -1);
+  assert.equal(tree.firstAtLeast(2, -7), 2);
+  tree.assign(1, 4, 8);
+  tree.add(0, 5, -3);
+  assert.equal(tree.firstAtLeast(2, 5), 2);
+  assert.equal(tree.firstAtLeast(4, 5), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(3, -Infinity), 3);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('mixed updates and queries agree with an array oracle', () => {
+  let seed = 0x91abcdef;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const length of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    const values = Array.from({ length }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 600; step++) {
+      const a = random(length + 1);
+      const b = random(length + 1);
+      const l = Math.min(a, b);
+      const r = Math.max(a, b);
+      const value = random(41) - 20;
+      // Include full-range tags and partial overwrites, without materializing
+      // after every update (which would hide failures involving pending tags).
+      const start = step % 5 === 0 ? 0 : l;
+      const end = step % 5 === 0 ? length : r;
+      const operation = random(7);
+      if (operation < 2) {
+        assert.equal(tree.assign(start, end, value), undefined);
+        values.fill(value, start, end);
+      } else if (operation < 4) {
+        assert.equal(tree.add(start, end, value), undefined);
+        for (let i = start; i < end; i++) values[i] += value;
+      } else if (operation === 4) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((sum, v) => sum + v, 0));
+      } else if (operation === 5) {
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+      } else {
+        const threshold = step % 11 === 0 ? Infinity : step % 13 === 0 ? -Infinity : value;
+        assert.equal(tree.firstAtLeast(l, threshold), values.findIndex((v, i) => i >= l && v >= threshold));
+      }
+      if (step % 37 === 0) {
+        const index = random(length);
+        assert.equal(tree.get(index), values[index]);
+      }
+      if (step % 101 === 0) assert.deepEqual(tree.toArray(), values);
+    }
+    for (let l = 0; l <= length; l++) {
+      for (let r = l; r <= length; r++) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((sum, v) => sum + v, 0));
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+      }
+      for (const threshold of [-Infinity, -21, 0, 21, Infinity]) {
+        assert.equal(tree.firstAtLeast(l, threshold), values.findIndex((v, i) => i >= l && v >= threshold));
+      }
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('validation, empty ranges, read-only length, and array independence', () => {
+  for (const input of [undefined, null, {}, [], [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [2, -3, 4];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  tree.assign(0, 3, -2);
+  tree.add(0, 3, 5);
+  const snapshot = [3, 3, 3];
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]]) {
+      assert.throws(() => tree[method](l, r, 7), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '2', null, undefined]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0', undefined]) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0', undefined]) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '0', null, undefined]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 9), undefined);
+    assert.equal(tree.add(i, i, 9), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 9; }, TypeError);
+  assert.deepEqual(tree.toArray(), snapshot);
+  const output = tree.toArray();
+  output[1] = 100;
+  assert.deepEqual(tree.toArray(), snapshot);
+});
