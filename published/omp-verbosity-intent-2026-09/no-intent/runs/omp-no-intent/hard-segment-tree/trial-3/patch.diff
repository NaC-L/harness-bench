@@ -0,0 +1,159 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards additions at both the parent and its children', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.add(0, 2, 7);
+  tree.add(2, 5, -9);
+  tree.add(0, 5, 3);
+  tree.assign(0, 5, 0);
+  tree.add(0, 5, -2);
+  tree.assign(1, 4, -5);
+  assert.equal(tree.sum(0, 5), -19);
+  assert.equal(tree.sum(1, 3), -10);
+  assert.deepEqual(tree.toArray(), [-2, -5, -5, -5, -2]);
+});
+
+test('partial maxima retain negative values', () => {
+  const tree = new RangeTree([-8, -3, -6, -9, -5]);
+  assert.equal(tree.max(0, 1), -8);
+  assert.equal(tree.max(1, 4), -3);
+  tree.assign(0, 5, -10);
+  tree.add(2, 5, 4);
+  assert.equal(tree.max(0, 2), -10);
+  assert.equal(tree.max(1, 4), -6);
+});
+
+test('threshold search propagates lazy tags before descending', () => {
+  const tree = new RangeTree([100, -100, 100, -100, 100]);
+  tree.assign(0, 5, -7);
+  assert.equal(tree.firstAtLeast(1, -7), 1);
+  assert.equal(tree.firstAtLeast(0, 0), -1);
+  tree.add(0, 5, 10);
+  assert.equal(tree.firstAtLeast(2, 3), 2);
+  tree.assign(0, 5, -20);
+  tree.add(2, 5, 25);
+  assert.equal(tree.firstAtLeast(0, 5), 2);
+  assert.equal(tree.firstAtLeast(3, 5), 3);
+  assert.equal(tree.firstAtLeast(0, 6), -1);
+  assert.equal(tree.firstAtLeast(4, -Infinity), 4);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(5, -Infinity), -1);
+});
+
+test('API validation, empty ranges, and independent arrays are preserved', () => {
+  for (const values of [undefined, null, {}, [], [NaN], [Infinity], [-Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const input = [1, -2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  const copy = tree.toArray();
+  copy[1] = 99;
+  assert.deepEqual(tree.toArray(), [1, -2, 3]);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 99; }, TypeError);
+
+  tree.add(0, 3, 4);
+  const expected = [5, 2, 7];
+  for (const [l, r] of [[-1, 1], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]]) {
+    for (const method of ['assign', 'add', 'sum', 'max']) {
+      assert.throws(() => tree[method](l, r, 5), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '2', undefined, null]) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 1.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 1.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, undefined, null, '0']) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.assign(i, i, 99), undefined);
+    assert.equal(tree.add(i, i, 99), undefined);
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.deepEqual(tree.toArray(), expected);
+  assert.equal(tree.assign(0, 1, 8), undefined);
+  assert.equal(tree.add(0, 1, -3), undefined);
+  assert.deepEqual(tree.toArray(), expected);
+});
+
+test('mixed updates and queries agree with an array oracle', () => {
+  let state = 0x12345678;
+  const random = bound => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state % bound;
+  };
+  const first = (values, lo, x) => {
+    for (let i = lo; i < values.length; i++) {
+      if (values[i] >= x) return i;
+    }
+    return -1;
+  };
+  for (const n of [1, 2, 3, 5, 8, 17, 32, 65]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 2000; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 11 === 0) { l = 0; r = n; }
+      const value = random(41) - 20;
+      const operation = random(8);
+      const label = `length=${n}, step=${step}, operation=${operation}`;
+      switch (operation) {
+        case 0:
+        case 1:
+        case 2: {
+          const assigning = operation === 0;
+          assert.equal(tree[assigning ? 'assign' : 'add'](l, r, value), undefined);
+          for (let i = l; i < r; i++) values[i] = assigning ? value : values[i] + value;
+          break;
+        }
+        case 3:
+          assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0), label);
+          break;
+        case 4:
+          assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)), label);
+          break;
+        case 5: {
+          const x = step % 13 === 0 ? Infinity : step % 17 === 0 ? -Infinity : value;
+          assert.equal(tree.firstAtLeast(l, x), first(values, l, x), label);
+          break;
+        }
+        case 6: {
+          const i = random(n);
+          assert.equal(tree.get(i), values[i], label);
+          break;
+        }
+        case 7:
+          assert.deepEqual(tree.toArray(), values, label);
+          break;
+      }
+    }
+    // Exhaustively check all final ranges and starting positions as well.
+    for (let l = 0; l <= n; l++) {
+      for (let r = l; r <= n; r++) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0));
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+      }
+      for (const x of [-Infinity, -20, 0, 20, Infinity]) {
+        assert.equal(tree.firstAtLeast(l, x), first(values, l, x));
+      }
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
