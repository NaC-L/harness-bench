+/**
+ * Least-recently-used cache with Map key semantics (SameValueZero).
+ *
+ * Recency is tracked by the insertion order of a private Map: the first
+ * entry is the least recently used, the last is the most recently used.
+ * Refreshing an entry is a delete + re-insert, so every operation is O(1).
+ */
 class LRUCache {
+  #map = new Map();
+
   constructor(capacity) {
+    if (typeof capacity !== 'number' || !Number.isInteger(capacity) || capacity < 1) {
+      throw new RangeError(`LRUCache capacity must be a positive integer, got ${String(capacity)}`);
+    }
     this.capacity = capacity;
   }
 
