+  get(key) {
+    const map = this.#map;
+    // Check with has() so entries whose value is undefined still get refreshed.
+    if (!map.has(key)) return undefined;
+    const value = map.get(key);
+    map.delete(key);
+    map.set(key, value);
+    return value;
+  }
