+/** Python's float divmod (CPython float_divmod); zero results are +0. */
+function floorDivMod(left, right) {
+  let mod = left % right;
+  let div = (left - mod) / right;
+  if (mod) {
+    if ((right < 0) !== (mod < 0)) {
+      mod += right;
+      div -= 1;
+    }
+  } else {
+    mod = 0;
+  }
+  let floordiv;
+  if (div) {
+    floordiv = Math.floor(div);
+    if (div - floordiv > 0.5) floordiv += 1;
+  } else {
+    floordiv = 0;
+  }
+  return [floordiv === 0 ? 0 : floordiv, mod === 0 ? 0 : mod];
+}
