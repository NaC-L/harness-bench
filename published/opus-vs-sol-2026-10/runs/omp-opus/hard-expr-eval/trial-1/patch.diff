@@ -0,0 +1,71 @@
+'use strict';
+
+// Regression tests for the language contract documented in src/index.js.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('../src/index');
+
+const columnOf = (source, variables) => {
+  try {
+    evaluate(source, variables);
+  } catch (error) {
+    assert.ok(error instanceof ExprError);
+    return error.column;
+  }
+  assert.fail(`expected ExprError for ${source}`);
+};
+
+test('** binds tighter than a left unary sign and associates right', () => {
+  assert.equal(evaluate('-2 ** 2'), -4);
+  assert.equal(evaluate('2 ** -1'), 0.5);
+  assert.equal(evaluate('2 ** 3 ** 2'), 512);
+  assert.equal(evaluate('2 ** -1 ** 2'), 0.5);
+  assert.equal(evaluate('- - 3'), 3);
+});
+
+test('// and % use Python float divmod semantics', () => {
+  assert.equal(evaluate('7 // -2'), -4);
+  assert.equal(evaluate('1 // 0.1'), 9);
+  assert.equal(evaluate('-5 % 3.5'), 2);
+  assert.equal(evaluate('-0.5 // 1'), -1);
+  assert.ok(Object.is(evaluate('0 // -5'), 0));
+  assert.ok(Object.is(evaluate('6 % -3'), 0));
+});
+
+test('comparisons chain, short-circuit and act as 0/1 in arithmetic', () => {
+  assert.equal(evaluate('1 < 2 < 3'), true);
+  assert.equal(evaluate('1 < 2 == 1'), false);
+  assert.equal(evaluate('(1 < 2) + 1'), 2);
+  assert.equal(evaluate('1 < 0 < y'), false);
+  let reads = 0;
+  const vars = { get a() { reads += 1; return 2; } };
+  assert.equal(evaluate('a < a * a < 10', vars), true);
+  assert.equal(reads, 3);
+});
+
+test('min/max return the first extreme argument like Python', () => {
+  assert.equal(evaluate('min(3, 1, 2)'), 1);
+  assert.equal(evaluate('max(1 < 2, 0)'), true);
+  assert.equal(evaluate('abs(1 < 2)'), 1);
+});
+
+test('error columns point at the offending token', () => {
+  assert.equal(columnOf('1 +  $'), 6);
+  assert.equal(columnOf('  1 2'), 5);
+  assert.equal(columnOf('(1 + 2  '), 9);
+  assert.equal(columnOf('1 / 0'), 3);
+  assert.equal(columnOf('1 + foo(1)'), 5);
+  assert.equal(columnOf('1 < 0 < abs(1, 2)'), 9);
+  assert.equal(columnOf('min()'), 1);
+  assert.equal(columnOf('x + 1'), 1);
+});
+
+test('long flat chains evaluate quickly without deep recursion', () => {
+  const n = 200000;
+  const start = Date.now();
+  assert.equal(evaluate(Array(n).fill('1').join(' + ')), n);
+  assert.equal(evaluate(Array(n).fill('1').join(' <= ')), true);
+  assert.equal(evaluate('-'.repeat(n + 1) + '1'), -1);
+  assert.equal(evaluate(Array(n).fill('1').join(' ** ')), 1);
+  assert.ok(Date.now() - start < 2000);
+});
