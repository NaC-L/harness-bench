+'use strict';
+
+// Property and edge-case tests for src/diff.js, checked against a brute-force
+// O(N * M) LCS reference on small random inputs.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { diffLines, unifiedHunks, applyHunks } = require('../src/diff');
+
+function lcsLength(a, b) {
+  const row = new Array(b.length + 1).fill(0);
+  for (let i = 1; i <= a.length; i++) {
+    let diag = 0;
+    for (let j = 1; j <= b.length; j++) {
+      const up = row[j];
+      row[j] = a[i - 1] === b[j - 1] ? diag + 1 : Math.max(row[j], row[j - 1]);
+      diag = up;
+    }
+  }
+  return row[b.length];
+}
+
+function rng(seed) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0;
+    return s / 2 ** 32;
+  };
+}
+
+function randomLines(rand, len, alphabet) {
+  return Array.from({ length: len }, () => alphabet[Math.floor(rand() * alphabet.length)]);
+}
+
+function checkScript(a, b, ops) {
+  assert.deepEqual(ops.filter((o) => o.op !== 'insert').map((o) => o.line), a);
+  assert.deepEqual(ops.filter((o) => o.op !== 'delete').map((o) => o.line), b);
+  const edits = ops.filter((o) => o.op !== 'equal').length;
+  assert.equal(edits, a.length + b.length - 2 * lcsLength(a, b));
+  for (let i = 1; i < ops.length; i++) {
+    assert.ok(!(ops[i - 1].op === 'insert' && ops[i].op === 'delete'), 'delete after insert');
+  }
+}
+
+function checkHunks(a, b, context) {
+  const hunks = unifiedHunks(a, b, { context });
+  assert.deepEqual(applyHunks(a, hunks), b);
+  for (let i = 0; i < hunks.length; i++) {
+    const h = hunks[i];
+    const lines = h.lines;
+    assert.equal(lines.filter((l) => l[0] !== '+').length, h.oldLines);
+    assert.equal(lines.filter((l) => l[0] !== '-').length, h.newLines);
+    // Leading/trailing context never exceeds `context`.
+    let lead = 0;
+    while (lead < lines.length && lines[lead][0] === ' ') lead++;
+    let trail = 0;
+    while (trail < lines.length && lines[lines.length - 1 - trail][0] === ' ') trail++;
+    assert.ok(lead <= context && trail <= context);
+    if (i > 0) {
+      const prev = hunks[i - 1];
+      const gap = (h.oldLines ? h.oldStart - 1 : h.oldStart) - (prev.oldLines ? prev.oldStart - 1 + prev.oldLines : prev.oldStart);
+      assert.ok(gap > 0, 'hunks must not touch');
+    }
+  }
+  return hunks;
+}
+
+test('random inputs: minimal, ordered, reconstructing, roundtripping', () => {
+  const rand = rng(12345);
+  for (let iter = 0; iter < 3000; iter++) {
+    const alphabet = ['', 'x', 'y', 'z', ' x', '-x', '+x', '__proto__'].slice(0, 1 + Math.floor(rand() * 8));
+    const a = randomLines(rand, Math.floor(rand() * 14), alphabet);
+    const b = randomLines(rand, Math.floor(rand() * 14), alphabet);
+    const a0 = a.slice();
+    const b0 = b.slice();
+    const ops = diffLines(a, b);
+    checkScript(a, b, ops);
+    assert.deepEqual(diffLines(a, b), ops, 'deterministic');
+    for (const context of [0, 1, 2, 3]) checkHunks(a, b, context);
+    assert.deepEqual(a, a0);
+    assert.deepEqual(b, b0);
+  }
+});
+
+test('edge cases', () => {
+  assert.deepEqual(diffLines([], []), []);
+  assert.deepEqual(unifiedHunks([], []), []);
+  assert.deepEqual(unifiedHunks(['a', 'b'], ['a', 'b']), []);
+  assert.deepEqual(unifiedHunks([], ['x']), [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['x'], []), [
+    { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a', 'b'], ['a', 'x', 'b'], { context: 0 }), [
+    { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] },
+  ]);
+  assert.deepEqual(unifiedHunks(['a', 'x', 'b'], ['a', 'b'], { context: 0 }), [
+    { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] },
+  ]);
+  // Gap of exactly 2 * context merges; 2 * context + 1 splits.
+  const base = ['1', '2', '3', '4', '5', '6', '7'];
+  assert.equal(unifiedHunks(base, ['X', '2', '3', 'Y', '5', '6', '7'], { context: 1 }).length, 1);
+  assert.equal(unifiedHunks(base, ['X', '2', '3', '4', 'Y', '6', '7'], { context: 1 }).length, 2);
+  assert.throws(() => unifiedHunks([], [], { context: -1 }), RangeError);
+});
+
+test('applyHunks rejects bad hunks with indexed messages', () => {
+  const a = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
+  const b = ['a', 'B', 'c', 'd', 'e', 'f', 'G', 'h'];
+  const hunks = unifiedHunks(a, b, { context: 1 });
+  assert.equal(hunks.length, 2);
+  assert.deepEqual(applyHunks(a, []), a);
+  assert.notEqual(applyHunks(a, []), a);
+  const bad = (mutate, index) => {
+    const copy = structuredClone(hunks);
+    mutate(copy);
+    assert.throws(() => applyHunks(a, copy), new RegExp(`hunk ${index} does not apply`));
+  };
+  bad((h) => { h[1].lines[0] = ' X'; }, 1);
+  bad((h) => { h[0].oldLines = 2; }, 0);
+  bad((h) => { h[1].newStart += 1; }, 1);
+  bad((h) => { h.reverse(); }, 1);
+  bad((h) => { h[0].lines.push('*z'); }, 0);
+  bad((h) => { h[1].oldStart = 8; }, 1);
+  bad((h) => { h[0] = null; }, 0);
+  // Applying the same hunk twice overlaps.
+  bad((h) => { h[1] = h[0]; }, 1);
+});
+
+test('large inputs with small changes are fast', () => {
+  const a = Array.from({ length: 20000 }, (_, i) => `line ${i % 7}`);
+  const b = a.slice();
+  for (let i = 100; i < 20000; i += 2000) b[i] = `changed ${i}`;
+  b.splice(5000, 0, 'inserted');
+  b.splice(15000, 3);
+  const start = process.hrtime.bigint();
+  const ops = diffLines(a, b);
+  const hunks = unifiedHunks(a, b);
+  assert.deepEqual(applyHunks(a, hunks), b);
+  const ms = Number(process.hrtime.bigint() - start) / 1e6;
+  assert.ok(ms < 500, `took ${ms}ms`);
+  assert.ok(ops.filter((o) => o.op !== 'equal').length <= 24);
+
+  const same = Array.from({ length: 20000 }, () => 'same');
+  const t0 = process.hrtime.bigint();
+  assert.equal(diffLines(same, same.slice(1)).filter((o) => o.op !== 'equal').length, 1);
+  assert.ok(Number(process.hrtime.bigint() - t0) / 1e6 < 200);
+});
