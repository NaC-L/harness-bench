 function createParser(options = {}) {
-  throw new Error('not implemented');
+  const delimiter = options.delimiter === undefined ? ',' : options.delimiter;
+  if (typeof delimiter !== 'string' || delimiter.length !== 1 ||
+      delimiter === '"' || delimiter === '\r' || delimiter === '\n') {
+    throw new RangeError('delimiter must be one UTF-16 code unit other than quote, CR, or LF');
+  }
+
+  let state = 'start';
+  let field = '';
+  let row = [];
+  let unfinished = false;
+  let atStart = true;
+  let ended = false;
+  let line = 1;
+  let previousCR = false;
+  let skipLF = false;
+
+  function finishField() {
+    row.push(field);
+    field = '';
+    state = 'start';
+  }
+
+  function push(chunk) {
+    if (ended) throw new Error('cannot push after end');
+    if (typeof chunk !== 'string') throw new TypeError('chunk must be a string');
+    const records = [];
+
+    for (let index = 0; index < chunk.length; index++) {
+      const character = chunk[index];
+      if (atStart) {
+        atStart = false;
+        if (character === '\uFEFF') continue;
+      }
+
+      // Physical line counting is independent of CSV quoting and separators.
+      const followsCR = previousCR;
+      previousCR = character === '\r';
+      if (character === '\r' || (character === '\n' && !followsCR)) line++;
+
+      // A CR already emitted its record, so consume only its optional LF.
+      if (skipLF) {
+        skipLF = false;
+        if (character === '\n') continue;
+      }
+
+      unfinished = true;
+      if (state === 'quoted') {
+        if (character === '"') state = 'afterQuote';
+        else field += character;
+        continue;
+      }
+
+      // Keep a closing quote pending across chunks: another quote escapes it.
+      if (state === 'afterQuote' && character === '"') {
+        field += '"';
+        state = 'quoted';
+      } else if (character === delimiter) {
+        finishField();
+      } else if (character === '\r' || character === '\n') {
+        finishField();
+        records.push(row);
+        row = [];
+        unfinished = false;
+        skipLF = character === '\r';
+      } else if (state === 'afterQuote') {
+        throw new SyntaxError(`unexpected character after closing quote at line ${line}`);
+      } else if (state === 'start' && character === '"') {
+        state = 'quoted';
+      } else {
+        field += character;
+        state = 'unquoted';
+      }
+    }
+    return records;
+  }
+
+  function end() {
+    if (ended) return [];
+    ended = true;
+    if (state === 'quoted') {
+      throw new SyntaxError(`unterminated quoted field at line ${line}`);
+    }
+    if (!unfinished) return [];
+    finishField();
+    return [row];
+  }
+
+  return { push, end };
 }
 
