-  throw new Error('not implemented');
+  const { delimiter = ',' } = options;
+  if (typeof delimiter !== 'string' || delimiter.length !== 1 ||
+      delimiter === '"' || delimiter === '\r' || delimiter === '\n') {
+    throw new RangeError('delimiter must be one UTF-16 code unit other than quote, CR, or LF');
+  }
+
+  let state = 'start';
+  let field = '';
+  let row = [];
+  let recordStarted = false;
+  let atStart = true;
+  let previousCR = false;
+  let line = 1;
+  let ended = false;
+
+  function push(chunk) {
+    if (ended) throw new Error('cannot push after end');
+    if (typeof chunk !== 'string') throw new TypeError('chunk must be a string');
+    const records = [];
+
+    // Index by UTF-16 code unit, just like the delimiter validation.
+    for (let index = 0; index < chunk.length; index++) {
+      const character = chunk[index];
+      if (atStart) {
+        atStart = false;
+        if (character === '\uFEFF') continue;
+      }
+
+      const followsCR = previousCR;
+      if (character === '\r' || (character === '\n' && !followsCR)) line++;
+      previousCR = character === '\r';
+
+      if (state === 'quoted') {
+        if (character === '"') {
+          state = 'afterQuote';
+        } else {
+          field += character;
+        }
+        continue;
+      }
+
+      // A CR already emitted its record; swallow only its immediately following LF.
+      if (character === '\n' && followsCR) continue;
+
+      if (state === 'afterQuote') {
+        if (character === '"') {
+          field += '"';
+          state = 'quoted';
+          continue;
+        }
+        if (character !== delimiter && character !== '\r' && character !== '\n') {
+          throw new SyntaxError(`unexpected character after closing quote at line ${line}`);
+        }
+      }
+
+      if (character === delimiter) {
+        row.push(field);
+        field = '';
+        state = 'start';
+        recordStarted = true;
+      } else if (character === '\r' || character === '\n') {
+        row.push(field);
+        records.push(row);
+        row = [];
+        field = '';
+        state = 'start';
+        recordStarted = false;
+      } else {
+        recordStarted = true;
+        if (state === 'start' && character === '"') {
+          state = 'quoted';
+        } else {
+          field += character;
+          state = 'unquoted';
+        }
+      }
+    }
+    return records;
+  }
+
+  function end() {
+    if (ended) return [];
+    ended = true;
+    if (state === 'quoted') {
+      throw new SyntaxError(`unterminated quoted field at line ${line}`);
+    }
+    if (!recordStarted) return [];
+    row.push(field);
+    const records = [row];
+    row = [];
+    field = '';
+    return records;
+  }
+
+  return { push, end };
 }
 
