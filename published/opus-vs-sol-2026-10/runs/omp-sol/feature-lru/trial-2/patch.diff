+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { LRUCache } = require('./src/lru');
+
+test('capacity must be a positive integer Number', () => {
+  for (const capacity of [0, -0, -1, 1.5, Infinity, -Infinity, NaN, '2', undefined, null, true, 2n, {}, new Number(2), Symbol('capacity')]) {
+    assert.throws(() => new LRUCache(capacity), RangeError);
+  }
+  assert.throws(() => new LRUCache(), RangeError);
+  for (const capacity of [1, 2, Number.MAX_SAFE_INTEGER, Number.MAX_VALUE]) {
+    assert.equal(new LRUCache(capacity).size, 0);
+  }
+});
+
+test('getting an undefined value refreshes recency', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', undefined).set('b', 2);
+  assert.equal(cache.get('a'), undefined);
+  cache.set('c', 3);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('b'), false);
+  assert.equal(cache.size, 2);
+});
+
+test('updating refreshes recency without increasing size or evicting another key', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.set('a', 3), cache);
+  assert.equal(cache.size, 2);
+  assert.equal(cache.has('b'), true);
+  cache.set('c', 4);
+  assert.equal(cache.has('b'), false);
+  assert.equal(cache.get('a'), 3);
+});
+
+test('has and missing get do not refresh recency', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('missing'), false);
+  assert.equal(cache.get('missing'), undefined);
+  cache.set('c', 3);
+  assert.equal(cache.has('a'), false);
+  assert.equal(cache.has('b'), true);
+});
+
+test('deletion preserves recency of surviving entries', () => {
+  const cache = new LRUCache(3);
+  cache.set('a', 1).set('b', 2).set('c', 3);
+  assert.equal(cache.delete('b'), true);
+  assert.equal(cache.delete('b'), false);
+  cache.set('d', 4).set('e', 5);
+  assert.equal(cache.has('a'), false);
+  assert.equal(cache.has('c'), true);
+  assert.equal(cache.size, 3);
+});
+
+test('arbitrary keys and values retain Map semantics', () => {
+  const cache = new LRUCache(20);
+  const keys = [undefined, null, NaN, 0, '0', {}, {}, Symbol('key'), Symbol('key'), 1n, false, '__proto__'];
+  const values = keys.map(() => ({}));
+  keys.forEach((key, index) => cache.set(key, values[index]));
+  keys.forEach((key, index) => assert.equal(cache.get(key), values[index]));
+  assert.equal(cache.size, keys.length);
+  assert.equal(cache.get(-0), cache.get(0));
+  cache.set(-0, undefined);
+  assert.equal(cache.size, keys.length);
+  assert.equal(cache.has(0), true);
+  assert.equal(cache.get(0), undefined);
+  assert.equal(cache.delete(NaN), true);
+  assert.equal(cache.has(NaN), false);
+});
+
+test('capacity-one caches evict undefined keys and remain independent', () => {
+  const first = new LRUCache(1);
+  const second = new LRUCache(1);
+  first.set(undefined, 1);
+  second.set(undefined, 2);
+  first.set('next', 3);
+  assert.equal(first.has(undefined), false);
+  assert.equal(first.size, 1);
+  assert.equal(second.get(undefined), 2);
+  first.delete('next');
+  assert.equal(first.size, 0);
+  assert.equal(second.size, 1);
+});
