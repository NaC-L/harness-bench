+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { LRUCache } = require('./src/lru');
+
+test('capacity accepts only positive integer Numbers', () => {
+  for (const capacity of [0, -0, -1, 0.5, Infinity, -Infinity, NaN,
+    '2', undefined, null, true, 2n, Symbol('capacity'), {}, new Number(2)]) {
+    assert.throws(() => new LRUCache(capacity), RangeError);
+  }
+  assert.throws(() => new LRUCache(), RangeError);
+  for (const capacity of [1, 2, Number.MAX_SAFE_INTEGER, Number.MAX_VALUE]) {
+    assert.equal(new LRUCache(capacity).size, 0);
+  }
+});
+
+test('getting an undefined value refreshes recency', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', undefined).set('b', 2);
+  assert.equal(cache.get('a'), undefined);
+  cache.set('c', 3);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('b'), false);
+  assert.equal(cache.size, 2);
+});
+
+test('updating a full cache refreshes recency without evicting another key', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.set('a', 3), cache);
+  assert.equal(cache.size, 2);
+  assert.equal(cache.has('b'), true);
+  cache.set('c', 4);
+  assert.equal(cache.has('b'), false);
+  assert.equal(cache.get('a'), 3);
+});
+
+test('has, missed gets, and deletion preserve surviving recency', () => {
+  const cache = new LRUCache(3);
+  cache.set('a', 1).set('b', 2).set('c', 3);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('missing'), false);
+  assert.equal(cache.get('missing'), undefined);
+  assert.equal(cache.delete('b'), true);
+  assert.equal(cache.delete('missing'), false);
+  cache.set('d', 4).set('e', 5);
+  assert.equal(cache.has('a'), false);
+  assert.equal(cache.has('c'), true);
+  assert.equal(cache.size, 3);
+});
+
+test('arbitrary keys and values follow Map semantics', () => {
+  const cache = new LRUCache(10);
+  const object = {};
+  const distinctObject = {};
+  const symbol = Symbol('key');
+  const value = { nested: true };
+  const entries = [[undefined, undefined], [null, null], [NaN, value],
+    [object, object], [distinctObject, false], [symbol, symbol],
+    [1n, 1n], ['__proto__', 'safe'], [0, 'zero']];
+  for (const [key, stored] of entries) cache.set(key, stored);
+  for (const [key, stored] of entries) {
+    assert.equal(cache.has(key), true);
+    assert.equal(cache.get(key), stored);
+  }
+  assert.equal(cache.has({}), false);
+  cache.set(-0, 'updated zero');
+  assert.equal(cache.get(0), 'updated zero');
+  assert.equal(cache.size, entries.length);
+  cache.set(Number('not a number'), 'updated NaN');
+  assert.equal(cache.get(NaN), 'updated NaN');
+  assert.equal(cache.size, entries.length);
+});
+
+test('capacity one evicts undefined keys and caches are independent', () => {
+  const first = new LRUCache(1);
+  const second = new LRUCache(1);
+  first.set(undefined, 1);
+  second.set(undefined, 2);
+  first.set('replacement', 3);
+  assert.equal(first.has(undefined), false);
+  assert.equal(first.size, 1);
+  assert.equal(second.get(undefined), 2);
+  first.delete('replacement');
+  assert.equal(first.size, 0);
+  assert.equal(second.size, 1);
+});
