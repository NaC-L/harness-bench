+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./src');
+
+const record = entries => Object.assign(Object.create(null), entries);
+
+test('numeric candidate ordering compares every component', () => {
+  const registry = {
+    major: { '9.0.0': {}, '10.0.0': {} },
+    minor: { '1.9.0': {}, '1.10.0': {} },
+    patch: { '1.0.9': {}, '1.0.10': {} },
+  };
+  assert.deepEqual(resolve(registry, { major: '*', minor: '*', patch: '*' }), {
+    major: '10.0.0', minor: '1.10.0', patch: '1.0.10',
+  });
+});
+
+test('all root and discovered constraints apply before queued names are selected', () => {
+  const registry = {
+    a: { '1.0.0': { b: '<2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '>=1.0.0' }), {
+    a: '1.0.0', b: '1.0.0',
+  });
+  assert.equal(resolve(registry, { a: '*', b: '2.0.0' }), null);
+});
+
+test('FIFO selection keeps the earlier root choice and retries the latest choice', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+    c: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '2.0.0', c: '1.0.0',
+  });
+  assert.deepEqual(resolve(registry, { c: '*', b: '*' }), {
+    c: '2.0.0', b: '1.0.0',
+  });
+});
+
+test('dependency key order participates in first-found selection', () => {
+  const registry = {
+    root: { '1.0.0': { a: '*', b: '*' } },
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { root: '*' }), {
+    root: '1.0.0', a: '2.0.0', b: '1.0.0',
+  });
+  registry.root['1.0.0'] = { b: '*', a: '*' };
+  assert.deepEqual(resolve(registry, { root: '*' }), {
+    root: '1.0.0', b: '2.0.0', a: '1.0.0',
+  });
+});
+
+test('failed choices undo missing dependencies, nested selections and constraints', () => {
+  const registry = {
+    a: { '3.0.0': { b: '2.0.0' }, '2.0.0': { b: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '*' }, '1.0.0': { d: '*' } },
+    c: { '1.0.0': { missing: '*' } },
+    d: { '1.0.0': {} },
+  };
+  const result = resolve(registry, { a: '*' });
+  assert.deepEqual(result, { a: '2.0.0', b: '1.0.0', d: '1.0.0' });
+  assert.deepEqual(Object.keys(result), ['a', 'b', 'd']);
+});
+
+test('partially discovered constraints are removed after immediate conflicts', () => {
+  const registry = {
+    a: { '1.0.0': {} },
+    b: {
+      '2.0.0': { missing: '*', a: '2.0.0', unreachable: '*' },
+      '1.0.0': { c: '*' },
+    },
+    c: { '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('rollback retains constraints from older choices', () => {
+  const registry = {
+    a: { '1.0.0': { c: '<2.0.0' } },
+    b: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '*' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('self and mutual cycles expand selected names only once', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { a: '1.0.0' }, '1.0.0': { b: '*' } },
+    b: { '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0', b: '1.0.0' });
+  registry.b['1.0.0'].a = '2.0.0';
+  assert.equal(resolve(registry, { a: '*' }), null);
+});
+
+test('long chains and cyclic chains do not depend on call-stack depth or iteration caps', () => {
+  const length = 15000;
+  const registry = {};
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': { [`p${(i + 1) % length}`]: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length);
+  assert.equal(result[`p${length - 1}`], '1.0.0');
+  registry[`p${length - 1}`]['1.0.0'] = { missing: '*' };
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('discovered conflicts prune branches before unrelated version products', () => {
+  const registry = {
+    anchor: { '1.0.0': {} },
+    branch: { '2.0.0': { anchor: '2.0.0' }, '1.0.0': {} },
+  };
+  const root = { anchor: '*', branch: '*' };
+  for (let i = 0; i < 50; i += 1) {
+    registry[`p${i}`] = { '2.0.0': {}, '1.0.0': {} };
+    root[`p${i}`] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(result.branch, '1.0.0');
+  assert.equal(result.p49, '2.0.0');
+  assert.equal(Object.keys(result).length, 52);
+});
+
+test('missing packages are unsatisfiable and unselected packages remain unreachable', () => {
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ a: {} }, { a: '*' }), null);
+  assert.deepEqual(resolve({ a: { '1.0.0': { missing: '*' } } }, {}), {});
+});
+
+test('every map, version and range is eagerly validated, including unreachable entries', () => {
+  for (const invalid of [null, [], new Date(), () => {}, Object.create({})]) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  for (const version of ['01.0.0', '1.0', '1.0.0\n', '9007199254740992.0.0']) {
+    assert.throws(() => resolve({ unused: { [version]: {} } }, {}), TypeError);
+  }
+  for (const range of ['', null, '^', '1.0.0 || 2.0.0']) {
+    assert.throws(() => resolve({ unused: { '1.0.0': { dep: range } } }, {}), TypeError);
+    assert.throws(() => resolve({}, { missing: range }), TypeError);
+  }
+});
+
+test('null-prototype maps and special package names produce an ordinary own-key result', () => {
+  const registry = record({});
+  const root = record({});
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = record({ '1.0.0': record({}) });
+    root[name] = '*';
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+});
+
+test('only enumerable own string keys participate and frozen inputs remain unchanged', () => {
+  const ignored = {
+    hidden: { enumerable: false, get() { throw new Error('hidden key read'); } },
+    [Symbol('ignored')]: { enumerable: true, get() { throw new Error('symbol read'); } },
+  };
+  const deps = Object.freeze(Object.defineProperties({}, ignored));
+  const versions = Object.freeze(Object.defineProperties({ '1.0.0': deps }, ignored));
+  const registry = Object.freeze(Object.defineProperties({ a: versions }, ignored));
+  const root = Object.freeze(Object.defineProperties({ a: '*' }, ignored));
+  assert.deepEqual(resolve(registry, root), { a: '1.0.0' });
+  assert.equal(registry.a, versions);
+  assert.equal(versions['1.0.0'], deps);
+  assert.equal(root.a, '*');
+  assert.equal(resolve({}, { toString: '*' }), null);
+});
+
+// A small independent copying search specifies FIFO first-found behavior.
+// Its recursion is bounded by the four-package randomized fixtures, not used
+// by the production resolver or the long-chain tests.
+function referenceResolve(registry, root) {
+  const accepts = (version, range) => range === '*' || version === range;
+  function search(queue, cursor, selected) {
+    while (cursor < queue.length && selected.has(queue[cursor][0])) cursor += 1;
+    if (cursor === queue.length) return Object.fromEntries(selected);
+    const name = queue[cursor][0];
+    for (const version of ['3.0.0', '2.0.0', '1.0.0']) {
+      if (!registry[name] || !Object.hasOwn(registry[name], version)) continue;
+      if (!queue.every(([dep, range]) => dep !== name || accepts(version, range))) continue;
+      const next = new Map(selected).set(name, version);
+      const requirements = queue.concat(Object.entries(registry[name][version]));
+      if (!requirements.every(([dep, range]) => !next.has(dep) || accepts(next.get(dep), range))) continue;
+      const result = search(requirements, cursor + 1, next);
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(Object.entries(root), 0, new Map());
+}
+
+test('first-found results match an independent reference over seeded cyclic graphs', () => {
+  let state = 0x12345678;
+  const random = limit => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return (state >>> 8) % limit;
+  };
+  const names = ['a', 'b', 'c', 'd'];
+  const ranges = ['*', '1.0.0', '2.0.0', '3.0.0'];
+  for (let sample = 0; sample < 600; sample += 1) {
+    const registry = {};
+    for (const name of names) {
+      registry[name] = {};
+      for (const version of ranges.slice(1)) {
+        if (random(5) === 0) continue;
+        const deps = {};
+        for (let i = random(4); i > 0; i -= 1) {
+          deps[[...names, 'missing'][random(5)]] = ranges[random(4)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    const root = {};
+    for (let i = 1 + random(4); i > 0; i -= 1) root[names[random(4)]] = ranges[random(4)];
+    const expected = referenceResolve(registry, root);
+    const actual = resolve(registry, root);
+    assert.deepEqual(actual, expected, `sample ${sample}: ${JSON.stringify({ registry, root })}`);
+    if (actual !== null) assert.deepEqual(Object.keys(actual), Object.keys(expected));
+  }
+});
