+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { resolve } = require('./index');
+const { compare, satisfies } = require('./semver');
+
+test('versions are ordered numerically in every component', () => {
+  for (const versions of [
+    ['9.0.0', '10.0.0'],
+    ['1.9.0', '1.10.0'],
+    ['1.0.9', '1.0.10'],
+    ['1.0.9007199254740990', '1.0.9007199254740991'],
+  ]) {
+    const registry = { a: Object.fromEntries(versions.map(version => [version, {}])) };
+    assert.deepEqual(resolve(registry, { a: '*' }), { a: versions[1] });
+  }
+});
+
+test('first found is FIFO depth-first, not the globally newest assignment', () => {
+  const registry = {
+    a: { '2.0.0': { b: '1.0.0' }, '1.0.0': { b: '2.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.deepEqual(resolve(registry, { b: '*', a: '*' }), { b: '2.0.0', a: '1.0.0' });
+});
+
+test('discovery collects constraints before queued names are selected', () => {
+  const registry = {
+    a: { '1.0.0': { c: '*', b: '1.0.0' } },
+    b: { '2.0.0': {}, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('backtracking removes conflicting constraints on unselected packages', () => {
+  const registry = {
+    a: { '2.0.0': { c: '1.0.0' }, '1.0.0': {} },
+    b: { '2.0.0': { c: '2.0.0' }, '1.0.0': { c: '1.0.0' } },
+    c: { '2.0.0': {}, '1.0.0': {} },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '2.0.0', b: '1.0.0', c: '1.0.0',
+  });
+});
+
+test('immediate conflicts undo partial discovery and retain older constraints', () => {
+  const registry = {
+    a: { '2.0.0': {}, '1.0.0': {} },
+    b: {
+      '2.0.0': { abandoned: '*', a: '1.0.0', never: '*' },
+      '1.0.0': { a: '2.0.0' },
+    },
+  };
+  assert.deepEqual(resolve(registry, { a: '>=2.0.0', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+});
+
+test('exhausted choices roll back selected descendants and orphaned dependencies', () => {
+  const registry = {
+    a: { '2.0.0': { orphan: '*' }, '1.0.0': { live: '*' } },
+    orphan: { '1.0.0': { missing: '*' } },
+    live: { '1.0.0': {} },
+    b: { '2.0.0': { a: '1.0.0' }, '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), {
+    a: '1.0.0', b: '2.0.0', live: '1.0.0',
+  });
+  assert.deepEqual(resolve({ a: { '2.0.0': { x: '*' }, '1.0.0': {} }, x: { '1.0.0': { missing: '*' } } }, { a: '*' }), { a: '1.0.0' });
+});
+
+test('cycles and repeated requirements expand each selected version only once', () => {
+  assert.deepEqual(resolve({ a: { '1.0.0': { a: '*' } } }, { a: '*' }), { a: '1.0.0' });
+  const registry = {
+    a: { '2.0.0': { b: '*' }, '1.0.0': {} },
+    b: { '1.0.0': { a: '1.0.0' } },
+  };
+  assert.deepEqual(resolve(registry, { a: '*' }), { a: '1.0.0' });
+  registry.b['1.0.0'].a = '*';
+  assert.deepEqual(resolve(registry, { a: '*', b: '*' }), { a: '2.0.0', b: '1.0.0' });
+  assert.equal(resolve({ a: { '1.0.0': { a: '>1.0.0' } } }, { a: '*' }), null);
+});
+
+test('long chains are stack independent and have no arbitrary iteration limit', () => {
+  const registry = {};
+  const length = 16000;
+  for (let i = 0; i < length; i += 1) {
+    registry[`p${i}`] = { '1.0.0': i + 1 < length ? { [`p${i + 1}`]: '*', p0: '*' } : { p0: '*' } };
+  }
+  const result = resolve(registry, { p0: '*' });
+  assert.equal(Object.keys(result).length, length);
+  assert.equal(result[`p${length - 1}`], '1.0.0');
+  registry[`p${length - 1}`]['1.0.0'].missing = '*';
+  assert.equal(resolve(registry, { p0: '*' }), null);
+});
+
+test('discovered conflicts are checked before exploring combinations', { timeout: 5000 }, () => {
+  const registry = { anchor: { '1.0.0': {} } };
+  const root = { anchor: '*' };
+  for (let i = 0; i < 60; i += 1) {
+    root[`p${i}`] = '*';
+    registry[`p${i}`] = { '2.0.0': { anchor: '2.0.0' }, '1.0.0': {} };
+  }
+  const result = resolve(registry, root);
+  assert.equal(Object.keys(result).length, 61);
+  assert.ok(Object.values(result).every(version => version === '1.0.0'));
+});
+
+test('all maps, versions and ranges are validated, even when unreachable', () => {
+  const invalidMaps = [null, [], 3, 'map', new Date(), Object.create({})];
+  for (const invalid of invalidMaps) {
+    assert.throws(() => resolve(invalid, {}), TypeError);
+    assert.throws(() => resolve({}, invalid), TypeError);
+    assert.throws(() => resolve({ unused: invalid }, {}), TypeError);
+    assert.throws(() => resolve({ unused: { '1.0.0': invalid } }, {}), TypeError);
+  }
+  assert.throws(() => resolve({ unused: { '01.0.0': {} } }, {}), TypeError);
+  assert.throws(() => resolve({ unused: { '1.0.0': { missing: '^' } } }, {}), TypeError);
+  assert.throws(() => resolve({}, { missing: '' }), TypeError);
+  assert.deepEqual(resolve({ unused: { '1.0.0': { missing: '*' } } }, {}), {});
+  assert.equal(resolve({}, { missing: '*' }), null);
+  assert.equal(resolve({ empty: {} }, { empty: '*' }), null);
+});
+
+test('own enumerable string keys, null prototypes, special names and immutable inputs', () => {
+  const deps = Object.freeze(Object.create(null));
+  const versions = Object.freeze(Object.assign(Object.create(null), { '1.0.0': deps }));
+  const registry = Object.create(null);
+  const root = Object.create(null);
+  for (const name of ['__proto__', 'constructor', 'toString']) {
+    registry[name] = versions;
+    root[name] = '*';
+  }
+  Object.defineProperty(registry, 'ignored', { value: null });
+  Object.defineProperty(root, 'ignored', { value: null });
+  registry[Symbol('ignored')] = null;
+  root[Symbol('ignored')] = null;
+  Object.freeze(registry);
+  Object.freeze(root);
+  const result = resolve(registry, root);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__', 'constructor', 'toString']);
+  for (const name of Object.keys(root)) assert.equal(result[name], '1.0.0');
+  assert.deepEqual(resolve(registry, root), result);
+});
+
+// A small, deliberately recursive oracle copies branch state instead of using
+// production's reversible trails. It is used only for bounded random graphs.
+function referenceResolve(registry, root) {
+  const initial = Object.entries(root);
+  function search(selected, pending, requirements) {
+    if (pending.length === 0) return Object.fromEntries(selected);
+    const [name, ...remaining] = pending;
+    if (selected.has(name)) return search(selected, remaining, requirements);
+    const candidates = Object.keys(registry[name] || {}).sort((a, b) => compare(b, a));
+    for (const version of candidates) {
+      if (!requirements.filter(([key]) => key === name).every(([, range]) => satisfies(version, range))) continue;
+      const next = new Map(selected).set(name, version);
+      const deps = Object.entries(registry[name][version]);
+      if (deps.some(([key, range]) => next.has(key) && !satisfies(next.get(key), range))) continue;
+      const result = search(next, remaining.concat(deps.map(([key]) => key)), requirements.concat(deps));
+      if (result !== null) return result;
+    }
+    return null;
+  }
+  return search(new Map(), initial.map(([name]) => name), initial);
+}
+
+test('first-found assignments match a copy-on-branch oracle on cyclic graphs', () => {
+  let seed = 123456789;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 16) % limit;
+  };
+  const ranges = ['*', '1.0.0', '2.0.0', '>1.0.0', '<2.0.0'];
+  for (let run = 0; run < 500; run += 1) {
+    const registry = {};
+    const root = {};
+    for (let i = 0; i < 4; i += 1) {
+      const name = `p${i}`;
+      registry[name] = {};
+      if (random(2)) root[name] = ranges[random(ranges.length)];
+      for (const version of ['1.0.0', '2.0.0']) {
+        const deps = {};
+        for (let j = 0; j < 5; j += 1) {
+          if (random(4) === 0) deps[`p${j}`] = ranges[random(ranges.length)];
+        }
+        registry[name][version] = deps;
+      }
+    }
+    assert.deepEqual(resolve(registry, root), referenceResolve(registry, root), `graph ${run}`);
+  }
+});
