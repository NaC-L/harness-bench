@@ -0,0 +1,142 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column);
+    return true;
+  });
+}
+
+test('numbers, arithmetic precedence, and left associativity', () => {
+  const cases = [
+    ['0', 0], ['.5 + 5. + 1.5e-3', 5.5015], ['2E+2', 200],
+    ['20 - 6 - 3', 11], ['24 / 4 / 2', 3], ['2 + 3 * 4', 14],
+    ['(2 + 3) * 4', 20], ['20 // 3 * 2 % 5', 2], ['--2 + +-3', -1],
+    ['2 * -3 + 4 / +2', -4],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('power is right associative and binds asymmetrically to unary signs', () => {
+  const cases = [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['2 ** -2 ** 2', 0.0625],
+    ['-2 ** -2', -0.25], ['--2 ** 2', 4], ['3 * -2 ** 2', -12],
+    ['2 ** +3', 8], ['-(2 ** 2)', -4],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('floor division and modulo preserve the integer identity and divisor sign', () => {
+  for (let a = -30; a <= 30; a += 1) {
+    for (let b = -10; b <= 10; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      if (remainder !== 0) assert.equal(Math.sign(remainder), Math.sign(b));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const source of ['0 // -3', '-0 // 3', '-6 % 3', '6 % -3', '-0 % -3']) {
+    assert.ok(Object.is(evaluate(source), 0), source);
+  }
+});
+
+test('comparisons chain, short circuit, and coerce booleans numerically', () => {
+  const cases = [
+    ['3 > 2 > 1', true], ['1 < 2 <= 2 != 3', true], ['1 < 2 > 3', false],
+    ['1 + 2 < 2 * 2', true], ['(1 < 2) + (2 < 1)', 1],
+    ['(1 < 2) == 1', true], ['(2 < 1) == 0', true],
+    ['(1 < 2) != 1', false], ['(3 > 2) > 0', true],
+    ['(3 > 2) > 1', false], ['2 < 1 < missing', false],
+    ['2 < 1 < 1 / 0', false], ['2 < 1 < 2 ** missing', false],
+  ];
+  for (const [source, expected] of cases) assert.equal(evaluate(source), expected, source);
+});
+
+test('shared comparison operands and call arguments read getters once in order', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, { get() { reads.push(name); return value; } });
+  }
+  Object.freeze(variables);
+  assert.equal(evaluate('a < b < c', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('max(a + b, abs(-c), min(b, a))', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'b', 'a']);
+  assert.equal(evaluate('a + a * b', variables), 3);
+  assert.deepEqual(reads, ['a', 'a', 'b']);
+});
+
+test('variables use only own properties, including built-in names used without calls', () => {
+  const variables = Object.assign(Object.create({ inherited: 4 }), { min: 7, _x2: 3 });
+  assert.equal(evaluate('min + _x2', variables), 10);
+  errorAt('  inherited', 3, variables);
+  errorAt('constructor', 1, variables);
+  const own = Object.create(null);
+  own.__proto__ = 8;
+  assert.equal(evaluate('__proto__', own), 8);
+});
+
+test('built-ins accept expression arguments and enforce arities', () => {
+  assert.equal(evaluate('min(4, 2 + 1, -5, max(2, 7))'), -5);
+  assert.equal(evaluate('max(4)'), 4);
+  assert.equal(evaluate('abs(-2 ** 2)'), 4);
+  assert.equal(evaluate('min(1 < 2, 2 < 1)'), 0);
+  for (const source of ['  min()', '  max()', '  abs()', '  abs(1, 2)', '  unknown(1)']) {
+    errorAt(source, 3);
+  }
+});
+
+test('the full formula is parsed before any variable reads or arithmetic', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  for (const source of ['x + abs()', 'x + unknown(2)', 'x + 2 3', 'x + @']) {
+    assert.throws(() => evaluate(source, variables), ExprError);
+  }
+  errorAt('1 / 0 + abs()', 9);
+  errorAt('2 < 1 < min()', 9);
+  errorAt('2 < 1 < unknown(1)', 9);
+  errorAt('2 < 1 < (3 + )', 14);
+  assert.equal(reads, 0);
+});
+
+test('errors point at token starts after whitespace, or the actual end of source', () => {
+  for (const operator of ['/', '//', '%']) {
+    const source = `  1 \t ${operator}  -0`;
+    errorAt(source, source.indexOf(operator) + 1);
+  }
+  for (const [source, token] of [
+    ['1 + \n  missing', 'missing'], ['1 + \t @', '@'], ['1  \n 2', '2'],
+    ['min(1,  )', ')'], ['1 + \t)', ')'], ['2 (3)', '('],
+    ['  1 = 2', '='], ['  1 ! 2', '!'], ['1.2.3', '.3'],
+    ['  \t\u{1f600}', '\u{1f600}'], ['  \u20031 + @', '@'],
+  ]) {
+    errorAt(source, source.indexOf(token) + 1);
+  }
+  for (const source of ['', ' \n\t', '1 +  \n', 'min(1,  ', '(1 + 2  ']) {
+    errorAt(source, source.length + 1);
+  }
+});
+
+test('100,001-operand flat arithmetic, comparison, and call formulas are stack safe', () => {
+  const count = 100001;
+  const operands = Array(count).fill('1');
+  assert.equal(evaluate(operands.join('+')), count);
+  assert.equal(evaluate(operands.join('*')), 1);
+  assert.equal(evaluate(operands.join('==')), true);
+  assert.equal(evaluate(`max(${operands.join(',')})`), 1);
+});
