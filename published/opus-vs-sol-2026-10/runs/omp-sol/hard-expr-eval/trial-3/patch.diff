@@ -0,0 +1,140 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { evaluate, ExprError } = require('./src/index');
+
+function errorAt(source, column, variables) {
+  assert.throws(() => evaluate(source, variables), error => {
+    assert.ok(error instanceof ExprError);
+    assert.equal(error.name, 'ExprError');
+    assert.equal(error.column, column, source);
+    return true;
+  });
+}
+
+test('arithmetic follows the documented precedence and associativity', () => {
+  const cases = [
+    ['-2 ** 2', -4], ['(-2) ** 2', 4], ['2 ** -1', 0.5],
+    ['2 ** 3 ** 2', 512], ['-2 ** -2', -0.25],
+    ['2 ** -2 ** 2', 0.0625], ['--2 ** 2', 4],
+    ['2 * -3 ** 2', -18], ['+2 ** 3 * 4', 32],
+    ['20 - 5 - 3', 12], ['24 / 3 * 2', 16],
+    ['24 // 5 % 3 * 2', 2], ['2 + 3 * 4', 14],
+    ['1.5 + .5 + 5. + 1.5e-3 + 2E+1', 27.0015],
+    ['min(3, max(2, 5), abs(-4))', 3],
+    ['max(-3, -2, -4)', -2], ['min(4)', 4],
+  ];
+  for (const [source, expected] of cases) {
+    assert.equal(evaluate(source), expected, source);
+  }
+});
+
+test('floor division and modulo obey signed integer identities and normalize zero', () => {
+  for (let a = -20; a <= 20; a += 1) {
+    for (let b = -7; b <= 7; b += 1) {
+      if (b === 0) continue;
+      const quotient = evaluate('a // b', { a, b });
+      const remainder = evaluate('a % b', { a, b });
+      assert.equal(quotient, Math.floor(a / b) || 0);
+      assert.equal(quotient * b + remainder, a);
+      assert.ok(remainder === 0 || Math.sign(remainder) === Math.sign(b));
+      assert.ok(Math.abs(remainder) < Math.abs(b));
+      if (quotient === 0) assert.ok(!Object.is(quotient, -0));
+      if (remainder === 0) assert.ok(!Object.is(remainder, -0));
+    }
+  }
+  assert.equal(evaluate('-7.5 // 2'), -4);
+  assert.equal(evaluate('-7.5 % 2'), 0.5);
+  assert.equal(evaluate('7.5 % -2'), -0.5);
+  for (const source of ['0 // -2', '-0 // 2', '-6 % 3', '6 % -3']) {
+    assert.ok(Object.is(evaluate(source), 0), source);
+  }
+});
+
+test('comparisons chain, return booleans, and coerce booleans in numeric contexts', () => {
+  const cases = [
+    ['1 < 2 < 3', true], ['3 < 2 < 1', false],
+    ['3 > 2 >= 2 == 2 != 4 <= 5', true],
+    ['1 < 2 > 1', true], ['2 == 2 == 2', true],
+    ['1 < 2 == 2 > 3', false], ['1 != 2 != 1', true],
+    ['(1 < 2) + (3 < 2)', 1], ['(1 < 2) == 1', true],
+    ['(3 < 2) == 0', true], ['1 < (2 < 3)', false],
+    ['(1 < 2) < 2', true], ['-(1 < 2) ** 2', -1],
+    ['abs(1 > 2)', 0], ['max(1 < 2, 2 < 1)', 1],
+    ['1 + 2 < 2 * 2', true],
+  ];
+  for (const [source, expected] of cases) {
+    assert.equal(evaluate(source), expected, source);
+  }
+  assert.equal(evaluate('3 < 2 < missing'), false);
+  assert.equal(evaluate('3 < 2 < (1 / 0)'), false);
+});
+
+test('getters are read once per occurrence in left-to-right evaluation order', () => {
+  const reads = [];
+  const variables = {};
+  for (const [name, value] of [['a', 1], ['b', 2], ['c', 3]]) {
+    Object.defineProperty(variables, name, {
+      get() { reads.push(name); return value; },
+    });
+  }
+  assert.equal(evaluate('a < b <= c', variables), true);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c']);
+  assert.equal(evaluate('c < b < a', variables), false);
+  assert.deepEqual(reads.splice(0), ['c', 'b']);
+  assert.equal(evaluate('max(a + b, abs(-c), a ** b)', variables), 3);
+  assert.deepEqual(reads.splice(0), ['a', 'b', 'c', 'a', 'b']);
+  let occurrences = 0;
+  const changing = { get x() { occurrences += 1; return occurrences; } };
+  assert.equal(evaluate('x < x < x', changing), true);
+  assert.equal(occurrences, 3);
+});
+
+test('variables use own properties without changing the variable object', () => {
+  const variables = Object.freeze(Object.assign(Object.create({ inherited: 5 }), {
+    _amount2: 4, constructor: 3, min: 2,
+  }));
+  assert.equal(evaluate('_amount2 + constructor + min', variables), 9);
+  errorAt('inherited', 1, variables);
+  errorAt('toString', 1, {});
+  assert.equal(evaluate('__proto__', JSON.parse('{"__proto__": 7}')), 7);
+  assert.equal(evaluate('x', Object.assign(Object.create(null), { x: 8 })), 8);
+});
+
+test('error columns point to tokens after whitespace and to the true end of input', () => {
+  const cases = [
+    ['', 1], [' \t\n', 4], ['1 +  \t', 7],
+    ['  missing', 3], ['1 +\n  missing', 7],
+    ['1 /   0', 3], ['1  // 0', 4], ['1   % -0', 5],
+    ['1 / (2 > 3)', 3], ['1 +   @', 7], ['1 +   \u{1F600}', 7],
+    ['1   2', 5], ['(1 + 2   ', 10], ['1 + )', 5],
+    ['1e+', 2], ['2(3)', 2], ['1 = 2', 3], ['1 ! 2', 3],
+    ['1 & 2', 3], ['"1"', 1], ['min(1,)', 7],
+    ['  unknown(1)', 3], ['  abs()', 3], ['  abs(1, 2)', 3],
+    ['  min()', 3], ['  max()', 3], ['min(1 2)', 7],
+  ];
+  for (const [source, column] of cases) errorAt(source, column);
+});
+
+test('the entire formula is validated before evaluation, including skipped operands', () => {
+  let reads = 0;
+  const variables = { get x() { reads += 1; return 1; } };
+  for (const [source, column] of [
+    ['x + abs()', 5], ['x + unknown(1)', 5], ['x + max()', 5],
+    ['x < 0 < abs(1, 2)', 9], ['x < 0 < (1 + )', 14],
+    ['x + 1   2', 9], ['x + 1 @', 7],
+  ]) {
+    errorAt(source, column, variables);
+    assert.equal(reads, 0, source);
+  }
+});
+
+test('100,001-operand flat chains are linear and stack-safe', () => {
+  const count = 100001;
+  assert.equal(evaluate(Array(count).fill('1').join('+')), count);
+  assert.equal(evaluate(Array(count).fill('1').join('*')), 1);
+  assert.equal(evaluate(Array(count).fill('1').join('==')), true);
+  assert.equal(evaluate('2 < 1 < ' + Array(count).fill('missing').join(' < ')), false);
+  assert.equal(evaluate('max(' + Array(count).fill('1').join(',') + ')'), 1);
+});
