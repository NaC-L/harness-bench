@@ -0,0 +1,172 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('./diff');
+
+// A deliberately tiny, independent oracle; production must not use this table.
+function editDistance(a, b) {
+  const rows = Array.from({ length: a.length + 1 }, () =>
+    new Array(b.length + 1).fill(0));
+  for (let i = 1; i <= a.length; i++) {
+    for (let j = 1; j <= b.length; j++) {
+      rows[i][j] = a[i - 1] === b[j - 1]
+        ? rows[i - 1][j - 1] + 1
+        : Math.max(rows[i - 1][j], rows[i][j - 1]);
+    }
+  }
+  return a.length + b.length - 2 * rows[a.length][b.length];
+}
+
+function verify(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(entry => entry.op !== 'insert').map(entry => entry.line), a);
+  assert.deepEqual(script.filter(entry => entry.op !== 'delete').map(entry => entry.line), b);
+  assert.equal(script.filter(entry => entry.op !== 'equal').length, editDistance(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserting = false;
+  for (const { op } of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(op));
+    if (op === 'equal') inserting = false;
+    if (op === 'insert') inserting = true;
+    if (op === 'delete') assert.equal(inserting, false);
+  }
+  for (const context of [0, 1, 2, 3]) {
+    const hunks = unifiedHunks(a, b, { context });
+    for (const hunk of hunks) {
+      Object.freeze(hunk.lines);
+      Object.freeze(hunk);
+    }
+    Object.freeze(hunks);
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+}
+
+test('minimal deterministic scripts and roundtrips for exhaustive repetitive inputs', () => {
+  const inputs = [Object.freeze([])];
+  let level = inputs;
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(lines => ['', 'repeat'].map(line => Object.freeze([...lines, line])));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) verify(a, b);
+  }
+});
+
+test('seeded mixed-line scripts preserve prefixes, whitespace, and repeated lines', () => {
+  let seed = 123456789;
+  const random = () => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed;
+  };
+  const alphabet = ['', 'repeat', '+added', '-removed', ' leading', '\r', 'repeat'];
+  const input = () => Object.freeze(Array.from({ length: random() % 30 }, () =>
+    alphabet[random() % alphabet.length]));
+  for (let i = 0; i < 250; i++) verify(input(), input());
+});
+
+test('zero-line ranges use preceding line coordinates at every boundary', () => {
+  const base = Object.freeze(['a', 'b']);
+  for (let position = 0; position <= base.length; position++) {
+    const added = [...base.slice(0, position), '+new', ...base.slice(position)];
+    assert.deepEqual(unifiedHunks(base, added, { context: 0 }), [{
+      oldStart: position, oldLines: 0,
+      newStart: position + 1, newLines: 1, lines: ['++new'],
+    }]);
+    assert.deepEqual(unifiedHunks(added, base, { context: 0 }), [{
+      oldStart: position + 1, oldLines: 1,
+      newStart: position, newLines: 0, lines: ['-+new'],
+    }]);
+    assert.deepEqual(applyHunks(base, unifiedHunks(base, added, { context: 0 })), added);
+    assert.deepEqual(applyHunks(added, unifiedHunks(added, base, { context: 0 })), base);
+  }
+  assert.deepEqual(unifiedHunks([], []), []);
+  assert.deepEqual(unifiedHunks(base, base), []);
+  const copy = applyHunks(base, []);
+  assert.deepEqual(copy, base);
+  assert.notEqual(copy, base);
+});
+
+test('context merges exactly at touching boundaries without duplication', () => {
+  const a = ['0', '1', '2', '3', '4', '5', '6', '7'];
+  const touching = ['0', 'one', '2', '3', 'four', '5', '6', '7'];
+  assert.deepEqual(unifiedHunks(a, touching, { context: 1 }), [{
+    oldStart: 1, oldLines: 6, newStart: 1, newLines: 6,
+    lines: [' 0', '-1', '+one', ' 2', ' 3', '-4', '+four', ' 5'],
+  }]);
+  const separated = ['0', 'one', '2', '3', '4', 'five', '6', '7'];
+  assert.deepEqual(unifiedHunks(a, separated, { context: 1 }), [
+    { oldStart: 1, oldLines: 3, newStart: 1, newLines: 3,
+      lines: [' 0', '-1', '+one', ' 2'] },
+    { oldStart: 5, oldLines: 3, newStart: 5, newLines: 3,
+      lines: [' 4', '-5', '+five', ' 6'] },
+  ]);
+  assert.equal(unifiedHunks(a, separated, { context: 100 }).length, 1);
+});
+
+test('application retains unmentioned lines and tracks original coordinates', () => {
+  const a = Object.freeze(['a', 'b', 'c', 'd']);
+  const hunks = [
+    { oldStart: 0, oldLines: 0, newStart: 1, newLines: 2, lines: ['+x', '+y'] },
+    { oldStart: 2, oldLines: 1, newStart: 3, newLines: 0, lines: ['-b'] },
+    { oldStart: 4, oldLines: 0, newStart: 6, newLines: 1, lines: ['+z'] },
+  ];
+  assert.deepEqual(applyHunks(a, hunks), ['x', 'y', 'a', 'c', 'd', 'z']);
+});
+
+test('malformed and nonapplicable hunks identify their index', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: [' a'] };
+  const invalid = [
+    null, undefined, 42, {},
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: Infinity },
+    { ...valid, oldStart: Number.MAX_SAFE_INTEGER + 1 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 2 },
+    { ...valid, oldLines: -1 }, { ...valid, oldLines: 4 },
+    { ...valid, oldLines: 0 }, { ...valid, newLines: 0 },
+    { ...valid, newLines: '1' }, { ...valid, lines: null },
+    { ...valid, lines: [null] }, { ...valid, lines: [''] },
+    { ...valid, lines: ['?a'] }, { ...valid, lines: [' b'] },
+    { ...valid, lines: ['-b', '+a'] }, { ...valid, lines: [' a', ' b'] },
+    { ...valid, oldStart: 4, newStart: 4 },
+    { oldStart: 4, oldLines: 0, newStart: 5, newLines: 1, lines: ['+x'] },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, null]), /hunk 1 does not apply/);
+  const later = { oldStart: 3, oldLines: 1, newStart: 3, newLines: 1, lines: [' c'] };
+  assert.throws(() => applyHunks(a, [later, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, null), /hunk 0 does not apply/);
+});
+
+test('invalid context is rejected', () => {
+  for (const context of [-1, 0.5, NaN, Infinity, '3']) {
+    assert.throws(() => unifiedHunks([], [], { context }), /context/);
+  }
+});
+
+test('small edits to 20,000 lines run in under a second', () => {
+  for (const repeated of [false, true]) {
+    const a = Object.freeze(Array.from({ length: 20000 }, (_, i) =>
+      repeated ? 'repeat' : `line ${i}`));
+    const b = [...a];
+    b[0] = 'changed top';
+    b[10000] = 'changed middle';
+    b[19999] = 'changed end';
+    Object.freeze(b);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    const result = applyHunks(a, hunks);
+    const elapsed = performance.now() - start;
+    assert.ok(elapsed < 1000, `small-change diff took ${elapsed.toFixed(1)} ms`);
+    assert.equal(script.filter(entry => entry.op !== 'equal').length, 6);
+    assert.deepEqual(result, b);
+    assert.deepEqual(unifiedHunks(a, a), []);
+  }
+});
