@@ -0,0 +1,166 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { performance } = require('node:perf_hooks');
+const { diffLines, unifiedHunks, applyHunks } = require('../src/diff');
+
+// A small, independent oracle is appropriate here, not in the implementation.
+function editDistance(a, b) {
+  let row = Array.from({ length: b.length + 1 }, (_, i) => i);
+  for (let i = 0; i < a.length; i++) {
+    const next = [i + 1];
+    for (let j = 0; j < b.length; j++) {
+      next[j + 1] = a[i] === b[j] ? row[j] : Math.min(row[j + 1], next[j]) + 1;
+    }
+    row = next;
+  }
+  return row[b.length];
+}
+
+function checkScript(a, b) {
+  const script = diffLines(a, b);
+  assert.deepEqual(script.filter(e => e.op !== 'insert').map(e => e.line), a);
+  assert.deepEqual(script.filter(e => e.op !== 'delete').map(e => e.line), b);
+  assert.equal(script.filter(e => e.op !== 'equal').length, editDistance(a, b));
+  assert.deepEqual(diffLines(a, b), script);
+  let inserted = false;
+  for (const entry of script) {
+    assert.ok(['equal', 'delete', 'insert'].includes(entry.op));
+    if (entry.op === 'equal') inserted = false;
+    if (entry.op === 'insert') inserted = true;
+    if (entry.op === 'delete') assert.equal(inserted, false);
+  }
+}
+
+function checkRoundtrip(a, b, context) {
+  const hunks = unifiedHunks(a, b, { context });
+  for (const hunk of hunks) {
+    Object.freeze(hunk.lines);
+    Object.freeze(hunk);
+  }
+  Object.freeze(hunks);
+  assert.deepEqual(applyHunks(a, hunks), b);
+}
+
+test('exhaustive short repeated-line scripts are minimal, ordered and applicable', () => {
+  const alphabet = ['', 'repeat', '+prefix'];
+  const inputs = [Object.freeze([])];
+  let level = [[]];
+  for (let length = 1; length <= 3; length++) {
+    level = level.flatMap(lines => alphabet.map(line => Object.freeze([...lines, line])));
+    inputs.push(...level);
+  }
+  for (const a of inputs) {
+    for (const b of inputs) {
+      checkScript(a, b);
+      for (const context of [0, 1, 2, 3]) checkRoundtrip(a, b, context);
+    }
+  }
+});
+
+test('seeded repetitive inputs agree with an independent edit-distance oracle', () => {
+  let seed = 123456;
+  const random = n => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  };
+  const alphabet = ['', 'same', 'other', '-delete', '+insert', ' context'];
+  for (let trial = 0; trial < 250; trial++) {
+    const a = Object.freeze(Array.from({ length: random(50) }, () => alphabet[random(alphabet.length)]));
+    const b = Object.freeze(Array.from({ length: random(50) }, () => alphabet[random(alphabet.length)]));
+    checkScript(a, b);
+    checkRoundtrip(a, b, random(6));
+  }
+});
+
+test('zero-length ranges name the preceding line, including at boundaries', () => {
+  const cases = [
+    [[], ['x'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['x'], [], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a'], ['x', 'a'], { oldStart: 0, oldLines: 0, newStart: 1, newLines: 1, lines: ['+x'] }],
+    [['a'], ['a', 'x'], { oldStart: 1, oldLines: 0, newStart: 2, newLines: 1, lines: ['+x'] }],
+    [['x', 'a'], ['a'], { oldStart: 1, oldLines: 1, newStart: 0, newLines: 0, lines: ['-x'] }],
+    [['a', 'x'], ['a'], { oldStart: 2, oldLines: 1, newStart: 1, newLines: 0, lines: ['-x'] }],
+  ];
+  for (const [a, b, hunk] of cases) {
+    assert.deepEqual(unifiedHunks(a, b, { context: 0 }), [hunk]);
+    assert.deepEqual(applyHunks(a, [hunk]), b);
+  }
+});
+
+test('touching context merges, separated context does not, and coordinates are global', () => {
+  for (const gap of [1, 2, 3]) {
+    const middle = Array.from({ length: gap }, (_, i) => `gap${i}`);
+    const a = ['before', 'old1', ...middle, 'old2', 'after'];
+    const b = ['before', 'new1', ...middle, 'new2', 'after'];
+    const hunks = unifiedHunks(a, b, { context: 1 });
+    assert.equal(hunks.length, gap <= 2 ? 1 : 2);
+    if (gap <= 2) {
+      assert.deepEqual(hunks[0].lines, [' before', '-old1', '+new1', ...middle.map(s => ' ' + s), '-old2', '+new2', ' after']);
+    } else {
+      assert.equal(hunks[1].oldStart, 5);
+      assert.equal(hunks[1].newStart, 5);
+    }
+    assert.deepEqual(applyHunks(a, hunks), b);
+  }
+  const a = ['a', 'b', 'c', 'd'];
+  const b = ['x', 'y', 'a', 'b', 'd', 'z'];
+  const hunks = unifiedHunks(a, b, { context: 0 });
+  assert.deepEqual(hunks.map(h => [h.oldStart, h.newStart]), [[0, 1], [3, 4], [4, 6]]);
+  assert.deepEqual(applyHunks(a, hunks), b);
+});
+
+test('application rejects mismatches, malformed counts, ordering and coordinates', () => {
+  const a = Object.freeze(['a', 'b', 'c']);
+  const valid = { oldStart: 2, oldLines: 1, newStart: 2, newLines: 1, lines: ['-b', '+B'] };
+  const invalid = [
+    null, {},
+    { ...valid, oldStart: -1 }, { ...valid, oldStart: 0 },
+    { ...valid, oldStart: 1.5 }, { ...valid, oldStart: NaN },
+    { ...valid, oldLines: -1 }, { ...valid, oldLines: 0 },
+    { ...valid, oldLines: 9 }, { ...valid, oldStart: 5 },
+    { ...valid, newStart: 0 }, { ...valid, newStart: 3 },
+    { ...valid, newLines: 0 }, { ...valid, newLines: 2 },
+    { ...valid, lines: ['-wrong', '+B'] },
+    { ...valid, lines: [' wrong'] },
+    { ...valid, lines: ['?b'] }, { ...valid, lines: [''] },
+    { ...valid, lines: [null] }, { ...valid, lines: '-b' },
+  ];
+  for (const hunk of invalid) {
+    assert.throws(() => applyHunks(a, [hunk]), /hunk 0 does not apply/);
+  }
+  assert.throws(() => applyHunks(a, [valid, valid]), /hunk 1 does not apply/);
+  assert.throws(() => applyHunks(a, [valid, { ...valid, oldStart: 1 }]), /hunk 1 does not apply/);
+  assert.deepEqual(applyHunks(a, [valid]), ['a', 'B', 'c']);
+  assert.deepEqual(applyHunks(a, []), a);
+  assert.notEqual(applyHunks(a, []), a);
+  assert.deepEqual(unifiedHunks(a, a), []);
+});
+
+test('small edits on 20,000 lines remain comfortably subsecond', t => {
+  for (const repetitive of [false, true]) {
+    const a = Object.freeze(Array.from({ length: 20000 }, (_, i) => repetitive ? 'same' : `line ${i}`));
+    const b = a.slice();
+    b.splice(5000, 1, 'replacement');
+    b.splice(10000, 0, 'inserted');
+    b.splice(15000, 1);
+    Object.freeze(b);
+    const start = performance.now();
+    const script = diffLines(a, b);
+    const hunks = unifiedHunks(a, b);
+    assert.deepEqual(applyHunks(a, hunks), b);
+    const elapsed = performance.now() - start;
+    assert.equal(script.filter(e => e.op !== 'equal').length, 4);
+    assert.ok(elapsed < 1000, `small-edit roundtrip took ${elapsed.toFixed(1)}ms`);
+    t.diagnostic(`${repetitive ? 'repeated' : 'unique'} lines: ${elapsed.toFixed(1)}ms`);
+  }
+});
+
+test('large one-sided diffs need no edit-distance search', () => {
+  const lines = Object.freeze(Array.from({ length: 20000 }, (_, i) => `line ${i}`));
+  assert.deepEqual(diffLines([], lines), lines.map(line => ({ op: 'insert', line })));
+  assert.deepEqual(diffLines(lines, []), lines.map(line => ({ op: 'delete', line })));
+  checkRoundtrip([], lines, 3);
+  checkRoundtrip(lines, [], 3);
+});
