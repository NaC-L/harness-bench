@@ -0,0 +1,169 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignment discards pending additions at both parent and child nodes', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5]);
+  tree.add(0, 2, 7);
+  tree.add(0, 5, 3);
+  tree.assign(0, 5, 0);
+  tree.add(0, 5, -2);
+  assert.equal(tree.sum(1, 4), -6);
+  assert.deepEqual(tree.toArray(), [-2, -2, -2, -2, -2]);
+  tree.add(0, 5, 9);
+  tree.assign(0, 5, 4);
+  tree.assign(1, 4, -6);
+  assert.equal(tree.sum(0, 5), -10);
+  assert.deepEqual(tree.toArray(), [4, -6, -6, -6, 4]);
+});
+
+test('partial maxima retain negative values', () => {
+  const tree = new RangeTree([-9, -4, -7, -2, -8]);
+  assert.equal(tree.max(0, 2), -4);
+  assert.equal(tree.max(2, 5), -2);
+  assert.equal(tree.max(2, 3), -7);
+  tree.assign(0, 5, -10);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(0, 4), -7);
+  assert.equal(tree.max(4, 5), -10);
+});
+
+test('threshold search propagates assignments and additions before descending', () => {
+  const tree = new RangeTree([-5, -3, -7, -2, -9]);
+  tree.assign(0, 5, 10);
+  assert.equal(tree.firstAtLeast(0, 10), 0);
+  assert.equal(tree.firstAtLeast(3, 10), 3);
+  tree.add(0, 5, 5);
+  assert.equal(tree.firstAtLeast(2, 15), 2);
+  tree.assign(0, 3, -4);
+  assert.equal(tree.firstAtLeast(0, 0), 3);
+  const mixed = new RangeTree([10, 1, 20, 0]);
+  mixed.add(0, 4, -5);
+  assert.equal(mixed.firstAtLeast(0, 8), 2);
+  assert.equal(mixed.firstAtLeast(3, 8), -1);
+  assert.equal(mixed.firstAtLeast(0, Infinity), -1);
+  assert.equal(mixed.firstAtLeast(1, -Infinity), 1);
+  assert.equal(mixed.firstAtLeast(4, -Infinity), -1);
+});
+
+test('empty ranges, return values, read-only length, and array ownership', () => {
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 99;
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 4; }, TypeError);
+  assert.equal(tree.assign(1, 1, 9), undefined);
+  assert.equal(tree.add(3, 3, 9), undefined);
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  assert.equal(tree.assign(0, 1, 4), undefined);
+  assert.equal(tree.add(0, 1, 2), undefined);
+  const output = tree.toArray();
+  output[0] = 99;
+  assert.deepEqual(tree.toArray(), [6, 2, 3]);
+});
+
+test('invalid arguments throw RangeError without mutation, including empty updates', () => {
+  for (const values of [null, {}, [], [NaN], [Infinity], ['1'], new Array(2)]) {
+    assert.throws(() => new RangeTree(values), RangeError);
+  }
+  const tree = new RangeTree([1, 2, 3]);
+  tree.add(0, 3, 4);
+  const expected = [5, 6, 7];
+  const badRanges = [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2]];
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of badRanges) {
+      assert.throws(() => tree[method](l, r, 99), RangeError);
+    }
+  }
+  for (const value of [NaN, Infinity, -Infinity, '1', null, undefined, 1n]) {
+    for (const method of ['assign', 'add']) {
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+    }
+  }
+  for (const index of [-1, 3, 0.5, NaN, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 1), RangeError);
+  }
+  for (const threshold of [NaN, '1', null, undefined, 1n]) {
+    assert.throws(() => tree.firstAtLeast(0, threshold), RangeError);
+  }
+  assert.deepEqual(tree.toArray(), expected);
+});
+
+test('mixed updates and queries agree with an array oracle across tree shapes', () => {
+  let seed = 0x42a17;
+  const random = limit => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % limit;
+  };
+  for (const size of [1, 2, 3, 5, 8, 17, 33]) {
+    const values = Array.from({ length: size }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 1200; step++) {
+      let l = random(size + 1);
+      let r = random(size + 1);
+      if (l > r) [l, r] = [r, l];
+      if (step % 13 === 0) [l, r] = [0, size];
+      const value = random(61) - 30;
+      const operation = random(6);
+      const context = `size=${size}, step=${step}, range=[${l}, ${r})`;
+      if (operation === 0 || operation === 1) {
+        if (operation === 0) tree.assign(l, r, value);
+        else tree.add(l, r, value);
+        for (let i = l; i < r; i++) {
+          values[i] = operation === 0 ? value : values[i] + value;
+        }
+      } else if (operation === 2) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0), context);
+      } else if (operation === 3) {
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)), context);
+      } else if (operation === 4) {
+        const expected = values.findIndex((v, i) => i >= l && v >= value);
+        assert.equal(tree.firstAtLeast(l, value), expected, context);
+      } else {
+        const index = random(size);
+        assert.equal(tree.get(index), values[index], context);
+      }
+      // Keep lazy tags pending across many operations rather than flushing every update.
+      if (step % 97 === 96) assert.deepEqual(tree.toArray(), values, context);
+    }
+    assert.deepEqual(tree.toArray(), values);
+  }
+});
+
+test('large range operations visit logarithmically many nodes; materialization is linear', () => {
+  const size = 4097;
+  const tree = new RangeTree(new Array(size).fill(-10));
+  const counts = {};
+  for (const method of ['_update', '_sum', '_max', '_first', '_write']) {
+    const original = tree[method];
+    counts[method] = 0;
+    tree[method] = function (...args) {
+      counts[method]++;
+      return original.apply(this, args);
+    };
+  }
+  const bound = 8 * (Math.ceil(Math.log2(size)) + 1);
+  const check = (method, operation) => {
+    counts[method] = 0;
+    operation();
+    assert.ok(counts[method] <= bound, `${method} visited ${counts[method]} nodes`);
+  };
+  check('_update', () => tree.add(1, size - 1, 2));
+  check('_update', () => tree.assign(2, size - 2, -3));
+  check('_sum', () => assert.equal(tree.sum(1, size - 1), -16 - 3 * (size - 4)));
+  check('_max', () => assert.equal(tree.max(1, size - 1), -3));
+  tree.assign(size - 1, size, 20);
+  check('_first', () => assert.equal(tree.firstAtLeast(1, 0), size - 1));
+  check('_sum', () => assert.equal(tree.get(size - 1), 20));
+  assert.equal(tree.toArray().length, size);
+  assert.equal(counts._write, 2 * size - 1);
+});
