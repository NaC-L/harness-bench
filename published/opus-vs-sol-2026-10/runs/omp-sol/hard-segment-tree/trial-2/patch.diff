@@ -0,0 +1,135 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { RangeTree } = require('./src/range-tree');
+
+test('assignments discard additions on both parent and child lazy tags', () => {
+  const tree = new RangeTree([1, 2, 3, 4, 5, 6, 7]);
+  tree.add(0, 3, 20);
+  tree.add(3, 7, -10);
+  tree.assign(0, 7, -4);
+  tree.add(0, 7, 6);
+  tree.assign(0, 7, 0);
+  tree.add(1, 6, -3);
+  assert.equal(tree.sum(0, 7), -15);
+  assert.equal(tree.sum(2, 5), -9);
+  assert.deepEqual(tree.toArray(), [0, -3, -3, -3, -3, -3, 0]);
+});
+
+test('partial maxima preserve negative values', () => {
+  const tree = new RangeTree([-9, -8, -7, -6, -5]);
+  assert.equal(tree.max(0, 2), -8);
+  assert.equal(tree.max(2, 5), -5);
+  tree.assign(0, 5, -20);
+  tree.add(1, 4, 3);
+  assert.equal(tree.max(1, 4), -17);
+  assert.equal(tree.max(4, 5), -20);
+});
+
+test('threshold search propagates assignments and additions before descending', () => {
+  const tree = new RangeTree([10, -2, -3, -4, -5, -6, -7]);
+  tree.assign(0, 7, -10);
+  tree.add(0, 7, 15);
+  assert.equal(tree.firstAtLeast(0, 5), 0);
+  assert.equal(tree.firstAtLeast(2, 5), 2);
+  assert.equal(tree.firstAtLeast(0, 6), -1);
+  tree.assign(0, 3, -30);
+  tree.add(3, 7, 20);
+  assert.equal(tree.firstAtLeast(0, 25), 3);
+  assert.equal(tree.firstAtLeast(4, 25), 4);
+  assert.equal(tree.firstAtLeast(7, -Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+});
+
+test('mixed operations agree with a plain array across irregular tree sizes', () => {
+  let seed = 0x12345678;
+  const random = (limit) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 8) % limit;
+  };
+  for (const n of [1, 2, 3, 7, 8, 17, 32, 65]) {
+    const values = Array.from({ length: n }, () => random(41) - 20);
+    const tree = new RangeTree(values);
+    for (let step = 0; step < 2500; step++) {
+      let l = random(n + 1);
+      let r = random(n + 1);
+      if (l > r) [l, r] = [r, l];
+      // Regular full-range updates keep tags pending across multiple operations.
+      if (step % 5 === 0) [l, r] = [0, n];
+      const value = random(61) - 30;
+      const operation = random(8);
+      const context = `n=${n}, step=${step}, range=[${l}, ${r})`;
+      if (operation < 4) {
+        const assigning = operation < 2;
+        assert.equal(tree[assigning ? 'assign' : 'add'](l, r, value), undefined);
+        for (let i = l; i < r; i++) {
+          values[i] = assigning ? value : values[i] + value;
+        }
+      } else if (operation === 4) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0), context);
+      } else if (operation === 5) {
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)), context);
+      } else if (operation === 6) {
+        assert.equal(tree.firstAtLeast(l, value), values.findIndex((v, i) => i >= l && v >= value), context);
+      } else {
+        const i = random(n);
+        assert.equal(tree.get(i), values[i], context);
+      }
+      if (step % 97 === 96) assert.deepEqual(tree.toArray(), values, context);
+    }
+    assert.deepEqual(tree.toArray(), values);
+    for (let l = 0; l <= n; l++) {
+      for (let r = l; r <= n; r++) {
+        assert.equal(tree.sum(l, r), values.slice(l, r).reduce((a, b) => a + b, 0));
+        assert.equal(tree.max(l, r), Math.max(...values.slice(l, r)));
+      }
+    }
+  }
+});
+
+test('validation, empty ranges, read-only length, and array independence are preserved', () => {
+  for (const input of [[], [NaN], [Infinity], [-Infinity], ['1'], new Array(2), null, 1, new Float64Array([1])]) {
+    assert.throws(() => new RangeTree(input), RangeError);
+  }
+  const input = [1, 2, 3];
+  const tree = new RangeTree(input);
+  input[0] = 100;
+  assert.equal(tree.get(0), 1);
+  const output = tree.toArray();
+  output[1] = 100;
+  assert.equal(tree.get(1), 2);
+  assert.equal(tree.length, 3);
+  assert.throws(() => { tree.length = 100; }, TypeError);
+  tree.add(0, 3, 4);
+  for (const method of ['assign', 'add', 'sum', 'max']) {
+    for (const [l, r] of [[-1, 2], [0, 4], [2, 1], [0.5, 2], [0, NaN], ['0', 2], [0, Infinity]]) {
+      assert.throws(() => tree[method](l, r, 10), RangeError);
+    }
+  }
+  for (const method of ['assign', 'add']) {
+    for (const value of [NaN, Infinity, -Infinity, '1', undefined, null]) {
+      assert.throws(() => tree[method](1, 1, value), RangeError);
+      assert.throws(() => tree[method](0, 3, value), RangeError);
+    }
+    for (let i = 0; i <= tree.length; i++) assert.equal(tree[method](i, i, 99), undefined);
+  }
+  for (let i = 0; i <= tree.length; i++) {
+    assert.equal(tree.sum(i, i), 0);
+    assert.equal(tree.max(i, i), -Infinity);
+  }
+  for (const index of [-1, 3, 0.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.get(index), RangeError);
+  }
+  for (const lo of [-1, 4, 0.5, NaN, Infinity, '0']) {
+    assert.throws(() => tree.firstAtLeast(lo, 0), RangeError);
+  }
+  for (const x of [NaN, '1', undefined, null]) {
+    assert.throws(() => tree.firstAtLeast(0, x), RangeError);
+  }
+  assert.equal(tree.firstAtLeast(0, -Infinity), 0);
+  assert.equal(tree.firstAtLeast(0, Infinity), -1);
+  assert.equal(tree.firstAtLeast(3, -Infinity), -1);
+  assert.deepEqual(tree.toArray(), [5, 6, 7]);
+});
